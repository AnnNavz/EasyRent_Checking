@model EasyRent_Checking.Models.CustomerProfile

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Details";
    ViewData["ActivePage"] = "Customers";
}

<h1>Details</h1>

<div>
    <h4>Customer</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FullName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FullName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ContactNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ContactNumber)
        </dd>
        <dt class="col-sm-2">
            Email
        </dt>
        <dd class="col-sm-10">
            @(Model.User?.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ValidIDtype)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ValidIDtype)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ValidIDImagePath)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ValidIDImagePath)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-customerid="@Model?.CustomerId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
