@model EasyRent_Checking.Models.CustomerProfile
@using EasyRent_Checking.Models
@using System.Globalization

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Customer Details";
    ViewData["ActivePage"] = "Customers";

    var isPending = Model.Status == Status.Pending;
    var isActive = Model.Status == Status.Active;
    var isInactive = Model.Status == Status.Inactive;
    var email = Model.User?.Email ?? "—";
    var createdAt = Model.User?.CreatedAt;
    var customerLabel = Model.CustomerId.ToString("D8");
    var idFileName = !string.IsNullOrWhiteSpace(Model.FrontValidIDImagePath)
        ? System.IO.Path.GetFileName(Model.FrontValidIDImagePath)
        : null;
    var backFileName = !string.IsNullOrWhiteSpace(Model.BackValidIDImagePath)
        ? System.IO.Path.GetFileName(Model.BackValidIDImagePath)
        : null;

    string StatusLabel(Status status) => status switch
    {
        Status.Active => "Approved",
        Status.Inactive => "Inactive",
        _ => "Pending"
    };

    string StatusBadgeClass(Status status) => status switch
    {
        Status.Active => "booking-status-approved",
        Status.Inactive => "booking-status-cancelled",
        _ => "booking-status-pending"
    };

    string StatusIcon(Status status) => status switch
    {
        Status.Active => "bi-check-circle",
        Status.Inactive => "bi-x-circle",
        _ => "bi-clock"
    };

    string FormatIdType(string? type)
    {
        if (string.IsNullOrWhiteSpace(type)) return "—";
        return type switch
        {
            "NationalID" => "National ID",
            "DriverLicense" => "Driver's License",
            "VotersID" => "Voter's ID",
            "UMID" => "UMID",
            "Passport" => "Passport",
            _ => type
        };
    }

    string FormatTimestamp(DateTime value) =>
        value.ToString("MMM. d, yyyy", CultureInfo.InvariantCulture)
        + " • "
        + value.ToString("h:mm tt", CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/rentals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/customer-details.css" asp-append-version="true" />
}

<div class="container-fluid px-4 py-3 reservation-details-page customer-details-page">
    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="reservation-details-id-card mb-3">
                <div class="reservation-details-id-main">
                    <span class="reservation-view-id-label">Customer ID</span>
                    <h1 class="reservation-view-id mb-0">@customerLabel</h1>
                </div>
                <span class="booking-status-badge @StatusBadgeClass(Model.Status)">
                    <i class="bi @StatusIcon(Model.Status)"></i>@StatusLabel(Model.Status)
                </span>
            </div>

            <div class="reservation-view-card mb-4">
                <div class="customer-details-personal">
                    <div class="customer-details-avatar" aria-hidden="true">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="customer-details-personal-grid">
                        <div>
                            <span class="reservation-view-label">Full Name</span>
                            <span class="reservation-view-value">@Model.FullName</span>
                        </div>
                        <div>
                            <span class="reservation-view-label">Email Address</span>
                            <span class="reservation-view-value">@email</span>
                        </div>
                        <div>
                            <span class="reservation-view-label">Contact Number</span>
                            <span class="reservation-view-value">@Model.ContactNumber</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="reservation-view-card mb-4">
                <div class="reservation-view-section-title">
                    <span class="reservation-view-section-icon"><i class="bi bi-info-circle-fill"></i></span>
                    <span>Verification Documents</span>
                </div>
                <div class="mb-3">
                    <span class="reservation-view-label">ID Type</span>
                    <span class="reservation-view-value">@FormatIdType(Model.ValidIDtype)</span>
                </div>
                <div class="reservation-id-docs">
                    <div class="reservation-id-doc-card">
                        <span class="reservation-id-doc-label">Front</span>
                        <div class="reservation-id-doc-frame">
                            @if (!string.IsNullOrWhiteSpace(Model.FrontValidIDImagePath))
                            {
                                <a href="~/images/@Model.FrontValidIDImagePath" target="_blank" rel="noopener">
                                    <img src="~/images/@Model.FrontValidIDImagePath" alt="Front of valid ID" />
                                </a>
                            }
                            else
                            {
                                <div class="reservation-view-placeholder" aria-hidden="true">
                                    <i class="bi bi-person-vcard"></i>
                                </div>
                            }
                        </div>
                        <span class="reservation-id-doc-name">@(idFileName ?? "No file uploaded")</span>
                    </div>
                    <div class="reservation-id-doc-card">
                        <span class="reservation-id-doc-label">Back</span>
                        <div class="reservation-id-doc-frame">
                            @if (!string.IsNullOrWhiteSpace(Model.BackValidIDImagePath))
                            {
                                <a href="~/images/@Model.BackValidIDImagePath" target="_blank" rel="noopener">
                                    <img src="~/images/@Model.BackValidIDImagePath" alt="Back of valid ID" />
                                </a>
                            }
                            else
                            {
                                <div class="reservation-view-placeholder" aria-hidden="true">
                                    <i class="bi bi-person-vcard"></i>
                                </div>
                            }
                        </div>
                        <span class="reservation-id-doc-name">@(backFileName ?? "No file uploaded")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="details-page-actions reservation-details-side-actions mb-3">
                <a asp-action="Index" class="btn btn-page-back">Back</a>
                <a asp-action="Edit" asp-route-customerid="@Model.CustomerId" class="btn btn-reservation-edit">Edit Customer Details</a>
            </div>

            <div class="reservation-view-side-card mb-4">
                <h6 class="reservation-view-side-title">
                    <i class="bi bi-calendar3 me-2"></i>Account Activity
                </h6>
                <div class="customer-activity-timeline">
                    <div class="customer-activity-item">
                        <span class="customer-activity-dot"></span>
                        <div>
                            <strong>
                                @(createdAt.HasValue ? FormatTimestamp(createdAt.Value) : "—")
                            </strong>
                            <span>Customer account created</span>
                        </div>
                    </div>
                    @if (isActive)
                    {
                        <div class="customer-activity-item">
                            <span class="customer-activity-dot is-approved"></span>
                            <div>
                                <strong>Account approved</strong>
                                <span>Customer can sign in and book.</span>
                            </div>
                        </div>
                    }
                    else if (isInactive)
                    {
                        <div class="customer-activity-item">
                            <span class="customer-activity-dot is-rejected"></span>
                            <div>
                                <strong>Account inactive</strong>
                                <span>Rejected or deactivated.</span>
                            </div>
                        </div>
                    }
                </div>

                @if (isPending)
                {
                    <form asp-action="Approve" asp-route-customerid="@Model.CustomerId" method="post" class="mb-2"
                          data-confirm="Approve this customer?"
                          data-confirm-text="They will be able to sign in and complete bookings."
                          data-confirm-button="Approve Customer"
                          data-confirm-tone="approve">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn reservation-btn-approve w-100">Approve Customer</button>
                    </form>
                    <form asp-action="Reject" asp-route-customerid="@Model.CustomerId" method="post"
                          data-confirm="Reject this customer account?"
                          data-confirm-text="They will not be able to sign in until the account is reactivated."
                          data-confirm-button="Reject Customer"
                          data-confirm-tone="danger"
                          data-confirm-icon="bi-x-circle"
                          data-confirm-submit-icon="bi-x-lg">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn reservation-btn-reject w-100">Reject Customer</button>
                    </form>
                }
                else if (isActive)
                {
                    <form asp-action="Reject" asp-route-customerid="@Model.CustomerId" method="post"
                          data-confirm="Deactivate this customer account?"
                          data-confirm-text="They will not be able to sign in until the account is reactivated."
                          data-confirm-button="Deactivate Customer"
                          data-confirm-tone="danger"
                          data-confirm-icon="bi-slash-circle"
                          data-confirm-submit-icon="bi-slash-circle">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn reservation-btn-reject w-100">Deactivate Customer</button>
                    </form>
                }
                else
                {
                    <form asp-action="Approve" asp-route-customerid="@Model.CustomerId" method="post"
                          data-confirm="Reactivate this customer account?"
                          data-confirm-text="They will be able to sign in and complete bookings again."
                          data-confirm-button="Reactivate Customer"
                          data-confirm-tone="approve">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn reservation-btn-approve w-100">Reactivate Customer</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
