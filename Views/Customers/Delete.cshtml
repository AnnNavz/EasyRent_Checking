@model EasyRent_Checking.Models.CustomerProfile

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Delete";
    ViewData["ActivePage"] = "Customers";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Customer</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.User!.FullName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User!.FullName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.User!.ContactNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User!.ContactNumber)
        </dd>
        <dt class="col-sm-2">
