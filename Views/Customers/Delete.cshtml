        </dt>
        <dd class="col-sm-10">
            @(Model.User?.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ValidIDtype)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ValidIDtype)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.User!.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.User!.Status)
        </dd>
    </dl>
    <form asp-action="Delete" asp-route-customerid="@Model.CustomerId">
        <input type="hidden" asp-for="CustomerId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
