@model EasyRent_Checking.Models.Reservation
@using EasyRent_Checking.Models
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using System.IO

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "View Details";
    ViewData["ActivePage"] = "Bookings";

    var vehicle = Model.Vehicle;
    var pricing = vehicle != null
        ? ReservationPricingCalculator.Calculate(vehicle, Model)
        : null;

    string FormatBookingId(int id) => $"BK-{id:D4}";

    string FormatDateTime(DateOnly date, TimeOnly time)
    {
        var dt = date.ToDateTime(time);
        return dt.ToString("MMM. d, yyyy") + ", " + dt.ToString("h:mm tt");
    }

    string FormatStamp(DateTime? value)
    {
        if (value == null)
        {
            return "—";
        }

        var local = value.Value.Kind == DateTimeKind.Utc ? value.Value.ToLocalTime() : value.Value;
        return local.ToString("MMM. d, yyyy") + " • " + local.ToString("h:mm tt");
    }

    string StatusLabel(ReservationStatus status) => status switch
    {
        ReservationStatus.Confirmed => "Approved",
        ReservationStatus.InProgress => "Active",
        ReservationStatus.Pending => "Pending",
        _ => typeof(ReservationStatus).GetMember(status.ToString()).FirstOrDefault()
                ?.GetCustomAttribute<DisplayAttribute>()?.Name
            ?? status.ToString()
    };

    string PaymentLabel() => Model.PaymentChannel switch
    {
        PaymentChannel.GCash => "GCash QR Payment",
        PaymentChannel.BDO => "BDO Bank Transfer / QR",
        PaymentChannel.WalkIn => "Walk-in (Pay at Office)",
        _ => "—"
    };

    string Initials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
    }

    string DisplayFileName(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return string.Empty;
        var name = System.IO.Path.GetFileName(path);
        var underscore = name.IndexOf('_');
        if (underscore > 0 && underscore < name.Length - 1 && name.Length > 20)
        {
            return name[(underscore + 1)..];
        }
        return name;
    }

    string discountLabel = Model.Discount == 1 ? "Senior Citizen (10% off)" : "None";
    string typeLabel = vehicle == null ? "—" : (vehicle.Type == VehicleType.Van ? "Van" : vehicle.Type.ToString());
    bool isPending = Model.Status == ReservationStatus.Pending;
    string statusText = StatusLabel(Model.Status);
    string detailsReturnUrl = Url.Action("Details", new { id = Model.ReservationID }) ?? "";
}

@section Styles {
    <style>
        .booking-details-id-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            background: #d9d9d9;
            border-radius: 12px;
            padding: 0.85rem 1.1rem;
            margin-bottom: 1.1rem;
        }

        .booking-details-id {
            font-size: 1rem;
            font-weight: 700;
            color: #222;
            margin: 0;
        }

        .booking-details-id span {
            font-weight: 800;
        }

        .booking-details-id-actions {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            flex-wrap: wrap;
        }

        .booking-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.35rem 0.75rem;
            border-radius: 999px;
            background: #cfcfcf;
            color: #333;
            font-size: 0.75rem;
            font-weight: 700;
            box-shadow: 0 1px 3px rgba(0,0,0,.1);
        }

        .booking-status-pill.is-approved {
            background: #d9ebe0;
            color: #1f7a4d;
        }

        .booking-status-pill.is-rejected {
            background: #e8e8e8;
            color: #555;
        }

        .booking-details-card {
            background: #d9d9d9;
            border-radius: 12px;
            padding: 1.1rem 1.15rem;
            margin-bottom: 1rem;
        }

        .booking-details-card > h6:not(.booking-panel-title) {
            font-size: 0.9rem;
            font-weight: 700;
            margin: 0 0 0.85rem;
            color: #222;
        }

        .booking-party-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .booking-party {
            display: flex;
            gap: 0.75rem;
            align-items: center;
            min-width: 0;
        }

        .booking-party-avatar {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #c4c4c4;
            color: #333;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .booking-party-photo {
            width: 64px;
            height: 48px;
            border-radius: 8px;
            border: 1.5px solid #555;
            overflow: hidden;
            background: #ececec;
            flex-shrink: 0;
        }

        .booking-party-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .booking-party-label {
            display: block;
            font-size: 0.68rem;
            color: #666;
            font-weight: 500;
        }

        .booking-party-value {
            display: block;
            font-size: 0.86rem;
            font-weight: 700;
            color: #222;
        }

        .booking-party-sub {
            display: block;
            font-size: 0.72rem;
            color: #555;
            font-weight: 600;
        }

        .booking-meta-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.85rem 1.5rem;
        }

        .booking-meta-field label {
            display: block;
            font-size: 0.68rem;
            color: #666;
            margin-bottom: 0.2rem;
        }

        .booking-meta-field span {
            display: block;
            font-size: 0.82rem;
            font-weight: 700;
            color: #222;
            word-break: break-word;
        }

        .booking-notes-box {
            background: #fff;
            border-radius: 10px;
            padding: 0.75rem 0.9rem;
            font-size: 0.8rem;
            color: #333;
            line-height: 1.5;
            min-height: 3rem;
        }

        .booking-doc-preview {
            width: 100%;
            max-width: 280px;
            aspect-ratio: 4 / 3;
            border: 1.5px solid #666;
            border-radius: 8px;
            overflow: hidden;
            background: #ececec;
        }

        .booking-doc-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .booking-doc-placeholder {
            width: 100%;
            height: 100%;
            background:
                linear-gradient(to top right, transparent calc(50% - 0.6px), #777 calc(50% - 0.6px), #777 calc(50% + 0.6px), transparent calc(50% + 0.6px)),
                linear-gradient(to top left, transparent calc(50% - 0.6px), #777 calc(50% - 0.6px), #777 calc(50% + 0.6px), transparent calc(50% + 0.6px)),
                #ececec;
        }

        .booking-panel-title {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            font-size: 0.92rem;
            font-weight: 700;
            color: #2b2b2b;
            margin: 0 0 0.95rem;
        }

        .booking-panel-title i {
            font-size: 1rem;
            color: #3a3a3a;
        }

        .booking-finance-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 1rem;
            font-size: 0.84rem;
            padding: 0.28rem 0;
            color: #333;
        }

        .booking-finance-row strong {
            font-weight: 700;
            white-space: nowrap;
        }

        .booking-finance-total {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 0.55rem;
            padding-top: 0.7rem;
            border-top: 1px solid #b5b5b5;
            font-size: 0.88rem;
            font-weight: 700;
            color: #2b2b2b;
        }

        .booking-finance-total strong {
            font-size: 1.45rem;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .booking-payment-method-card {
            background: #c8c8c8;
            border-radius: 12px;
            padding: 0.9rem 1rem;
            margin-top: 1rem;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
        }

        .booking-payment-method-label {
            display: block;
            font-size: 0.72rem;
            color: #555;
            font-weight: 500;
            margin-bottom: 0.35rem;
        }

        .booking-payment-method-head {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.85rem;
            font-weight: 700;
            font-size: 0.9rem;
            color: #222;
        }

        .booking-payment-method-logo {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: #007dff;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.85rem;
            flex-shrink: 0;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
        }

        .booking-payment-method-logo.is-bdo {
            background: #003d79;
            font-size: 0.5rem;
            letter-spacing: 0.02em;
        }

        .booking-payment-method-logo.is-walkin {
            background: #555;
            font-size: 0.85rem;
        }

        .booking-payment-field {
            margin-bottom: 0.7rem;
        }

        .booking-payment-field:last-child {
            margin-bottom: 0;
        }

        .booking-payment-field label {
            display: block;
            font-size: 0.72rem;
            color: #555;
            font-weight: 500;
            margin-bottom: 0.15rem;
        }

        .booking-payment-field span {
            display: block;
            font-size: 0.88rem;
            font-weight: 700;
            color: #222;
            word-break: break-word;
        }

        .booking-receipt-frame {
            width: 100%;
            aspect-ratio: 5 / 4;
            border: 2px dashed #2b2b2b;
            border-radius: 10px;
            overflow: hidden;
            background: #cfcfcf;
            margin-bottom: 0.85rem;
        }

        .booking-receipt-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .booking-receipt-placeholder {
            width: 100%;
            height: 100%;
            min-height: 180px;
            background:
                linear-gradient(to top right, transparent calc(50% - 1px), #5a5a5a calc(50% - 1px), #5a5a5a calc(50% + 1px), transparent calc(50% + 1px)),
                linear-gradient(to top left, transparent calc(50% - 1px), #5a5a5a calc(50% - 1px), #5a5a5a calc(50% + 1px), transparent calc(50% + 1px)),
                #cfcfcf;
        }

        .booking-receipt-note {
            display: flex;
            gap: 0.55rem;
            align-items: flex-start;
            background: #bdbdbd;
            border: 1.5px solid #2b2b2b;
            border-radius: 10px;
            padding: 0.65rem 0.75rem;
            font-size: 0.72rem;
            color: #333;
            line-height: 1.4;
        }

        .booking-receipt-note i {
            font-size: 1rem;
            color: #2b2b2b;
            flex-shrink: 0;
            margin-top: 0.05rem;
        }

        .booking-audit-entry {
            margin-bottom: 0.85rem;
        }

        .booking-audit-entry:last-child {
            margin-bottom: 0;
        }

        .booking-audit-entry strong {
            display: block;
            font-size: 0.88rem;
            font-weight: 700;
            color: #2b2b2b;
            margin-bottom: 0.15rem;
        }

        .booking-audit-entry span {
            display: block;
            font-size: 0.78rem;
            color: #777;
            font-weight: 500;
        }

        .booking-details-actions {
            display: flex;
            gap: 0.65rem;
            flex-wrap: wrap;
            margin-top: 0.35rem;
        }

        @@media (max-width: 991.98px) {
            .booking-party-row,
            .booking-meta-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="container-fluid px-4 py-3">
    @if (TempData["BookingSuccess"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-3" role="alert">
            @TempData["BookingSuccess"]
        </div>
    }

    <div class="booking-details-id-bar">
        <p class="booking-details-id">Booking ID: <span>@FormatBookingId(Model.ReservationID)</span></p>
        <div class="booking-details-id-actions">
            @{
                var statusClass = Model.Status switch
                {
                    ReservationStatus.Confirmed or ReservationStatus.InProgress => "is-approved",
                    ReservationStatus.Rejected or ReservationStatus.Cancelled => "is-rejected",
                    _ => ""
                };
            }
            <span class="booking-status-pill @statusClass">
                <i class="bi bi-clock"></i> @statusText
            </span>
            <a asp-action="Index" class="btn btn-page-back">Back</a>
            <a asp-action="Edit" asp-route-id="@Model.ReservationID" asp-route-returnUrl="@detailsReturnUrl" class="btn btn-page-primary">Edit Reservation</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <section class="booking-details-card">
                <div class="booking-party-row">
                    <div class="booking-party">
                        <div class="booking-party-avatar">@Initials(Model.CustomerName)</div>
                        <div>
                            <span class="booking-party-label">Customer</span>
                            <span class="booking-party-value">@Model.CustomerName</span>
                            <span class="booking-party-sub">@Model.ContactInfo</span>
                        </div>
                    </div>
                    <div class="booking-party">
                        <div class="booking-party-photo">
                            @if (!string.IsNullOrEmpty(vehicle?.ImagePath))
                            {
                                <img src="~/images/@vehicle.ImagePath" alt="@vehicle.Brand @vehicle.Model" />
                            }
                            else
                            {
                                <div class="booking-doc-placeholder"></div>
                            }
                        </div>
                        <div>
                            <span class="booking-party-label">Selected Vehicle</span>
                            <span class="booking-party-value">@(vehicle != null ? $"{vehicle.Brand} {vehicle.Model}" : "—")</span>
                            <span class="booking-party-sub">@typeLabel</span>
                        </div>
                    </div>
                </div>

                <div class="booking-meta-grid">
                    <div class="booking-meta-field">
                        <label>Pick-up Date</label>
                        <span>@FormatDateTime(Model.PickupDate, Model.PickupTime)</span>
                    </div>
                    <div class="booking-meta-field">
                        <label>Return Date</label>
                        <span>@FormatDateTime(Model.ReturnDate, Model.ReturnTime)</span>
                    </div>
                    <div class="booking-meta-field">
                        <label>Total Duration</label>
                        <span>@(pricing?.DurationLabel ?? "—")</span>
                    </div>
                    <div class="booking-meta-field">
                        <label>Passengers</label>
                        <span>@Model.PassengerCount Person@(Model.PassengerCount == 1 ? "" : "s")</span>
                    </div>
                    <div class="booking-meta-field">
                        <label>Pick-up Location</label>
                        <span>@Model.PickupLoc</span>
                    </div>
                    <div class="booking-meta-field">
                        <label>Drop-off Location</label>
                        <span>@Model.DropoffLoc</span>
                    </div>
                </div>
            </section>

            <section class="booking-details-card">
                <h6>Additional Reservation Information</h6>
                <div class="booking-meta-grid mb-3">
                    <div class="booking-meta-field">
                        <label>Designated Driver</label>
                        <span><i class="bi bi-info-circle me-1"></i> Not Assigned Yet</span>
                    </div>
                    <div class="booking-meta-field">
                        <label>Discount Applied</label>
                        <span>@discountLabel</span>
                    </div>
                </div>
                <label class="booking-meta-field mb-1" style="font-size:0.68rem;color:#666;">Special Requests / Notes</label>
                <div class="booking-notes-box">
                    @(string.IsNullOrWhiteSpace(Model.SpNotes) ? "None" : Model.SpNotes)
                </div>
            </section>

            <section class="booking-details-card">
                <h6 class="booking-panel-title"><i class="bi bi-person-vcard"></i> Verification Documents</h6>
                @if (Model.Discount == 1)
                {
                    <label class="booking-meta-field mb-2" style="font-size:0.72rem;color:#555;">Customer Valid ID (Senior Proof)</label>
                    <div class="booking-doc-preview">
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <img src="~/images/@Model.ImagePath" alt="@DisplayFileName(Model.ImagePath)" />
                        }
                        else
                        {
                            <div class="booking-doc-placeholder"></div>
                        }
                    </div>
                }
                else
                {
                    <span class="booking-party-value">None</span>
                }
            </section>

            @if (isPending)
            {
                <div class="booking-details-actions">
                    <form asp-action="Approve" asp-route-id="@Model.ReservationID" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-page-primary">Approve Booking</button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@Model.ReservationID" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-page-primary">Reject Booking</button>
                    </form>
                </div>
            }
        </div>

        <div class="col-lg-5">
            <section class="booking-details-card">
                <h6 class="booking-panel-title"><i class="bi bi-receipt"></i> Financial Review</h6>
                @if (pricing != null)
                {
                    <div class="booking-finance-row">
                        <span>Base Rental Rate</span>
                        <strong>₱@pricing.BaseFee.ToString("N2")</strong>
                    </div>
                    @if (pricing.SucceedingHours > 0)
                    {
                        <div class="booking-finance-row">
                            <span>Extra Hours (@pricing.SucceedingHours hrs)</span>
                            <strong>₱@pricing.SucceedingFee.ToString("N2")</strong>
                        </div>
                    }
                    @if (pricing.HasDiscount)
                    {
                        <div class="booking-finance-row">
                            <span>Senior Discount (10%)</span>
                            <strong>-₱@pricing.DiscountAmount.ToString("N2")</strong>
                        </div>
                    }
                    <div class="booking-finance-total">
                        <span>Total to Verify</span>
                        <strong>₱@pricing.Total.ToString("N2")</strong>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">Vehicle pricing unavailable.</p>
                }

                @if (Model.PaymentChannel != null)
                {
                    <div class="booking-payment-method-card">
                        <span class="booking-payment-method-label">Payment Method</span>
                        <div class="booking-payment-method-head">
                            @if (Model.PaymentChannel == PaymentChannel.GCash)
                            {
                                <span class="booking-payment-method-logo">G</span>
                            }
                            else if (Model.PaymentChannel == PaymentChannel.BDO)
                            {
                                <span class="booking-payment-method-logo is-bdo">BDO</span>
                            }
                            else
                            {
                                <span class="booking-payment-method-logo is-walkin"><i class="bi bi-shop"></i></span>
                            }
                            <span>@PaymentLabel()</span>
                        </div>
                        @if (Model.PaymentChannel != PaymentChannel.WalkIn)
                        {
                            <div class="booking-payment-field">
                                <label>Account Name</label>
                                <span>@(Model.PayerAccountName ?? "—")</span>
                            </div>
                            <div class="booking-payment-field">
                                <label>Reference Number</label>
                                <span>@(Model.PaymentReference ?? "—")</span>
                            </div>
                        }
                        <div class="booking-payment-field">
                            <label>Timestamp</label>
                            <span>@FormatStamp(Model.PaymentDateTime ?? Model.CreatedAtUtc)</span>
                        </div>
                    </div>
                }
            </section>

            @if (Model.PaymentChannel != PaymentChannel.WalkIn)
            {
                <section class="booking-details-card">
                    <h6 class="booking-panel-title"><i class="bi bi-file-earmark-image"></i> Receipt Verification</h6>
                    <div class="booking-receipt-frame">
                        @if (!string.IsNullOrEmpty(Model.PaymentProofPath))
                        {
                            <img src="~/images/@Model.PaymentProofPath" alt="Payment receipt" />
                        }
                        else
                        {
                            <div class="booking-receipt-placeholder"></div>
                        }
                    </div>
                    <div class="booking-receipt-note">
                        <i class="bi bi-question-circle"></i>
                        <span>Verify that the Reference Number matches the screenshot and the amount sent is exactly</span>
                    </div>
                </section>
            }

            <section class="booking-details-card">
                <h6 class="booking-panel-title">Internal Audit Log</h6>
                <div class="booking-audit-entry">
                    <strong>Booking Created</strong>
                    <span>@FormatStamp(Model.CreatedAtUtc)</span>
                </div>
                <div class="booking-audit-entry">
                    <strong>Payment Submitted</strong>
                    <span>@FormatStamp(Model.PaymentDateTime)</span>
                </div>
            </section>
        </div>
    </div>
</div>
