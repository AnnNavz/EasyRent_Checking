@model IEnumerable<EasyRent_Checking.Models.Reservation>
@using EasyRent_Checking.Models
@using System.ComponentModel.DataAnnotations
@using System.Reflection

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Booking Management";
    ViewData["ActivePage"] = "Bookings";

    string currentSortName = ViewData["CurrentSort"]?.ToString() switch
    {
        "Customer" => "Customer",
        "Dates" => "Dates",
        "Status" => "Status",
        "Vehicle" => "Vehicle",
        _ => "Sorting by"
    };

    string currentFilterName = ViewData["CurrentFilter"]?.ToString() switch
    {
        "Pending" => "Pending",
        "Confirmed" => "Approved",
        "InProgress" => "Active Trips",
        "Completed" => "Completed",
        "Cancelled" => "Cancelled",
        "Rejected" => "Rejected",
        _ => "Filters"
    };

    string FormatBookingId(int id) => $"BK-{id:D4}";

    string indexReturnUrl = Context.Request.Path + Context.Request.QueryString;

    string FormatDateRange(DateOnly pickup, DateOnly ret)
    {
        if (pickup.Year == ret.Year && pickup.Month == ret.Month)
        {
            return $"{pickup:MMM}. {pickup.Day} - {ret.Day} {ret.Year}";
        }

        if (pickup.Year == ret.Year)
        {
            return $"{pickup:MMM}. {pickup.Day} - {ret:MMM}. {ret.Day} {ret.Year}";
        }

        return $"{pickup:MMM}. {pickup.Day} {pickup.Year} - {ret:MMM}. {ret.Day} {ret.Year}";
    }

    string StatusLabel(ReservationStatus status) => status switch
    {
        ReservationStatus.Confirmed => "Approved",
        ReservationStatus.InProgress => "Active",
        ReservationStatus.Pending => "Pending",
        _ => typeof(ReservationStatus).GetMember(status.ToString()).FirstOrDefault()
                ?.GetCustomAttribute<DisplayAttribute>()?.Name
            ?? status.ToString()
    };

    string Initials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
    }
}

@if (TempData["BookingSuccess"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-4" role="alert">
        @TempData["BookingSuccess"]
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="metric-card p-4 d-flex justify-content-between align-items-center">
            <div>
                <span class="metric-label">Total Bookings</span>
                <div class="metric-value">@(ViewData["TotalBookingsCount"] ?? "0")</div>
            </div>
            <div class="metric-icon-box" aria-hidden="true"></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card p-4 d-flex justify-content-between align-items-center">
            <div>
                <span class="metric-label">Pending Approvals</span>
                <div class="metric-value">@(ViewData["PendingApprovalsCount"] ?? "0")</div>
            </div>
            <div class="metric-icon-box" aria-hidden="true"></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card p-4 d-flex justify-content-between align-items-center">
            <div>
                <span class="metric-label">Active Trips</span>
                <div class="metric-value">@(ViewData["ActiveTripsCount"] ?? "0")</div>
            </div>
            <div class="metric-icon-box" aria-hidden="true"></div>
        </div>
    </div>
</div>

<form asp-action="Index" method="get" class="w-100">
    <input type="hidden" name="sortBy" value="@ViewData["CurrentSort"]" />
    <input type="hidden" name="currentFilter" value="@ViewData["CurrentFilter"]" />

    <div class="card index-toolbar-card mb-4">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle border px-3 fw-semibold text-secondary btn-filter text-capitalize" type="button" data-bs-toggle="dropdown">
                        @currentSortName
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="?sortBy=Customer&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Customer</a></li>
                        <li><a class="dropdown-item" href="?sortBy=Vehicle&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Vehicle</a></li>
                        <li><a class="dropdown-item" href="?sortBy=Dates&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Dates</a></li>
                        <li><a class="dropdown-item" href="?sortBy=Status&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Status</a></li>
                        <li><hr class="dropdown-menu-divider"></li>
                        <li><a class="dropdown-item text-muted small" href="?sortBy=&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Clear Sorting</a></li>
                    </ul>
                </div>
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle border px-3 fw-semibold text-secondary btn-filter text-capitalize" type="button" data-bs-toggle="dropdown">
                        @currentFilterName
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="?currentFilter=Pending&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Pending</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=Confirmed&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Approved</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=InProgress&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Active Trips</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=Completed&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Completed</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=Cancelled&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Cancelled</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=Rejected&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Rejected</a></li>
                        <li><hr class="dropdown-menu-divider"></li>
                        <li><a class="dropdown-item text-muted small" href="?currentFilter=&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Clear Filters</a></li>
                    </ul>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 flex-grow-1 flex-sm-grow-0">
                <div class="position-relative flex-grow-1">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control ps-5 pe-4 rounded-3 border bg-light text-secondary search-bar-input" placeholder="Search bookings..." />
                    @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()))
                    {
                        <a href="?searchString=&sortBy=@ViewData["CurrentSort"]&currentFilter=@ViewData["CurrentFilter"]" class="position-absolute top-50 end-0 translate-middle-y me-3 text-secondary text-decoration-none small">✕</a>
                    }
                </div>

                <a asp-action="Create" class="btn btn-dark d-flex align-items-center gap-2 px-3 py-2 fw-bold text-nowrap rounded-3 shadow-sm btn-add-driver">
                    <i class="bi bi-plus-lg"></i> Add Reservation
                </a>
            </div>
        </div>
    </div>
</form>

<div class="index-table-panel mb-4">
    <div class="table-responsive">
        <table class="table admin-table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Dates</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th class="text-center" style="width: 60px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var vehicle = item.Vehicle;
                        var amount = vehicle != null
                            ? ReservationPricingCalculator.Calculate(vehicle, item).Total
                            : 0m;
                        var statusText = StatusLabel(item.Status);
                        var vehicleLabel = vehicle != null
                            ? $"{vehicle.Brand} {vehicle.Model} {vehicle.Type}"
                            : "—";

                        <tr>
                            <td class="fw-bold text-dark">@FormatBookingId(item.ReservationID)</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="booking-customer-avatar">@Initials(item.CustomerName)</div>
                                    <div>
                                        <div class="fw-semibold text-dark">@item.CustomerName</div>
                                        <div class="text-secondary small">@item.ContactInfo</div>
                                    </div>
                                </div>
                            </td>
                            <td>@vehicleLabel</td>
                            <td>@FormatDateRange(item.PickupDate, item.ReturnDate)</td>
                            <td class="fw-bold text-dark">₱@amount.ToString("N2")</td>
                            <td>
                                @if (item.Status == ReservationStatus.Confirmed || item.Status == ReservationStatus.InProgress)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-2 px-2.5 py-1.5 fw-bold">@statusText</span>
                                }
                                else if (item.Status == ReservationStatus.Pending)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-2 px-2.5 py-1.5 fw-bold">@statusText</span>
                                }
                                else if (item.Status == ReservationStatus.Cancelled || item.Status == ReservationStatus.Rejected)
                                {
                                    <span class="badge bg-dark bg-opacity-10 text-dark rounded-2 px-2.5 py-1.5 fw-bold">@statusText</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-2 px-2.5 py-1.5 fw-bold">@statusText</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="dropdown">
                                    <button class="btn btn-link text-dark p-0 border-0 line-height-1" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed","placement":"bottom-end"}' data-bs-boundary="viewport">
                                        <i class="bi bi-three-dots fs-5"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.ReservationID" asp-route-returnUrl="@indexReturnUrl"><i class="bi bi-pencil me-2"></i> Edit</a></li>
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.ReservationID"><i class="bi bi-info-circle me-2"></i> Details</a></li>
                                        <li><hr class="dropdown-menu-divider"></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" onclick="openDeletePopup('@item.ReservationID', '@FormatBookingId(item.ReservationID)')">
                                                <i class="bi bi-trash me-2"></i> Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted fw-medium">
                            <i class="bi bi-calendar2-check fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            No matching bookings found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_AdminPagination" />
</div>

@{
    ViewData["DeleteModalId"] = "bookingDeletePopup";
    ViewData["DeleteHiddenInputId"] = "popupBookingId";
    ViewData["DeleteMessageId"] = "deletePopupMessage";
    ViewData["DeleteEntityLabel"] = "booking";
}
<partial name="_DeleteConfirmModal" />
