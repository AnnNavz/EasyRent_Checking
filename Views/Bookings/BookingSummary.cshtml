@model EasyRent_Checking.Models.ReservationPaymentDetailsViewModel
@using EasyRent_Checking.Models

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["ActivePage"] = "Bookings";
    ViewData["Title"] = "Make a Reservation";
    ViewData["ReservationStep"] = 4;

    var reservation = Model.Reservation;
    var vehicle = Model.Vehicle;
    var pricing = Model.Pricing;

    string FormatDateTime(DateOnly date, TimeOnly time)
    {
        var dt = date.ToDateTime(time);
        return dt.ToString("MMM. d, yyyy") + " • " + dt.ToString("h:mmtt").ToUpperInvariant();
    }

    string FormatCreatedAt(DateTime utc)
    {
        var local = utc.Kind == DateTimeKind.Utc ? utc.ToLocalTime() : utc;
        return local.ToString("MMM. d, yyyy") + " • " + local.ToString("h:mmtt").ToUpperInvariant();
    }

    string PaymentLabel() => reservation.PaymentChannel switch
    {
        PaymentChannel.GCash => "GCash",
        PaymentChannel.BDO => "BDO Bank Transfer / QR",
        PaymentChannel.WalkIn => "Walk-in (Pay at Office)",
        _ => "—"
    };

    string DisplayFileName(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return string.Empty;
        }

        var name = System.IO.Path.GetFileName(path);
        var underscore = name.IndexOf('_');
        if (underscore > 0 && underscore < name.Length - 1 && name.Length > 20)
        {
            return name[(underscore + 1)..];
        }

        return name;
    }

    string DiscountLabel = reservation.Discount == 1 ? "Senior Citizen (10% off)" : "None";
    string typeLabel = vehicle.Type == VehicleType.Van ? "Van" : vehicle.Type.ToString();
    bool isWalkIn = reservation.PaymentChannel == PaymentChannel.WalkIn;
}

@section Styles {
    <partial name="_AdminBookingWizardStyles" />
}

<div class="admin-booking-create client-page client-reservation-page client-payment-page px-1">
    <partial name="_ReservationStepper" />

    <div class="admin-booking-summary">
        <header class="admin-booking-summary-header">
            <h2>Booking Summary</h2>
            <p>Review reservation, payment, and submission details before confirming this booking.</p>
        </header>

        @* ---------- Reservation Details ---------- *@
        <section class="admin-summary-card">
            <div class="admin-summary-card-head">
                <div class="admin-summary-card-title">
                    <i class="bi bi-clipboard2-check"></i>
                    <h3>Reservation Details</h3>
                </div>
                <a asp-action="Create" asp-route-vehicleId="@vehicle.VehicleId" class="admin-summary-edit">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            </div>

            <div class="admin-summary-columns">
                <div class="admin-summary-col">
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Reservation Status</span>
                        <span class="admin-summary-badge is-pending"><i class="bi bi-clock"></i> Pending</span>
                    </div>
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Booking Date &amp; Time</span>
                        <span class="admin-summary-value">@FormatCreatedAt(reservation.CreatedAtUtc)</span>
                    </div>
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Customer Name</span>
                        <span class="admin-summary-value">@reservation.CustomerName</span>
                    </div>
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Contact Information</span>
                        <span class="admin-summary-value">@reservation.ContactInfo</span>
                    </div>
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Pick-up Location</span>
                        <span class="admin-summary-value">@reservation.PickupLoc</span>
                    </div>
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Drop-off Location</span>
                        <span class="admin-summary-value">@reservation.DropoffLoc</span>
                    </div>
                </div>

                <div class="admin-summary-col">
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Designated Driver</span>
                        <span class="admin-summary-badge is-pending"><i class="bi bi-clock"></i> Pending</span>
                    </div>
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Vehicle Brand &amp; Model</span>
                        <span class="admin-summary-value">@vehicle.Brand @vehicle.Model</span>
                    </div>
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Vehicle Type</span>
                        <span class="admin-summary-value">@typeLabel</span>
                    </div>
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Pick-up Date &amp; Time</span>
                        <span class="admin-summary-value">@FormatDateTime(reservation.PickupDate, reservation.PickupTime)</span>
                    </div>
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Return Date &amp; Time</span>
                        <span class="admin-summary-value">@FormatDateTime(reservation.ReturnDate, reservation.ReturnTime)</span>
                    </div>
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Total Duration</span>
                        <span class="admin-summary-value">@pricing.DurationLabel</span>
                    </div>
                </div>
            </div>

            <div class="admin-summary-divider"></div>

            <div class="admin-summary-columns admin-summary-columns--secondary">
                <div class="admin-summary-col">
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Passenger Count</span>
                        <span class="admin-summary-value">@reservation.PassengerCount Passenger@(reservation.PassengerCount == 1 ? "" : "s")</span>
                    </div>
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Senior/PWD Discount</span>
                        <span class="admin-summary-value">@DiscountLabel</span>
                    </div>
                </div>
                <div class="admin-summary-col">
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Valid ID Uploaded</span>
                        @if (!string.IsNullOrEmpty(reservation.ImagePath))
                        {
                            <div class="admin-summary-file">
                                <div class="admin-summary-file-preview">
                                    <img src="/images/@reservation.ImagePath" alt="Valid ID" />
                                </div>
                                <span class="admin-summary-file-name">@DisplayFileName(reservation.ImagePath)</span>
                            </div>
                        }
                        else
                        {
                            <span class="admin-summary-value text-muted">No ID uploaded</span>
                        }
                    </div>
                </div>
            </div>

            <div class="admin-summary-divider"></div>

            <div class="admin-summary-notes">
                <span class="admin-summary-label">Special Requests / Notes</span>
                <div class="admin-summary-notes-box">
                    @(string.IsNullOrWhiteSpace(reservation.SpNotes) ? "None" : reservation.SpNotes)
                </div>
            </div>
        </section>

        @* ---------- Payment Details ---------- *@
        <section class="admin-summary-card">
            <div class="admin-summary-card-head">
                <div class="admin-summary-card-title">
                    <i class="bi bi-credit-card"></i>
                    <h3>Payment Details</h3>
                </div>
                <a asp-action="PaymentDetails" class="admin-summary-edit">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            </div>

            <div class="admin-summary-columns">
                <div class="admin-summary-col">
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Base Rental Fee</span>
                        <span class="admin-summary-value">₱@pricing.BaseFee.ToString("N2")</span>
                    </div>
                    @if (pricing.SucceedingHours > 0)
                    {
                        <div class="admin-summary-field">
                            <span class="admin-summary-label">Succeeding Hours (@pricing.SucceedingHours hour@(pricing.SucceedingHours == 1 ? "" : "s"))</span>
                            <span class="admin-summary-value">₱@pricing.SucceedingFee.ToString("N2")</span>
                        </div>
                    }
                    @if (pricing.HasDiscount)
                    {
                        <div class="admin-summary-field">
                            <span class="admin-summary-label">Senior Discount (10%)</span>
                            <span class="admin-summary-value">-₱@pricing.DiscountAmount.ToString("N2")</span>
                        </div>
                    }
                </div>
                <div class="admin-summary-col">
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Payment Status</span>
                        <span class="admin-summary-badge is-pending"><i class="bi bi-clock"></i> Pending</span>
                    </div>
                    <div class="admin-summary-field">
                        <span class="admin-summary-label">Payment Method</span>
                        <span class="admin-summary-value">@PaymentLabel()</span>
                    </div>
                </div>
            </div>

            <div class="admin-summary-divider"></div>

            <div class="admin-summary-total">
                <span>Total Reservation Costs</span>
                <strong>₱@pricing.Total.ToString("N2")</strong>
            </div>
        </section>

        @* ---------- Payment Submission Details ---------- *@
        <section class="admin-summary-card">
            <div class="admin-summary-card-head">
                <div class="admin-summary-card-title">
                    <i class="bi bi-check2-square"></i>
                    <h3>Payment Submission Details</h3>
                </div>
                <a asp-action="PaymentConfirmation" class="admin-summary-edit">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            </div>

            @if (isWalkIn)
            {
                <div class="admin-summary-columns">
                    <div class="admin-summary-col">
                        <div class="admin-summary-field">
                            <span class="admin-summary-label">Payment Method</span>
                            <span class="admin-summary-value">Walk-in (Pay at Office)</span>
                        </div>
                    </div>
                    <div class="admin-summary-col">
                        @if (!string.IsNullOrWhiteSpace(reservation.PaymentNotes))
                        {
                            <div class="admin-summary-field">
                                <span class="admin-summary-label">Additional Notes</span>
                                <span class="admin-summary-value">@reservation.PaymentNotes</span>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="admin-summary-columns">
                    <div class="admin-summary-col">
                        <div class="admin-summary-field">
                            <span class="admin-summary-label">Account Name (Sender)</span>
                            <span class="admin-summary-value">@(reservation.PayerAccountName ?? "—")</span>
                        </div>
                        <div class="admin-summary-field">
                            <span class="admin-summary-label">Reference Number</span>
                            <span class="admin-summary-value">@(reservation.PaymentReference ?? "—")</span>
                        </div>
                    </div>
                    <div class="admin-summary-col">
                        <div class="admin-summary-field">
                            <span class="admin-summary-label">Amount Sent</span>
                            <span class="admin-summary-value">₱@((reservation.AmountSent ?? pricing.Total).ToString("N2"))</span>
                        </div>
                        <div class="admin-summary-field">
                            <span class="admin-summary-label">Receipt Screenshot</span>
                            @if (!string.IsNullOrEmpty(reservation.PaymentProofPath))
                            {
                                <div class="admin-summary-file">
                                    <div class="admin-summary-file-preview">
                                        <img src="/images/@reservation.PaymentProofPath" alt="Payment receipt" />
                                    </div>
                                    <span class="admin-summary-file-name">@DisplayFileName(reservation.PaymentProofPath)</span>
                                </div>
                            }
                            else
                            {
                                <span class="admin-summary-value text-muted">No receipt uploaded</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </section>

        <div class="client-reservation-actions client-payment-actions">
            <a asp-action="PaymentConfirmation" class="client-reservation-btn-back">Back</a>
            <form asp-action="ConfirmBooking" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="client-reservation-btn-continue">Confirm Booking and Submit</button>
            </form>
        </div>
    </div>
</div>
