@model IEnumerable<EasyRent_Checking.Models.Driver>

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Driver Management";
    ViewData["ActivePage"] = "Drivers";

    string currentSortName = ViewData["CurrentSort"]?.ToString() == "Name" ? "Name" :
                             ViewData["CurrentSort"]?.ToString() == "ExpiryDate" ? "Expiry Date" : "Sorting by";

    string currentFilterName = ViewData["CurrentFilter"]?.ToString() == "ActiveOnly" ? "Active Only" :
                               ViewData["CurrentFilter"]?.ToString() == "Expired" ? "Expired Licenses" : "Filters";

    string indexReturnUrl = Url.Action("Index", new
    {
        searchString = ViewData["CurrentSearch"],
        sortBy = ViewData["CurrentSort"],
        currentFilter = ViewData["CurrentFilter"],
        page = ViewData["PageIndex"]
    }) ?? "";
}

<div class="drivers-index-page">
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="driver-metric-card">
                <div class="driver-metric-icon" aria-hidden="true">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="driver-metric-body">
                    <span class="driver-metric-label">Total Drivers</span>
                    <div class="driver-metric-value">@(ViewData["TotalDriversCount"] ?? "0")</div>
                </div>
                <div class="driver-metric-trend">
                    <span class="driver-metric-badge"><i class="bi bi-arrow-up-short"></i> 12.4%</span>
                    <span class="driver-metric-compare">vs last month</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="driver-metric-card">
                <div class="driver-metric-icon" aria-hidden="true">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="driver-metric-body">
                    <span class="driver-metric-label">Active Drivers</span>
                    <div class="driver-metric-value">@(ViewData["ActiveDriversCount"] ?? "0")</div>
                </div>
                <div class="driver-metric-trend">
                    <span class="driver-metric-badge"><i class="bi bi-arrow-up-short"></i> 12.4%</span>
                    <span class="driver-metric-compare">vs last month</span>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Index" method="get" class="w-100">
        <input type="hidden" name="sortBy" value="@ViewData["CurrentSort"]" />
        <input type="hidden" name="currentFilter" value="@ViewData["CurrentFilter"]" />

        <div class="driver-index-toolbar mb-4">
            <div class="driver-index-toolbar-filters">
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle border px-3 fw-semibold text-secondary btn-filter text-capitalize" type="button" data-bs-toggle="dropdown">
                        @currentSortName
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="?sortBy=Name&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Name</a></li>
                        <li><a class="dropdown-item" href="?sortBy=ExpiryDate&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Expiry Date</a></li>
                        <li><hr class="dropdown-menu-divider"></li>
                        <li><a class="dropdown-item text-muted small" href="?sortBy=&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Clear Sorting</a></li>
                    </ul>
                </div>

                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle border px-3 fw-semibold text-secondary btn-filter text-capitalize" type="button" data-bs-toggle="dropdown">
                        @currentFilterName
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="?currentFilter=ActiveOnly&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Active Only</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=Expired&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Expired Licenses</a></li>
                        <li><hr class="dropdown-menu-divider"></li>
                        <li><a class="dropdown-item text-muted small" href="?currentFilter=&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Clear Filters</a></li>
                    </ul>
                </div>
            </div>

            <div class="driver-index-toolbar-search">
                <i class="bi bi-search driver-index-search-icon" aria-hidden="true"></i>
                <input type="text"
                       name="searchString"
                       value="@ViewData["CurrentSearch"]"
                       class="form-control driver-index-search-input"
                       placeholder="Search Driver" />
                <i class="bi bi-mic driver-index-mic-icon" aria-hidden="true"></i>
                @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()))
                {
                    <a href="?searchString=&sortBy=@ViewData["CurrentSort"]&currentFilter=@ViewData["CurrentFilter"]"
                       class="driver-index-search-clear"
                       aria-label="Clear search">&times;</a>
                }
            </div>

            <a asp-action="Create" class="btn driver-index-add-btn">
                <i class="bi bi-plus-lg"></i> Add Driver
            </a>
        </div>
    </form>

    <div class="index-table-panel mb-4">
        <div class="table-responsive">
            <table class="table admin-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Driver Picture</th>
                        <th>Full Name</th>
                        <th>Address</th>
                        <th>Contact Number</th>
                        <th>License Number</th>
                        <th>License Expiry</th>
                        <th class="text-end" style="width: 60px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="table-driver-avatar mx-auto">
                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            <img src="~/images/@item.ImagePath" alt="@item.Name" />
                                        }
                                        else
                                        {
                                            <span class="table-driver-initials">
                                                @(string.IsNullOrEmpty(item.Name) ? "DR" : string.Join("", item.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])))
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="fw-semibold text-dark">@Html.DisplayFor(modelItem => item.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.Address)</td>
                                <td>@Html.DisplayFor(modelItem => item.ContactNo)</td>
                                <td class="text-uppercase">@Html.DisplayFor(modelItem => item.LicenseNo)</td>
                                <td>@(item.ExpiryDate.ToString("MM-dd-yyyy"))</td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-link text-dark p-0 border-0 line-height-1" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed","placement":"bottom-end"}' data-bs-boundary="viewport" aria-label="Driver actions">
                                            <i class="bi bi-three-dots-vertical fs-5"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.DriverId" asp-route-returnUrl="@indexReturnUrl"><i class="bi bi-pencil me-2"></i> Edit</a></li>
                                            <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.DriverId"><i class="bi bi-info-circle me-2"></i> Details</a></li>
                                            <li><hr class="dropdown-menu-divider"></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger" onclick="openDeletePopup('@item.DriverId', '@item.Name')">
                                                    <i class="bi bi-trash me-2"></i> Delete
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted fw-medium">
                                <i class="bi bi-person-badge fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                No matching drivers located in directory indexes.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AdminPagination" />
    </div>
</div>

@{
    ViewData["DeleteModalId"] = "driverDeletePopup";
    ViewData["DeleteHiddenInputId"] = "popupDriverId";
    ViewData["DeleteMessageId"] = "deletePopupMessage";
    ViewData["DeleteEntityLabel"] = "driver";
}
<partial name="_DeleteConfirmModal" />
