@model EasyRent_Checking.ViewModels.DriverDetailsViewModel
@using System.Globalization
@using EasyRent_Checking.Services

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "View Details";
    ViewData["ActivePage"] = "Drivers";

    var driver = Model.Driver;
    string address = driver?.Address ?? "—";
    string licenseNo = driver?.LicenseNo ?? "—";
    string expiryText = driver != null ? driver.ExpiryDate.ToString("MMMM dd, yyyy") : "—";

    int daysLeft = 0;
    bool hasValidLicense = false;
    if (driver != null)
    {
        DateOnly today = DateOnly.FromDateTime(DateTime.Today);
        daysLeft = driver.ExpiryDate.DayNumber - today.DayNumber;
        hasValidLicense = daysLeft > 0;
    }

    bool isEmployed = driver?.IsActive ?? false;
    string statusText = daysLeft > 0 ? $"valid for {daysLeft} days" : "Expired";
    string driverStatusLabel = !isEmployed
        ? "Deactivated"
        : hasValidLicense
            ? "Active Driver"
            : "License Expired";
    bool showInactiveBadge = !isEmployed || !hasValidLicense;

    string detailsReturnUrl = Url.Action("Details", new { id = driver?.DriverId }) ?? "";

    string FormatPhoneDisplay(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
        {
            return "—";
        }

        var digits = new string(phone.Where(char.IsDigit).ToArray());
        if (digits.Length == 11 && digits.StartsWith("09"))
        {
            return $"{digits[..2]} {digits[2..5]} {digits[5..9]} {digits[9..]}";
        }

        return phone;
    }

    string profileSubtitle = driver != null
        ? $"Added {driver.CreatedAt.ToLocalTime():MMMM yyyy}"
        : "Driver Profile";
    string displayPhone = FormatPhoneDisplay(driver?.ContactNo);

    string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
        {
            return "?";
        }

        if (parts.Length == 1)
        {
            return parts[0][..1].ToUpperInvariant();
        }

        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }

    var reviewCount = Model.ReviewCount;
    var averageRating = reviewCount > 0 ? Model.OverallTen / 2.0 : 0d;
    var filledStars = reviewCount == 0 ? 0 : (int)Math.Round(averageRating, MidpointRounding.AwayFromZero);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/driver-details.css" asp-append-version="true" />
}

<div class="driver-details-page">
    <div class="driver-details-header">
        <div class="driver-details-profile">
            <div class="driver-details-avatar">
                @if (driver != null && !string.IsNullOrEmpty(driver.ImagePath))
                {
                    <img src="~/images/@driver.ImagePath" alt="@driver.Name" />
                }
                else
                {
                    <i class="bi bi-person-fill"></i>
                }
            </div>
            <div>
                <h1 class="driver-details-name">@(driver?.Name ?? "Jane Doe")</h1>
                <span class="driver-details-subtitle">@profileSubtitle</span>
                <span class="driver-status-badge @(showInactiveBadge ? "is-inactive" : "")">
                    <span class="driver-status-dot"></span>
                    @driverStatusLabel
                </span>
            </div>
        </div>
        <div class="driver-details-actions">
            <a asp-action="Index" class="btn driver-details-btn-back">Back</a>
            <a asp-action="Edit" asp-route-id="@driver?.DriverId" asp-route-returnUrl="@detailsReturnUrl" class="btn driver-details-btn-edit">Edit Driver's Profile</a>
        </div>
    </div>

    <ul class="nav nav-tabs driver-details-tabs" id="driverDetailTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="information-tab" data-bs-toggle="tab" data-bs-target="#information-pane" type="button" role="tab" aria-selected="true">Information</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history-pane" type="button" role="tab" aria-selected="false">History</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews-pane" type="button" role="tab" aria-selected="false">Reviews</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="documents-tab" data-bs-toggle="tab" data-bs-target="#documents-pane" type="button" role="tab" aria-selected="false">Documents</button>
        </li>
    </ul>

    <div class="tab-content" id="driverDetailTabsContent">
        <div class="tab-pane fade show active" id="information-pane" role="tabpanel" aria-labelledby="information-tab">
            <div class="row g-4 driver-info-cards-row">
                <div class="col-lg-6">
                    <div class="driver-info-card">
                        <div class="driver-info-card-head">
                            <span class="driver-info-card-icon"><i class="bi bi-person-fill"></i></span>
                            <h6 class="driver-info-card-title">Personal Information</h6>
                        </div>
                        <div class="driver-info-stack">
                            <div class="driver-info-field">
                                <span class="driver-info-field-label">Phone Number</span>
                                <div class="driver-info-field-value">
                                    <span class="driver-info-value-icon"><i class="bi bi-telephone-fill"></i></span>
                                    <span>@displayPhone</span>
                                </div>
                            </div>
                            <div class="driver-info-field">
                                <span class="driver-info-field-label">Address</span>
                                <div class="driver-info-field-value">
                                    <span class="driver-info-value-icon"><i class="bi bi-geo-alt-fill"></i></span>
                                    <span>@address</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="driver-info-card">
                        <div class="driver-info-card-head">
                            <span class="driver-info-card-icon"><i class="bi bi-file-earmark-text-fill"></i></span>
                            <h6 class="driver-info-card-title">License</h6>
                        </div>
                        <div class="driver-info-stack">
                            <div class="driver-info-field">
                                <span class="driver-info-field-label">License Number</span>
                                <div class="driver-info-field-value">
                                    <span class="driver-info-value-icon"><i class="bi bi-123"></i></span>
                                    <span class="font-monospace">@licenseNo</span>
                                </div>
                            </div>
                            <div class="driver-info-field">
                                <span class="driver-info-field-label">License Expiry Date</span>
                                <div class="driver-info-field-value">
                                    <span class="driver-info-value-icon"><i class="bi bi-calendar3"></i></span>
                                    <span>@expiryText</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="driver-info-review-banner">
                <i class="bi bi-info-circle-fill"></i>
                <p>Review the driver information above. You can update their details by clicking <strong>Edit Driver's Profile</strong>.</p>
            </div>
        </div>

        <div class="tab-pane fade" id="history-pane" role="tabpanel" aria-labelledby="history-tab">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="driver-timeline-section-title">ACTIVITY TIMELINE</div>

                    @if (Model.ActivityHistory.Any())
                    {
                        <div class="driver-timeline">
                            @for (var i = 0; i < Model.ActivityHistory.Count; i++)
                            {
                                var item = Model.ActivityHistory[i];
                                var isPrimary = i == 0;
                                <div class="driver-timeline-item">
                                    <div class="driver-timeline-marker @(isPrimary ? "is-primary" : "")"><i class="bi bi-check-lg"></i></div>
                                    <div class="driver-timeline-card">
                                        <div class="driver-timeline-time">@item.OccurredAt.ToString("MMMM dd, yyyy | h:mm tt")</div>
                                        <div class="driver-timeline-title">@item.Title</div>
                                        <p class="driver-timeline-desc">@item.Description</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="driver-timeline-empty text-center py-4 text-muted">
                            <i class="bi bi-clock-history fs-3 d-block mb-2 opacity-50"></i>
                            No trip history recorded for this driver yet.
                        </div>
                    }

                    @if (Model.ActivityHistory.Any())
                    {
                        <button type="button" class="btn driver-load-older-btn">
                            <i class="bi bi-arrow-clockwise"></i> Load Older Logs
                        </button>
                    }
                </div>

                <div class="col-lg-4">
                    <div class="driver-license-expiry-card">
                        <div class="driver-license-expiry-head">
                            <i class="bi bi-calendar3"></i>
                            <span>License Expiry</span>
                        </div>
                        <div class="driver-license-expiry-date">@expiryText</div>
                        <span class="driver-license-expiry-badge @(hasValidLicense ? "is-valid" : "is-expired")">@statusText</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="reviews-pane" role="tabpanel" aria-labelledby="reviews-tab">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="driver-info-card driver-ratings-card">
                        <div class="driver-info-card-head">
                            <span class="driver-info-card-icon"><i class="bi bi-star-fill"></i></span>
                            <h6 class="driver-info-card-title">Performance Ratings</h6>
                        </div>

                        @if (reviewCount > 0)
                        {
                            <div class="driver-reviews-summary-score">
                                <span class="driver-reviews-avg">@averageRating.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                <div class="driver-reviews-summary-stars" aria-hidden="true">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= filledStars ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </div>
                                <span class="driver-reviews-summary-count">Based on @reviewCount verified @(reviewCount == 1 ? "review" : "reviews")</span>
                            </div>

                            <div class="driver-rating-bars">
                                <div class="driver-rating-row">
                                    <span>Professionalism</span>
                                    <div class="driver-rating-track">
                                        <div class="driver-rating-fill" style="width: @(RatingScale.FillPercentFromTen(Model.ProfessionalismTen).ToString(CultureInfo.InvariantCulture))%"></div>
                                    </div>
                                    <span class="driver-rating-score">@Model.ProfessionalismTen.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                </div>
                                <div class="driver-rating-row">
                                    <span>Driving</span>
                                    <div class="driver-rating-track">
                                        <div class="driver-rating-fill" style="width: @(RatingScale.FillPercentFromTen(Model.DrivingTen).ToString(CultureInfo.InvariantCulture))%"></div>
                                    </div>
                                    <span class="driver-rating-score">@Model.DrivingTen.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                </div>
                                <div class="driver-rating-row">
                                    <span>Courtesy</span>
                                    <div class="driver-rating-track">
                                        <div class="driver-rating-fill" style="width: @(RatingScale.FillPercentFromTen(Model.CourtesyTen).ToString(CultureInfo.InvariantCulture))%"></div>
                                    </div>
                                    <span class="driver-rating-score">@Model.CourtesyTen.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="driver-rating-empty">No customer reviews yet. Ratings appear here after completed trips are reviewed.</p>
                        }
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="driver-reviews-section-title">CUSTOMER REVIEWS</div>

                    @if (Model.Reviews.Any())
                    {
                        <div class="driver-reviews-list">
                            @foreach (var review in Model.Reviews)
                            {
                                <article class="driver-review-card">
                                    <div class="driver-review-head">
                                        <span class="driver-review-avatar" aria-hidden="true">@GetInitials(review.CustomerName)</span>
                                        <div class="driver-review-meta">
                                            <span class="driver-review-name">@review.CustomerName</span>
                                            <span class="driver-review-date">@review.CreatedAt.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</span>
                                        </div>
                                        <div class="driver-review-stars" aria-label="@review.OverallStars out of 5 stars">
                                            @for (var i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= review.OverallStars ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>
                                            }
                                        </div>
                                    </div>
                                    <div class="driver-review-categories">
                                        <span>Professionalism: @review.Professionalism/5</span>
                                        <span>Driving: @review.Driving/5</span>
                                        <span>Courtesy: @review.Courtesy/5</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                                    {
                                        <p class="driver-review-comment">@review.Comment</p>
                                    }
                                    else
                                    {
                                        <p class="driver-review-comment is-muted">No written comment.</p>
                                    }
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="driver-reviews-empty">
                            <i class="bi bi-chat-square-text"></i>
                            <p>No customer reviews for this driver yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="documents-pane" role="tabpanel" aria-labelledby="documents-tab">
            @{
                var documents = Model.Documents;
                var documentCount = documents.Count;
                var documentPageSize = 10;
                var documentTotalPages = documentCount == 0 ? 1 : (int)Math.Ceiling(documentCount / (double)documentPageSize);
                var documentStart = documentCount == 0 ? 0 : 1;
                var documentEnd = documentCount;
            }

            <div class="driver-documents-panel">
                <div class="driver-documents-panel-head">
                    <div class="driver-documents-panel-intro">
                        <span class="driver-documents-panel-icon"><i class="bi bi-file-earmark-text-fill"></i></span>
                        <div>
                            <h6 class="driver-documents-panel-title">Documents</h6>
                            <p class="driver-documents-panel-desc">View and manage driver's uploaded documents.</p>
                        </div>
                    </div>
                    <a asp-action="Edit" asp-route-id="@driver?.DriverId" asp-route-returnUrl="@detailsReturnUrl" class="btn driver-documents-upload-btn">
                        <i class="bi bi-upload"></i> Upload Document
                    </a>
                </div>

                @if (documents.Any())
                {
                    <div class="table-responsive driver-documents-table-wrap">
                        <table class="table driver-documents-table mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Document Name</th>
                                    <th>Type</th>
                                    <th>Upload Date</th>
                                    <th>Status</th>
                                    <th class="text-end" style="width: 60px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var document in documents)
                                {
                                    <tr>
                                        <td>
                                            <div class="driver-document-name-cell">
                                                <div class="driver-document-thumb">
                                                    @if (!string.IsNullOrEmpty(document.ImagePath))
                                                    {
                                                        <img src="~/images/@document.ImagePath" alt="@document.DisplayName" />
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-file-earmark-image"></i>
                                                    }
                                                </div>
                                                <div class="driver-document-name-meta">
                                                    <span class="driver-document-display-name">@document.DisplayName</span>
                                                    <span class="driver-document-file-name">@document.FileName</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="driver-document-type-badge">@document.TypeLabel</span>
                                        </td>
                                        <td>@document.UploadedAt.ToString("MMMM dd, yyyy h:mmtt", CultureInfo.InvariantCulture)</td>
                                        <td>
                                            @if (document.IsVerified)
                                            {
                                                <span class="driver-document-status-badge is-verified">
                                                    <span class="driver-document-status-dot"></span>
                                                    Verified
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="driver-document-status-badge is-pending">
                                                    <span class="driver-document-status-dot"></span>
                                                    Pending
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-link p-0 text-secondary" aria-label="@document.DisplayName options">
                                                <i class="bi bi-three-dots"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="driver-documents-pagination">
                        <div class="driver-documents-pagination-range">@documentStart-@documentEnd of @documentCount</div>
                        <div class="driver-documents-pagination-nav">
                            <button type="button" class="btn btn-link p-0 text-secondary disabled opacity-50" disabled aria-label="Previous page">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <span>1/@documentTotalPages</span>
                            <button type="button" class="btn btn-link p-0 text-secondary disabled opacity-50" disabled aria-label="Next page">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="driver-documents-empty">
                        <i class="bi bi-folder2-open"></i>
                        <p>No documents uploaded for this driver yet.</p>
                        <a asp-action="Edit" asp-route-id="@driver?.DriverId" asp-route-returnUrl="@detailsReturnUrl" class="btn driver-documents-upload-btn">
                            <i class="bi bi-upload"></i> Upload Document
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (driver != null)
    {
        <div class="driver-details-status-footer">
            <div class="driver-details-status-footer-text">
                <h6 class="driver-details-status-footer-title">Account Status</h6>
                <p class="mb-0">
                    @if (isEmployed)
                    {
                        @:Deactivating removes this driver from trip assignment. Their profile and history stay saved.
                    }
                    else
                    {
                        @:This driver is currently deactivated and cannot be assigned to new trips.
                    }
                </p>
            </div>
            <form asp-action="ToggleActive" asp-route-id="@driver.DriverId" method="post" class="driver-details-status-footer-action"
                  data-confirm="@(isEmployed ? "Deactivate this driver?" : "Reactivate this driver?")"
                  data-confirm-text="@(isEmployed ? "They will no longer appear in trip assignment. Their profile and history stay saved." : "They will be available for trip assignment again.")"
                  data-confirm-button="@(isEmployed ? "Deactivate Driver" : "Activate Driver")"
                  data-confirm-tone="@(isEmployed ? "danger" : "approve")"
                  data-confirm-icon="@(isEmployed ? "bi-slash-circle" : "bi-check-circle")"
                  data-confirm-submit-icon="@(isEmployed ? "bi-slash-circle" : "bi-check-lg")">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn @(isEmployed ? "driver-details-btn-deactivate" : "driver-details-btn-activate")">
                    @(isEmployed ? "Deactivate Driver" : "Activate Driver")
                </button>
            </form>
        </div>
    }
</div>
