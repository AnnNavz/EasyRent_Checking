@{
    var modalId = ViewData["DeleteModalId"]?.ToString() ?? "entityDeletePopup";
    var hiddenInputId = ViewData["DeleteHiddenInputId"]?.ToString() ?? "popupEntityId";
    var messageId = ViewData["DeleteMessageId"]?.ToString() ?? "deletePopupMessage";
    var entityLabel = ViewData["DeleteEntityLabel"]?.ToString() ?? "item";
    var entityTypeName = char.ToUpper(entityLabel[0]) + entityLabel[1..];
    var deleteButtonText = ViewData["DeleteConfirmButtonText"]?.ToString() ?? $"Yes, Delete {entityTypeName}";
    var hiddenInputName = ViewData["DeleteHiddenInputName"]?.ToString() ?? "id";
    var deleteAction = ViewData["DeleteAction"]?.ToString() ?? "Delete";
}

<div class="modal fade admin-delete-modal" id="@modalId" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered admin-delete-modal-dialog">
        <div class="modal-content admin-delete-modal-content text-center border-0 shadow-lg">
            <div class="admin-delete-icon-wrap" aria-hidden="true">
                <i class="bi bi-trash3"></i>
            </div>

            <h5 class="admin-delete-title" id="@messageId">
                Are you sure you want to delete <strong>this @entityLabel</strong>?
            </h5>
            <p class="admin-delete-subtext">
                This action cannot be undone. All related data will be permanently removed.
            </p>

            <form method="post" asp-action="@deleteAction" asp-controller="@ViewContext.RouteData.Values["controller"]">
                <input type="hidden" name="@hiddenInputName" id="@hiddenInputId" value="" />

                <div class="admin-delete-actions">
                    <button type="submit" class="btn admin-delete-btn-confirm w-100">
                        <i class="bi bi-trash3"></i>
                        <span>@deleteButtonText</span>
                    </button>
                    <button type="button" class="btn admin-delete-btn-cancel w-100" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        var modalEl = document.getElementById('@modalId');
        if (modalEl) {
            modalEl.addEventListener('show.bs.modal', function () {
                document.body.classList.add('admin-delete-modal-open');
            });
            modalEl.addEventListener('hidden.bs.modal', function () {
                document.body.classList.remove('admin-delete-modal-open');
            });
        }
    })();

    function openDeletePopup(entityId, entityName) {
        document.getElementById('@hiddenInputId').value = entityId;
        document.getElementById('@messageId').innerHTML =
            'Are you sure you want to delete <strong>' + entityName + '</strong>?';

        var deleteModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('@modalId'));
        deleteModal.show();
    }
</script>
