<div class="modal fade logout-confirm-modal" id="logoutConfirmModal" tabindex="-1" aria-labelledby="logoutConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered logout-confirm-dialog">
        <div class="modal-content logout-confirm-content text-center border-0 shadow-lg">
            <div class="logout-confirm-icon" aria-hidden="true">
                <i class="bi bi-box-arrow-right"></i>
            </div>
            <h5 class="logout-confirm-title" id="logoutConfirmTitle">Log out?</h5>
            <p class="logout-confirm-text">You will need to sign in again to access your account.</p>
            <div class="logout-confirm-actions">
                <button type="button" class="btn logout-confirm-submit w-100" id="logoutConfirmSubmit">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    Log Out
                </button>
                <button type="button" class="btn logout-confirm-cancel w-100" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var modalEl = document.getElementById('logoutConfirmModal');
        if (!modalEl) return;

        var pendingHref = null;
        var modal = null;

        function getModal() {
            if (!modal) modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            return modal;
        }

        document.addEventListener('click', function (event) {
            var link = event.target.closest('[data-logout-confirm]');
            if (!link) return;
            event.preventDefault();
            pendingHref = link.getAttribute('href');
            getModal().show();
        });

        document.getElementById('logoutConfirmSubmit').addEventListener('click', function () {
            if (!pendingHref) return;
            window.location.href = pendingHref;
        });

        modalEl.addEventListener('hidden.bs.modal', function () {
            pendingHref = null;
        });
    })();
</script>
