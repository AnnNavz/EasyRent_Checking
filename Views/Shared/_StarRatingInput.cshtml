@model EasyRent_Checking.ViewModels.StarRatingInputModel

<div class="rate-trip-category-row">
    <span class="rate-trip-category-label">@Model.Label</span>
    <div class="rate-trip-stars" role="radiogroup" aria-label="@Model.Label rating">
        @for (var star = 5; star >= 1; star--)
        {
            var isChecked = Model.Value == star;
            <input type="radio"
                   name="@Model.Name"
                   value="@star"
                   id="@Model.Name-@star"
                   class="rate-trip-star-input"
                   @(isChecked ? "checked=\"checked\"" : null) />
            <label for="@Model.Name-@star" class="rate-trip-star-label" title="@star star@(star == 1 ? "" : "s")">
                <i class="bi bi-star-fill" aria-hidden="true"></i>
                <span class="visually-hidden">@star star@(star == 1 ? "" : "s")</span>
            </label>
        }
    </div>
</div>
