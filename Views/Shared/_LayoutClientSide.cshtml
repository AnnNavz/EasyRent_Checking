@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyRent</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/client.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="client-body">
    @{
        var activeNav = ViewData["ActiveNav"]?.ToString() ?? "";
        var isSignedIn = User.Identity?.IsAuthenticated == true;
        var displayName = User.Identity?.Name ?? "User";
        var avatarInitial = !string.IsNullOrWhiteSpace(displayName)
            ? char.ToUpperInvariant(displayName.Trim()[0]).ToString()
            : "U";
    }

    <header class="client-navbar">
        <div class="client-navbar-inner">
            <a asp-controller="ClientSide" asp-action="Homepage" class="client-brand">
                <img src="~/images/System Images/EasyRentLogo.png" alt="EasyRent" class="client-brand-logo-img" asp-append-version="true" />
                <span class="client-brand-name">EasyRent</span>
            </a>

            <nav class="client-nav-links d-none d-lg-flex">
                <a asp-controller="ClientSide" asp-action="Homepage" class="client-nav-link @(activeNav == "Home" ? "active" : "")">Home</a>
                <a asp-controller="ClientSide" asp-action="Browse" class="client-nav-link @(activeNav == "Vehicles" ? "active" : "")">Book a Vehicle</a>
                <a href="#about-us" class="client-nav-link @(activeNav == "AboutUs" ? "active" : "")">About Us</a>
                <a href="#faqs" class="client-nav-link @(activeNav == "FAQs" ? "active" : "")">FAQs</a>
            </nav>

            @if (ViewData["HideSignIn"] as bool? != true)
            {
                <div class="client-nav-actions d-none d-lg-flex">
                    @if (isSignedIn)
                    {
                        <div class="dropdown">
                            <button class="client-profile-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="client-profile-name">@displayName</span>
                                <span class="client-profile-avatar">@avatarInitial</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end client-profile-menu shadow border-0">
                                <div class="client-profile-menu-header">
                                    <div class="client-profile-menu-avatar" aria-hidden="true">@avatarInitial</div>
                                    <div class="client-profile-menu-identity">
                                        <span class="client-profile-menu-name">@displayName</span>
                                        <span class="client-profile-menu-role">Customer</span>
                                        <span class="client-profile-menu-status">Online</span>
                                    </div>
                                </div>

                                <div class="client-profile-menu-divider" role="separator"></div>

                                <a class="client-profile-menu-item" asp-controller="ClientSide" asp-action="MyBookings">
                                    <i class="bi bi-calendar2-check client-profile-menu-icon" aria-hidden="true"></i>
                                    <span class="client-profile-menu-copy">
                                        <span class="client-profile-menu-item-title">Transactions &amp; Rentals</span>
                                        <span class="client-profile-menu-item-sub">Active and past rentals</span>
                                    </span>
                                    <i class="bi bi-chevron-right client-profile-menu-chevron" aria-hidden="true"></i>
                                </a>

                                <div class="client-profile-menu-divider" role="separator"></div>

                                <a class="client-profile-menu-item" asp-controller="ClientSide" asp-action="Browse">
                                    <i class="bi bi-truck-front client-profile-menu-icon" aria-hidden="true"></i>
                                    <span class="client-profile-menu-copy">
                                        <span class="client-profile-menu-item-title">Book a Vehicle</span>
                                        <span class="client-profile-menu-item-sub">Find and reserve a vehicle</span>
                                    </span>
                                    <i class="bi bi-chevron-right client-profile-menu-chevron" aria-hidden="true"></i>
                                </a>

                                <div class="client-profile-menu-divider" role="separator"></div>

                                <a class="client-profile-menu-item is-logout" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right client-profile-menu-icon" aria-hidden="true"></i>
                                    <span class="client-profile-menu-copy">
                                        <span class="client-profile-menu-item-title">Log Out</span>
                                        <span class="client-profile-menu-item-sub">Sign out from your account</span>
                                    </span>
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="client-btn-signin">Sign In</a>
                    }
                </div>
            }

            <button class="client-nav-toggle d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#clientNavMenu" aria-controls="clientNavMenu" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <div class="collapse d-lg-none" id="clientNavMenu">
            <div class="client-nav-mobile">
                <nav class="client-nav-links">
                    <a asp-controller="ClientSide" asp-action="Homepage" class="client-nav-link @(activeNav == "Home" ? "active" : "")">Home</a>
                    <a asp-controller="ClientSide" asp-action="Browse" class="client-nav-link @(activeNav == "Vehicles" ? "active" : "")">Book a Vehicle</a>
                    <a href="#about-us" class="client-nav-link @(activeNav == "AboutUs" ? "active" : "")">About Us</a>
                    <a href="#faqs" class="client-nav-link @(activeNav == "FAQs" ? "active" : "")">FAQs</a>
                </nav>
                @if (ViewData["HideSignIn"] as bool? != true)
                {
                    @if (isSignedIn)
                    {
                        <div class="client-profile-mobile">
                            <div class="client-profile-menu-header">
                                <div class="client-profile-menu-avatar" aria-hidden="true">@avatarInitial</div>
                                <div class="client-profile-menu-identity">
                                    <span class="client-profile-menu-name">@displayName</span>
                                    <span class="client-profile-menu-role">Customer</span>
                                    <span class="client-profile-menu-status">Online</span>
                                </div>
                            </div>
                            <div class="client-profile-menu-divider" role="separator"></div>
                            <a asp-controller="ClientSide" asp-action="MyBookings" class="client-profile-menu-item">
                                <i class="bi bi-calendar2-check client-profile-menu-icon" aria-hidden="true"></i>
                                <span class="client-profile-menu-copy">
                                    <span class="client-profile-menu-item-title">Transactions &amp; Rentals</span>
                                    <span class="client-profile-menu-item-sub">Active and past rentals</span>
                                </span>
                                <i class="bi bi-chevron-right client-profile-menu-chevron" aria-hidden="true"></i>
                            </a>
                            <div class="client-profile-menu-divider" role="separator"></div>
                            <a asp-controller="ClientSide" asp-action="Browse" class="client-profile-menu-item">
                                <i class="bi bi-truck-front client-profile-menu-icon" aria-hidden="true"></i>
                                <span class="client-profile-menu-copy">
                                    <span class="client-profile-menu-item-title">Book a Vehicle</span>
                                    <span class="client-profile-menu-item-sub">Find and reserve a vehicle</span>
                                </span>
                                <i class="bi bi-chevron-right client-profile-menu-chevron" aria-hidden="true"></i>
                            </a>
                            <div class="client-profile-menu-divider" role="separator"></div>
                            <a asp-controller="Account" asp-action="Logout" class="client-profile-menu-item is-logout">
                                <i class="bi bi-box-arrow-right client-profile-menu-icon" aria-hidden="true"></i>
                                <span class="client-profile-menu-copy">
                                    <span class="client-profile-menu-item-title">Log Out</span>
                                    <span class="client-profile-menu-item-sub">Sign out from your account</span>
                                </span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="client-btn-signin">Sign In</a>
                    }
                }
            </div>
        </div>
    </header>

    <main class="client-main">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
