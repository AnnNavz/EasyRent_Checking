@model EasyRent_Checking.ViewModels.CreateSuccessViewModel

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = Model.PageTitle;
    ViewData["ActivePage"] = Model.ActivePage;

    var successClass = Model.ActivePage switch
    {
        "Drivers" => "driver-create-success",
        "Vehicles" => "vehicle-create-success",
        "Customers" => "customer-create-success",
        "Maintenance" => "pms-record-success",
        _ => ""
    };
}

@section Styles {
    @if (Model.ActivePage == "Drivers")
    {
        <link rel="stylesheet" href="~/css/admin/driver-create.css" asp-append-version="true" />
    }
    else if (Model.ActivePage == "Vehicles")
    {
        <link rel="stylesheet" href="~/css/admin/vehicle-create.css" asp-append-version="true" />
    }
    else if (Model.ActivePage == "Customers")
    {
        <link rel="stylesheet" href="~/css/admin/customer-create.css" asp-append-version="true" />
    }
}

<div class="admin-success-screen @successClass">
    <div class="admin-success-icon-wrap">
        <partial name="_SuccessCheckIcon" />
    </div>

    <h2 class="admin-success-heading">@Model.Heading</h2>
    <p class="admin-success-message">@Html.Raw(Model.MessageHtml)</p>

    <div class="admin-success-actions">
        <a href="@Model.PrimaryActionUrl" class="btn btn-admin-primary">
            @Model.PrimaryActionText <i class="bi bi-arrow-right ms-1"></i>
        </a>
        <a href="@Model.SecondaryActionUrl" class="btn btn-admin-outline">
            @if (Model.ShowSecondaryPlusIcon)
            {
                <i class="bi bi-plus-lg me-1"></i>
            }
            @Model.SecondaryActionText
        </a>
    </div>
</div>
