@model EasyRent_Checking.Models.Vehicle
@using EasyRent_Checking.Models
@using System.Globalization

@{
    decimal succeedingRate = Model.SucceedingFee;
    decimal exampleTotal = Model.BasePrice + (2m * succeedingRate);
    bool canReserve = Model.IsActive && Model.Status == VehicleStatus.Available;
    bool hideReserveButton = ViewData["HideReserveButton"] as bool? == true;
    bool liveRate = ViewData["LiveRateSummary"] as bool? == true;
    string basePriceAttr = Model.BasePrice.ToString(CultureInfo.InvariantCulture);
    string succeedingFeeAttr = succeedingRate.ToString(CultureInfo.InvariantCulture);
}

<div class="client-rate-summary"
     id="rateSummaryRoot"
     data-live="@(liveRate ? "true" : "false")"
     data-base-price="@basePriceAttr"
     data-succeeding-fee="@succeedingFeeAttr"
     data-base-hours="8"
     data-discount-percent="10">
    <h2 class="client-rate-summary-title">Rate Summary</h2>
    <p class="client-rate-summary-note">
        <i class="bi bi-check-circle-fill"></i>
        Taxes &amp; fees included &bull; No hidden charges
    </p>
    <hr class="client-rate-summary-divider" />

    <div class="client-rate-card client-rate-card--base">
        <div class="client-rate-card-header">
            <div class="client-rate-card-icon"><i class="bi bi-clock"></i></div>
            <div class="client-rate-card-info">
                <span class="client-rate-card-label">BASE PACKAGE <span class="client-rate-card-subtitle" id="ratePackageBaseSubtitle">(First 8 hours)</span></span>
            </div>
            <span class="client-rate-card-price" id="ratePackageBasePrice">₱@Model.BasePrice.ToString("N0")</span>
        </div>
        <hr class="client-rate-card-divider" />
        <ul class="client-rate-includes">
            <li><i class="bi bi-check-lg"></i> Driver's fee included</li>
            <li><i class="bi bi-check-lg"></i> Fuel included</li>
            <li><i class="bi bi-check-lg"></i> Full Air-condition for all passengers</li>
            <li><i class="bi bi-check-lg"></i> All taxes &amp; fees included</li>
        </ul>
    </div>

    <div class="client-rate-card client-rate-card--succeeding">
        <div class="client-rate-card-header">
            <div class="client-rate-card-icon client-rate-card-icon--circle"><i class="bi bi-plus-lg"></i></div>
            <div class="client-rate-card-info">
                <span class="client-rate-card-label">SUCCEEDING HOURS <span class="client-rate-card-subtitle" id="ratePackageSucceedingSubtitle">(Per hour (after 8 hours))</span></span>
            </div>
            <span class="client-rate-card-price" id="ratePackageSucceedingPrice">₱@succeedingRate.ToString("N0")</span>
        </div>
        <p class="client-rate-footnote">
            <i class="bi bi-info-circle"></i>
            <span id="ratePackageSucceedingNote"><strong>Note:</strong> Fuel cost for succeeding is charged separately and not included in @succeedingRate.ToString("N0")/per hour rate.</span>
        </p>
    </div>

    <div class="client-rate-example" id="rateSummaryEstimate">
        <div class="client-rate-example-header">
            <i class="bi bi-calculator"></i>
            <span id="rateEstimateTitle">EXAMPLE: 10-HOUR TRIP</span>
        </div>

        <p id="rateEstimateEmpty" class="client-rate-example-empty d-none">
            Select pick-up and return dates to calculate your total.
        </p>

        <div id="rateEstimateDetails">
            <div id="rateVehicleBreakdown" class="client-rate-vehicle-breakdown d-none"></div>
            <div class="client-rate-example-row">
                <span id="rateBaseLabel">Base package (8 hrs)</span>
                <span id="rateBaseAmount">₱@Model.BasePrice.ToString("N0")</span>
            </div>
            <div class="client-rate-example-row" id="rateSucceedingRow">
                <span id="rateSucceedingLabel">+2 succeeding hours (₱@succeedingRate.ToString("N0")×2)</span>
                <span id="rateSucceedingAmount">₱@((2m * succeedingRate).ToString("N0"))</span>
            </div>
            <div class="client-rate-example-row is-discount d-none" id="rateDiscountRow">
                <span>Senior/PWD discount (10%)</span>
                <span id="rateDiscountAmount">-₱0</span>
            </div>
            <hr class="client-rate-card-divider" />
            <div class="client-rate-example-total">
                <span id="rateTotalLabel">ESTIMATED TOTAL (10 hours)</span>
                <span id="rateTotalAmount">₱@exampleTotal.ToString("N0")</span>
            </div>
            <p class="client-rate-example-note">* Excludes fuel for succeeding hours. Exact details in your rent form.</p>
        </div>
    </div>

    <div class="client-rate-info-box client-rate-info-box--discount">
        <i class="bi bi-tag"></i>
        <p><strong>10% discount</strong> for Senior Citizen's &amp; PWD - present valid ID upon booking. Not combinable.</p>
    </div>
    <div class="client-rate-info-box client-rate-info-box--payment">
        <i class="bi bi-file-earmark-text"></i>
        <p>After trip details, choose <strong>Pay Now (Full)</strong>, <strong>Pay Deposit</strong> or <strong>Pay At Office</strong>.</p>
    </div>

    @if (!hideReserveButton)
    {
        if (canReserve)
        {
            <div class="client-rate-cta-stack">
                <a asp-controller="ClientSide"
                   asp-action="Rental"
                   asp-route-id="@Model.VehicleId"
                   class="client-btn-reserve client-btn-reserve-lg">
                    <i class="bi bi-calendar-check"></i>
                    Rent Now
                </a>
            </div>
        }
        else
        {
            <button type="button" class="client-btn-reserve client-btn-reserve-lg" disabled>
                <i class="bi bi-calendar-x"></i>
                Currently Unavailable
            </button>
        }
    }

    <div class="client-rate-trust">
        <div class="client-rate-trust-item">
            <i class="bi bi-lock"></i>
            <span>Secure Checkout</span>
        </div>
        <div class="client-rate-trust-item">
            <i class="bi bi-arrow-counterclockwise"></i>
            <span>Free Cancel (before pull-out)</span>
        </div>
        <div class="client-rate-trust-item">
            <i class="bi bi-headset"></i>
            <span>24/7 Support</span>
        </div>
    </div>

    <p class="client-rate-disclaimer">
        * Free cancellation only applies while vehicle is still in garage.
        A <strong>₱2,000 fee</strong> applies if cancelled after pull-out.
    </p>
</div>
