@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyRent</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/client/client.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/client/auth.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="client-body client-body-login">

    <header class="client-navbar">
        <div class="client-navbar-inner">
            <a asp-controller="ClientSide" asp-action="Homepage" class="client-brand">
                <img src="~/images/System Images/EasyRentLogo.png" alt="EasyRent" class="client-brand-logo-img" asp-append-version="true" />
                <span class="client-brand-name">EasyRent</span>
            </a>

            <nav class="client-nav-links d-none d-lg-flex">
                <a asp-controller="ClientSide" asp-action="Homepage" class="client-nav-link">Home</a>
                <a asp-controller="ClientSide" asp-action="Browse" class="client-nav-link">Vehicles</a>
                <a asp-controller="ClientSide" asp-action="HowItWorks" class="client-nav-link">How It Works</a>
                <a asp-controller="ClientSide" asp-action="AboutUs" class="client-nav-link">About Us</a>
                <a asp-controller="ClientSide" asp-action="ContactUs" class="client-nav-link">Contact Us</a>
            </nav>

            <button class="client-nav-toggle d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#clientNavMenu" aria-controls="clientNavMenu" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <div class="collapse d-lg-none" id="clientNavMenu">
            <div class="client-nav-mobile">
                <nav class="client-nav-links">
                    <a asp-controller="ClientSide" asp-action="Homepage" class="client-nav-link">Home</a>
                    <a asp-controller="ClientSide" asp-action="Browse" class="client-nav-link">Vehicles</a>
                    <a asp-controller="ClientSide" asp-action="HowItWorks" class="client-nav-link">How It Works</a>
                    <a asp-controller="ClientSide" asp-action="AboutUs" class="client-nav-link">About Us</a>
                    <a asp-controller="ClientSide" asp-action="ContactUs" class="client-nav-link">Contact Us</a>
                </nav>
            </div>
        </div>
    </header>

    <main class="client-main client-main-login">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_LegalModals" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
