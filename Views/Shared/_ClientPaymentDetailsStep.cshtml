@model EasyRent_Checking.ViewModels.RentalInputModel
@using System.Globalization
@{
    var totalFare = ViewData["TotalFare"] as decimal? ?? 0m;
    var paymentDetailsFromStep = ViewData["PaymentDetailsFromStep"] as int? ?? 3;
    var paymentDetailsBackStep = ViewData["PaymentDetailsBackStep"] as int? ?? 2;
    var hideReminders = ViewData["HidePaymentReminders"] as bool? == true;

    string FormatPeso(decimal amount) =>
        "₱" + Math.Max(0, amount).ToString("N2", CultureInfo.GetCultureInfo("en-PH"));
}

<input type="hidden" asp-for="PaymentMethod" id="input-PaymentMethod" />

<div class="payment-details-step">
    <div class="rent-step-card payment-method-select-block">
        <div class="rent-card-head">
            <span class="rent-card-icon"><i class="bi bi-credit-card-2-front"></i></span>
            <h2 class="payment-type-title">Select Payment Method</h2>
        </div>
        <p class="rent-card-hint">Choose how you’d like to send your payment.</p>

        <div class="payment-method-tabs" role="tablist" aria-label="Payment methods">
            <button type="button" class="payment-method-tab" data-payment-method="GCash" role="tab">
                <img src="~/images/System Images/GcashImage.jpg" alt="" class="payment-method-tab-logo" />
                <span class="payment-method-tab-text">
                    <span class="payment-method-tab-name">GCash</span>
                    <span class="payment-method-tab-channel">QR only</span>
                </span>
            </button>
            <button type="button" class="payment-method-tab" data-payment-method="BDO" role="tab">
                <img src="~/images/System Images/BDOimage.png" alt="" class="payment-method-tab-logo" />
                <span class="payment-method-tab-text">
                    <span class="payment-method-tab-name">BDO</span>
                    <span class="payment-method-tab-channel">QR only</span>
                </span>
            </button>
            <button type="button" class="payment-method-tab" data-payment-method="Walk-in" role="tab">
                <span class="payment-method-tab-logo-fallback"><i class="bi bi-shop"></i></span>
                <span class="payment-method-tab-text">
                    <span class="payment-method-tab-name">Walk-in</span>
                    <span class="payment-method-tab-channel">Pay at Office</span>
                </span>
            </button>
        </div>

        <div class="payment-channel-panel d-none mt-3" id="channelPanelGCash">
            <div class="payment-channel-panel-title">
                <img src="~/images/System Images/GcashImage.jpg" alt="GCash" class="payment-channel-title-logo" />
                <span>GCash QR Code</span>
            </div>
            <div class="payment-qr-box">
                <i class="bi bi-qr-code"></i>
                <span>Scan with GCash app</span>
            </div>
            <div class="payment-channel-details">
                <div class="payment-channel-detail-row">
                    <span>Gcash Name:</span>
                    <strong>TRUST RENT A CAR</strong>
                </div>
                <div class="payment-channel-detail-row">
                    <span>Gcash Number:</span>
                    <strong>09XX-XXX-XXXX</strong>
                </div>
                <div class="payment-channel-detail-row">
                    <span>Amount:</span>
                    <strong class="js-pay-now-amount">@FormatPeso(totalFare)</strong>
                </div>
            </div>
        </div>

        <div class="payment-channel-panel d-none mt-3" id="channelPanelBDO">
            <div class="payment-channel-panel-title">
                <img src="~/images/System Images/BDOimage.png" alt="BDO" class="payment-channel-title-logo" />
                <span>BDO QR Code</span>
            </div>
            <div class="payment-qr-box">
                <i class="bi bi-qr-code"></i>
                <span>Scan with banking app</span>
            </div>
            <div class="payment-channel-details">
                <div class="payment-channel-detail-row">
                    <span>Account Name:</span>
                    <strong>TRUST RENT A CAR</strong>
                </div>
                <div class="payment-channel-detail-row">
                    <span>Account Number:</span>
                    <strong>XXXX-XXXX-XXXX</strong>
                </div>
                <div class="payment-channel-detail-row">
                    <span>Amount:</span>
                    <strong class="js-pay-now-amount">@FormatPeso(totalFare)</strong>
                </div>
            </div>
        </div>

        <div class="payment-channel-panel d-none mt-3" id="channelPanelWalkin">
            <div class="payment-channel-panel-title">
                <span class="payment-channel-title-icon"><i class="bi bi-shop"></i></span>
                <span>Pay at EasyRent Office</span>
            </div>
            <div class="payment-qr-box">
                <i class="bi bi-geo-alt"></i>
                <span>Bring exact amount if possible</span>
            </div>
            <div class="payment-channel-details">
                <div class="payment-channel-detail-row">
                    <span>Office:</span>
                    <strong>EasyRent Vehicle Rental</strong>
                </div>
                <div class="payment-channel-detail-row">
                    <span>Address:</span>
                    <strong>Cebu City, Philippines</strong>
                </div>
                <div class="payment-channel-detail-row">
                    <span>Amount Due:</span>
                    <strong class="js-pay-now-amount">@FormatPeso(totalFare)</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="rent-step-card payment-step2-card">
        <div class="rent-card-head">
            <span class="rent-card-icon"><i class="bi bi-clipboard-check"></i></span>
            <h2 class="payment-step2-heading">Submit Payment Details</h2>
        </div>
        <p class="rent-card-hint">
            After sending the payment, fill in the details below and submit for verification. Our team will confirm within 24 hours.
        </p>

        <div class="row g-3">
            <div class="col-md-6 js-cashless-only">
                <label asp-for="AccountName" class="form-label payment-field-label rent-field-label">Account Name</label>
                <input asp-for="AccountName" id="AccountName" class="form-control form-control-thin payment-field-input rent-field-input" placeholder="e.g. Jane Doe" />
            </div>
            <div class="col-md-6 js-cashless-only">
                <label asp-for="TransactionReference" class="form-label payment-field-label rent-field-label">Reference/Transaction Number</label>
                <input asp-for="TransactionReference" id="TransactionReference" class="form-control form-control-thin payment-field-input rent-field-input" placeholder="e.g. 123456789" />
            </div>
            <div class="col-md-6">
                <label class="form-label payment-field-label rent-field-label">Amount Sent (₱)</label>
                <input asp-for="AmountPaid" id="input-AmountPaid" class="form-control form-control-thin payment-field-input rent-field-input" type="number" step="0.01" min="0" placeholder="Input the exact amount" />
                <span class="payment-field-help rent-field-help">Must match the total: <strong id="amountMatchLabel">@FormatPeso(totalFare)</strong></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PaymentDate" class="form-label payment-field-label rent-field-label">Date &amp; Time of Payment</label>
                <div class="rent-date-field">
                    <input asp-for="PaymentDate" id="input-PaymentDate" class="form-control form-control-thin payment-field-input rent-field-input" type="datetime-local" />
                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                </div>
            </div>
            <div class="col-12 js-cashless-only">
                <label class="form-label payment-field-label rent-field-label">Upload Payment Screenshot / Receipt</label>
                <div class="rent-upload-panel">
                    <div class="payment-upload-zone" id="receiptUploadZone">
                        <div class="payment-upload-empty" id="receiptUploadEmpty">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <strong>Drag &amp; drop or click to upload</strong>
                            <span>PNG, JPG, or JPEG (max 5MB)</span>
                        </div>
                        <input asp-for="ReceiptImageFile" id="input-ReceiptFile" type="file" class="payment-upload-input" accept=".png,.jpg,.jpeg,image/*" />
                    </div>
                    <div class="payment-upload-preview" id="receiptUploadPreview">
                        <div class="license-preview-box" id="receiptPreviewBox" title="Click to replace image">
                            <img id="receiptPreviewImg" class="d-none" alt="Payment receipt preview" />
                        </div>
                        <div class="upload-preview-bar d-flex align-items-center justify-content-between">
                            <span id="receiptFilename" class="small fw-semibold text-muted font-monospace" style="font-size:0.8rem;"></span>
                            <button type="button" class="upload-preview-remove-btn" id="receiptRemoveBtn">Remove</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="PaymentNotes" class="form-label payment-field-label rent-field-label">Additional Notes (Optional)</label>
                <textarea asp-for="PaymentNotes" id="PaymentNotes" class="form-control form-control-thin payment-field-input rent-field-input rent-field-textarea" rows="3" placeholder="Additional notes about your payment"></textarea>
            </div>
        </div>

        @if (!hideReminders)
        {
            <div class="payment-reminders">
                <div class="payment-reminders-title">
                    <i class="bi bi-info-circle"></i>
                    <span>Important Reminders</span>
                </div>
                <ul>
                    <li>Send the exact amount given to avoid delays.</li>
                    <li>Use the correct QR code or account details for your selected channel.</li>
                    <li>Keep the transaction receipt for reference.</li>
                </ul>
            </div>
        }
    </div>

    <div class="rent-step-actions rent-step-actions--split payment-type-actions">
        <button type="button" class="rent-btn-cancel" data-wizard-back="@paymentDetailsBackStep">Back</button>
        <button type="button" class="rent-btn-continue" data-wizard-next="@paymentDetailsFromStep">
            Continue to Summary
        </button>
    </div>
</div>
