@{
    var confirmLabel = ViewData["SummaryConfirmLabel"]?.ToString() ?? "Confirm Booking and Submit";
    var summaryBackStep = ViewData["SummaryBackStep"]?.ToString();
    var isReserveFlow = ViewData["IsReserveFlow"] as bool? == true;
    var paymentSummaryOnly = ViewData["PaymentSummaryOnly"] as bool? == true;
    var summaryPaymentEditStep = ViewData["SummaryPaymentEditStep"]?.ToString() ?? "3";
    var hidePaymentEdit = ViewData["HideSummaryPaymentEdit"] as bool? == true || isReserveFlow;
    var rentalInfoTitle = paymentSummaryOnly ? "Trip Summary" : "Rental Information";
}

<div class="client-booking-summary-step @(paymentSummaryOnly ? "is-payment-completion" : "")">
<!-- Rental Information -->
<div class="form-container-card booking-summary-card booking-details-panel p-4 mb-4 shadow-sm">
    <div class="booking-details-header">
        <div class="booking-details-title">
            <span class="booking-details-title-icon" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></span>
            <span>@rentalInfoTitle</span>
        </div>
        @if (!paymentSummaryOnly)
        {
            <button type="button" class="btn booking-summary-edit-btn" data-summary-edit data-summary-edit-step="1">
                <i class="bi bi-pencil"></i> Edit
            </button>
        }
    </div>

    @if (paymentSummaryOnly)
    {
        <div class="booking-details-list booking-details-columns">
            <div class="booking-details-col">
                <div class="booking-details-row">
                    <span class="booking-details-label">Customer Name</span>
                    <span class="booking-details-value" id="summaryCustomerName">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Contact Information</span>
                    <span class="booking-details-value" id="summaryContact">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Vehicle Brand &amp; Model</span>
                    <span class="booking-details-value" id="summaryVehicleName">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Vehicle Type</span>
                    <span class="booking-details-value" id="summaryVehicleType">—</span>
                </div>
            </div>
            <div class="booking-details-col">
                <div class="booking-details-row">
                    <span class="booking-details-label">Pickup Location</span>
                    <span class="booking-details-value" id="summaryPickupLocation">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Drop-off Location</span>
                    <span class="booking-details-value" id="summaryDropoffLocation">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Pick-up Date &amp; Time</span>
                    <span class="booking-details-value" id="summaryPickupDateTime">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Return Date &amp; Time</span>
                    <span class="booking-details-value" id="summaryReturnDateTime">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Total Duration</span>
                    <span class="booking-details-value" id="summaryDuration">—</span>
                </div>
            </div>
            <div class="booking-details-col booking-details-col-full">
                <div class="booking-details-divider" role="separator"></div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Passenger Count</span>
                    <span class="booking-details-value" id="summaryPassengers">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Senior/PWD Discount</span>
                    <span class="booking-details-value" id="summaryDiscount">—</span>
                </div>
                <div class="booking-details-section booking-details-section-notes">
                    <span class="booking-details-label">Special Requests / Notes</span>
                    <div class="booking-summary-notes" id="summaryNotes">—</div>
                </div>
            </div>
            <span class="d-none" id="summaryBookingDateTime" aria-hidden="true"></span>
            <span class="d-none" id="summaryValidIdFallback" aria-hidden="true"></span>
            <div class="d-none" id="summaryDiscountIdSection" aria-hidden="true">
                <div id="summaryDiscountFrontCard"></div>
                <div id="summaryDiscountBackCard"></div>
                <a id="summaryDiscountPreviewLink" class="d-none" href="#"></a>
                <img id="summaryDiscountPreviewImg" class="d-none" alt="" />
                <a id="summaryDiscountBackPreviewLink" class="d-none" href="#"></a>
                <img id="summaryDiscountBackPreviewImg" class="d-none" alt="" />
                <span id="summaryDiscountFrontName" class="d-none"></span>
                <span id="summaryDiscountBackName" class="d-none"></span>
            </div>
        </div>
    }
    else
    {
        <div class="booking-details-list">
            <div class="booking-details-row">
                <span class="booking-details-label">Rental Status</span>
                <span class="booking-status-badge booking-status-pending"><i class="bi bi-clock"></i> Pending</span>
            </div>
            <div class="booking-details-row">
                <span class="booking-details-label">Designated Driver</span>
                <span class="booking-status-badge booking-status-pending"><i class="bi bi-clock"></i> Pending</span>
            </div>
            <div class="booking-details-row">
                <span class="booking-details-label">Booking Date &amp; Time</span>
                <span class="booking-details-value booking-details-value-with-icon">
                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                    <span id="summaryBookingDateTime">—</span>
                </span>
            </div>
            <div class="booking-details-row">
                <span class="booking-details-label">Customer Name</span>
                <span class="booking-details-value" id="summaryCustomerName">—</span>
            </div>
            <div class="booking-details-row">
                <span class="booking-details-label">Vehicle Brand &amp; Model</span>
                <span class="booking-details-value" id="summaryVehicleName">—</span>
            </div>
            <div class="booking-details-row">
                <span class="booking-details-label">Vehicle Type</span>
                <span class="booking-details-value" id="summaryVehicleType">—</span>
            </div>
            <div class="booking-details-row">
                <span class="booking-details-label">Contact Information</span>
                <span class="booking-details-value" id="summaryContact">—</span>
            </div>
            <div class="booking-details-row">
                <span class="booking-details-label">Pickup Location</span>
                <span class="booking-details-value" id="summaryPickupLocation">—</span>
            </div>
            <div class="booking-details-row">
                <span class="booking-details-label">Drop-off Location</span>
                <span class="booking-details-value" id="summaryDropoffLocation">—</span>
            </div>
            <div class="booking-details-row">
                <span class="booking-details-label">Pick-up Date &amp; Time</span>
                <span class="booking-details-value" id="summaryPickupDateTime">—</span>
            </div>
            <div class="booking-details-row">
                <span class="booking-details-label">Return Date &amp; Time</span>
                <span class="booking-details-value" id="summaryReturnDateTime">—</span>
            </div>
            <div class="booking-details-row">
                <span class="booking-details-label">Total Duration</span>
                <span class="booking-details-value" id="summaryDuration">—</span>
            </div>

            <div class="booking-details-divider" role="separator"></div>

            <div class="booking-details-row">
                <span class="booking-details-label">Passenger Count</span>
                <span class="booking-details-value" id="summaryPassengers">—</span>
            </div>
            <div class="booking-details-row">
                <span class="booking-details-label">Senior/PWD Discount</span>
                <span class="booking-details-value" id="summaryDiscount">—</span>
            </div>
            <div class="booking-details-row booking-details-row-id">
                <span class="booking-details-label">Valid ID Uploaded</span>
                <span class="booking-details-value booking-details-file d-none" id="summaryValidIdFallback">—</span>
            </div>
            <div class="booking-summary-id-grid d-none" id="summaryDiscountIdSection">
                <div class="booking-summary-id-card" id="summaryDiscountFrontCard">
                    <span class="booking-summary-id-label">Front</span>
                    <a class="booking-summary-id-thumb d-none" id="summaryDiscountPreviewLink" href="#" target="_blank" rel="noopener">
                        <img id="summaryDiscountPreviewImg" alt="Front of Senior/PWD ID" />
                    </a>
                    <span class="booking-summary-id-name" id="summaryDiscountFrontName"></span>
                </div>
                <div class="booking-summary-id-card d-none" id="summaryDiscountBackCard">
                    <span class="booking-summary-id-label">Back</span>
                    <a class="booking-summary-id-thumb d-none" id="summaryDiscountBackPreviewLink" href="#" target="_blank" rel="noopener">
                        <img id="summaryDiscountBackPreviewImg" alt="Back of Senior/PWD ID" />
                    </a>
                    <span class="booking-summary-id-name" id="summaryDiscountBackName"></span>
                </div>
            </div>

            <div class="booking-details-section booking-details-section-notes">
                <span class="booking-details-label">Special Requests / Notes</span>
                <div class="booking-summary-notes" id="summaryNotes">—</div>
            </div>
        </div>
    }</div>

<!-- Payment Details -->
<div class="form-container-card booking-summary-card booking-payment-panel p-4 mb-4 shadow-sm">
    <div class="booking-details-header">
        <div class="booking-details-title">
            <span class="booking-details-title-icon booking-details-title-icon--round" aria-hidden="true"><i class="bi bi-credit-card-2-front-fill"></i></span>
            <span id="summaryPaymentPanelTitle">@(isReserveFlow ? "Estimated Costs" : "Payment Details")</span>
        </div>
        <button type="button" class="btn booking-summary-edit-btn @(hidePaymentEdit ? "d-none" : "")" id="summaryPaymentEditBtn" data-summary-edit data-summary-edit-step="@summaryPaymentEditStep">
            <i class="bi bi-pencil"></i> Edit
        </button>
    </div>

    <div class="alert alert-warning py-2 px-3 mb-3 @(isReserveFlow ? "" : "d-none")" id="summaryReserveAlert" role="status">
        Payment is deferred. Estimated total is shown below — pay within @RentalRules.ReservePaymentWindowDays days from Transactions &amp; Rentals.
    </div>

    @* Pay-now: account / reference / amount / date / proof *@
    <div class="booking-details-list js-summary-paynow @(isReserveFlow ? "d-none" : "")">
        <div class="booking-details-row">
            <span class="booking-details-label">Account Name</span>
            <span class="booking-details-value" id="summaryPaymentAccount">—</span>
        </div>
        <div class="booking-details-row">
            <span class="booking-details-label">Reference/Transaction Number</span>
            <span class="booking-details-value" id="summaryTransactionReference">—</span>
        </div>
        <div class="booking-details-row">
            <span class="booking-details-label">Amount Sent (₱)</span>
            <strong class="booking-details-value booking-details-value-strong" id="summaryAmountPaid">₱0.00</strong>
        </div>
        <div class="booking-details-row">
            <span class="booking-details-label">Date &amp; Time of Payment</span>
            <span class="booking-details-value booking-details-value-with-icon">
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                <span id="summaryPaymentDateTime">—</span>
            </span>
        </div>

        <div class="booking-details-divider" role="separator"></div>

        <div class="booking-summary-receipt-section" id="summaryReceiptSection">
            <span class="booking-details-label booking-summary-receipt-label">Payment Proof/Screenshot</span>
            <span class="booking-details-value booking-details-file d-none" id="summaryReceiptName">—</span>
            <div class="booking-summary-receipt-frame d-none" id="summaryReceiptPreviewWrap">
                <a class="booking-summary-receipt-link" id="summaryReceiptPreviewLink" href="#" target="_blank" rel="noopener">
                    <img id="summaryReceiptPreviewImg" alt="Payment receipt" />
                </a>
            </div>
        </div>
    </div>

    @* Pay-later / hold: estimated fare breakdown *@
    <div class="booking-details-list @(isReserveFlow ? "" : "d-none")" id="summaryFeeGrid">
        <div class="booking-details-row">
            <span class="booking-details-label">Base Rental Fee</span>
            <strong class="booking-details-value booking-details-value-strong" id="summaryBaseFee">₱0.00</strong>
        </div>
        <div class="booking-details-row">
            <span class="booking-details-label">Payment Status</span>
            <span class="booking-status-badge booking-status-pending"><i class="bi bi-clock"></i> <span id="summaryPaymentStatusText">@(isReserveFlow ? "Pay Later" : "Pending")</span></span>
        </div>
        <div class="booking-details-row">
            <span class="booking-details-label" id="summarySucceedingLabel">Succeeding Hours</span>
            <strong class="booking-details-value booking-details-value-strong" id="summarySucceedingFee">₱0.00</strong>
        </div>
        <div class="booking-details-row" id="summaryDiscountRow" hidden>
            <span class="booking-details-label">Senior Discount (10%)</span>
            <strong class="booking-details-value booking-details-value-strong" id="summaryDiscountAmount">-₱0.00</strong>
        </div>
        <div class="booking-details-divider" role="separator"></div>
        <div class="booking-details-row" id="summaryFeeTotal">
            <span class="booking-details-label" id="summaryTotalLabel">@(isReserveFlow ? "Estimated Total" : "Total Rental Costs")</span>
            <strong class="booking-details-value booking-payment-total-amount" id="summaryTotalCost">₱0.00</strong>
        </div>
    </div>

    @* Hidden fields still written by BookingSummary.populate *@
    <span class="d-none" id="summaryPaymentType" aria-hidden="true"></span>
    <span class="d-none" id="summaryPaymentMethod" aria-hidden="true"></span>
    <span class="d-none" id="summaryDiscountSpacer" aria-hidden="true"></span>
</div>

<div class="rent-step-actions rent-step-actions--split payment-type-actions">
    <button type="button"
            class="rent-btn-cancel"
            id="summaryBackBtn"
            @if (!string.IsNullOrEmpty(summaryBackStep)) { <text>data-wizard-back="@summaryBackStep"</text> }>
        Back
    </button>
    <button type="submit" class="rent-btn-continue" id="summaryConfirmBtn"
            data-label-pay-now="Submit Booking &amp; Payment"
            data-label-pay-later="Confirm Hold">
        @confirmLabel
    </button>
</div>
</div>
