@{
    var confirmLabel = ViewData["SummaryConfirmLabel"]?.ToString() ?? "Confirm Booking and Submit";
    var summaryBackStep = ViewData["SummaryBackStep"]?.ToString();
    var isReserveFlow = ViewData["IsReserveFlow"] as bool? == true;
    var hidePaymentEdit = ViewData["HideSummaryPaymentEdit"] as bool? == true || isReserveFlow;
}

<div class="text-start mb-4" id="summaryHeaderBlock" data-reserve-flow="@(isReserveFlow ? "true" : "false")">
    <h5 class="wizard-page-title fw-bold text-dark mb-1" style="letter-spacing: -0.3px;" id="summaryPageTitle">@(isReserveFlow ? "Hold Summary" : "Booking Summary")</h5>
    <p class="text-muted small mb-0" id="summaryPageSubtitle">
        @(isReserveFlow
            ? $"Review your trip details. Payment is not included now — you must pay within {RentalRules.ReservePaymentWindowDays} days or this hold expires."
            : "Review the rental details below before confirming and submitting this booking.")
    </p>
</div>

<!-- Rental Details -->
<div class="form-container-card booking-summary-card booking-details-panel p-4 mb-4 shadow-sm">
    <div class="booking-details-header">
        <div class="booking-details-title">
            <i class="bi bi-clipboard2-check"></i>
            <span>Rental Details</span>
        </div>
        <button type="button" class="btn booking-summary-edit-btn" data-summary-edit data-summary-edit-step="1">
            <i class="bi bi-pencil"></i> Edit
        </button>
    </div>

    <div class="booking-details-section">
        <div class="booking-details-columns">
            <div class="booking-details-col">
                <div class="booking-details-row">
                    <span class="booking-details-label">Rental Status</span>
                    <span class="booking-status-badge booking-status-pending"><i class="bi bi-clock"></i> Pending</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Booking Date &amp; Time</span>
                    <span class="booking-details-value" id="summaryBookingDateTime">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Customer Name</span>
                    <span class="booking-details-value" id="summaryCustomerName">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Contact Information</span>
                    <span class="booking-details-value" id="summaryContact">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Pick-up Location</span>
                    <span class="booking-details-value" id="summaryPickupLocation">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Drop-off Location</span>
                    <span class="booking-details-value" id="summaryDropoffLocation">—</span>
                </div>
            </div>
            <div class="booking-details-col">
                <div class="booking-details-row">
                    <span class="booking-details-label">Designated Driver</span>
                    <span class="booking-status-badge booking-status-pending"><i class="bi bi-clock"></i> Pending</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Vehicle Brand &amp; Model</span>
                    <span class="booking-details-value" id="summaryVehicleName">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Vehicle Type</span>
                    <span class="booking-details-value" id="summaryVehicleType">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Pick-up Date &amp; Time</span>
                    <span class="booking-details-value" id="summaryPickupDateTime">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Return Date &amp; Time</span>
                    <span class="booking-details-value" id="summaryReturnDateTime">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Total Duration</span>
                    <span class="booking-details-value" id="summaryDuration">—</span>
                </div>
            </div>
        </div>
    </div>

    <div class="booking-details-section">
        <div class="booking-details-columns">
            <div class="booking-details-col">
                <div class="booking-details-row">
                    <span class="booking-details-label">Passenger Count</span>
                    <span class="booking-details-value" id="summaryPassengers">—</span>
                </div>
                <div class="booking-details-row">
                    <span class="booking-details-label">Senior/PWD Discount</span>
                    <span class="booking-details-value" id="summaryDiscount">—</span>
                </div>
            </div>
            <div class="booking-details-col">
                <div class="booking-details-row booking-details-row-stack">
                    <span class="booking-details-label">Valid ID Uploaded</span>
                    <span class="booking-details-value booking-details-file" id="summaryValidId">—</span>
                    <div class="booking-summary-doc-preview d-none" id="summaryDiscountPreviewWrap">
                        <a id="summaryDiscountPreviewLink" href="#" target="_blank" rel="noopener">
                            <img id="summaryDiscountPreviewImg" alt="Senior/PWD discount ID" />
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="booking-details-section booking-details-section-notes">
        <span class="booking-details-label">Special Requests / Notes</span>
        <div class="booking-summary-notes" id="summaryNotes">—</div>
    </div>
</div>

<!-- Payment Details -->
<div class="form-container-card booking-summary-card booking-payment-panel p-4 mb-4 shadow-sm">
    <div class="booking-details-header">
        <div class="booking-details-title">
            <i class="bi bi-credit-card-2-front"></i>
            <span id="summaryPaymentPanelTitle">@(isReserveFlow ? "Estimated Costs" : "Payment Details")</span>
        </div>
        <button type="button" class="btn booking-summary-edit-btn @(hidePaymentEdit ? "d-none" : "")" id="summaryPaymentEditBtn" data-summary-edit data-summary-edit-step="3">
            <i class="bi bi-pencil"></i> Edit
        </button>
    </div>

    <div class="alert alert-warning py-2 px-3 mb-3 @(isReserveFlow ? "" : "d-none")" id="summaryReserveAlert" role="status">
        Payment is deferred. Estimated total is shown below — pay within @RentalRules.ReservePaymentWindowDays days from Transactions &amp; Rentals.
    </div>

    <div class="booking-payment-grid">
        <div class="booking-payment-line">
            <span class="booking-payment-label">Base Rental Fee</span>
            <strong class="booking-payment-amount" id="summaryBaseFee">₱0.00</strong>
        </div>
        <div class="booking-payment-status">
            <span class="booking-payment-status-label">Payment Status</span>
            <span class="booking-status-badge booking-status-pending"><i class="bi bi-clock"></i> <span id="summaryPaymentStatusText">@(isReserveFlow ? "Pay Later" : "Pending")</span></span>
        </div>

        <div class="booking-payment-line">
            <span class="booking-payment-label" id="summarySucceedingLabel">Succeeding Hours</span>
            <strong class="booking-payment-amount" id="summarySucceedingFee">₱0.00</strong>
        </div>
        <div class="booking-payment-status-spacer" aria-hidden="true"></div>

        <div class="booking-payment-line" id="summaryDiscountRow" hidden>
            <span class="booking-payment-label">Senior Discount (10%)</span>
            <strong class="booking-payment-amount" id="summaryDiscountAmount">-₱0.00</strong>
        </div>
        <div class="booking-payment-status-spacer" id="summaryDiscountSpacer" aria-hidden="true" hidden></div>

        <div class="booking-payment-line js-summary-paynow @(isReserveFlow ? "d-none" : "")">
            <span class="booking-payment-label">Payment Type</span>
            <strong class="booking-payment-amount" id="summaryPaymentType">—</strong>
        </div>
        <div class="booking-payment-status-spacer js-summary-paynow @(isReserveFlow ? "d-none" : "")" aria-hidden="true"></div>

        <div class="booking-payment-line js-summary-paynow @(isReserveFlow ? "d-none" : "")">
            <span class="booking-payment-label">Payment Method</span>
            <strong class="booking-payment-amount" id="summaryPaymentMethod">—</strong>
        </div>
        <div class="booking-payment-status-spacer js-summary-paynow @(isReserveFlow ? "d-none" : "")" aria-hidden="true"></div>

        <div class="booking-payment-line js-summary-paynow @(isReserveFlow ? "d-none" : "")">
            <span class="booking-payment-label">Amount Paying Now</span>
            <strong class="booking-payment-amount" id="summaryAmountPaid">₱0.00</strong>
        </div>
        <div class="booking-payment-status-spacer js-summary-paynow @(isReserveFlow ? "d-none" : "")" aria-hidden="true"></div>

        <div class="booking-payment-line js-summary-paynow @(isReserveFlow ? "d-none" : "")">
            <span class="booking-payment-label">Account Name</span>
            <strong class="booking-payment-amount" id="summaryPaymentAccount">—</strong>
        </div>
        <div class="booking-payment-status-spacer js-summary-paynow @(isReserveFlow ? "d-none" : "")" aria-hidden="true"></div>
    </div>

    <div class="booking-summary-receipt-section js-summary-paynow @(isReserveFlow ? "d-none" : "")" id="summaryReceiptSection" hidden>
        <span class="booking-details-label">Payment Receipt</span>
        <span class="booking-details-value booking-details-file" id="summaryReceiptName">—</span>
        <div class="booking-summary-doc-preview d-none" id="summaryReceiptPreviewWrap">
            <a id="summaryReceiptPreviewLink" href="#" target="_blank" rel="noopener">
                <img id="summaryReceiptPreviewImg" alt="Payment receipt" />
            </a>
        </div>
    </div>

    <div class="booking-payment-total">
        <span class="booking-payment-total-label" id="summaryTotalLabel">@(isReserveFlow ? "Estimated Total" : "Total Rental Costs")</span>
        <strong class="booking-payment-total-amount" id="summaryTotalCost">₱0.00</strong>
        <span class="booking-payment-status-spacer" aria-hidden="true"></span>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 align-items-center">
    <button type="button"
            class="btn btn-light border px-4 py-2 fw-semibold text-dark rounded-3"
            style="font-size: 0.9rem;"
            id="summaryBackBtn"
            @if (!string.IsNullOrEmpty(summaryBackStep)) { <text>data-wizard-back="@summaryBackStep"</text> }>
        Back
    </button>
    <button type="submit" class="btn btn-dark px-4 py-2 fw-bold rounded-3 shadow-sm" style="font-size: 0.9rem; background-color: #1E3A8A; border-color: #1E3A8A;" id="summaryConfirmBtn"
            data-label-pay-now="Submit Booking &amp; Payment"
            data-label-pay-later="Confirm Hold">
        @confirmLabel
    </button>
</div>
