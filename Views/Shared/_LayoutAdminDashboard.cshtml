@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyRent</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    var activePage = ViewData["ActivePage"]?.ToString();
    var isBookingSection = activePage is "Rentals" or "Transit";
    var isUserSection = activePage is "Customers" or "Admins";
    var adminDisplayName = User.Identity?.IsAuthenticated == true
        ? (User.Identity.Name ?? "Admin")
        : "Admin";
    var adminInitials = !string.IsNullOrWhiteSpace(adminDisplayName)
        ? (adminDisplayName.Trim().Length >= 2
            ? adminDisplayName.Trim()[..2].ToUpperInvariant()
            : adminDisplayName.Trim()[..1].ToUpperInvariant())
        : "AD";
}
<body class="admin-shell">

    <aside class="admin-sidebar" id="adminSidebar" aria-label="Admin navigation">
        <div class="admin-sidebar-brand">
            <img src="~/images/System Images/EasyRentLogo.png" alt="EasyRent" class="brand-logo-img" asp-append-version="true" />
            <div class="admin-sidebar-brand-text">
                <h4 class="fw-bold brand-text mb-0">EasyRent</h4>
                <small class="brand-subtext d-block">Vehicle Rental System</small>
            </div>
        </div>

        <nav class="admin-sidebar-nav">
            <a asp-controller="Dashboard" asp-action="Index" class="nav-link-admin @(activePage == "Dashboard" ? "active" : "")" title="Dashboard">
                <i class="bi bi-grid-1x2-fill admin-nav-icon" aria-hidden="true"></i>
                <span class="admin-nav-label">Dashboard</span>
            </a>
            <a asp-controller="Drivers" asp-action="Index" class="nav-link-admin @(activePage == "Drivers" ? "active" : "")" title="Driver">
                <i class="bi bi-person-badge admin-nav-icon" aria-hidden="true"></i>
                <span class="admin-nav-label">Driver</span>
            </a>
            <a asp-controller="Vehicles" asp-action="Index" class="nav-link-admin @(activePage == "Vehicles" ? "active" : "")" title="Vehicle">
                <i class="bi bi-truck-front admin-nav-icon" aria-hidden="true"></i>
                <span class="admin-nav-label">Vehicle</span>
            </a>

            <div class="admin-nav-group">
                <button type="button"
                        class="nav-link-admin nav-link-admin-parent @(isBookingSection ? "active" : "")"
                        data-bs-toggle="collapse"
                        data-bs-target="#rentalNavGroup"
                        aria-expanded="@(isBookingSection ? "true" : "false")"
                        aria-controls="rentalNavGroup"
                        title="Rental">
                    <i class="bi bi-calendar2-check admin-nav-icon" aria-hidden="true"></i>
                    <span class="admin-nav-label">Rental</span>
                    <i class="bi bi-chevron-down admin-nav-chevron" aria-hidden="true"></i>
                </button>
                <div class="collapse @(isBookingSection ? "show" : "")" id="rentalNavGroup">
                    <a asp-controller="Rentals" asp-action="Index" class="nav-link-admin nav-link-admin-sub @(activePage == "Rentals" ? "active" : "")" title="Booking">
                        <i class="bi bi-journal-bookmark admin-nav-icon" aria-hidden="true"></i>
                        <span class="admin-nav-label">Booking</span>
                    </a>
                    <a asp-controller="Transits" asp-action="Index" class="nav-link-admin nav-link-admin-sub @(activePage == "Transit" ? "active" : "")" title="Active Trips">
                        <i class="bi bi-geo-alt admin-nav-icon" aria-hidden="true"></i>
                        <span class="admin-nav-label">Active Trips</span>
                    </a>
                </div>
            </div>

            <div class="admin-nav-group">
                <button type="button"
                        class="nav-link-admin nav-link-admin-parent @(isUserSection ? "active" : "")"
                        data-bs-toggle="collapse"
                        data-bs-target="#userNavGroup"
                        aria-expanded="@(isUserSection ? "true" : "false")"
                        aria-controls="userNavGroup"
                        title="User">
                    <i class="bi bi-people admin-nav-icon" aria-hidden="true"></i>
                    <span class="admin-nav-label">User</span>
                    <i class="bi bi-chevron-down admin-nav-chevron" aria-hidden="true"></i>
                </button>
                <div class="collapse @(isUserSection ? "show" : "")" id="userNavGroup">
                    <a asp-controller="Customers" asp-action="Index" class="nav-link-admin nav-link-admin-sub @(activePage == "Customers" ? "active" : "")" title="Customer">
                        <i class="bi bi-person admin-nav-icon" aria-hidden="true"></i>
                        <span class="admin-nav-label">Customer</span>
                    </a>
                    <a asp-controller="Admins" asp-action="Index" class="nav-link-admin nav-link-admin-sub @(activePage == "Admins" ? "active" : "")" title="Admin">
                        <i class="bi bi-shield-lock admin-nav-icon" aria-hidden="true"></i>
                        <span class="admin-nav-label">Admin</span>
                    </a>
                </div>
            </div>
        </nav>

        <div class="admin-sidebar-promo">
            <img src="~/images/System Images/bottomDesign.png"
                 alt=""
                 class="admin-sidebar-promo-img"
                 asp-append-version="true" />
            <div class="admin-sidebar-promo-copy">
                <p class="admin-sidebar-promo-title">Joy in every trip.</p>
                <p class="admin-sidebar-promo-text">EasyRent, your partner<br />on the road.</p>
            </div>
        </div>
    </aside>

    <div class="admin-content-shell">
        <header class="admin-topbar d-flex align-items-center">
            <div class="d-flex align-items-center flex-grow-1 min-w-0">
                <button class="layout-toggle-btn me-3"
                        type="button"
                        id="adminSidebarToggle"
                        aria-controls="adminSidebar"
                        aria-expanded="false"
                        title="Toggle menu">
                    <i class="bi bi-list"></i>
                </button>

                <partial name="_TopbarPageTitle" />
            </div>

            <div class="topbar-actions d-flex align-items-center">
                <div class="dropdown">
                    <button class="topbar-profile-trigger dropdown-toggle d-flex align-items-center gap-2"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            title="Admin profile">
                        <div class="profile-avatar d-flex align-items-center justify-content-center text-white fw-bold">@adminInitials</div>
                        <span class="profile-name">@adminDisplayName</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end admin-profile-menu shadow border-0">
                        <div class="admin-profile-menu-header">
                            <div class="admin-profile-menu-avatar" aria-hidden="true">@adminInitials.Substring(0, 1)</div>
                            <div class="admin-profile-menu-identity">
                                <span class="admin-profile-menu-name">@adminDisplayName</span>
                                <span class="admin-profile-menu-role">System Administrator</span>
                                <span class="admin-profile-menu-status">Online</span>
                            </div>
                        </div>

                        <div class="admin-profile-menu-divider" role="separator"></div>

                        <a class="admin-profile-menu-item" asp-controller="Admins" asp-action="Index">
                            <i class="bi bi-gear admin-profile-menu-icon" aria-hidden="true"></i>
                            <span class="admin-profile-menu-copy">
                                <span class="admin-profile-menu-item-title">Account Settings</span>
                                <span class="admin-profile-menu-item-sub">Password, preferences, security</span>
                            </span>
                            <i class="bi bi-chevron-right admin-profile-menu-chevron" aria-hidden="true"></i>
                        </a>

                        <div class="admin-profile-menu-divider" role="separator"></div>

                        <a class="admin-profile-menu-item" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-clock-history admin-profile-menu-icon" aria-hidden="true"></i>
                            <span class="admin-profile-menu-copy">
                                <span class="admin-profile-menu-item-title">System Activity</span>
                                <span class="admin-profile-menu-item-sub">View login and system logs</span>
                            </span>
                            <i class="bi bi-chevron-right admin-profile-menu-chevron" aria-hidden="true"></i>
                        </a>

                        <div class="admin-profile-menu-divider" role="separator"></div>

                        <a class="admin-profile-menu-item is-logout" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right admin-profile-menu-icon" aria-hidden="true"></i>
                            <span class="admin-profile-menu-copy">
                                <span class="admin-profile-menu-item-title">Log Out</span>
                                <span class="admin-profile-menu-item-sub">Sign out from your account</span>
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <div class="admin-main-wrapper">
            <main>
                <div class="container-fluid px-0">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var body = document.body;
            var toggle = document.getElementById('adminSidebarToggle');
            var storageKey = 'easyrent-admin-sidebar-expanded';

            function setExpanded(expanded) {
                body.classList.toggle('admin-sidebar-expanded', expanded);
                if (toggle) toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                try { localStorage.setItem(storageKey, expanded ? '1' : '0'); } catch (e) { }
            }

            var saved = null;
            try { saved = localStorage.getItem(storageKey); } catch (e) { }
            setExpanded(saved === '1');

            if (toggle) {
                toggle.addEventListener('click', function () {
                    setExpanded(!body.classList.contains('admin-sidebar-expanded'));
                });
            }

            // When collapsed, opening a parent group expands the sidebar first.
            document.querySelectorAll('.admin-nav-group .nav-link-admin-parent').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    if (!body.classList.contains('admin-sidebar-expanded')) {
                        setExpanded(true);
                    }
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
