@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyRent</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header class="admin-topbar d-flex align-items-center">
        <div class="d-flex align-items-center flex-grow-1 min-w-0">
            <button class="layout-toggle-btn me-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebarFlyout" aria-controls="adminSidebarFlyout">
                <i class="bi bi-list"></i>
            </button>
            <div class="d-flex align-items-center gap-2 topbar-brand-cluster">
                <div class="brand-logo-circle">L</div>
                <div>
                    <h4 class="fw-bold text-dark brand-text">EasyRent</h4>
                    <small class="text-muted d-block brand-subtext">Vehicle Rental System</small>
                </div>
            </div>

            <partial name="_TopbarPageTitle" />
        </div>

        <div class="topbar-actions d-flex align-items-center">
            <a asp-controller="Admins" asp-action="Index" class="topbar-profile-link d-flex align-items-center gap-2 text-decoration-none text-dark" title="Admin profile">
                <div class="profile-avatar d-flex align-items-center justify-content-center text-white fw-bold">AD</div>
                <span class="profile-name">Admin</span>
            </a>
        </div>
    </header>

    <div class="offcanvas offcanvas-start admin-sidebar-flyout" tabindex="-1" id="adminSidebarFlyout" aria-labelledby="adminSidebarFlyoutLabel">
        <div class="offcanvas-header">
            <div class="d-flex align-items-center gap-2">
                <div class="brand-logo-circle">L</div>
                <div>
                    <h4 class="fw-bold text-dark brand-text">EasyRent</h4>
                    <small class="text-muted d-block brand-subtext">Vehicle Rental System</small>
                </div>
            </div>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body d-flex flex-column justify-content-between px-0 py-3">
            @{
                var activePage = ViewData["ActivePage"]?.ToString();
                var isBookingSection = activePage is "Reservations" or "Payments" or "Transit";
                var isUserSection = activePage is "Customers" or "Admins";
            }
            <div class="pe-0">
                <a asp-controller="Admin" asp-action="Dashboard" class="nav-link-admin @(activePage == "Dashboard" ? "active" : "")">
                    <div class="mock-icon-square"></div>
                    Dashboard
                </a>
                <a asp-controller="Drivers" asp-action="Index" class="nav-link-admin @(activePage == "Drivers" ? "active" : "")">
                    <div class="mock-icon-square"></div>
                    Driver
                </a>
                <a asp-controller="Vehicles" asp-action="Index" class="nav-link-admin @(activePage == "Vehicles" ? "active" : "")">
                    <div class="mock-icon-square"></div>
                    Vehicle
                </a>

                <div class="admin-nav-group">
                    <button type="button"
                            class="nav-link-admin nav-link-admin-parent @(isBookingSection ? "active" : "")"
                            data-bs-toggle="collapse"
                            data-bs-target="#bookingNavGroup"
                            aria-expanded="@(isBookingSection ? "true" : "false")"
                            aria-controls="bookingNavGroup">
                        <div class="mock-icon-square"></div>
                        <span>Booking</span>
                        <i class="bi bi-chevron-down admin-nav-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="collapse @(isBookingSection ? "show" : "")" id="bookingNavGroup">
                        <a asp-controller="Reservations" asp-action="Index" class="nav-link-admin nav-link-admin-sub @(activePage == "Reservations" ? "active" : "")">
                            Bookings
                        </a>
                        <a asp-controller="Payments" asp-action="Index" class="nav-link-admin nav-link-admin-sub @(activePage == "Payments" ? "active" : "")">
                            Payment
                        </a>
                        <a asp-controller="Transits" asp-action="Index" class="nav-link-admin nav-link-admin-sub @(activePage == "Transit" ? "active" : "")">
                            Transit
                        </a>
                    </div>
                </div>

                <div class="admin-nav-group">
                    <button type="button"
                            class="nav-link-admin nav-link-admin-parent @(isUserSection ? "active" : "")"
                            data-bs-toggle="collapse"
                            data-bs-target="#userNavGroup"
                            aria-expanded="@(isUserSection ? "true" : "false")"
                            aria-controls="userNavGroup">
                        <div class="mock-icon-square"></div>
                        <span>User</span>
                        <i class="bi bi-chevron-down admin-nav-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="collapse @(isUserSection ? "show" : "")" id="userNavGroup">
                        <a asp-controller="Customers" asp-action="Index" class="nav-link-admin nav-link-admin-sub @(activePage == "Customers" ? "active" : "")">
                            Customer
                        </a>
                        <a asp-controller="Admins" asp-action="Index" class="nav-link-admin nav-link-admin-sub @(activePage == "Admins" ? "active" : "")">
                            Admin
                        </a>
                    </div>
                </div>
            </div>

            <div>
                <hr class="mx-3 my-3 text-muted opacity-25" />
                <div class="pe-0">
                    <a asp-controller="Account" asp-action="Logout" class="nav-link-admin client-side-link">
                        <div class="mock-icon-square"></div>
                        Log out
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-main-wrapper">
        <main>
            <div class="container-fluid px-0">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
