@model EasyRent_Checking.ViewModels.AdminStaffMemberViewModel
@using EasyRent_Checking.Models
@using System.Globalization

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = Model.IsStaff ? "Staff Details" : "Admin Details";
    ViewData["ActivePage"] = "Admins";

    var email = Model.User?.Email ?? "—";
    var createdAt = Model.CreatedAt == default ? Model.User?.CreatedAt : Model.CreatedAt;
    var memberLabel = Model.Id.ToString("D8");
    var currentAdminId = ViewData["CurrentAdminId"] as int?;
    var canDeleteAdmins = ViewData["CanDeleteAdmins"] as bool? ?? false;
    var isCurrent = currentAdminId.HasValue && Model.Id == currentAdminId.Value;
    var isStaff = Model.IsStaff;
    var roleLabel = isStaff ? "Staff" : "Admin";
    var isInactive = Model.IsSelfDeactivated;
    var safeName = (Model.FullName ?? (isStaff ? "this staff" : "this admin"))
        .Replace("\\", "\\\\")
        .Replace("'", "\\'");

    string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "AD";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            return parts[0].Length >= 2
                ? parts[0][..2].ToUpperInvariant()
                : parts[0].ToUpperInvariant();
        }
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
    }

    string FormatTimestamp(DateTime value) =>
        value.ToString("MMM. d, yyyy", CultureInfo.InvariantCulture)
        + " • "
        + value.ToString("h:mm tt", CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/rentals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/customer-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admins.css" asp-append-version="true" />
}

<div class="container-fluid px-4 py-3 reservation-details-page customer-details-page">
    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="reservation-details-id-card mb-3">
                <div class="reservation-details-id-main">
                    <span class="reservation-view-id-label">@(isStaff ? "Staff ID" : "Admin ID")</span>
                    <h1 class="reservation-view-id mb-0">@memberLabel</h1>
                </div>
                <span class="booking-status-badge @(isInactive ? "booking-status-cancelled" : "booking-status-approved")">
                    <i class="bi @(isInactive ? "bi-pause-circle" : "bi-shield-lock")"></i>@(isInactive ? "Inactive" : roleLabel)
                </span>
            </div>

            <div class="reservation-view-card mb-4">
                <div class="customer-details-personal">
                    <div class="customer-details-avatar is-initials" aria-hidden="true">
                        @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                        {
                            <img src="~/images/@Model.ProfileImagePath" alt="" />
                        }
                        else
                        {
                            @GetInitials(Model.FullName)
                        }
                    </div>
                    <div class="customer-details-personal-grid">
                        <div>
                            <span class="reservation-view-label">Full Name</span>
                            <span class="reservation-view-value">@Model.FullName</span>
                        </div>
                        <div>
                            <span class="reservation-view-label">Email Address</span>
                            <span class="reservation-view-value">@email</span>
                        </div>
                        <div>
                            <span class="reservation-view-label">Contact Number</span>
                            <span class="reservation-view-value">@(string.IsNullOrWhiteSpace(Model.ContactNumber) ? "—" : Model.ContactNumber)</span>
                        </div>
                        <div>
                            <span class="reservation-view-label">Address</span>
                            <span class="reservation-view-value">@(string.IsNullOrWhiteSpace(Model.Address) ? "—" : Model.Address)</span>
                        </div>
                        <div>
                            <span class="reservation-view-label">Role</span>
                            <span class="reservation-view-value">@roleLabel</span>
                        </div>
                        <div>
                            <span class="reservation-view-label">Member since</span>
                            <span class="reservation-view-value">@AdminDates.Format(createdAt)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="details-page-actions reservation-details-side-actions mb-3">
                <a asp-action="Index" class="btn btn-page-back">Back</a>
                @if (!isCurrent)
                {
                    <a asp-action="Edit" asp-route-adminid="@Model.Id" class="btn btn-reservation-edit">Edit @(isStaff ? "Staff" : "Admin") Details</a>
                }
            </div>

            <div class="reservation-view-side-card mb-4">
                <h6 class="reservation-view-side-title">
                    <i class="bi bi-calendar3 me-2"></i>Account Activity
                </h6>
                <div class="customer-activity-timeline">
                    <div class="customer-activity-item">
                        <span class="customer-activity-dot"></span>
                        <div>
                            <strong>
                                @(createdAt.HasValue ? FormatTimestamp(createdAt.Value) : "—")
                            </strong>
                            <span>@(roleLabel) account created</span>
                        </div>
                    </div>
                </div>

                @if (isStaff && !isCurrent)
                {
                    @if (!isInactive)
                    {
                        <form asp-action="ToggleStaffActive" asp-route-staffid="@Model.Id" method="post" class="mb-2"
                              data-confirm="Deactivate this staff account?"
                              data-confirm-text="They will not be able to sign in until an admin reactivates the account."
                              data-confirm-button="Deactivate Staff"
                              data-confirm-tone="danger"
                              data-confirm-icon="bi-slash-circle"
                              data-confirm-submit-icon="bi-slash-circle">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn reservation-btn-reject w-100">Deactivate Staff</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="ToggleStaffActive" asp-route-staffid="@Model.Id" method="post" class="mb-2"
                              data-confirm="Reactivate this staff account?"
                              data-confirm-text="They will be able to sign in to the admin area again."
                              data-confirm-button="Reactivate Staff"
                              data-confirm-tone="approve">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn reservation-btn-approve w-100">Reactivate Staff</button>
                        </form>
                    }
                }

                @if (canDeleteAdmins && !isCurrent && !isStaff)
                {
                    <button type="button" class="btn reservation-btn-reject w-100" onclick="openDeletePopup('@Model.Id', '@safeName')">
                        Delete Admin
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@{
    ViewData["DeleteModalId"] = "adminDeletePopup";
    ViewData["DeleteHiddenInputId"] = "popupAdminId";
    ViewData["DeleteHiddenInputName"] = "adminid";
    ViewData["DeleteMessageId"] = "deletePopupMessage";
    ViewData["DeleteEntityLabel"] = "admin";
}
<partial name="_DeleteConfirmModal" />
