@model EasyRent_Checking.ViewModels.MaintenanceSetupViewModel

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Set Up Maintenance";
    ViewData["ActivePage"] = "Maintenance";
    ViewData["ShowInclude"] = true;

    var schedule = Model.Schedule;
    var vehiclePicker = new VehicleSelectionPickerViewModel
    {
        Vehicles = Model.Vehicles,
        SelectedVehicleId = schedule.VehicleId,
        InputName = "Schedule.VehicleId",
        ValidationKey = "Schedule.VehicleId",
        EmptyMessage = "No vehicles without a maintenance schedule are available.",
        TabEmptyMessage = "No vehicles match your search."
    };
}

<div class="pms-setup-page incident-record-page">
    <div class="pms-setup-heading">
        <h1>Set Up Maintenance</h1>
        <p>Choose a vehicle and configure its maintenance intervals. The vehicle will appear on the due list only after this is saved.</p>
    </div>

    <form asp-action="Setup" method="post" id="pmsSetupForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="pms-setup-card">
            <div class="incident-record-card incident-vehicle-card pms-setup-vehicle-card mb-0">
                <partial name="_VehicleSelectionPicker" model="vehiclePicker" />
            </div>
        </div>

        <div class="pms-setup-card">
            <h2 class="pms-setup-card-title">Maintenance Items</h2>
            <partial name="_PmsScheduleTable" for="Schedule.Rows" />
        </div>

        <div class="pms-setup-footer">
            <div class="pms-setup-note">
                <i class="bi bi-info-circle-fill"></i>
                <p><strong>Note:</strong> The maintenance schedule will be used to generate due items based on the PMS interval. You can edit this setup anytime.</p>
            </div>
            <div class="pms-setup-actions">
                <a asp-action="Index" class="btn pms-setup-btn-cancel">Cancel</a>
                <button type="submit" class="btn pms-setup-btn-save">Save Maintenance</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/vehicle-selection-picker.js" asp-append-version="true"></script>
    <script>
        if (window.initVehicleSelectionPicker) {
            window.initVehicleSelectionPicker();
        }
    </script>
}
