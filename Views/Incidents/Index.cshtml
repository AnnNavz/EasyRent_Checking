@model IEnumerable<EasyRent_Checking.Models.IncidentReport>

@using System.ComponentModel.DataAnnotations

@using System.Globalization

@using System.Reflection

@using EasyRent_Checking.Models



@{

    Layout = "_LayoutAdminDashboard";

    ViewData["Title"] = "Incident Reports";

    ViewData["ActivePage"] = "Incidents";



    var underReviewChange = ViewData["UnderReviewChange"] as decimal? ?? 0m;

    var inRepairChange = ViewData["InRepairChange"] as decimal? ?? 0m;

    var closedChange = ViewData["ClosedChange"] as decimal? ?? 0m;



    string FormatTrend(decimal change) =>

        Math.Abs(change).ToString("0.0", CultureInfo.InvariantCulture) + "%";



    string EnumLabel(Enum value)

    {

        var member = value.GetType().GetMember(value.ToString()).FirstOrDefault();

        var display = member?.GetCustomAttribute<DisplayAttribute>()?.GetName();

        return display ?? value.ToString();

    }



    string StatusClass(IncidentStatus status) => status switch

    {

        IncidentStatus.UnderReview => "incident-status-badge is-under-review",

        IncidentStatus.InRepair => "incident-status-badge is-in-repair",

        IncidentStatus.Closed => "incident-status-badge is-closed",

        IncidentStatus.Reported => "incident-status-badge is-reported",

        IncidentStatus.Dismissed => "incident-status-badge is-dismissed",

        _ => "incident-status-badge is-reported"

    };



    string currentSortName = ViewData["CurrentSort"]?.ToString() switch

    {

        "Vehicle" => "Vehicle",

        "Severity" => "Severity",

        "Status" => "Status",

        _ => "Sorting by"

    };



    string currentFilterName = ViewData["CurrentFilter"]?.ToString() switch

    {

        "Reported" => "Reported",

        "UnderReview" => "Under Review",

        "InRepair" => "In Repair",

        "Closed" => "Closed",

        "Dismissed" => "Dismissed",

        _ => "Filters"

    };

}



<div class="incidents-index-page">

    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="incident-metric-card">

                <div class="incident-metric-icon is-gold" aria-hidden="true">

                    <i class="bi bi-clipboard2-check"></i>

                </div>

                <div class="incident-metric-body">

                    <span class="incident-metric-label">Under Review</span>

                    <div class="incident-metric-value">@(ViewData["UnderReviewCount"] ?? "0")</div>

                </div>

                <div class="incident-metric-trend">

                    <span class="incident-metric-badge @(underReviewChange >= 0 ? "is-up" : "is-down")">

                        <i class="bi @(underReviewChange >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>

                        @FormatTrend(underReviewChange)

                    </span>

                    <span class="incident-metric-compare">vs last month</span>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="incident-metric-card">

                <div class="incident-metric-icon is-orange" aria-hidden="true">

                    <i class="bi bi-tools"></i>

                </div>

                <div class="incident-metric-body">

                    <span class="incident-metric-label">In Repair</span>

                    <div class="incident-metric-value">@(ViewData["InRepairCount"] ?? "0")</div>

                </div>

                <div class="incident-metric-trend">

                    <span class="incident-metric-badge @(inRepairChange >= 0 ? "is-up" : "is-down")">

                        <i class="bi @(inRepairChange >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>

                        @FormatTrend(inRepairChange)

                    </span>

                    <span class="incident-metric-compare">vs last month</span>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="incident-metric-card">

                <div class="incident-metric-icon is-success" aria-hidden="true">

                    <i class="bi bi-check-circle-fill"></i>

                </div>

                <div class="incident-metric-body">

                    <span class="incident-metric-label">Closed</span>

                    <div class="incident-metric-value">@(ViewData["ClosedCount"] ?? "0")</div>

                </div>

                <div class="incident-metric-trend">

                    <span class="incident-metric-badge @(closedChange >= 0 ? "is-up" : "is-down")">

                        <i class="bi @(closedChange >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>

                        @FormatTrend(closedChange)

                    </span>

                    <span class="incident-metric-compare">vs last month</span>

                </div>

            </div>

        </div>

    </div>



    <form asp-action="Index" method="get" class="w-100">

        <input type="hidden" name="sortBy" value="@ViewData["CurrentSort"]" />

        <input type="hidden" name="currentFilter" value="@ViewData["CurrentFilter"]" />



        <div class="admin-index-toolbar mb-4">

            <div class="admin-index-toolbar-filters">

                <div class="dropdown">

                    <button class="btn btn-filter dropdown-toggle text-capitalize" type="button" data-bs-toggle="dropdown">

                        @currentSortName

                    </button>

                    <ul class="dropdown-menu">

                        <li><a class="dropdown-item" href="?sortBy=Vehicle&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Vehicle</a></li>

                        <li><a class="dropdown-item" href="?sortBy=Severity&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Severity</a></li>

                        <li><a class="dropdown-item" href="?sortBy=Status&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Status</a></li>

                        <li><hr class="dropdown-menu-divider"></li>

                        <li><a class="dropdown-item text-muted small" href="?sortBy=&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Clear Sorting</a></li>

                    </ul>

                </div>



                <div class="dropdown">

                    <button class="btn btn-filter dropdown-toggle text-capitalize" type="button" data-bs-toggle="dropdown">

                        @currentFilterName

                    </button>

                    <ul class="dropdown-menu">

                        <li><a class="dropdown-item" href="?currentFilter=Reported&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Reported</a></li>

                        <li><a class="dropdown-item" href="?currentFilter=UnderReview&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Under Review</a></li>

                        <li><a class="dropdown-item" href="?currentFilter=InRepair&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">In Repair</a></li>

                        <li><a class="dropdown-item" href="?currentFilter=Closed&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Closed</a></li>

                        <li><a class="dropdown-item" href="?currentFilter=Dismissed&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Dismissed</a></li>

                        <li><hr class="dropdown-menu-divider"></li>

                        <li><a class="dropdown-item text-muted small" href="?currentFilter=&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Clear Filters</a></li>

                    </ul>

                </div>

            </div>



            <div class="admin-index-toolbar-search">

                <i class="bi bi-search admin-index-search-icon" aria-hidden="true"></i>

                <input type="text"

                       name="searchString"

                       value="@ViewData["CurrentSearch"]"

                       class="form-control admin-index-search-input"

                       placeholder="Search Incidents" />

                @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()))

                {

                    <a href="?searchString=&sortBy=@ViewData["CurrentSort"]&currentFilter=@ViewData["CurrentFilter"]"

                       class="admin-index-search-clear"

                       aria-label="Clear search">&times;</a>

                }

            </div>



            <a asp-action="Create" class="btn incident-index-add-btn">

                <i class="bi bi-plus-lg"></i> Report Incident

            </a>

        </div>

    </form>



    <div class="index-table-panel mb-4">

        <div class="table-responsive">

            <table class="table admin-table mb-0 align-middle">

                <thead>

                    <tr>

                        <th>Report</th>

                        <th>Vehicle</th>

                        <th>Type</th>

                        <th>Severity</th>

                        <th>Occurred</th>

                        <th>Status</th>

                        <th class="text-end" style="width: 72px;">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())

                    {

                        foreach (var item in Model)

                        {

                            var vehicleName = item.Vehicle != null

                                ? $"{item.Vehicle.Brand} {item.Vehicle.Model}".Trim()

                                : "—";

                            <tr>

                                <td class="fw-semibold text-dark font-monospace">@IncidentReport.FormatReference(item.IncidentReportId)</td>

                                <td>

                                    <div class="fw-semibold text-dark">@(item.Vehicle?.PlateNumber ?? "—")</div>

                                    <div class="small text-muted">@vehicleName</div>

                                </td>

                                <td>@EnumLabel(item.Type)</td>

                                <td>@EnumLabel(item.Severity)</td>

                                <td>@AdminDates.Format(item.OccurredAt, includeTime: true)</td>

                                <td>

                                    <span class="@StatusClass(item.Status)">@EnumLabel(item.Status)</span>

                                </td>

                                <td class="text-end">

                                    <div class="dropdown">

                                        <button class="admin-row-action" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed","placement":"bottom-end"}' data-bs-boundary="viewport" aria-label="Incident actions">

                                            <i class="bi bi-three-dots"></i>

                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                                            <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.IncidentReportId"><i class="bi bi-info-circle me-2"></i> Details</a></li>

                                        </ul>

                                    </div>

                                </td>

                            </tr>

                        }

                    }

                    else

                    {

                        <tr>

                            <td colspan="7" class="text-center py-5 text-muted fw-medium">

                                <i class="bi bi-exclamation-triangle fs-2 d-block mb-2 text-secondary opacity-50"></i>

                                No incident reports yet.

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

        <partial name="_AdminPagination" />

    </div>

</div>


