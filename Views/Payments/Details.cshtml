@model EasyRent_Checking.Models.Payment
@using EasyRent_Checking.Models
@using System.Globalization

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "View Details";
    ViewData["ActivePage"] = "Payments";
    ViewData["SectionTitle"] = "Payment Management";
    ViewData["SectionUrl"] = Url.Action("Index", "Payments");

    var reservation = Model?.Reservation;
    var bookingId = $"BK-{(Model?.ReservationId ?? 0):D5}";
    var isPending = Model?.PaymentStatus == PaymentStatus.Pending;
    var isApproved = Model?.PaymentStatus == PaymentStatus.Approved;
    var isRejected = Model?.PaymentStatus == PaymentStatus.Rejected;

    var basePrice = ViewData["BasePrice"] as decimal? ?? 0m;
    var succeedingHours = ViewData["SucceedingHours"] as int? ?? 0;
    var succeedingAmount = ViewData["SucceedingAmount"] as decimal? ?? 0m;
    var hasSeniorDiscount = ViewData["HasSeniorDiscount"] as bool? ?? false;
    var discountAmount = ViewData["DiscountAmount"] as decimal? ?? 0m;
    var fareTotal = ViewData["FareTotal"] as decimal? ?? Model?.TotalAmount ?? 0m;
    var discountImagePath = ViewData["DiscountImagePath"] as string;

    var statusLabel = Model?.PaymentStatus switch
    {
        PaymentStatus.Approved => "Approved",
        PaymentStatus.Rejected => "Cancelled",
        _ => "Pending"
    };

    string StatusBadgeClass(PaymentStatus status) => status switch
    {
        PaymentStatus.Approved => "booking-status-approved",
        PaymentStatus.Rejected => "booking-status-cancelled",
        _ => "booking-status-pending"
    };

    string StatusIcon(PaymentStatus status) => status switch
    {
        PaymentStatus.Approved => "bi-check-circle",
        PaymentStatus.Rejected => "bi-x-circle",
        _ => "bi-clock"
    };

    string FormatPeso(decimal amount) =>
        "₱" + amount.ToString("N2", CultureInfo.GetCultureInfo("en-PH"));

    string FormatTimestamp(DateTime value) =>
        value.ToString("MMM. d, yyyy", CultureInfo.InvariantCulture)
        + " • "
        + value.ToString("h:mm tt", CultureInfo.InvariantCulture);

    string MethodLabel(string? method) => method switch
    {
        "GCash" => "GCash QR Payment",
        "BDO" => "BDO Bank Transfer / QR",
        "Walk-in" => "Walk-in (Pay at Office)",
        _ => string.IsNullOrWhiteSpace(method) ? "—" : method
    };

    string? MethodLogo(string? method) => method switch
    {
        "GCash" => Url.Content("~/images/System Images/GcashImage.jpg"),
        "BDO" => Url.Content("~/images/System Images/BDOimage.png"),
        _ => null
    };
}

@section Styles {
    <style>
        .payment-details-page .details-page-actions {
            width: 100%;
            justify-content: flex-end;
        }

        .btn-payment-edit {
            background-color: #1E3A8A !important;
            color: #fff !important;
            border: none !important;
            border-radius: 8px !important;
            padding: 0.5rem 1.35rem;
            font-weight: 600;
            font-size: 0.9rem;
            text-decoration: none;
        }

        .btn-payment-edit:hover {
            background-color: #172e6e !important;
            color: #fff !important;
        }

        .payment-view-card,
        .payment-view-side-card {
            background: #e4e4e4;
            border: 1px solid #cfcfcf;
            border-radius: 12px;
            padding: 1.15rem 1.2rem 1.25rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        .payment-view-idbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            background: #cfcfcf;
            border-radius: 10px;
            padding: 0.85rem 1rem;
            margin-bottom: 1.1rem;
        }

        .payment-view-id-label {
            display: block;
            font-size: 0.72rem;
            font-weight: 600;
            color: #555;
        }

        .payment-view-id {
            margin: 0.1rem 0 0;
            font-size: 1.55rem;
            font-weight: 800;
            color: #111;
            letter-spacing: -0.02em;
            line-height: 1.1;
        }

        .payment-line {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            font-size: 0.9rem;
            color: #333;
            padding: 0.35rem 0;
        }

        .payment-line strong {
            font-weight: 700;
            color: #111;
            white-space: nowrap;
        }

        .payment-line.is-discount strong {
            color: #1f6b4f;
        }

        .payment-total-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 1rem;
            margin-top: 0.75rem;
            padding-top: 0.75rem;
            border-top: 1px solid #bdbdbd;
            font-size: 1rem;
            font-weight: 800;
            color: #111;
        }

        .payment-method-box {
            margin-top: 1rem;
            background: #d5d5d5;
            border-radius: 10px;
            padding: 0.9rem 1rem;
        }

        .payment-method-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            margin-bottom: 0.65rem;
        }

        .payment-method-name {
            font-size: 0.92rem;
            font-weight: 800;
            color: #111;
        }

        .payment-method-logo-sm {
            height: 28px;
            width: auto;
            object-fit: contain;
        }

        .payment-method-meta {
            font-size: 0.84rem;
            color: #333;
            margin-bottom: 0.25rem;
        }

        .payment-method-meta strong {
            font-weight: 700;
        }

        .payment-section-title {
            font-size: 0.95rem;
            font-weight: 800;
            color: #222;
            margin-bottom: 0.85rem;
        }

        .payment-receipt-frame,
        .payment-id-frame {
            width: 100%;
            min-height: 220px;
            background: #efefef;
            border: 1px solid #aaa;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        .payment-id-frame {
            min-height: 160px;
            max-width: 280px;
        }

        .payment-receipt-frame img,
        .payment-id-frame img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: #fff;
        }

        .payment-placeholder-x {
            width: 100%;
            height: 100%;
            min-height: 220px;
        }

        .payment-placeholder-x svg {
            width: 100%;
            height: 100%;
            stroke: #777;
            stroke-width: 1;
        }

        .payment-id-frame .payment-placeholder-x {
            min-height: 160px;
        }

        .payment-verify-hint {
            margin-top: 0.75rem;
            background: #ececec;
            border-radius: 8px;
            padding: 0.65rem 0.8rem;
            font-size: 0.8rem;
            color: #555;
            display: flex;
            gap: 0.45rem;
            align-items: flex-start;
        }

        .payment-view-side-title {
            font-size: 0.95rem;
            font-weight: 800;
            color: #222;
            margin-bottom: 0.85rem;
        }

        .payment-audit-item {
            font-size: 0.82rem;
            font-weight: 600;
            color: #444;
            margin-bottom: 0.45rem;
        }

        .payment-audit-item span {
            color: #777;
            font-weight: 500;
        }

        .payment-btn-approve {
            background: #2e9b4f !important;
            color: #fff !important;
            border: none !important;
            border-radius: 8px !important;
            font-weight: 700;
            padding: 0.7rem 1rem;
            box-shadow: 0 2px 6px rgba(46, 155, 79, 0.3);
        }

        .payment-btn-approve:hover {
            background: #258a44 !important;
            color: #fff !important;
        }

        .payment-btn-reject {
            background: #b33b3b !important;
            color: #fff !important;
            border: none !important;
            border-radius: 8px !important;
            font-weight: 700;
            padding: 0.7rem 1rem;
            box-shadow: 0 2px 6px rgba(179, 59, 59, 0.28);
        }

        .payment-btn-reject:hover {
            background: #9c3232 !important;
            color: #fff !important;
        }
    </style>
}

<div class="container-fluid px-4 py-3 payment-details-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 px-3 mb-3" role="alert">@TempData["SuccessMessage"]</div>
    }

    <div class="details-page-actions mb-3">
        <a asp-action="Index" class="btn btn-page-back">Back</a>
        <a asp-action="Edit" asp-route-paymentid="@Model?.PaymentId" class="btn btn-payment-edit">Edit Payment</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="payment-view-card mb-4">
                <div class="payment-view-idbar">
                    <div>
                        <span class="payment-view-id-label">Booking ID</span>
                        <h1 class="payment-view-id">@bookingId</h1>
                    </div>
                    <span class="booking-status-badge @StatusBadgeClass(Model!.PaymentStatus)">
                        <i class="bi @StatusIcon(Model.PaymentStatus) me-1"></i>@statusLabel
                    </span>
                </div>

                <div class="payment-line">
                    <span>Payment Options</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.PaymentType) ? "—" : Model.PaymentType)</strong>
                </div>
                <div class="payment-line">
                    <span>Base Rental Rate</span>
                    <strong>@FormatPeso(basePrice)</strong>
                </div>
                @if (succeedingHours > 0)
                {
                    var hoursLabel = succeedingHours == 1 ? "hr" : "hrs";
                    <div class="payment-line">
                        <span>Extra Hours (@succeedingHours @hoursLabel)</span>
                        <strong>@FormatPeso(succeedingAmount)</strong>
                    </div>
                }
                @if (hasSeniorDiscount)
                {
                    <div class="payment-line is-discount">
                        <span>Senior Discount (10%)</span>
                        <strong>-@FormatPeso(discountAmount)</strong>
                    </div>
                }

                <div class="payment-total-row">
                    <span>Total to Verify</span>
                    <span>@FormatPeso(fareTotal > 0 ? fareTotal : Model.TotalAmount)</span>
                </div>

                <div class="payment-method-box">
                    <div class="payment-method-row">
                        <div class="payment-method-name">Payment Method: @MethodLabel(Model.PaymentMethod)</div>
                        @{
                            var logo = MethodLogo(Model.PaymentMethod);
                        }
                        @if (!string.IsNullOrEmpty(logo))
                        {
                            <img src="@logo" alt="@Model.PaymentMethod" class="payment-method-logo-sm" />
                        }
                    </div>
                    <div class="payment-method-meta"><strong>Account Name:</strong> @(string.IsNullOrWhiteSpace(Model.AccountName) ? "—" : Model.AccountName)</div>
                    <div class="payment-method-meta"><strong>Reference Number:</strong> @(string.IsNullOrWhiteSpace(Model.TransactionReference) ? "—" : Model.TransactionReference)</div>
                    <div class="payment-method-meta"><strong>Timestamp:</strong> @FormatTimestamp(Model.PaymentDate)</div>
                </div>
            </div>

            <div class="payment-view-card mb-4">
                <div class="payment-section-title">Receipt Verification</div>
                <div class="payment-receipt-frame">
                    @if (!string.IsNullOrWhiteSpace(Model.ReceiptImagePath))
                    {
                        <img src="@Url.Content("~/images/" + Model.ReceiptImagePath.Replace('\\', '/'))" alt="Payment receipt" />
                    }
                    else
                    {
                        <div class="payment-placeholder-x" aria-hidden="true">
                            <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                                <line x1="0" y1="0" x2="100" y2="100" />
                                <line x1="100" y1="0" x2="0" y2="100" />
                            </svg>
                        </div>
                    }
                </div>
                <div class="payment-verify-hint">
                    <i class="bi bi-info-circle mt-1"></i>
                    <span>Verify that the Reference Number matches the screenshot and the amount sent is exact.</span>
                </div>
            </div>

            @if (hasSeniorDiscount)
            {
                <div class="payment-view-card">
                    <div class="payment-section-title">Verification Documents</div>
                    <div class="mb-2 fw-semibold small text-secondary">Customer Valid ID (Senior Proof)</div>
                    <div class="payment-id-frame">
                        @if (!string.IsNullOrWhiteSpace(discountImagePath))
                        {
                            <img src="@Url.Content("~/images/" + discountImagePath.Replace('\\', '/'))" alt="Customer valid ID" />
                        }
                        else
                        {
                            <div class="payment-placeholder-x" aria-hidden="true">
                                <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                                    <line x1="0" y1="0" x2="100" y2="100" />
                                    <line x1="100" y1="0" x2="0" y2="100" />
                                </svg>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="payment-view-side-card mb-4">
                <h6 class="payment-view-side-title">Internal Audit Log</h6>
                <div class="payment-audit-item">
                    Payment Created <span>@FormatTimestamp(Model.PaymentDate)</span>
                </div>
                <div class="payment-audit-item">
                    Payment Submitted <span>@FormatTimestamp(Model.PaymentDate)</span>
                </div>
                @if (isApproved)
                {
                    <div class="payment-audit-item">Payment Approved</div>
                }
                @if (isRejected)
                {
                    <div class="payment-audit-item">Payment Rejected</div>
                }

                @if (isPending)
                {
                    <form asp-action="Approve" asp-route-paymentid="@Model.PaymentId" method="post" class="mt-3 mb-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn payment-btn-approve w-100">Approve Reservation</button>
                    </form>
                    <form asp-action="Reject" asp-route-paymentid="@Model.PaymentId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn payment-btn-reject w-100" onclick="return confirm('Reject this payment?');">Reject Reservation</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
