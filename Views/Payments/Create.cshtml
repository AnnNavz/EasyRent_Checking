@model EasyRent_Checking.Models.Payment
@using EasyRent_Checking.Models
@using System.Globalization

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Create Payment";
    ViewData["ActivePage"] = "Payments";

    var totalFare = ViewData["TotalFare"] as decimal? ?? Model.TotalAmount;
    var depositPercent = ViewData["DepositPercent"] as decimal? ?? 5m;
    var depositAmount = Math.Round(totalFare * (depositPercent / 100m), 2);
    var remainingAmount = Math.Max(0, totalFare - depositAmount);
    var reservationLabel = ViewData["ReservationLabel"] as string ?? (Model.ReservationId > 0 ? $"BK-{Model.ReservationId:D5}" : "No reservation selected");
    var backUrl = Model.ReservationId > 0
        ? Url.Action("Details", "Reservations", new { id = Model.ReservationId })
        : Url.Action("Index", "Payments");

    string FormatPeso(decimal amount) =>
        "₱" + amount.ToString("N2", CultureInfo.GetCultureInfo("en-PH"));
}

@section Styles {
    <style>
        .payment-create-wizard {
            max-width: 920px;
            margin: 0 auto;
        }

        .payment-create-wizard .step-timeline {
            max-width: 640px;
        }

        .payment-create-wizard .step-node {
            background: #f4f4f4;
        }

        .payment-type-title {
            font-size: 1.55rem;
            font-weight: 800;
            color: #111;
            letter-spacing: -0.03em;
            margin-bottom: 0.35rem;
        }

        .payment-type-subtitle {
            color: #6b6b6b;
            font-size: 0.92rem;
            margin-bottom: 1.35rem;
        }

        .payment-option-card {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            width: 100%;
            text-align: left;
            background: #e8e8e8;
            border: 2px solid transparent;
            border-radius: 14px;
            padding: 1.15rem 1.2rem;
            cursor: pointer;
            transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
        }

        .payment-option-card:hover {
            background: #e2e2e2;
        }

        .payment-option-card.is-selected {
            border-color: #1E3A8A;
            background: #e4e8f3;
            box-shadow: 0 2px 10px rgba(30, 58, 138, 0.12);
        }

        .payment-option-icon {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: #1f1f1f;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 1.15rem;
        }

        .payment-option-body {
            flex: 1;
            min-width: 0;
        }

        .payment-option-title {
            font-size: 1.05rem;
            font-weight: 800;
            color: #111;
            margin-bottom: 0.2rem;
        }

        .payment-option-desc {
            font-size: 0.86rem;
            color: #555;
            margin-bottom: 0.55rem;
        }

        .payment-option-amount {
            font-size: 0.95rem;
            font-weight: 800;
            color: #111;
        }

        .payment-option-amount span {
            font-weight: 600;
            color: #444;
        }

        .payment-option-note {
            font-size: 0.82rem;
            color: #666;
            margin-top: 0.2rem;
        }

        .payment-option-radio {
            width: 22px;
            height: 22px;
            border: 2px solid #9a9a9a;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 0.15rem;
            background: #fff;
        }

        .payment-option-card.is-selected .payment-option-radio {
            border-color: #1E3A8A;
        }

        .payment-option-card.is-selected .payment-option-radio::after {
            content: "";
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #1E3A8A;
        }

        .payment-method-panel {
            background: #dcdcdc;
            border-radius: 14px;
            padding: 1.1rem 1.15rem 1.25rem;
            margin-top: 1.35rem;
        }

        .payment-method-title {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            font-size: 1rem;
            font-weight: 800;
            color: #111;
            margin-bottom: 0.95rem;
        }

        .payment-method-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.85rem;
        }

        .payment-method-card {
            background: #efefef;
            border: 2px solid transparent;
            border-radius: 12px;
            padding: 0.95rem 0.85rem 0.85rem;
            cursor: default;
            text-align: left;
            min-height: 100%;
            pointer-events: none;
        }

        .payment-method-logo {
            width: 52px;
            height: 34px;
            object-fit: contain;
            margin-bottom: 0.55rem;
            display: block;
        }

        .payment-method-logo-fallback {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: #222;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            margin-bottom: 0.55rem;
        }

        .payment-method-name {
            font-size: 0.98rem;
            font-weight: 800;
            color: #111;
            margin-bottom: 0.1rem;
        }

        .payment-method-channel {
            font-size: 0.78rem;
            font-weight: 600;
            color: #666;
            margin-bottom: 0.45rem;
        }

        .payment-method-text {
            font-size: 0.78rem;
            color: #555;
            line-height: 1.35;
            margin-bottom: 0.55rem;
        }

        .payment-method-hint {
            font-size: 0.74rem;
            font-weight: 600;
            color: #777;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .payment-create-actions {
            display: flex;
            justify-content: flex-end;
            gap: 0.65rem;
            margin-top: 1.5rem;
            flex-wrap: wrap;
        }

        .btn-payment-proceed {
            background: #1E3A8A !important;
            color: #fff !important;
            border: none !important;
            border-radius: 8px !important;
            font-weight: 700;
            padding: 0.65rem 1.25rem;
        }

        .btn-payment-proceed:hover {
            background: #172e6e !important;
            color: #fff !important;
        }

        .payment-reservation-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: #ececec;
            border-radius: 999px;
            padding: 0.35rem 0.8rem;
            font-size: 0.8rem;
            font-weight: 600;
            color: #444;
            margin-bottom: 1rem;
        }

        .payment-step2-card {
            background: #e8e8e8;
            border-radius: 14px;
            padding: 1.25rem 1.3rem 1.4rem;
            margin-bottom: 1.15rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .payment-step2-heading {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            font-size: 1.02rem;
            font-weight: 800;
            color: #111;
            margin-bottom: 0.25rem;
        }

        .payment-step2-subtext {
            font-size: 0.86rem;
            color: #666;
            margin-bottom: 1rem;
        }

        .payment-channel-tabs {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .payment-channel-tab {
            background: #f3f3f3;
            border: 2px solid transparent;
            border-radius: 12px;
            padding: 0.85rem 0.75rem;
            text-align: left;
            cursor: pointer;
            transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
        }

        .payment-channel-tab:hover {
            background: #eee;
        }

        .payment-channel-tab.is-selected {
            border-color: #1E3A8A;
            background: #fff;
            box-shadow: 0 2px 8px rgba(30, 58, 138, 0.12);
        }

        .payment-channel-tab-logo {
            width: 48px;
            height: 30px;
            object-fit: contain;
            display: block;
            margin-bottom: 0.4rem;
        }

        .payment-channel-tab-icon {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: #222;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.4rem;
        }

        .payment-channel-tab-name {
            font-size: 0.95rem;
            font-weight: 800;
            color: #111;
        }

        .payment-channel-tab-meta {
            font-size: 0.76rem;
            font-weight: 600;
            color: #666;
        }

        .payment-channel-panel {
            border: 2px dashed #9a9a9a;
            border-radius: 12px;
            background: #f7f7f7;
            padding: 1.25rem 1rem;
            text-align: center;
        }

        .payment-channel-panel-title {
            font-size: 0.95rem;
            font-weight: 800;
            color: #222;
            margin-bottom: 0.85rem;
        }

        .payment-qr-box {
            width: 180px;
            height: 180px;
            margin: 0 auto 0.85rem;
            background: #fff;
            border: 1px solid #cfcfcf;
            border-radius: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
            color: #555;
        }

        .payment-qr-box i {
            font-size: 3.2rem;
            color: #333;
        }

        .payment-qr-box span {
            font-size: 0.78rem;
            font-weight: 600;
        }

        .payment-channel-details {
            max-width: 320px;
            margin: 0 auto;
            text-align: left;
            font-size: 0.86rem;
            color: #333;
        }

        .payment-channel-details div {
            margin-bottom: 0.2rem;
        }

        .payment-channel-details strong {
            font-weight: 700;
        }

        .payment-field-help {
            display: block;
            font-size: 0.74rem;
            color: #777;
            margin-top: 0.25rem;
        }

        .payment-upload-zone {
            position: relative;
            border: 1.5px dashed #8f8f8f;
            border-radius: 10px;
            background: #f3f3f3;
            min-height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            overflow: hidden;
        }

        .payment-upload-zone:hover {
            background: #ececec;
        }

        .payment-upload-empty {
            text-align: center;
            color: #666;
            font-size: 0.86rem;
            font-weight: 600;
            padding: 1rem;
        }

        .payment-upload-preview {
            width: 100%;
            min-height: 140px;
            display: none;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            padding: 0.85rem 1rem;
            position: relative;
        }

        .payment-upload-preview.is-visible {
            display: flex;
        }

        .payment-upload-preview img {
            width: 96px;
            height: 96px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #bbb;
            background: #ddd;
        }

        .payment-upload-filename {
            font-size: 0.88rem;
            font-weight: 700;
            color: #222;
            word-break: break-all;
        }

        .payment-upload-remove {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: none;
            background: #111;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .payment-reminders {
            background: #ececec;
            border-radius: 10px;
            padding: 0.95rem 1rem;
            margin-top: 1.1rem;
        }

        .payment-reminders-title {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.9rem;
            font-weight: 800;
            color: #222;
            margin-bottom: 0.55rem;
        }

        .payment-reminders ul {
            margin: 0;
            padding-left: 1.15rem;
            color: #555;
            font-size: 0.8rem;
            line-height: 1.45;
        }

        .payment-reminders li + li {
            margin-top: 0.25rem;
        }

        @@media (max-width: 767.98px) {
            .payment-method-grid,
            .payment-channel-tabs {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="wizard-max-wrapper payment-create-wizard admin-booking-create py-3">
    <div class="step-timeline admin-booking-stepper" id="paymentStepper">
        <div class="step-node active" data-step="1">
            <div class="step-circle">1</div>
            <div class="step-label">Payment Type</div>
        </div>
        <div class="step-node" data-step="2">
            <div class="step-circle">2</div>
            <div class="step-label">Payment Details</div>
        </div>
        <div class="step-node" data-step="3">
            <div class="step-circle">3</div>
            <div class="step-label">Summary</div>
        </div>
        <div class="step-node" data-step="4">
            <div class="step-circle">4</div>
            <div class="step-label">Complete</div>
        </div>
    </div>

    <form asp-action="Create" enctype="multipart/form-data" id="paymentWizardForm">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <input type="hidden" asp-for="ReservationId" id="input-ReservationId" />
        <input type="hidden" asp-for="PaymentType" id="input-PaymentType" />
        <input type="hidden" asp-for="PaymentMethod" id="input-PaymentMethod" />
        <input type="hidden" asp-for="TotalAmount" id="input-TotalAmount" value="@totalFare.ToString(CultureInfo.InvariantCulture)" />
        <input type="hidden" asp-for="PaymentStatus" value="@PaymentStatus.Approved" />

        <div class="wizard-step-panel active" id="paymentStep1"
             data-total-fare="@totalFare.ToString(CultureInfo.InvariantCulture)"
             data-deposit-percent="@depositPercent.ToString(CultureInfo.InvariantCulture)"
             data-deposit-amount="@depositAmount.ToString(CultureInfo.InvariantCulture)"
             data-remaining-amount="@remainingAmount.ToString(CultureInfo.InvariantCulture)">

            <div class="payment-reservation-chip">
                <i class="bi bi-bookmark-check"></i>
                <span>@reservationLabel</span>
            </div>

            <h1 class="payment-type-title">Type of Payment</h1>
            <p class="payment-type-subtitle">
                The staff has approved your request. Choose your preferred payment option to confirm your booking.
            </p>

            <div class="d-flex flex-column gap-3 mb-1">
                <button type="button" class="payment-option-card" data-payment-type="Partial Payment" id="optionPartial">
                    <div class="payment-option-icon"><i class="bi bi-percent"></i></div>
                    <div class="payment-option-body">
                        <div class="payment-option-title">Partial Payment</div>
                        <div class="payment-option-desc">Pay a deposit percentage to secure your slot.</div>
                        <div class="payment-option-amount">
                            @FormatPeso(depositAmount) <span>initial deposit (@depositPercent.ToString("0.##")%)</span>
                        </div>
                        <div class="payment-option-note">
                            Remaining @FormatPeso(remainingAmount) to be paid on-site to the driver.
                        </div>
                    </div>
                    <span class="payment-option-radio" aria-hidden="true"></span>
                </button>

                <button type="button" class="payment-option-card" data-payment-type="Full Payment" id="optionFull">
                    <div class="payment-option-icon"><i class="bi bi-coin"></i></div>
                    <div class="payment-option-body">
                        <div class="payment-option-title">Full Payment</div>
                        <div class="payment-option-desc">Pay 100% of base fare online or walk-in for a hassle-free trip.</div>
                        <div class="payment-option-amount">
                            @FormatPeso(totalFare) <span>total base fare</span>
                        </div>
                        <div class="payment-option-note">
                            Balance = ₱0.00 (Note: Exceeding hours are separate).
                        </div>
                    </div>
                    <span class="payment-option-radio" aria-hidden="true"></span>
                </button>
            </div>

            <div class="payment-method-panel">
                <div class="payment-method-title">
                    <i class="bi bi-credit-card-2-front"></i>
                    <span>Payment Method</span>
                </div>

                <div class="payment-method-grid">
                    <div class="payment-method-card">
                        <img src="~/images/System Images/GcashImage.jpg" alt="GCash" class="payment-method-logo" />
                        <div class="payment-method-name">GCash</div>
                        <div class="payment-method-channel">Mobile Wallet / QR</div>
                        <div class="payment-method-text">Scan our GCash QR and upload your receipt screenshot.</div>
                        <div class="payment-method-hint"><i class="bi bi-qr-code"></i> QR Code provided on next.</div>
                    </div>

                    <div class="payment-method-card">
                        <img src="~/images/System Images/BDOimage.png" alt="BDO" class="payment-method-logo" />
                        <div class="payment-method-name">BDO</div>
                        <div class="payment-method-channel">Bank Transfer / QR</div>
                        <div class="payment-method-text">Transfer via online banking or scan BDO QR, then upload proof.</div>
                        <div class="payment-method-hint"><i class="bi bi-qr-code"></i> QR Code provided on next.</div>
                    </div>

                    <div class="payment-method-card">
                        <div class="payment-method-logo-fallback"><i class="bi bi-shop"></i></div>
                        <div class="payment-method-name">Walk-in</div>
                        <div class="payment-method-channel">Pay at Office</div>
                        <div class="payment-method-text">Pay in person (cash/card) at the EasyRent office counter.</div>
                        <div class="payment-method-hint"><i class="bi bi-geo-alt"></i> Address shown on confirmation.</div>
                    </div>
                </div>
            </div>

            <div class="payment-create-actions">
                <a href="@backUrl" class="btn btn-page-back">Back</a>
                <button type="button" class="btn btn-payment-proceed" id="proceedPaymentBtn">
                    Proceed to Payment Confirmation
                </button>
            </div>
        </div>

        <div class="wizard-step-panel" id="paymentStep2">
            <div class="payment-step2-card">
                <div class="payment-step2-heading">
                    <i class="bi bi-credit-card-2-front"></i>
                    <span>Select Payment Channel</span>
                </div>
                <p class="payment-step2-subtext mb-0">Choose how you'd like to send your payment.</p>

                <div class="payment-channel-tabs mt-3">
                    <button type="button" class="payment-channel-tab" data-channel="GCash">
                        <img src="~/images/System Images/GcashImage.jpg" alt="GCash" class="payment-channel-tab-logo" />
                        <div class="payment-channel-tab-name">GCash</div>
                        <div class="payment-channel-tab-meta">Mobile Wallet / QR</div>
                    </button>
                    <button type="button" class="payment-channel-tab" data-channel="BDO">
                        <img src="~/images/System Images/BDOimage.png" alt="BDO" class="payment-channel-tab-logo" />
                        <div class="payment-channel-tab-name">BDO</div>
                        <div class="payment-channel-tab-meta">Bank Transfer / QR</div>
                    </button>
                    <button type="button" class="payment-channel-tab" data-channel="Walk-in">
                        <div class="payment-channel-tab-icon"><i class="bi bi-shop"></i></div>
                        <div class="payment-channel-tab-name">Walk-in</div>
                        <div class="payment-channel-tab-meta">Pay at Office</div>
                    </button>
                </div>

                <div class="payment-channel-panel" id="channelPanelGCash">
                    <div class="payment-channel-panel-title">GCash QR Code</div>
                    <div class="payment-qr-box">
                        <i class="bi bi-qr-code"></i>
                        <span>Scan with GCash app</span>
                    </div>
                    <div class="payment-channel-details">
                        <div><strong>GCash Name:</strong> TRUST RENT A CAR</div>
                        <div><strong>GCash Number:</strong> 09XX-XXX-XXXX</div>
                        <div><strong>Amount:</strong> <span class="js-pay-now-amount">@FormatPeso(totalFare)</span></div>
                    </div>
                </div>

                <div class="payment-channel-panel d-none" id="channelPanelBDO">
                    <div class="payment-channel-panel-title">BDO QR Code</div>
                    <div class="payment-qr-box">
                        <i class="bi bi-qr-code"></i>
                        <span>Scan with banking app</span>
                    </div>
                    <div class="payment-channel-details">
                        <div><strong>Account Name:</strong> TRUST RENT A CAR</div>
                        <div><strong>Account Number:</strong> XXXX-XXXX-XXXX</div>
                        <div><strong>Amount:</strong> <span class="js-pay-now-amount">@FormatPeso(totalFare)</span></div>
                    </div>
                </div>

                <div class="payment-channel-panel d-none" id="channelPanelWalkin">
                    <div class="payment-channel-panel-title">Pay at EasyRent Office</div>
                    <div class="payment-qr-box">
                        <i class="bi bi-geo-alt"></i>
                        <span>Bring exact amount if possible</span>
                    </div>
                    <div class="payment-channel-details">
                        <div><strong>Office:</strong> EasyRent Vehicle Rental</div>
                        <div><strong>Address:</strong> Cebu City, Philippines</div>
                        <div><strong>Amount Due:</strong> <span class="js-pay-now-amount">@FormatPeso(totalFare)</span></div>
                    </div>
                </div>
            </div>

            <div class="payment-step2-card">
                <div class="payment-step2-heading">
                    <i class="bi bi-file-earmark-check"></i>
                    <span>Submit Payment Details</span>
                </div>
                <p class="payment-step2-subtext" id="paymentDetailsSubtext">
                    After sending the payment, fill in the details below and submit for verification. Our team will confirm within 24 hours.
                </p>

                <div class="row g-3">
                    <div class="col-md-6 js-cashless-only">
                        <label asp-for="AccountName" class="form-label fw-bold small text-dark mb-1">Account Name (Sender)</label>
                        <input asp-for="AccountName" id="AccountName" class="form-control form-control-thin" placeholder="Your name on GCash / BDO" />
                        <span class="payment-field-help">Name associated with the account you used to send money.</span>
                        <span asp-validation-for="AccountName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 js-cashless-only">
                        <label asp-for="TransactionReference" class="form-label fw-bold small text-dark mb-1">Reference / Transaction Number</label>
                        <input asp-for="TransactionReference" id="TransactionReference" class="form-control form-control-thin" placeholder="e.g 123456789123" />
                        <span class="payment-field-help">Found in your GCash receipt or BDO transaction history.</span>
                        <span asp-validation-for="TransactionReference" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-dark mb-1" id="amountPaidLabel">Amount Sent (₱)</label>
                        <input asp-for="AmountPaid" id="input-AmountPaid" class="form-control form-control-thin" type="number" step="0.01" min="0" placeholder="0.00" />
                        <span class="payment-field-help" id="amountPaidHelp">Must match the total: <strong id="amountMatchLabel">@FormatPeso(totalFare)</strong></span>
                        <span asp-validation-for="AmountPaid" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PaymentDate" class="form-label fw-bold small text-dark mb-1">Date &amp; Time of Payment</label>
                        <input asp-for="PaymentDate" id="input-PaymentDate" class="form-control form-control-thin" type="datetime-local" />
                        <span class="payment-field-help" id="paymentDateHelp">When you completed the transfer or office payment.</span>
                        <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                    </div>
                    <div class="col-12 js-cashless-only">
                        <label class="form-label fw-bold small text-dark mb-1">Upload Payment Screenshot / Receipt</label>
                        <input asp-for="ReceiptImageFile" id="input-ReceiptFile" type="file" class="d-none" accept=".png,.jpg,.jpeg,image/*" />
                        <div class="payment-upload-zone" id="receiptUploadZone">
                            <div class="payment-upload-empty" id="receiptUploadEmpty">
                                <i class="bi bi-cloud-arrow-up fs-3 d-block mb-1"></i>
                                Click or drop receipt image here
                            </div>
                            <div class="payment-upload-preview" id="receiptUploadPreview">
                                <img id="receiptPreviewImg" alt="Receipt preview" />
                                <div class="payment-upload-filename" id="receiptFileName"></div>
                                <button type="button" class="payment-upload-remove" id="receiptRemoveBtn" aria-label="Remove receipt">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </div>
                        <span asp-validation-for="ReceiptImageFile" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="PaymentNotes" class="form-label fw-bold small text-dark mb-1">Additional Notes (Optional)</label>
                        <textarea asp-for="PaymentNotes" id="PaymentNotes" class="form-control form-control-thin" rows="3" placeholder="Additional notes about your payment"></textarea>
                        <span asp-validation-for="PaymentNotes" class="text-danger small"></span>
                    </div>
                </div>

                <div class="payment-reminders js-cashless-only">
                    <div class="payment-reminders-title">
                        <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                        <span>Important Reminders</span>
                    </div>
                    <ul>
                        <li>Send the exact amount shown: <strong id="reminderAmountLabel">@FormatPeso(totalFare)</strong></li>
                        <li>Use the correct QR code / account details for your selected channel.</li>
                        <li>Keep your receipt until the payment is verified.</li>
                        <li>Verification usually takes up to 24 hours during business days.</li>
                        <li>Your reservation is confirmed only after staff verifies this payment.</li>
                    </ul>
                </div>
            </div>

            <div class="payment-create-actions">
                <button type="button" class="btn btn-page-back" id="backToStep1Btn">Back</button>
                <button type="button" class="btn btn-payment-proceed" id="toSummaryBtn">Submit Payment</button>
            </div>
        </div>

        <div class="wizard-step-panel" id="paymentStep3">
            <div class="form-container-card p-4 mb-4 shadow-sm">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-clipboard-check fs-5 text-dark"></i>
                    <h6 class="wizard-section-title fw-bold mb-0 text-dark" style="font-size:0.95rem;">Payment Summary</h6>
                </div>
                <hr class="wizard-section-divider" />
                <div class="row g-3 small">
                    <div class="col-md-6"><span class="text-secondary">Reservation</span><div class="fw-bold" id="summaryReservation">@reservationLabel</div></div>
                    <div class="col-md-6"><span class="text-secondary">Payment Type</span><div class="fw-bold" id="summaryType">—</div></div>
                    <div class="col-md-6"><span class="text-secondary">Payment Method</span><div class="fw-bold" id="summaryMethod">—</div></div>
                    <div class="col-md-6"><span class="text-secondary">Total Fare</span><div class="fw-bold" id="summaryTotal">—</div></div>
                    <div class="col-md-6"><span class="text-secondary">Amount Paying Now</span><div class="fw-bold" id="summaryPaid">—</div></div>
                    <div class="col-md-6"><span class="text-secondary">Account Name</span><div class="fw-bold" id="summaryAccount">—</div></div>
                </div>
            </div>

            <div class="payment-create-actions">
                <button type="button" class="btn btn-page-back" id="backToStep2Btn">Back</button>
                <button type="submit" class="btn btn-payment-proceed">Confirm &amp; Submit Payment</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const step1 = document.getElementById('paymentStep1');
            const step2 = document.getElementById('paymentStep2');
            const step3 = document.getElementById('paymentStep3');
            const stepperNodes = document.querySelectorAll('#paymentStepper .step-node');
            const typeInput = document.getElementById('input-PaymentType');
            const methodInput = document.getElementById('input-PaymentMethod');
            const totalInput = document.getElementById('input-TotalAmount');
            const paidInput = document.getElementById('input-AmountPaid');
            const paymentDateInput = document.getElementById('input-PaymentDate');
            const optionCards = document.querySelectorAll('.payment-option-card');
            const channelTabs = document.querySelectorAll('.payment-channel-tab');
            const panelGCash = document.getElementById('channelPanelGCash');
            const panelBDO = document.getElementById('channelPanelBDO');
            const panelWalkin = document.getElementById('channelPanelWalkin');
            const receiptInput = document.getElementById('input-ReceiptFile');
            const uploadZone = document.getElementById('receiptUploadZone');
            const uploadEmpty = document.getElementById('receiptUploadEmpty');
            const uploadPreview = document.getElementById('receiptUploadPreview');
            const previewImg = document.getElementById('receiptPreviewImg');
            const fileNameLabel = document.getElementById('receiptFileName');
            const removeReceiptBtn = document.getElementById('receiptRemoveBtn');

            const totalFare = parseFloat(step1.dataset.totalFare || '0') || 0;
            const depositAmount = parseFloat(step1.dataset.depositAmount || '0') || 0;

            function formatPeso(amount) {
                return '₱' + Number(amount || 0).toLocaleString('en-PH', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            function toDateTimeLocalValue(date) {
                const pad = function (n) { return String(n).padStart(2, '0'); };
                return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate())
                    + 'T' + pad(date.getHours()) + ':' + pad(date.getMinutes());
            }

            function setStep(step) {
                [step1, step2, step3].forEach(function (panel, index) {
                    panel.classList.toggle('active', index + 1 === step);
                });
                stepperNodes.forEach(function (node) {
                    const nodeStep = parseInt(node.getAttribute('data-step'), 10);
                    node.classList.toggle('active', nodeStep === step);
                    node.classList.toggle('completed', nodeStep < step);
                });
            }

            function currentPayNowAmount() {
                return typeInput.value === 'Partial Payment' ? depositAmount : totalFare;
            }

            function syncAmountPaid() {
                const amount = currentPayNowAmount();
                paidInput.value = amount.toFixed(2);
                totalInput.value = totalFare.toFixed(2);
                document.querySelectorAll('.js-pay-now-amount').forEach(function (el) {
                    el.textContent = formatPeso(amount);
                });
                const matchLabel = document.getElementById('amountMatchLabel');
                const reminderLabel = document.getElementById('reminderAmountLabel');
                if (matchLabel) matchLabel.textContent = formatPeso(amount);
                if (reminderLabel) reminderLabel.textContent = formatPeso(amount);
            }

            function selectType(type) {
                typeInput.value = type;
                optionCards.forEach(function (card) {
                    card.classList.toggle('is-selected', card.getAttribute('data-payment-type') === type);
                });
                syncAmountPaid();
            }

            function showChannelPanel(method) {
                panelGCash.classList.toggle('d-none', method !== 'GCash');
                panelBDO.classList.toggle('d-none', method !== 'BDO');
                panelWalkin.classList.toggle('d-none', method !== 'Walk-in');
            }

            function syncWalkInForm(method) {
                const isWalkIn = method === 'Walk-in';
                document.querySelectorAll('.js-cashless-only').forEach(function (el) {
                    el.classList.toggle('d-none', isWalkIn);
                });

                const detailsSubtext = document.getElementById('paymentDetailsSubtext');
                const amountLabel = document.getElementById('amountPaidLabel');
                const amountHelp = document.getElementById('amountPaidHelp');
                const dateHelp = document.getElementById('paymentDateHelp');

                if (detailsSubtext) {
                    detailsSubtext.textContent = isWalkIn
                        ? 'Record the walk-in payment details below.'
                        : 'After sending the payment, fill in the details below and submit for verification. Our team will confirm within 24 hours.';
                }
                if (amountLabel) {
                    amountLabel.textContent = isWalkIn ? 'Amount Paid (₱)' : 'Amount Sent (₱)';
                }
                if (amountHelp) {
                    amountHelp.innerHTML = isWalkIn
                        ? 'Amount collected at the office: <strong id="amountMatchLabel">' + formatPeso(currentPayNowAmount()) + '</strong>'
                        : 'Must match the total: <strong id="amountMatchLabel">' + formatPeso(currentPayNowAmount()) + '</strong>';
                }
                if (dateHelp) {
                    dateHelp.textContent = isWalkIn
                        ? 'When the customer paid at the office.'
                        : 'When you completed the transfer or office payment.';
                }

                if (isWalkIn) {
                    document.getElementById('AccountName').value = '';
                    document.getElementById('TransactionReference').value = '';
                    clearReceipt();
                }
            }

            function selectMethod(method) {
                methodInput.value = method;
                channelTabs.forEach(function (tab) {
                    tab.classList.toggle('is-selected', tab.getAttribute('data-channel') === method);
                });
                showChannelPanel(method);
                syncWalkInForm(method);
            }

            function clearReceipt() {
                receiptInput.value = '';
                previewImg.removeAttribute('src');
                fileNameLabel.textContent = '';
                uploadPreview.classList.remove('is-visible');
                uploadEmpty.classList.remove('d-none');
            }

            function showReceiptPreview(file) {
                if (!file) return;
                fileNameLabel.textContent = file.name;
                uploadEmpty.classList.add('d-none');
                uploadPreview.classList.add('is-visible');
                if (file.type && file.type.startsWith('image/')) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        previewImg.src = e.target.result;
                        previewImg.style.display = '';
                    };
                    reader.readAsDataURL(file);
                } else {
                    previewImg.style.display = 'none';
                }
            }

            optionCards.forEach(function (card) {
                card.addEventListener('click', function () {
                    selectType(card.getAttribute('data-payment-type'));
                });
            });

            channelTabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    selectMethod(tab.getAttribute('data-channel'));
                });
            });

            uploadZone.addEventListener('click', function (e) {
                if (e.target.closest('#receiptRemoveBtn')) return;
                receiptInput.click();
            });

            receiptInput.addEventListener('change', function () {
                if (receiptInput.files && receiptInput.files[0]) {
                    showReceiptPreview(receiptInput.files[0]);
                }
            });

            removeReceiptBtn.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                clearReceipt();
            });

            ['dragenter', 'dragover'].forEach(function (evt) {
                uploadZone.addEventListener(evt, function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    uploadZone.style.backgroundColor = '#e4e4e4';
                });
            });
            ['dragleave', 'drop'].forEach(function (evt) {
                uploadZone.addEventListener(evt, function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    uploadZone.style.backgroundColor = '';
                });
            });
            uploadZone.addEventListener('drop', function (e) {
                const files = e.dataTransfer.files;
                if (files && files.length > 0) {
                    const dt = new DataTransfer();
                    dt.items.add(files[0]);
                    receiptInput.files = dt.files;
                    showReceiptPreview(files[0]);
                }
            });

            document.getElementById('proceedPaymentBtn').addEventListener('click', function () {
                if (!typeInput.value) {
                    alert('Please select Partial Payment or Full Payment.');
                    return;
                }
                syncAmountPaid();
                if (!methodInput.value) {
                    selectMethod('GCash');
                } else {
                    selectMethod(methodInput.value);
                }
                if (!paymentDateInput.value) {
                    paymentDateInput.value = toDateTimeLocalValue(new Date());
                }
                setStep(2);
            });

            document.getElementById('backToStep1Btn').addEventListener('click', function () {
                setStep(1);
            });

            document.getElementById('toSummaryBtn').addEventListener('click', function () {
                const amount = parseFloat(paidInput.value || '0');
                const expected = currentPayNowAmount();
                const isWalkIn = methodInput.value === 'Walk-in';
                if (!methodInput.value) {
                    alert('Please select a payment channel.');
                    return;
                }
                if (!isWalkIn && !(document.getElementById('AccountName').value || '').trim()) {
                    alert('Please enter the account name (sender).');
                    return;
                }
                if (!isWalkIn && !(document.getElementById('TransactionReference').value || '').trim()) {
                    alert('Please enter the reference / transaction number.');
                    return;
                }
                if (!amount || amount <= 0) {
                    alert(isWalkIn ? 'Please enter the amount paid.' : 'Please enter the amount sent.');
                    return;
                }
                if (Math.abs(amount - expected) > 0.009) {
                    alert((isWalkIn ? 'Amount paid' : 'Amount sent') + ' must match ' + formatPeso(expected) + '.');
                    return;
                }
                if (!paymentDateInput.value) {
                    alert('Please enter the date and time of payment.');
                    return;
                }
                if (!isWalkIn && !(receiptInput.files && receiptInput.files[0])) {
                    alert('Please upload your payment screenshot / receipt.');
                    return;
                }

                document.getElementById('summaryType').textContent = typeInput.value || '—';
                document.getElementById('summaryMethod').textContent = methodInput.value || '—';
                document.getElementById('summaryTotal').textContent = formatPeso(totalFare);
                document.getElementById('summaryPaid').textContent = formatPeso(amount);
                document.getElementById('summaryAccount').textContent = isWalkIn
                    ? 'Walk-in'
                    : ((document.getElementById('AccountName').value || '').trim() || '—');
                setStep(3);
            });

            document.getElementById('backToStep2Btn').addEventListener('click', function () {
                setStep(2);
            });

            if (typeInput.value) selectType(typeInput.value);
            else selectType('Full Payment');
            if (methodInput.value) selectMethod(methodInput.value);
            else selectMethod('GCash');
            syncAmountPaid();

            if (!paymentDateInput.value) {
                paymentDateInput.value = toDateTimeLocalValue(new Date());
            }
        })();
    </script>
}
