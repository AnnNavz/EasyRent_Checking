@model EasyRent_Checking.Models.Rental
@using EasyRent_Checking.Models
@using System.Globalization

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "View Details";
    ViewData["ActivePage"] = "Rentals";

    var details = Model?.Details;
    var rentalVehicles = (Model?.RentalVehicles ?? Enumerable.Empty<RentalVehicle>())
        .OrderBy(rv => rv.SortOrder)
        .ThenBy(rv => rv.RentalVehicleId)
        .ToList();
    var vehicle = rentalVehicles.FirstOrDefault()?.Vehicle ?? details?.Vehicle;
    var latestPayment = ViewData["LatestPayment"] as Payment;
    var transit = ViewData["Transit"] as Transit;
    var transits = ViewData["Transits"] as IList<Transit> ?? new List<Transit>();
    var isPending = Model?.RentalStatus == RentalStatus.Pending;
    var isApproved = Model?.RentalStatus == RentalStatus.Approved;
    var isCancelled = Model?.RentalStatus == RentalStatus.Cancelled;
    var ph = CultureInfo.GetCultureInfo("en-PH");

    string FormatDate(DateOnly? date)
    {
        if (date == null) return "—";
        return date.Value.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture);
    }

    string FormatTimestamp(DateTime value) =>
        value.ToString("MMM. d, yyyy", CultureInfo.InvariantCulture)
        + " • "
        + value.ToString("h:mm tt", CultureInfo.InvariantCulture);

    string FormatPeso(decimal amount) => "₱" + amount.ToString("N2", ph);

    string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpperInvariant();
        return (parts[0][0].ToString() + parts[^1][0]).ToUpperInvariant();
    }

    int GetDurationHours()
    {
        if (details == null) return 0;
        var start = details.PickupDate.ToDateTime(details.PickupTime);
        var end = details.ReturnDate.ToDateTime(details.ReturnTime);
        return Math.Max(0, (int)Math.Round((end - start).TotalHours));
    }

    var hours = GetDurationHours();
    var computedSucceedingHours = Math.Max(0, hours - 8);
    var basePrice = vehicle?.BasePrice ?? 0m;
    var succeedingFee = vehicle?.SucceedingFee ?? 0m;
    var useFareSnapshot = Model?.TotalAmount > 0;
    var succeedingAmount = useFareSnapshot
        ? Model!.SucceedingFeeTotal
        : computedSucceedingHours * succeedingFee;
    var succeedingHours = useFareSnapshot && succeedingFee > 0 && succeedingAmount > 0
        ? (int)Math.Round(succeedingAmount / succeedingFee)
        : computedSucceedingHours;
    var subtotal = basePrice + succeedingAmount;
    var hasSeniorDiscount = details?.Discount == Discount.Yes;
    var discountAmount = hasSeniorDiscount ? Math.Round(subtotal * 0.10m, 2) : 0m;
    var fareTotal = useFareSnapshot
        ? Model!.TotalAmount
        : (latestPayment?.TotalAmount > 0
            ? latestPayment.TotalAmount
            : Math.Round(subtotal - discountAmount, 2));

    string MethodChannel(string? method) => method switch
    {
        "GCash" => "QR only",
        "BDO" => "QR only",
        "Walk-in" => "Pay at Office",
        _ => ""
    };

    string? MethodLogo(string? method) => method switch
    {
        "GCash" => Url.Content("~/images/System Images/GcashImage.jpg"),
        "BDO" => Url.Content("~/images/System Images/BDOimage.png"),
        _ => null
    };

    string StatusBadgeClass(RentalStatus status) => status switch
    {
        RentalStatus.Approved => "booking-status-approved",
        RentalStatus.Cancelled => "booking-status-cancelled",
        RentalStatus.Expired => "booking-status-expired",
        _ => "booking-status-pending"
    };

    string StatusIcon(RentalStatus status) => status switch
    {
        RentalStatus.Approved => "bi-check-circle",
        RentalStatus.Cancelled => "bi-x-circle",
        RentalStatus.Expired => "bi-hourglass-bottom",
        _ => "bi-clock"
    };

    var bookingId = $"BK-{Model?.RentalId.ToString("D5") ?? "00000"}";
    var discountLabel = hasSeniorDiscount ? "Senior Citizen (10% off)" : "None";
    var driverName = transit?.Driver?.Name;
    var auditTime = latestPayment?.PaymentDate;
    var discountFileName = !string.IsNullOrWhiteSpace(details?.DiscountImagePath)
        ? System.IO.Path.GetFileName(details!.DiscountImagePath)
        : null;
    var vehicleTypeLabel = vehicle != null ? VehicleTypes.Display(vehicle.Type) : "—";
    var paymentOptionLabel = latestPayment?.PaymentType
        ?? (Model?.RentalOption == RentalOption.Reserve ? "Pay Later" : "—");
}

<div class="container-fluid px-4 py-3 reservation-details-page">
    <div class="row g-4 align-items-start">
        <div class="col-lg-8">
            <div class="reservation-details-id-card mb-3">
                <div class="reservation-details-id-main">
                    <span class="reservation-view-id-label">Booking ID</span>
                    <h1 class="reservation-view-id mb-0">@bookingId</h1>
                </div>
                <span class="booking-status-badge @StatusBadgeClass(Model!.RentalStatus)">
                    <i class="bi @StatusIcon(Model.RentalStatus)"></i>@Model.RentalStatus
                </span>
            </div>

            <div class="reservation-view-card mb-4">
                <div class="reservation-view-people">
                    <div class="reservation-view-person">
                        <div class="reservation-view-avatar" aria-hidden="true">@GetInitials(Model.CustomerName)</div>
                        <div>
                            <div class="reservation-view-person-name">@Model.CustomerName</div>
                            <div class="reservation-view-person-meta">@Model.ContactNumber</div>
                        </div>
                    </div>
                    <div class="reservation-view-vehicle">
                        <div class="reservation-view-vehicle-thumb" aria-hidden="true">
                            @if (!string.IsNullOrEmpty(vehicle?.ImagePath))
                            {
                                <img src="~/images/@vehicle.ImagePath" alt="@vehicle.Model" />
                            }
                            else
                            {
                                <i class="bi bi-truck-front"></i>
                            }
                        </div>
                        <div>
                            <div class="reservation-view-vehicle-label">
                                @(rentalVehicles.Count > 1 ? $"Selected Vehicles ({rentalVehicles.Count})" : "Selected Vehicle")
                            </div>
                            <div class="reservation-view-vehicle-name">
                                @if (rentalVehicles.Count > 0)
                                {
                                    @string.Join(", ", rentalVehicles.Select(rv =>
                                        rv.Vehicle != null
                                            ? $"{rv.Vehicle.Model} {rv.Vehicle.Brand}".Trim()
                                            : $"Vehicle #{rv.VehicleId}"))
                                }
                                else if (vehicle != null)
                                {
                                    @($"{vehicle.Model} {vehicle.Brand}")
                                }
                                else
                                {
                                    @:Unassigned
                                }
                            </div>
                            <div class="reservation-view-vehicle-type">
                                @if (rentalVehicles.Count > 1)
                                {
                                    @:Multiple vehicles · shared schedule
                                }
                                else
                                {
                                    @vehicleTypeLabel
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="reservation-view-facts">
                    <div class="reservation-view-fact">
                        <span class="reservation-view-fact-icon"><i class="bi bi-calendar3"></i></span>
                        <div>
                            <span class="reservation-view-label">Pick-up Date</span>
                            <span class="reservation-view-value">@FormatDate(details?.PickupDate)</span>
                        </div>
                    </div>
                    <div class="reservation-view-fact">
                        <span class="reservation-view-fact-icon"><i class="bi bi-calendar3"></i></span>
                        <div>
                            <span class="reservation-view-label">Return Date</span>
                            <span class="reservation-view-value">@FormatDate(details?.ReturnDate)</span>
                        </div>
                    </div>
                    <div class="reservation-view-fact">
                        <span class="reservation-view-fact-icon"><i class="bi bi-geo-alt"></i></span>
                        <div>
                            <span class="reservation-view-label">Pick-up Location</span>
                            <span class="reservation-view-value">@(details?.PickupLocation ?? "—")</span>
                        </div>
                    </div>
                    <div class="reservation-view-fact">
                        <span class="reservation-view-fact-icon"><i class="bi bi-geo-alt"></i></span>
                        <div>
                            <span class="reservation-view-label">Drop-off Location</span>
                            <span class="reservation-view-value">@(details?.DropoffLocation ?? "—")</span>
                        </div>
                    </div>
                    <div class="reservation-view-fact">
                        <span class="reservation-view-fact-icon"><i class="bi bi-clock"></i></span>
                        <div>
                            <span class="reservation-view-label">Total Duration</span>
                            <span class="reservation-view-value">@(hours == 1 ? "1 hour" : $"{hours} hours")</span>
                        </div>
                    </div>
                    <div class="reservation-view-fact">
                        <span class="reservation-view-fact-icon"><i class="bi bi-person-plus"></i></span>
                        <div>
                            <span class="reservation-view-label">Passenger Count</span>
                            <span class="reservation-view-value">@(details != null ? $"{details.PassengerCount} Persons" : "—")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="reservation-view-card mb-4">
                <div class="reservation-view-section-title">
                    <span class="reservation-view-section-icon"><i class="bi bi-file-earmark-text"></i></span>
                    <span>Additional Information</span>
                </div>

                <div class="reservation-view-facts reservation-view-facts--two mb-3">
                    <div class="reservation-view-fact">
                        <span class="reservation-view-fact-icon"><i class="bi bi-person-vcard"></i></span>
                        <div>
                            <span class="reservation-view-label">Designated Driver</span>
                            <span class="reservation-view-value">
                                @if (!string.IsNullOrWhiteSpace(driverName))
                                {
                                    @driverName
                                    @if (transit != null)
                                    {
                                        <a asp-controller="Transits" asp-action="Details" asp-route-transitid="@transit.TransitID" class="reservation-view-inline-link">View Transit</a>
                                    }
                                }
                                else
                                {
                                    <text>Not Assigned Yet</text>
                                    <i class="bi bi-info-circle reservation-view-info-icon" title="Available after booking is approved"></i>
                                    @if (transit != null)
                                    {
                                        <a asp-controller="Transits" asp-action="Details" asp-route-transitid="@transit.TransitID" class="reservation-view-inline-link">Assign Driver</a>
                                    }
                                }
                            </span>
                        </div>
                    </div>
                    <div class="reservation-view-fact">
                        <span class="reservation-view-fact-icon"><i class="bi bi-tag"></i></span>
                        <div>
                            <span class="reservation-view-label">Discount Applied</span>
                            <span class="reservation-view-value">@discountLabel</span>
                        </div>
                    </div>
                </div>

                @if (hasSeniorDiscount)
                {
                    <div class="reservation-id-docs mb-3">
                        <div class="reservation-id-doc-card">
                            <span class="reservation-id-doc-label">Front</span>
                            <div class="reservation-id-doc-frame">
                                @if (!string.IsNullOrWhiteSpace(details?.DiscountImagePath))
                                {
                                    <a href="~/images/@details.DiscountImagePath" target="_blank" rel="noopener">
                                        <img src="~/images/@details.DiscountImagePath" alt="Front of Senior/PWD ID" />
                                    </a>
                                }
                                else
                                {
                                    <div class="reservation-view-placeholder" aria-hidden="true">
                                        <i class="bi bi-person-vcard"></i>
                                    </div>
                                }
                            </div>
                            <span class="reservation-id-doc-name">@(discountFileName ?? "No file uploaded")</span>
                        </div>
                        <div class="reservation-id-doc-card">
                            <span class="reservation-id-doc-label">Back</span>
                            <div class="reservation-id-doc-frame">
                                <div class="reservation-view-placeholder" aria-hidden="true">
                                    <i class="bi bi-person-vcard"></i>
                                </div>
                            </div>
                            <span class="reservation-id-doc-name">Not uploaded</span>
                        </div>
                    </div>
                }

                <div class="reservation-view-notes-block">
                    <span class="reservation-view-notes-title">Special Requests/ Notes</span>
                    <div class="reservation-view-notes">@(string.IsNullOrWhiteSpace(Model.Notes) ? "None" : Model.Notes)</div>
                </div>
            </div>

            <div class="reservation-view-card mb-4">
                <div class="reservation-view-section-title">
                    <span class="reservation-view-section-icon"><i class="bi bi-receipt"></i></span>
                    <span>Financial Review</span>
                </div>

                <div class="reservation-finance-lines">
                    <div class="reservation-finance-line">
                        <span>Payment Options</span>
                        <strong>@paymentOptionLabel</strong>
                    </div>
                    <div class="reservation-finance-line">
                        <span>Base Rental Rate</span>
                        <strong>@FormatPeso(basePrice)</strong>
                    </div>
                    @if (succeedingAmount > 0)
                    {
                        <div class="reservation-finance-line">
                            <span>Extra Hours (@succeedingHours @(succeedingHours == 1 ? "hr" : "hrs"))</span>
                            <strong>@FormatPeso(succeedingAmount)</strong>
                        </div>
                    }
                    @if (hasSeniorDiscount)
                    {
                        <div class="reservation-finance-line is-discount">
                            <span>Senior Discount (10%)</span>
                            <strong>-@FormatPeso(discountAmount)</strong>
                        </div>
                    }
                </div>

                <div class="reservation-finance-total">
                    <span>Total to Verify</span>
                    <strong>@FormatPeso(fareTotal)</strong>
                </div>

                @if (latestPayment != null)
                {
                    <div class="reservation-payment-submitted">
                        <div class="reservation-payment-method-row">
                            @{
                                var logo = MethodLogo(latestPayment.PaymentMethod);
                            }
                            @if (!string.IsNullOrEmpty(logo))
                            {
                                <img src="@logo" alt="@latestPayment.PaymentMethod" class="reservation-payment-method-logo" />
                            }
                            else
                            {
                                <span class="reservation-payment-method-fallback"><i class="bi bi-shop"></i></span>
                            }
                            <div>
                                <div class="reservation-payment-method-value">@(latestPayment.PaymentMethod ?? "—")</div>
                                <div class="reservation-payment-method-label">@MethodChannel(latestPayment.PaymentMethod)</div>
                            </div>
                        </div>
                        <div class="reservation-payment-submitted-meta">
                            <div>
                                <span>Account Name</span>
                                <strong>@(string.IsNullOrWhiteSpace(latestPayment.AccountName) ? "—" : latestPayment.AccountName)</strong>
                            </div>
                            <div>
                                <span>Reference Number</span>
                                <strong>@(string.IsNullOrWhiteSpace(latestPayment.TransactionReference) ? "—" : latestPayment.TransactionReference)</strong>
                            </div>
                            <div>
                                <span>Timestamp</span>
                                <strong class="reservation-payment-timestamp">
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    @FormatTimestamp(latestPayment.PaymentDate)
                                </strong>
                            </div>
                            <div>
                                <span>Amount Paid</span>
                                <strong>@FormatPeso(latestPayment.AmountPaid)</strong>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="reservation-payment-submitted">
                        <p class="small text-muted mb-0">No payment submitted with this booking yet.</p>
                    </div>
                }
            </div>

            @if (latestPayment != null)
            {
                <div class="reservation-view-card mb-4">
                    <div class="reservation-view-section-title">
                        <span class="reservation-view-section-icon"><i class="bi bi-image"></i></span>
                        <span>Receipt Verification</span>
                    </div>
                    <div class="reservation-receipt-frame">
                        @if (!string.IsNullOrWhiteSpace(latestPayment.ReceiptImagePath))
                        {
                            <a href="~/images/@latestPayment.ReceiptImagePath" target="_blank" rel="noopener">
                                <img src="~/images/@latestPayment.ReceiptImagePath" alt="Payment receipt" />
                            </a>
                        }
                        else
                        {
                            <div class="reservation-receipt-empty">
                                <i class="bi bi-receipt"></i>
                                <p>No receipt image uploaded (e.g. Walk-in payment).</p>
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(latestPayment.ReceiptImagePath))
                    {
                        <div class="reservation-verify-hint">
                            <span class="reservation-verify-hint-icon" aria-hidden="true">i</span>
                            <span>Verify that the Reference Number matches the screenshot and the amount sent is exactly matched.</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="details-page-actions reservation-details-side-actions mb-3">
                <a asp-action="Index" class="btn btn-page-back">Back</a>
                <a asp-action="Edit" asp-route-id="@Model?.RentalId" class="btn btn-reservation-edit">Edit Reservation</a>
            </div>

            <div class="reservation-view-side-card mb-4">
                <h6 class="reservation-view-side-title">Internal Audit Log</h6>
                <div class="reservation-view-audit-list">
                    <div class="reservation-view-audit-item">
                        <span>Booking Created</span>
                        @if (auditTime.HasValue)
                        {
                            <strong>@FormatTimestamp(auditTime.Value)</strong>
                        }
                    </div>
                    <div class="reservation-view-audit-item">
                        <span>Booking Submitted</span>
                        @if (auditTime.HasValue)
                        {
                            <strong>@FormatTimestamp(auditTime.Value)</strong>
                        }
                    </div>
                    @if (isApproved)
                    {
                        <div class="reservation-view-audit-item">
                            <span>Booking Approved</span>
                        </div>
                    }
                    @if (isCancelled)
                    {
                        <div class="reservation-view-audit-item">
                            <span>Booking Cancelled@(Model?.CancelledAt != null ? $" · {FormatTimestamp(Model.CancelledAt.Value)}" : "")</span>
                        </div>
                        @if ((Model?.CancellationFee ?? 0m) > 0)
                        {
                            <div class="reservation-view-audit-item is-danger">
                                <span>Cancellation fee due: @FormatPeso(Model!.CancellationFee!.Value)</span>
                            </div>
                        }
                    }
                </div>

                @if (isPending)
                {
                    <form asp-action="Approve" asp-route-id="@Model.RentalId" method="post" class="mb-2"
                          data-confirm="Approve this reservation?"
                          data-confirm-text="The booking will be confirmed and the vehicle will be reserved for this customer."
                          data-confirm-button="Approve Reservation"
                          data-confirm-tone="approve">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn reservation-btn-approve w-100">Approve Reservation</button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@Model.RentalId" method="post"
                          data-confirm="Reject this reservation?"
                          data-confirm-text="The customer will be notified and the vehicle will become available again."
                          data-confirm-button="Reject Reservation"
                          data-confirm-tone="danger"
                          data-confirm-icon="bi-x-circle"
                          data-confirm-submit-icon="bi-x-lg">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn reservation-btn-reject w-100">Reject Reservation</button>
                    </form>
                }
            </div>

            <div class="reservation-view-side-card reservation-payment-card">
                <div class="reservation-payment-header">
                    <h6 class="reservation-view-side-title mb-0">Payment Status</h6>
                    <strong class="reservation-payment-status-text">@(isApproved ? "Paid" : "Unpaid")</strong>
                </div>
                @if (latestPayment == null)
                {
                    <a asp-action="Edit" asp-route-id="@Model.RentalId" class="btn reservation-btn-payment w-100">Add Payment</a>
                }
                else
                {
                    <a asp-action="Edit" asp-route-id="@Model.RentalId" class="btn reservation-btn-payment w-100">Edit Payment</a>
                }
            </div>
        </div>
    </div>
</div>
