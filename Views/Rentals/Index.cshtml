@model IEnumerable<EasyRent_Checking.Models.Rental>
@using EasyRent_Checking.Models
@using System.Globalization

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Inquiries Management";
    ViewData["ActivePage"] = "Rentals";

    var totalBookingsChange = ViewData["TotalBookingsChange"] as decimal? ?? 0m;
    var pendingApprovalsChange = ViewData["PendingApprovalsChange"] as decimal? ?? 0m;

    string FormatTrend(decimal change) =>
        Math.Abs(change).ToString("0.0", CultureInfo.InvariantCulture) + "%";

    string currentSortName = ViewData["CurrentSort"]?.ToString() switch
    {
        "CustomerName" => "Customer",
        "PickupDate" => "Pickup Date",
        "Status" => "Status",
        "Vehicle" => "Vehicle",
        _ => "Sorting by"
    };

    string currentFilterName = ViewData["CurrentFilter"]?.ToString() switch
    {
        "Pending" => "Pending",
        "Approved" => "Approved",
        "Cancelled" => "Cancelled",
        "Expired" => "Expired",
        _ => "Filters"
    };

    string indexReturnUrl = Url.Action("Index", new
    {
        searchString = ViewData["CurrentSearch"],
        sortBy = ViewData["CurrentSort"],
        currentFilter = ViewData["CurrentFilter"],
        page = ViewData["PageIndex"]
    }) ?? "";

    string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            return parts[0].Length >= 2
                ? parts[0][..2].ToUpperInvariant()
                : parts[0].ToUpperInvariant();
        }
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
    }

    string FormatDuration(Rental rental)
    {
        var start = rental.PickupDate.ToDateTime(rental.PickupTime);
        var end = rental.ReturnDate.ToDateTime(rental.ReturnTime);
        var span = end - start;
        if (span.TotalMinutes <= 0) return "—";

        if (span.TotalHours < 24)
        {
            var hours = Math.Max(1, (int)Math.Round(span.TotalHours));
            return hours == 1 ? "1 hour" : $"{hours} hours";
        }

        var days = Math.Max(1, (int)Math.Round(span.TotalDays));
        return days == 1 ? "1 day" : $"{days} days";
    }

    string StatusBadgeClass(Rental item)
    {
        if (item.RefundRequestedAt != null && item.RefundedAt == null && item.RefundRejectedAt == null && item.RentalStatus == RentalStatus.Cancelled)
        {
            return "booking-status-refundable";
        }

        return item.RentalStatus switch
        {
            RentalStatus.Approved => "booking-status-approved",
            RentalStatus.Cancelled => "booking-status-cancelled",
            RentalStatus.Expired => "booking-status-expired",
            RentalStatus.Refunded => "booking-status-refunded",
            RentalStatus.RefundRejected => "booking-status-refund-rejected",
            _ => "booking-status-pending"
        };
    }

    string StatusLabel(Rental item)
    {
        if (item.RefundRequestedAt != null && item.RefundedAt == null && item.RefundRejectedAt == null && item.RentalStatus == RentalStatus.Cancelled)
        {
            return "Pending Refund Review";
        }

        return item.RentalStatus switch
        {
            RentalStatus.RefundRejected => "Refund Rejected",
            _ => item.RentalStatus.ToString()
        };
    }
}

<div class="inquiries-index-page">
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="inquiry-metric-card">
                <div class="inquiry-metric-icon" aria-hidden="true">
                    <i class="bi bi-clipboard-check"></i>
                </div>
                <div class="inquiry-metric-body">
                    <span class="inquiry-metric-label">Total Bookings</span>
                    <div class="inquiry-metric-value">@(ViewData["TotalBookingsCount"] ?? "0")</div>
                </div>
                <div class="inquiry-metric-trend">
                    <span class="inquiry-metric-badge @(totalBookingsChange >= 0 ? "is-up" : "is-down")">
                        <i class="bi @(totalBookingsChange >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                        @FormatTrend(totalBookingsChange)
                    </span>
                    <span class="inquiry-metric-compare">vs last month</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="inquiry-metric-card">
                <div class="inquiry-metric-icon is-gold" aria-hidden="true">
                    <i class="bi bi-clipboard2-pulse"></i>
                </div>
                <div class="inquiry-metric-body">
                    <span class="inquiry-metric-label">Unpaid Holds</span>
                    <div class="inquiry-metric-value">@(ViewData["PendingApprovalsCount"] ?? "0")</div>
                </div>
                <div class="inquiry-metric-trend">
                    <span class="inquiry-metric-badge @(pendingApprovalsChange >= 0 ? "is-up" : "is-down")">
                        <i class="bi @(pendingApprovalsChange >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                        @FormatTrend(pendingApprovalsChange)
                    </span>
                    <span class="inquiry-metric-compare">vs last month</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="inquiry-metric-card">
                <div class="inquiry-metric-icon is-green" aria-hidden="true">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <div class="inquiry-metric-body">
                    <span class="inquiry-metric-label">Refundable</span>
                    <div class="inquiry-metric-value">@(ViewData["RefundableCount"] ?? "0")</div>
                </div>
                <div class="inquiry-metric-trend">
                    <span class="inquiry-metric-badge is-neutral">
                        <i class="bi bi-hourglass-split"></i>
                        Pending review
                    </span>
                    <span class="inquiry-metric-compare">customer requests</span>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Index" method="get" class="w-100">
        <input type="hidden" name="sortBy" value="@ViewData["CurrentSort"]" />
        <input type="hidden" name="currentFilter" value="@ViewData["CurrentFilter"]" />

        <div class="inquiry-index-toolbar mb-4">
            <div class="inquiry-index-toolbar-filters">
                <div class="dropdown">
                    <button class="btn btn-filter dropdown-toggle text-capitalize" type="button" data-bs-toggle="dropdown">
                        @currentSortName
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="?sortBy=CustomerName&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Customer</a></li>
                        <li><a class="dropdown-item" href="?sortBy=PickupDate&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Pickup Date</a></li>
                        <li><a class="dropdown-item" href="?sortBy=Vehicle&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Vehicle</a></li>
                        <li><a class="dropdown-item" href="?sortBy=Status&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Status</a></li>
                        <li><hr class="dropdown-menu-divider"></li>
                        <li><a class="dropdown-item text-muted small" href="?sortBy=&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Clear Sorting</a></li>
                    </ul>
                </div>

                <div class="dropdown">
                    <button class="btn btn-filter dropdown-toggle text-capitalize" type="button" data-bs-toggle="dropdown">
                        @currentFilterName
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="?currentFilter=Pending&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Pending</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=Approved&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Approved</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=Cancelled&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Cancelled</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=Expired&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Expired</a></li>
                        <li><hr class="dropdown-menu-divider"></li>
                        <li><a class="dropdown-item text-muted small" href="?currentFilter=&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Clear Filters</a></li>
                    </ul>
                </div>
            </div>

            <div class="inquiry-index-toolbar-search">
                <i class="bi bi-search inquiry-index-search-icon" aria-hidden="true"></i>
                <input type="text"
                       name="searchString"
                       value="@ViewData["CurrentSearch"]"
                       class="form-control inquiry-index-search-input"
                       placeholder="Search Inquiries" />
                @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()))
                {
                    <a href="?searchString=&sortBy=@ViewData["CurrentSort"]&currentFilter=@ViewData["CurrentFilter"]"
                       class="inquiry-index-search-clear"
                       aria-label="Clear search">&times;</a>
                }
            </div>

            <a asp-action="Create" class="btn inquiry-index-add-btn">
                <i class="bi bi-plus-lg"></i> Add Rental
            </a>
        </div>
    </form>

    <div class="index-table-panel mb-4">
        <div class="table-responsive">
            <table class="table admin-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Customer</th>
                        <th>Vehicle</th>
                        <th>Dates</th>
                        <th>Duration</th>
                        <th>Status</th>
                        <th class="text-center" style="width: 60px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var bookingLabel = $"BK-{item.RentalId:D4}";
                            <tr>
                                <td class="fw-semibold text-dark font-monospace">@bookingLabel</td>
                                <td>
                                    <div class="booking-customer-cell">
                                        @if (item.CustomerId.HasValue)
                                        {
                                            <a asp-controller="Customers" asp-action="Details" asp-route-customerid="@item.CustomerId" class="booking-customer-avatar" aria-label="View @item.CustomerName profile">
                                                @if (!string.IsNullOrEmpty(item.Customer?.User?.ProfileImagePath))
                                                {
                                                    <img src="~/images/@item.Customer.User!.ProfileImagePath" alt="" />
                                                }
                                                else
                                                {
                                                    @GetInitials(item.CustomerName)
                                                }
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="booking-customer-avatar" aria-hidden="true">@GetInitials(item.CustomerName)</span>
                                        }
                                        <div class="booking-customer-meta">
                                            <span class="booking-customer-name">@item.CustomerName</span>
                                            <span class="booking-customer-phone">@item.ContactNumber</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var indexVehicle = item.RentalVehicles?
                                            .OrderBy(rv => rv.SortOrder)
                                            .Select(rv => rv.Vehicle)
                                            .FirstOrDefault();
                                    }
                                    @if (indexVehicle != null)
                                    {
                                        <span class="booking-vehicle-name">@indexVehicle.Brand @indexVehicle.Model</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unassigned</span>
                                    }
                                </td>
                                <td>
                                    @AdminDates.FormatRange(item.PickupDate, item.ReturnDate)
                                </td>
                                <td>@FormatDuration(item)</td>
                                <td>
                                    <span class="booking-status-badge @StatusBadgeClass(item)">@StatusLabel(item)</span>
                                </td>
                                <td class="text-center">
                                    <div class="dropdown">
                                        <button class="admin-row-action" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed","placement":"bottom-end"}' data-bs-boundary="viewport" aria-label="Inquiry actions">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.RentalId" asp-route-returnUrl="@indexReturnUrl"><i class="bi bi-pencil me-2"></i> Edit</a></li>
                                            <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.RentalId"><i class="bi bi-info-circle me-2"></i> Details</a></li>
                                            <li><hr class="dropdown-menu-divider"></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger" onclick="openDeletePopup('@item.RentalId', '@bookingLabel')">
                                                    <i class="bi bi-trash me-2"></i> Delete
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted fw-medium">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                No matching inquiries found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AdminPagination" />
    </div>
</div>

@{
    ViewData["DeleteModalId"] = "reservationDeletePopup";
    ViewData["DeleteHiddenInputId"] = "popupRentalId";
    ViewData["DeleteMessageId"] = "deletePopupMessage";
    ViewData["DeleteEntityLabel"] = "rental";
}
<partial name="_DeleteConfirmModal" />
