@model IEnumerable<EasyRent_Checking.Models.Rental>
@using EasyRent_Checking.Models
@using System.Globalization

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Booking Management";
    ViewData["ActivePage"] = "Rentals";
    var paymentsByRental = ViewBag.PaymentsByRentalId as Dictionary<int, Payment>
        ?? new Dictionary<int, Payment>();

    string currentSortName = ViewData["CurrentSort"]?.ToString() switch
    {
        "CustomerName" => "Customer",
        "PickupDate" => "Pickup Date",
        "Status" => "Status",
        "Vehicle" => "Vehicle",
        _ => "Sorting by"
    };

    string currentFilterName = ViewData["CurrentFilter"]?.ToString() switch
    {
        "Pending" => "Pending",
        "Approved" => "Approved",
        "Cancelled" => "Cancelled",
        _ => "Filters"
    };

    string indexReturnUrl = Url.Action("Index", new
    {
        searchString = ViewData["CurrentSearch"],
        sortBy = ViewData["CurrentSort"],
        currentFilter = ViewData["CurrentFilter"],
        page = ViewData["PageIndex"]
    }) ?? "";

    string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            return parts[0].Length >= 2
                ? parts[0][..2].ToUpperInvariant()
                : parts[0].ToUpperInvariant();
        }
        return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
    }

    string FormatDateRange(DateOnly start, DateOnly end)
    {
        string Month(DateOnly d) => d.ToString("MMM") + ".";

        if (start == end)
        {
            return $"{Month(start)} {start.Day} {start.Year}";
        }

        if (start.Year == end.Year && start.Month == end.Month)
        {
            return $"{Month(start)} {start.Day} - {end.Day} {end.Year}";
        }

        if (start.Year == end.Year)
        {
            return $"{Month(start)} {start.Day} - {Month(end)} {end.Day} {end.Year}";
        }

        return $"{Month(start)} {start.Day} {start.Year} - {Month(end)} {end.Day} {end.Year}";
    }

    string StatusBadgeClass(RentalStatus status) => status switch
    {
        RentalStatus.Approved => "booking-status-approved",
        RentalStatus.Cancelled => "booking-status-cancelled",
        RentalStatus.Expired => "booking-status-cancelled",
        _ => "booking-status-pending"
    };
}

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="metric-card p-4 d-flex justify-content-between align-items-center">
            <div>
                <span class="metric-label">Total Bookings</span>
                <div class="metric-value">@(ViewData["TotalBookingsCount"] ?? "0")</div>
            </div>
            <div class="metric-icon-box" aria-hidden="true"></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card p-4 d-flex justify-content-between align-items-center">
            <div>
                <span class="metric-label">Pending Approvals</span>
                <div class="metric-value">@(ViewData["PendingApprovalsCount"] ?? "0")</div>
            </div>
            <div class="metric-icon-box" aria-hidden="true"></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card p-4 d-flex justify-content-between align-items-center">
            <div>
                <span class="metric-label">Active Trips</span>
                <div class="metric-value">@(ViewData["ActiveTripsCount"] ?? "0")</div>
            </div>
            <div class="metric-icon-box" aria-hidden="true"></div>
        </div>
    </div>
</div>

<form asp-action="Index" method="get" class="w-100">
    <input type="hidden" name="sortBy" value="@ViewData["CurrentSort"]" />
    <input type="hidden" name="currentFilter" value="@ViewData["CurrentFilter"]" />

    <div class="card index-toolbar-card mb-4">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle border px-3 fw-semibold text-secondary btn-filter text-capitalize" type="button" data-bs-toggle="dropdown">
                        @currentSortName
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="?sortBy=CustomerName&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Customer</a></li>
                        <li><a class="dropdown-item" href="?sortBy=PickupDate&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Pickup Date</a></li>
                        <li><a class="dropdown-item" href="?sortBy=Vehicle&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Vehicle</a></li>
                        <li><a class="dropdown-item" href="?sortBy=Status&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Status</a></li>
                        <li><hr class="dropdown-menu-divider"></li>
                        <li><a class="dropdown-item text-muted small" href="?sortBy=&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Clear Sorting</a></li>
                    </ul>
                </div>
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle border px-3 fw-semibold text-secondary btn-filter text-capitalize" type="button" data-bs-toggle="dropdown">
                        @currentFilterName
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="?currentFilter=Pending&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Pending</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=Approved&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Approved</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=Cancelled&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Cancelled</a></li>
                        <li><hr class="dropdown-menu-divider"></li>
                        <li><a class="dropdown-item text-muted small" href="?currentFilter=&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Clear Filters</a></li>
                    </ul>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 flex-grow-1 flex-sm-grow-0">
                <div class="position-relative flex-grow-1">
                    <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control ps-5 pe-5 rounded-3 border bg-light text-secondary search-bar-input" placeholder="Search booking entries..." />
                    <i class="bi bi-mic position-absolute top-50 end-0 translate-middle-y me-3 text-muted" aria-hidden="true"></i>
                </div>

                <a asp-action="Create" class="btn btn-dark d-flex align-items-center gap-2 px-3 py-2 fw-bold text-nowrap rounded-3 shadow-sm btn-add-driver">
                    <i class="bi bi-plus-lg"></i> Add Booking
                </a>
            </div>
        </div>
    </div>
</form>

<div class="index-table-panel mb-4">
    <div class="table-responsive">
        <table class="table admin-table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Customer</th>
                    <th>Vehicle</th>
                    <th>Dates</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th class="text-center" style="width: 60px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var bookingLabel = $"BK-{item.RentalId:D4}";
                        paymentsByRental.TryGetValue(item.RentalId, out var payment);
                        <tr>
                            <td class="fw-semibold text-dark font-monospace">@bookingLabel</td>
                            <td>
                                <div class="booking-customer-cell">
                                    <span class="booking-customer-avatar">@GetInitials(item.CustomerName)</span>
                                    <div class="booking-customer-meta">
                                        <span class="booking-customer-name">@item.CustomerName</span>
                                        <span class="booking-customer-phone">@item.ContactNumber</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (item.Details?.Vehicle != null)
                                {
                                    <div class="booking-vehicle-meta">
                                        <span class="booking-vehicle-name">@item.Details.Vehicle.Brand @item.Details.Vehicle.Model</span>
                                        <span class="booking-vehicle-type">@item.Details.Vehicle.Type</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Unassigned</span>
                                }
                            </td>
                            <td>
                                @(item.Details != null
                                    ? FormatDateRange(item.Details.PickupDate, item.Details.ReturnDate)
                                    : "—")
                            </td>
                            <td>
                                @if (payment != null)
                                {
                                    <div class="booking-vehicle-meta">
                                        <span class="booking-vehicle-name">@payment.PaymentMethod</span>
                                        <span class="booking-vehicle-type">₱@payment.AmountPaid.ToString("N2", CultureInfo.GetCultureInfo("en-PH")) · @payment.PaymentType</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">No payment</span>
                                }
                            </td>
                            <td>
                                <span class="booking-status-badge @StatusBadgeClass(item.RentalStatus)">@item.RentalStatus</span>
                                <div class="small text-muted mt-1">@item.RentalOption</div>
                            </td>
                            <td class="text-center">
                                <div class="dropdown">
                                    <button class="btn btn-link text-dark p-0 border-0 line-height-1" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed","placement":"bottom-end"}' data-bs-boundary="viewport">
                                        <i class="bi bi-three-dots fs-5"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.RentalId" asp-route-returnUrl="@indexReturnUrl"><i class="bi bi-pencil me-2"></i> Edit</a></li>
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.RentalId"><i class="bi bi-info-circle me-2"></i> Details</a></li>
                                        <li><hr class="dropdown-menu-divider"></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" onclick="openDeletePopup('@item.RentalId', '@bookingLabel')">
                                                <i class="bi bi-trash me-2"></i> Delete
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted fw-medium">
                            <i class="bi bi-calendar2-check fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            No matching bookings located.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_AdminPagination" />
</div>

@{
    ViewData["DeleteModalId"] = "reservationDeletePopup";
    ViewData["DeleteHiddenInputId"] = "popupRentalId";
    ViewData["DeleteMessageId"] = "deletePopupMessage";
    ViewData["DeleteEntityLabel"] = "reservation";
}
<partial name="_DeleteConfirmModal" />
