@model EasyRent_Checking.Models.Rental

@{
    ViewData["Title"] = "Delete";
    var details = Model?.Details;
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Rental</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Vehicle</dt>
        <dd class="col-sm-10">
            @(details?.Vehicle != null ? $"{details.Vehicle.Brand} {details.Vehicle.Model} ({details.Vehicle.Type})" : "Unassigned")
        </dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.CustomerName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.CustomerName)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ContactNumber)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ContactNumber)</dd>

        <dt class="col-sm-2">Pickup Location</dt>
        <dd class="col-sm-10">@(details?.PickupLocation ?? "—")</dd>

        <dt class="col-sm-2">Drop-off Location</dt>
        <dd class="col-sm-10">@(details?.DropoffLocation ?? "—")</dd>

        <dt class="col-sm-2">Pickup Date</dt>
        <dd class="col-sm-10">@(details?.PickupDate.ToString("MMM dd, yyyy") ?? "—")</dd>

        <dt class="col-sm-2">Return Date</dt>
        <dd class="col-sm-10">@(details?.ReturnDate.ToString("MMM dd, yyyy") ?? "—")</dd>

        <dt class="col-sm-2">Pickup Time</dt>
        <dd class="col-sm-10">@(details?.PickupTime.ToString("hh\\:mm tt") ?? "—")</dd>

        <dt class="col-sm-2">Return Time</dt>
        <dd class="col-sm-10">@(details?.ReturnTime.ToString("hh\\:mm tt") ?? "—")</dd>

        <dt class="col-sm-2">Passenger Count</dt>
        <dd class="col-sm-10">@(details?.PassengerCount.ToString() ?? "—")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Notes)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Notes)</dd>

        <dt class="col-sm-2">Discount</dt>
        <dd class="col-sm-10">@(details?.Discount.ToString() ?? "—")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.RentalStatus)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.RentalStatus)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="RentalId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
