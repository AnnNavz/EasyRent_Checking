@model EasyRent_Checking.ViewModels.RentalInputModel
@using EasyRent_Checking.Models

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Add New Rental";
    ViewData["ActivePage"] = "Rentals";
    ViewData["ShowPayLaterOption"] = true;
    ViewData["PaymentTypeFromStep"] = 2;
    ViewData["PaymentTypeBackStep"] = 1;
    var vehicles = ViewBag.Vehicles as IEnumerable<Vehicle> ?? Enumerable.Empty<Vehicle>();
    var initialUnavailableDates = ViewData["InitialUnavailableDates"] as IEnumerable<string> ?? Enumerable.Empty<string>();
    var initialUnavailableJson = System.Text.Json.JsonSerializer.Serialize(initialUnavailableDates);
    var wizardStartStep = ViewData["WizardStartStep"] as int? ?? 1;
    var pickupDateValue = Model?.PickupDate.Year >= 2000 ? Model.PickupDate.ToString("yyyy-MM-dd") : "";
    var returnDateValue = Model?.ReturnDate.Year >= 2000 ? Model.ReturnDate.ToString("yyyy-MM-dd") : "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/payment-wizard.css" asp-append-version="true" />
    <style>
        /* Past = grey (never red). Rented = solid red highlight. */
        .admin-booking-create .airbnb-cal-cell.is-past .airbnb-cal-day {
            color: #bdbdbd !important;
            background: transparent !important;
            text-decoration: none !important;
        }
        .admin-booking-create .airbnb-cal-cell.is-rented,
        .admin-booking-create .airbnb-cal-cell.is-rented:disabled {
            opacity: 1 !important;
            cursor: not-allowed !important;
        }
        .admin-booking-create .airbnb-cal-cell.is-rented .airbnb-cal-day,
        .admin-booking-create .airbnb-cal-cell.is-rented:disabled .airbnb-cal-day {
            color: #fff !important;
            background: #e53935 !important;
            text-decoration: none !important;
            box-shadow: 0 1px 3px rgba(229, 57, 53, 0.35) !important;
            opacity: 1 !important;
        }
        .admin-booking-create .btn-request-reservation {
            background-color: #1E3A8A !important;
            border-color: #1E3A8A !important;
            color: #fff !important;
        }
        .admin-booking-create .step-node.is-skipped,
        .admin-booking-create .wizard-step-panel.is-skipped {
            opacity: 0.45;
        }
    </style>
}

<div class="wizard-max-wrapper admin-booking-create py-3">
    <div class="step-timeline admin-booking-stepper">
        <div class="step-node active">
            <div class="step-circle">1</div>
            <div class="step-label">Info</div>
        </div>
        <div class="step-node">
            <div class="step-circle">2</div>
            <div class="step-label">Payment Type</div>
        </div>
        <div class="step-node" data-pay-now-only="true">
            <div class="step-circle">3</div>
            <div class="step-label">Payment Details</div>
        </div>
        <div class="step-node">
            <div class="step-circle">4</div>
            <div class="step-label">Summary</div>
        </div>
        <div class="step-node">
            <div class="step-circle">5</div>
            <div class="step-label">Complete</div>
        </div>
    </div>

    <form asp-action="Create" enctype="multipart/form-data" id="reservationWizardForm" novalidate>
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-warning py-2 px-3 small mb-3" role="status">
                Please fix the highlighted issues. Your typed details are kept — re-upload any ID or receipt images if needed (browsers clear file inputs after a failed submit).
            </div>
        }
        <input type="hidden" asp-for="RentalStatus" value="Approved" />
        <input type="hidden" asp-for="RentalOption" id="input-RentalOption" value="@Model.RentalOption" />

        <div class="wizard-step-panel active" id="reservationStep1">
            <div class="admin-create-step1-intro">
                <h1 class="admin-create-step1-title">Add walk-in rental</h1>
                <p class="admin-create-step1-subtitle">Enter customer details, trip dates, and passenger information. Payment choice comes next.</p>
            </div>

            <!-- Vehicle Information -->
            <div class="rent-step-card">
                <div class="rent-card-head">
                    <span class="rent-card-icon"><i class="bi bi-car-front"></i></span>
                    <h2>Vehicle Information</h2>
                </div>
                <p class="rent-card-hint mb-3">
                    Add one or more vehicles to this booking. They share the same pick-up / return schedule and one payment.
                </p>

                <div id="bookingVehiclesGallery" class="booking-vehicles-gallery" aria-live="polite"></div>

                <label class="rent-field-label mt-3" for="input-VehiclePicker">Add vehicle</label>
                <div class="d-flex flex-wrap gap-2 align-items-stretch">
                    <div class="flex-grow-1">
                        <select id="input-VehiclePicker" class="rent-field-input form-select">
                            <option value="">Select vehicle to add</option>
                            @foreach (var vehicle in vehicles)
                            {
                                var imageUrl = string.IsNullOrEmpty(vehicle.ImagePath) ? "" : Url.Content($"~/images/{vehicle.ImagePath}");
                                <option value="@vehicle.VehicleId"
                                        data-capacity="@vehicle.PassengersCount"
                                        data-base-price="@vehicle.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-succeeding-fee="@vehicle.SucceedingFee.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-brand="@vehicle.Brand"
                                        data-model="@vehicle.Model"
                                        data-type="@vehicle.Type"
                                        data-type-label="@VehicleTypes.DisplayUpper(vehicle.Type)"
                                        data-plate="@vehicle.PlateNumber"
                                        data-image="@imageUrl">
                                    @vehicle.Brand @vehicle.Model (@vehicle.PlateNumber)
                                </option>
                            }
                        </select>
                    </div>
                    <button type="button" class="rent-btn-continue" id="btnAddVehicle" style="white-space:nowrap;">+ Add vehicle</button>
                </div>
                <input type="hidden" asp-for="VehicleId" id="input-VehicleId" />
                <div id="selectedVehiclesHidden"></div>
                <div id="selectedVehiclesList" class="d-none" aria-hidden="true"></div>
                <span class="rent-field-help">All selected vehicles share one schedule. Remove any vehicle before checkout if needed.</span>
                <span asp-validation-for="VehicleId" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Rental Information -->
            <div class="rent-step-card">
                <div class="rent-card-head">
                    <span class="rent-card-icon"><i class="bi bi-file-earmark-text"></i></span>
                    <h2>Rental Information</h2>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerName" class="rent-field-label">Customer Name</label>
                        <input asp-for="CustomerName" id="CustomerName" class="rent-field-input" placeholder="e.g. Jane Doe" />
                        <span asp-validation-for="CustomerName" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ContactNumber" class="rent-field-label">Contact Information</label>
                        <input asp-for="ContactNumber" id="ContactNumber" class="rent-field-input" placeholder="09123456789 or +639123456789" />
                        <span asp-validation-for="ContactNumber" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PickupLocation" class="rent-field-label">Pick-up Location</label>
                        <input asp-for="PickupLocation" id="PickupLocation" class="rent-field-input" placeholder="e.g. Mactan International Airport" />
                        <span asp-validation-for="PickupLocation" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DropoffLocation" class="rent-field-label">Drop-off Location</label>
                        <input asp-for="DropoffLocation" id="DropoffLocation" class="rent-field-input" placeholder="e.g. Talisay, Cebu City" />
                        <span asp-validation-for="DropoffLocation" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>

            <!-- Pick-up & Return Date -->
            <div class="rent-step-card">
                <div class="rent-card-head">
                    <span class="rent-card-icon"><i class="bi bi-calendar3"></i></span>
                    <h2>Select Pick-up &amp; Return Date</h2>
                </div>
                <p class="rent-card-hint">
                    Click on available date to set your pick-up date, then select your return date. White = Available and Red = Rented.
                </p>

                <div class="row g-4 airbnb-cal-split align-items-start">
                    <div class="col-lg-7">
                        <div class="airbnb-cal-card mb-0">
                            <div class="airbnb-cal-header">
                                <button type="button" class="airbnb-cal-nav" id="calPrev" aria-label="Previous month">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <span class="airbnb-cal-month" id="calMonthLabel">July 2026</span>
                                <button type="button" class="airbnb-cal-nav" id="calNext" aria-label="Next month">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                            <div class="airbnb-cal-weekdays">
                                <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
                            </div>
                            <div class="airbnb-cal-grid" id="calGrid"></div>
                            <div class="airbnb-cal-legend">
                                <span><i class="airbnb-legend-dot is-unavailable"></i>Unavailable</span>
                                <span><i class="airbnb-legend-dot is-return"></i>Return</span>
                                <span><i class="airbnb-legend-dot is-range"></i>Range</span>
                                <span><i class="airbnb-legend-dot is-pickup"></i>Selected</span>
                                <span><i class="airbnb-legend-dot is-rented"></i>Rented</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5 airbnb-date-fields-side">
                        <input type="hidden" name="PickupDate" id="input-PickupDate" value="@pickupDateValue" />
                        <input type="hidden" name="ReturnDate" id="input-ReturnDate" value="@returnDateValue" />

                        <label class="rent-field-label">Pick-up Date &amp; Time</label>
                        <div class="airbnb-datetime-stack mb-3">
                            <div class="airbnb-date-field">
                                <input type="date" id="pickupDisplay" class="airbnb-date-input" />
                                <i class="bi bi-calendar3 airbnb-date-icon" aria-hidden="true"></i>
                            </div>
                            <div class="airbnb-date-field">
                                <input asp-for="PickupTime" id="input-PickupTime" type="time" class="airbnb-time-input" value="09:00" />
                                <i class="bi bi-clock airbnb-date-icon" aria-hidden="true"></i>
                            </div>
                        </div>
                        <span asp-validation-for="PickupDate" class="text-danger small mt-1 d-block"></span>
                        <span asp-validation-for="PickupTime" class="text-danger small mt-1 d-block"></span>

                        <label class="rent-field-label">Return Date &amp; Time</label>
                        <div class="airbnb-datetime-stack">
                            <div class="airbnb-date-field">
                                <input type="date" id="returnDisplay" class="airbnb-date-input" />
                                <i class="bi bi-calendar3 airbnb-date-icon" aria-hidden="true"></i>
                            </div>
                            <div class="airbnb-date-field">
                                <input asp-for="ReturnTime" id="input-ReturnTime" type="time" class="airbnb-time-input" value="17:00" />
                                <i class="bi bi-clock airbnb-date-icon" aria-hidden="true"></i>
                            </div>
                        </div>
                        <span asp-validation-for="ReturnDate" class="text-danger small mt-1 d-block"></span>
                        <span asp-validation-for="ReturnTime" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>

            <!-- Passenger & Discount -->
            <div class="rent-step-card">
                <div class="rent-card-head">
                    <span class="rent-card-icon"><i class="bi bi-people"></i></span>
                    <h2>Passenger &amp; Discount</h2>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="PassengerCount" class="rent-field-label">Passenger Count</label>
                        <select asp-for="PassengerCount" id="input-PassengerCount" class="rent-field-input form-select">
                            <option value="">Select Capacity</option>
                        </select>
                        <span class="rent-field-help" id="capacityHint">Maximum capacity: select a vehicle.</span>
                        <span asp-validation-for="PassengerCount" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Discount" class="rent-field-label">Senior/PWD Discount (if applicable)</label>
                        <select asp-for="Discount" id="input-Discount" class="rent-field-input form-select">
                            <option value="No">No</option>
                            <option value="Yes">Yes</option>
                        </select>
                        <span class="rent-field-help">10% discount - present valid ID upon booking.</span>
                        <span asp-validation-for="Discount" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-12 @(Model?.Discount == Discount.Yes ? "" : "d-none")" id="discountUploadSection">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="discount-id-panel">
                                    <div class="discount-id-panel-title">Front</div>
                                    <div id="discount-front-upload-zone" class="license-upload-zone discount-id-upload-zone">
                                        <div>
                                            <i class="bi bi-person-vcard fs-3 text-muted d-block mb-2"></i>
                                            <span class="d-block small fw-semibold mb-1">Drag &amp; drop or click to upload</span>
                                            <span class="d-block text-muted" style="font-size: 0.72rem;">PNG, JPG, or JPEG (max 5MB)</span>
                                        </div>
                                        <input asp-for="DiscountImageFile" id="input-DiscountFile" type="file" class="license-file-input" accept=".png,.jpg,.jpeg" />
                                    </div>
                                    <div id="discount-front-preview-state" class="d-none">
                                        <div class="license-preview-box" id="discount-front-preview-box" title="Click to replace image">
                                            <img id="discount-front-preview-img" class="d-none" alt="Front ID preview" />
                                        </div>
                                        <div class="upload-preview-bar d-flex align-items-center justify-content-between">
                                            <span id="discount-front-filename" class="small fw-semibold text-muted font-monospace" style="font-size:0.8rem;"></span>
                                            <button type="button" class="upload-preview-remove-btn" id="discount-front-remove-btn">Remove</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="discount-id-panel">
                                    <div class="discount-id-panel-title">Back</div>
                                    <div id="discount-back-upload-zone" class="license-upload-zone discount-id-upload-zone">
                                        <div>
                                            <i class="bi bi-person-vcard fs-3 text-muted d-block mb-2"></i>
                                            <span class="d-block small fw-semibold mb-1">Drag &amp; drop or click to upload</span>
                                            <span class="d-block text-muted" style="font-size: 0.72rem;">PNG, JPG, or JPEG (max 5MB)</span>
                                        </div>
                                        <input type="file" id="input-DiscountBackFile" class="license-file-input" accept=".png,.jpg,.jpeg" />
                                    </div>
                                    <div id="discount-back-preview-state" class="d-none">
                                        <div class="license-preview-box" id="discount-back-preview-box" title="Click to replace image">
                                            <img id="discount-back-preview-img" class="d-none" alt="Back ID preview" />
                                        </div>
                                        <div class="upload-preview-bar d-flex align-items-center justify-content-between">
                                            <span id="discount-back-filename" class="small fw-semibold text-muted font-monospace" style="font-size:0.8rem;"></span>
                                            <button type="button" class="upload-preview-remove-btn" id="discount-back-remove-btn">Remove</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="DiscountImageFile" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>

            <!-- Additional Information -->
            <div class="rent-step-card">
                <div class="rent-card-head">
                    <span class="rent-card-icon"><i class="bi bi-file-earmark-plus"></i></span>
                    <h2>Additional Information</h2>
                </div>

                <label asp-for="Notes" class="rent-field-label">Special Requests/ Notes (Optional)</label>
                <textarea asp-for="Notes" id="input-Notes" class="rent-field-input rent-field-textarea" rows="4" placeholder="e.g. Please prepare child seats, need early morning pick-up, allergic to cigarette smoke..."></textarea>
                <span asp-validation-for="Notes" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="rent-step-actions">
                <a asp-action="Index" class="rent-btn-cancel">Cancel</a>
                <button type="button" class="rent-btn-continue" data-wizard-next="1">
                    Continue to Payment Type
                </button>
            </div>
        </div>

        <div class="wizard-step-panel" id="reservationStep2">
            <div class="admin-payment-step-layout">
                <div class="admin-payment-step-main">
                    <partial name="_ClientPaymentMethodStep" model="Model" />
                </div>
                <aside class="admin-trip-summary-sidebar" id="adminTripSummarySidebar" aria-label="Rental summary">
                    <div class="rent-vehicle-preview">
                        <div class="rent-vehicle-preview-image" id="tripSummaryImageWrap">
                            <div class="admin-rental-summary-placeholder" id="tripSummaryImagePlaceholder" aria-hidden="true">
                                <i class="bi bi-car-front"></i>
                            </div>
                            <img id="tripSummaryImage" class="d-none" alt="Selected vehicle" />
                        </div>
                        <div class="rent-vehicle-preview-meta">
                            <strong id="tripSummaryName">Select a vehicle</strong>
                            <p id="tripSummaryMeta"><span id="tripSummaryType">—</span></p>
                        </div>
                    </div>

                    <div class="rent-trip-card">
                        <div class="rent-trip-row">
                            <span>Pickup Date</span>
                            <strong id="tripSummaryPickup">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Return Date</span>
                            <strong id="tripSummaryReturn">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Duration</span>
                            <strong id="tripSummaryDuration">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Passengers</span>
                            <strong id="tripSummaryPassengers">—</strong>
                        </div>

                        <div class="rent-trip-row rent-trip-row--total">
                            <span>Base Package</span>
                            <strong id="tripSummaryBasePrice">₱0.00</strong>
                        </div>
                    </div>
                </aside>
            </div>
        </div>

        <div class="wizard-step-panel" id="reservationStep3" data-pay-now-only="true">
            @{
                ViewData["HidePaymentReminders"] = true;
            }
            <div class="admin-payment-step-layout">
                <div class="admin-payment-step-main">
                    <partial name="_ClientPaymentDetailsStep" model="Model" />
                </div>
                <aside class="admin-trip-summary-sidebar admin-payment-details-sidebar" aria-label="Payment summary">
                    <div class="rent-vehicle-preview">
                        <div class="rent-vehicle-preview-image">
                            <div class="admin-rental-summary-placeholder" id="payDetailsImagePlaceholder" aria-hidden="true">
                                <i class="bi bi-car-front"></i>
                            </div>
                            <img id="payDetailsImage" class="d-none" alt="Selected vehicle" />
                        </div>
                        <div class="rent-vehicle-preview-meta">
                            <strong id="payDetailsName">Select a vehicle</strong>
                            <p id="payDetailsMeta"><span id="payDetailsType">—</span></p>
                        </div>
                    </div>

                    <div class="rent-trip-card">
                        <div class="rent-trip-row">
                            <span>Customer</span>
                            <strong id="payDetailsCustomer">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Pickup Date</span>
                            <strong id="payDetailsPickup">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Return Date</span>
                            <strong id="payDetailsReturn">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Duration</span>
                            <strong id="payDetailsDuration">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Passengers</span>
                            <strong id="payDetailsPassengers">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Discount</span>
                            <strong id="payDetailsDiscount">None</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Status</span>
                            <strong id="payDetailsStatus">—</strong>
                        </div>

                        <div class="rent-trip-box" id="payDetailsCostBreakdown">
                            <div class="rent-trip-row" id="payDetailsPartialRow">
                                <span>Partial Payment</span>
                                <strong id="payDetailsPartialAmount">₱0.00</strong>
                            </div>
                            <div class="rent-trip-row" id="payDetailsExceedingRow">
                                <span id="payDetailsExceedingLabel">Exceeding Hours</span>
                                <strong id="payDetailsExceedingAmount">₱0.00</strong>
                            </div>
                            <div class="rent-trip-row rent-trip-row--total">
                                <span>Total Amount</span>
                                <strong id="payDetailsTotalAmount">₱0.00</strong>
                            </div>
                        </div>
                    </div>

                    <div class="remaining-balance-card d-none" id="payDetailsBalanceBox">
                        <div class="remaining-balance-row">
                            <span>Remaining Balance</span>
                            <strong id="payDetailsRemaining">₱0.00</strong>
                        </div>
                        <div class="remaining-balance-note-box">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>Please pay this exact amount to the driver upon arrival.</span>
                        </div>
                    </div>

                    <div class="payment-reminders-sidebar-card">
                        <div class="payment-reminders-sidebar-title">
                            <span class="payment-reminders-sidebar-icon" aria-hidden="true">i</span>
                            <span>Important Reminders</span>
                        </div>
                        <ul>
                            <li>Send the exact amount given to avoid delays.</li>
                            <li>Use the correct QR code or account details for your selected channel.</li>
                            <li>Keep the transaction receipt for reference.</li>
                        </ul>
                    </div>
                </aside>
            </div>
        </div>

        <div class="wizard-step-panel" id="reservationStep4">
            @{
                ViewData["SummaryConfirmLabel"] = "Continue";
                ViewData["SummaryBackStep"] = "3";
                ViewData["IsReserveFlow"] = Model.RentalOption == RentalOption.Reserve;
            }
            <div class="admin-payment-step-layout">
                <div class="admin-payment-step-main">
                    <partial name="_BookingSummaryStep" />
                </div>
                <aside class="admin-trip-summary-sidebar admin-summary-sidebar" aria-label="Booking summary">
                    <div class="rent-vehicle-preview">
                        <div class="rent-vehicle-preview-image">
                            <div class="admin-rental-summary-placeholder" id="summarySideImagePlaceholder" aria-hidden="true">
                                <i class="bi bi-car-front"></i>
                            </div>
                            <img id="summarySideImage" class="d-none" alt="Selected vehicle" />
                        </div>
                        <div class="rent-vehicle-preview-meta">
                            <strong id="summarySideName">Select a vehicle</strong>
                            <p id="summarySideMeta">—</p>
                        </div>
                    </div>

                    <div class="rent-trip-card">
                        <div class="rent-trip-row">
                            <span>Customer</span>
                            <strong id="summarySideCustomer">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Pickup Date</span>
                            <strong id="summarySidePickup">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Return Date</span>
                            <strong id="summarySideReturn">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Duration</span>
                            <strong id="summarySideDuration">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Passengers</span>
                            <strong id="summarySidePassengers">—</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Discount</span>
                            <strong id="summarySideDiscount">None</strong>
                        </div>
                        <div class="rent-trip-row">
                            <span>Status</span>
                            <strong id="summarySideStatus">—</strong>
                        </div>

                        <div class="rent-trip-box" id="summarySideCostBreakdown">
                            <div class="rent-trip-row" id="summarySidePartialRow">
                                <span id="summarySidePartialLabel">Full Payment</span>
                                <strong id="summarySidePartialAmount">₱0.00</strong>
                            </div>
                            <div class="rent-trip-row d-none" id="summarySideExceedingRow">
                                <span id="summarySideExceedingLabel">Exceeding Hours</span>
                                <strong id="summarySideExceedingAmount">₱0.00</strong>
                            </div>
                            <div class="rent-trip-row rent-trip-row--total">
                                <span>Total Amount</span>
                                <strong id="summarySideTotalAmount">₱0.00</strong>
                            </div>
                        </div>
                    </div>

                    <div class="remaining-balance-card d-none" id="summarySideBalanceBox">
                        <div class="remaining-balance-row">
                            <span>Remaining Balance</span>
                            <strong id="summarySideRemaining">₱0.00</strong>
                        </div>
                        <div class="remaining-balance-note-box">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>Please pay this exact amount to the driver upon arrival.</span>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/booking-summary.js" asp-append-version="true"></script>
    <script src="~/js/availability-calendar.js" asp-append-version="true"></script>
    <script>
        (function () {
            const pickupDateInput = document.getElementById('input-PickupDate');
            const returnDateInput = document.getElementById('input-ReturnDate');
            const vehicleSelect = document.getElementById('input-VehicleId');
            const vehiclePicker = document.getElementById('input-VehiclePicker');
            const selectedVehiclesList = document.getElementById('selectedVehiclesList');
            const selectedVehiclesHidden = document.getElementById('selectedVehiclesHidden');
            const bookingVehiclesGallery = document.getElementById('bookingVehiclesGallery');
            const btnAddVehicle = document.getElementById('btnAddVehicle');
            const passengerInput = document.getElementById('input-PassengerCount');
            const capacityHint = document.getElementById('capacityHint');
            const discountSelect = document.getElementById('input-Discount');
            const discountSection = document.getElementById('discountUploadSection');
            const fileInput = document.getElementById('input-DiscountFile');
            const backFileInput = document.getElementById('input-DiscountBackFile');
            const frontUploadZone = document.getElementById('discount-front-upload-zone');
            const frontPreviewState = document.getElementById('discount-front-preview-state');
            const frontFilenameLabel = document.getElementById('discount-front-filename');
            const frontRemoveBtn = document.getElementById('discount-front-remove-btn');
            const frontPreviewImg = document.getElementById('discount-front-preview-img');
            const backUploadZone = document.getElementById('discount-back-upload-zone');
            const backPreviewState = document.getElementById('discount-back-preview-state');
            const backFilenameLabel = document.getElementById('discount-back-filename');
            const backRemoveBtn = document.getElementById('discount-back-remove-btn');
            const backPreviewImg = document.getElementById('discount-back-preview-img');
            const frontPreviewBox = document.getElementById('discount-front-preview-box');
            const backPreviewBox = document.getElementById('discount-back-preview-box');
            const notesInput = document.getElementById('input-Notes');
            const customerNameInput = document.getElementById('CustomerName');
            const contactInput = document.getElementById('ContactNumber');
            const pickupLocationInput = document.getElementById('PickupLocation');
            const dropoffLocationInput = document.getElementById('DropoffLocation');
            const pickupTimeInput = document.getElementById('input-PickupTime');
            const returnTimeInput = document.getElementById('input-ReturnTime');
            const initialPassengerCount = '@(Model?.PassengerCount > 0 ? Model.PassengerCount.ToString() : "")';
            const initialVehicleIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.GetNormalizedVehicleIds() ?? Array.Empty<int>()));
            let selectedVehicleIds = Array.isArray(initialVehicleIds) ? initialVehicleIds.map(Number).filter(function (id) { return id > 0; }) : [];
            let calendar;

            function getPickerOption(vehicleId) {
                if (!vehiclePicker) return null;
                return Array.from(vehiclePicker.options).find(function (o) { return String(o.value) === String(vehicleId); }) || null;
            }

            function getPrimaryVehicleOption() {
                if (!selectedVehicleIds.length) return null;
                return getPickerOption(selectedVehicleIds[0]);
            }

            function escapeHtml(value) {
                return String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function formatPeso(amount) {
                return BookingSummary.formatPeso(amount);
            }

            function getVehicleMeta(vehicleId) {
                const opt = getPickerOption(vehicleId);
                if (!opt) return null;
                return {
                    id: Number(opt.value),
                    capacity: parseInt(opt.dataset.capacity || '0', 10) || 0,
                    basePrice: parseFloat(opt.dataset.basePrice || '0') || 0,
                    succeedingFee: parseFloat(opt.dataset.succeedingFee || '0') || 0,
                    brand: opt.dataset.brand || '',
                    model: opt.dataset.model || '',
                    typeLabel: opt.dataset.typeLabel || opt.dataset.type || '',
                    plate: opt.dataset.plate || '',
                    image: opt.dataset.image || '',
                    locked: false
                };
            }

            function renderVehicleGallery() {
                if (!bookingVehiclesGallery) return;
                if (!selectedVehicleIds.length) {
                    bookingVehiclesGallery.innerHTML = '<p class="booking-vehicles-empty text-muted small mb-0">No vehicles added yet. Select a vehicle above to begin.</p>';
                    return;
                }

                bookingVehiclesGallery.innerHTML = selectedVehicleIds.map(function (id) {
                    const meta = getVehicleMeta(id);
                    if (!meta) {
                        return '<article class="booking-vehicle-info-card"><div class="booking-vehicle-info-body"><h3 class="booking-vehicle-info-name">Vehicle #' + id + '</h3></div></article>';
                    }
                    const name = escapeHtml((meta.brand + ' ' + meta.model).trim());
                    const typeLabel = escapeHtml(meta.typeLabel || 'Vehicle');
                    const plate = escapeHtml(meta.plate || '—');
                    const media = meta.image
                        ? '<img src="' + escapeHtml(meta.image) + '" alt="' + name + '" />'
                        : '<span class="booking-vehicle-info-placeholder" aria-hidden="true"><i class="bi bi-car-front"></i></span>';
                    return ''
                        + '<article class="booking-vehicle-info-card" data-vehicle-id="' + meta.id + '">'
                        +   '<div class="booking-vehicle-info-media">' + media + '</div>'
                        +   '<div class="booking-vehicle-info-body">'
                        +     '<span class="booking-vehicle-info-type">' + typeLabel + '</span>'
                        +     '<h3 class="booking-vehicle-info-name">' + name + '</h3>'
                        +     '<p class="booking-vehicle-info-specs">' + plate + ' • ' + meta.capacity + ' seater</p>'
                        +     '<p class="booking-vehicle-info-rates">'
                        +       'Base ' + formatPeso(meta.basePrice)
                        +       ' · +' + formatPeso(meta.succeedingFee) + '/hr after 8h'
                        +     '</p>'
                        +   '</div>'
                        +   '<div class="booking-vehicle-info-actions">'
                        +     '<button type="button" class="booking-vehicle-info-remove" data-remove-vehicle="' + meta.id + '" aria-label="Remove vehicle"><i class="bi bi-x-lg"></i></button>'
                        +   '</div>'
                        + '</article>';
                }).join('');
            }

            function syncVehicleFormFields() {
                if (vehicleSelect) vehicleSelect.value = selectedVehicleIds[0] ? String(selectedVehicleIds[0]) : '';
                if (selectedVehiclesHidden) {
                    selectedVehiclesHidden.innerHTML = selectedVehicleIds.map(function (id, index) {
                        return '<input type="hidden" name="VehicleIds[' + index + ']" value="' + id + '" />';
                    }).join('');
                }
                if (selectedVehiclesList) {
                    if (!selectedVehicleIds.length) {
                        selectedVehiclesList.innerHTML = '<span class="text-muted small">No vehicles added yet.</span>';
                    } else {
                        selectedVehiclesList.innerHTML = selectedVehicleIds.map(function (id) {
                            const opt = getPickerOption(id);
                            const label = opt
                                ? ((opt.dataset.brand || '') + ' ' + (opt.dataset.model || '') + ' (' + (opt.dataset.plate || '') + ')').trim()
                                : ('Vehicle #' + id);
                            return '<span class="selected-vehicle-chip" data-vehicle-id="' + id + '">'
                                + '<span>' + label + '</span>'
                                + '<button type="button" class="selected-vehicle-remove" data-remove-vehicle="' + id + '" aria-label="Remove vehicle">&times;</button>'
                                + '</span>';
                        }).join('');
                    }
                }
                renderVehicleGallery();
                if (vehiclePicker) {
                    Array.from(vehiclePicker.options).forEach(function (opt) {
                        if (!opt.value) return;
                        opt.disabled = selectedVehicleIds.indexOf(Number(opt.value)) >= 0;
                    });
                }
            }

            function addSelectedVehicle(vehicleId) {
                const id = Number(vehicleId);
                if (!id || selectedVehicleIds.indexOf(id) >= 0) return false;
                selectedVehicleIds.push(id);
                syncVehicleFormFields();
                updateCapacityHint();
                syncPaymentFare();
                updateTripSummarySidebar();
                if (calendar && calendar.loadAvailability) calendar.loadAvailability();
                return true;
            }

            function removeSelectedVehicle(vehicleId) {
                const id = Number(vehicleId);
                selectedVehicleIds = selectedVehicleIds.filter(function (x) { return x !== id; });
                syncVehicleFormFields();
                updateCapacityHint();
                syncPaymentFare();
                updateTripSummarySidebar();
                if (calendar && calendar.loadAvailability) calendar.loadAvailability();
            }

            function rebuildPassengerOptions(capacity, preferredValue) {
                const current = (preferredValue != null && preferredValue !== '')
                    ? String(preferredValue)
                    : String(passengerInput.value || '');
                passengerInput.innerHTML = '<option value="">Select Capacity</option>';
                const max = parseInt(capacity, 10);
                if (!max || max < 1) return;
                for (let i = 1; i <= max; i++) {
                    const opt = document.createElement('option');
                    opt.value = String(i);
                    opt.textContent = String(i);
                    passengerInput.appendChild(opt);
                }
                if (current && parseInt(current, 10) <= max) {
                    passengerInput.value = current;
                }
            }

            function updateCapacityHint() {
                const option = getPrimaryVehicleOption();
                const capacity = option && option.dataset.capacity ? option.dataset.capacity : null;
                if (capacity) {
                    capacityHint.textContent = 'Maximum capacity (first vehicle): ' + capacity + ' passengers.';
                    rebuildPassengerOptions(capacity, passengerInput.value || initialPassengerCount);
                } else {
                    capacityHint.textContent = 'Maximum capacity: add a vehicle.';
                    rebuildPassengerOptions(0);
                }
            }

            function clearFrontDiscountFile() {
                fileInput.value = '';
                frontFilenameLabel.textContent = '';
                BookingSummary.clearImagePreview(frontPreviewImg);
                frontUploadZone.classList.remove('d-none');
                frontPreviewState.classList.add('d-none');
            }

            function clearBackDiscountFile() {
                if (backFileInput) backFileInput.value = '';
                if (backFilenameLabel) backFilenameLabel.textContent = '';
                BookingSummary.clearImagePreview(backPreviewImg);
                backUploadZone?.classList.remove('d-none');
                backPreviewState?.classList.add('d-none');
            }

            function toggleDiscountUpload() {
                const isYes = discountSelect.value === 'Yes';
                discountSection.classList.toggle('d-none', !isYes);
                if (!isYes) {
                    clearFrontDiscountFile();
                    clearBackDiscountFile();
                }
            }

            function showFrontDiscountPreview(file) {
                if (!file) return;
                frontFilenameLabel.textContent = file.name;
                BookingSummary.showImagePreview(file, frontPreviewImg);
                frontUploadZone.classList.add('d-none');
                frontPreviewState.classList.remove('d-none');
            }

            function showBackDiscountPreview(file) {
                if (!file || !backFilenameLabel) return;
                backFilenameLabel.textContent = file.name;
                BookingSummary.showImagePreview(file, backPreviewImg);
                backUploadZone?.classList.add('d-none');
                backPreviewState?.classList.remove('d-none');
            }

            function formatSummaryDate(dateStr, timeStr) {
                if (!dateStr) return '—';
                const parse = (calendar && calendar.parseDate) || AvailabilityCalendar.parseDate;
                const d = parse(dateStr);
                if (!d) return '—';
                const months = ['Jan.', 'Feb.', 'Mar.', 'Apr.', 'May', 'Jun.', 'Jul.', 'Aug.', 'Sep.', 'Oct.', 'Nov.', 'Dec.'];
                let timeLabel = '';
                if (timeStr) {
                    const parts = timeStr.split(':');
                    let h = parseInt(parts[0], 10);
                    const m = parts[1] || '00';
                    const ampm = h >= 12 ? 'PM' : 'AM';
                    h = h % 12 || 12;
                    timeLabel = ' • ' + h + ':' + m + ' ' + ampm;
                }
                return months[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear() + timeLabel;
            }

            function formatSummaryDuration(hours) {
                if (!hours || hours <= 0) return '—';
                if (hours < 24) {
                    const h = Math.max(1, Math.round(hours));
                    return h === 1 ? '1 hour' : h + ' hours';
                }
                const days = Math.max(1, Math.round(hours / 24));
                return days === 1 ? '1 day' : days + ' days';
            }

            function updateTripSummarySidebar() {
                const opt = getPrimaryVehicleOption();
                const typeEl = document.getElementById('tripSummaryType');
                const metaEl = document.getElementById('tripSummaryMeta');
                const nameEl = document.getElementById('tripSummaryName');
                const img = document.getElementById('tripSummaryImage');
                const placeholder = document.getElementById('tripSummaryImagePlaceholder');
                const pickupEl = document.getElementById('tripSummaryPickup');
                const returnEl = document.getElementById('tripSummaryReturn');
                const durationEl = document.getElementById('tripSummaryDuration');
                const passengersEl = document.getElementById('tripSummaryPassengers');
                const basePriceEl = document.getElementById('tripSummaryBasePrice');

                const hours = BookingSummary.calcHours(
                    pickupDateInput.value,
                    pickupTimeInput.value,
                    returnDateInput.value,
                    returnTimeInput.value
                );
                const durationText = formatSummaryDuration(hours);
                const pickupText = formatSummaryDate(pickupDateInput.value, pickupTimeInput.value);
                const returnText = formatSummaryDate(returnDateInput.value, returnTimeInput.value);
                const passengersText = passengerInput.value || '—';

                if (opt && opt.value) {
                    const type = (opt.dataset.type || '').toUpperCase();
                    const modelName = (opt.dataset.model || '').trim();
                    const name = (modelName + ' ' + (opt.dataset.brand || '')).trim() || 'Vehicle';
                    const imageUrl = opt.dataset.image || '';
                    const base = parseFloat(opt.dataset.basePrice || '0');
                    const capacity = opt.dataset.capacity || '';

                    if (nameEl) nameEl.textContent = modelName || name;
                    if (typeEl) typeEl.textContent = type || '—';
                    if (metaEl) {
                        metaEl.textContent = capacity
                            ? ((type || '—') + ' • ' + capacity + ' seater')
                            : (type || '—');
                    }
                    if (img && placeholder) {
                        if (imageUrl) {
                            img.src = imageUrl;
                            img.classList.remove('d-none');
                            placeholder.classList.add('d-none');
                        } else {
                            img.classList.add('d-none');
                            placeholder.classList.remove('d-none');
                        }
                    }
                    if (basePriceEl) basePriceEl.textContent = BookingSummary.formatPeso(base);
                } else {
                    if (nameEl) nameEl.textContent = 'Select a vehicle';
                    if (typeEl) typeEl.textContent = '—';
                    if (metaEl) metaEl.textContent = '—';
                    if (img) img.classList.add('d-none');
                    if (placeholder) placeholder.classList.remove('d-none');
                    if (basePriceEl) basePriceEl.textContent = BookingSummary.formatPeso(0);
                }

                if (pickupEl) pickupEl.textContent = pickupText;
                if (returnEl) returnEl.textContent = returnText;
                if (durationEl) durationEl.textContent = durationText;
                if (passengersEl) passengersEl.textContent = passengersText;

                updatePaymentDetailsSidebar();
            }

            function updatePaymentDetailsSidebar() {
                const opt = getPrimaryVehicleOption();
                const img = document.getElementById('payDetailsImage');
                const placeholder = document.getElementById('payDetailsImagePlaceholder');
                const typeEl = document.getElementById('payDetailsType');
                const metaEl = document.getElementById('payDetailsMeta');
                const nameEl = document.getElementById('payDetailsName');
                if (!nameEl) return;

                const hours = BookingSummary.calcHours(
                    pickupDateInput.value,
                    pickupTimeInput.value,
                    returnDateInput.value,
                    returnTimeInput.value
                );
                const basePrice = opt ? parseFloat(opt.dataset.basePrice || '0') : 0;
                const succeedingFee = opt ? parseFloat(opt.dataset.succeedingFee || '0') : 0;
                const succeedingHours = Math.max(0, hours - 8);
                const succeedingAmount = succeedingHours * succeedingFee;
                let subtotal = basePrice + succeedingAmount;
                const hasDiscount = discountSelect.value === 'Yes';
                if (hasDiscount) subtotal -= subtotal * 0.10;
                const total = Math.round(subtotal * 100) / 100;

                const payChoice = getPayOptionChoice();
                const isPartial = payChoice === 'Partial';
                const block = document.querySelector('.payment-type-block');
                const depositPercent = parseFloat(block?.dataset.depositPercent || '5');
                const partialAmount = isPartial
                    ? Math.round(total * (depositPercent / 100) * 100) / 100
                    : total;
                const remaining = Math.max(0, Math.round((total - partialAmount) * 100) / 100);
                const payNowAmount = isPartial ? partialAmount : total;

                if (opt && opt.value) {
                    const type = (opt.dataset.type || '').toUpperCase() || '—';
                    const modelName = (opt.dataset.model || '').trim();
                    const name = (modelName + ' ' + (opt.dataset.brand || '')).trim() || 'Vehicle';
                    const capacity = opt.dataset.capacity || '';
                    if (typeEl) typeEl.textContent = type;
                    nameEl.textContent = modelName || name;
                    if (metaEl) {
                        metaEl.textContent = capacity
                            ? (type + ' • ' + capacity + ' seater')
                            : type;
                    }
                    const imageUrl = opt.dataset.image || '';
                    if (img && placeholder) {
                        if (imageUrl) {
                            img.src = imageUrl;
                            img.classList.remove('d-none');
                            placeholder.classList.add('d-none');
                        } else {
                            img.classList.add('d-none');
                            placeholder.classList.remove('d-none');
                        }
                    }
                } else {
                    if (typeEl) typeEl.textContent = '—';
                    nameEl.textContent = 'Select a vehicle';
                    if (metaEl) metaEl.textContent = '—';
                    if (img) img.classList.add('d-none');
                    if (placeholder) placeholder.classList.remove('d-none');
                }

                document.getElementById('payDetailsCustomer') && (document.getElementById('payDetailsCustomer').textContent = customerNameInput.value.trim() || '—');
                document.getElementById('payDetailsPickup') && (document.getElementById('payDetailsPickup').textContent = formatSummaryDate(pickupDateInput.value, pickupTimeInput.value));
                document.getElementById('payDetailsReturn') && (document.getElementById('payDetailsReturn').textContent = formatSummaryDate(returnDateInput.value, returnTimeInput.value));
                document.getElementById('payDetailsDuration') && (document.getElementById('payDetailsDuration').textContent = formatSummaryDuration(hours));
                document.getElementById('payDetailsPassengers') && (document.getElementById('payDetailsPassengers').textContent = passengerInput.value || '—');
                document.getElementById('payDetailsDiscount') && (document.getElementById('payDetailsDiscount').textContent = hasDiscount ? 'Senior (10%)' : 'None');
                document.getElementById('payDetailsStatus') && (document.getElementById('payDetailsStatus').textContent = isPartial ? 'Partially Paid' : (payChoice === 'Reserve' ? 'Pay Later' : 'Fully Paid'));

                const partialRow = document.getElementById('payDetailsPartialRow');
                const exceedingRow = document.getElementById('payDetailsExceedingRow');
                const balanceBox = document.getElementById('payDetailsBalanceBox');
                if (partialRow) {
                    const label = partialRow.querySelector('span');
                    if (label) label.textContent = isPartial ? 'Partial Payment' : (payChoice === 'Reserve' ? 'Estimated Total' : 'Full Payment');
                    document.getElementById('payDetailsPartialAmount').textContent = BookingSummary.formatPeso(payNowAmount);
                }
                if (exceedingRow) {
                    const showExceeding = succeedingHours > 0;
                    exceedingRow.classList.toggle('d-none', !showExceeding);
                    document.getElementById('payDetailsExceedingLabel').textContent =
                        'Exceeding Hours (' + (succeedingHours % 1 === 0 ? succeedingHours : succeedingHours.toFixed(1)) + 'hr)';
                    document.getElementById('payDetailsExceedingAmount').textContent = BookingSummary.formatPeso(succeedingAmount);
                }
                document.getElementById('payDetailsTotalAmount').textContent = BookingSummary.formatPeso(total);
                if (balanceBox) {
                    balanceBox.classList.toggle('d-none', !isPartial || remaining <= 0);
                    document.getElementById('payDetailsRemaining').textContent = BookingSummary.formatPeso(remaining);
                }
            }

            function updateSummarySidebar() {
                const opt = getPrimaryVehicleOption();
                const img = document.getElementById('summarySideImage');
                const placeholder = document.getElementById('summarySideImagePlaceholder');
                const metaEl = document.getElementById('summarySideMeta');
                const nameEl = document.getElementById('summarySideName');
                if (!nameEl) return;

                const hours = BookingSummary.calcHours(
                    pickupDateInput.value,
                    pickupTimeInput.value,
                    returnDateInput.value,
                    returnTimeInput.value
                );
                const basePrice = opt ? parseFloat(opt.dataset.basePrice || '0') : 0;
                const succeedingFee = opt ? parseFloat(opt.dataset.succeedingFee || '0') : 0;
                const succeedingHours = Math.max(0, hours - 8);
                const succeedingAmount = succeedingHours * succeedingFee;
                let subtotal = basePrice + succeedingAmount;
                const hasDiscount = discountSelect.value === 'Yes';
                if (hasDiscount) subtotal -= subtotal * 0.10;
                const total = Math.round(subtotal * 100) / 100;

                const payChoice = getPayOptionChoice();
                const isPartial = payChoice === 'Partial';
                const block = document.querySelector('.payment-type-block');
                const depositPercent = parseFloat(block?.dataset.depositPercent || '5');
                const partialAmount = isPartial
                    ? Math.round(total * (depositPercent / 100) * 100) / 100
                    : total;
                const remaining = Math.max(0, Math.round((total - partialAmount) * 100) / 100);
                const payNowAmount = isPartial ? partialAmount : total;

                if (opt && opt.value) {
                    const type = (opt.dataset.type || '').toUpperCase() || '—';
                    const modelName = (opt.dataset.model || '').trim();
                    const name = (modelName + ' ' + (opt.dataset.brand || '')).trim() || 'Vehicle';
                    const capacity = opt.dataset.capacity || '';
                    nameEl.textContent = modelName || name;
                    if (metaEl) {
                        metaEl.textContent = capacity
                            ? (type + ' • ' + capacity + ' seater')
                            : type;
                    }
                    const imageUrl = opt.dataset.image || '';
                    if (img && placeholder) {
                        if (imageUrl) {
                            img.src = imageUrl;
                            img.classList.remove('d-none');
                            placeholder.classList.add('d-none');
                        } else {
                            img.classList.add('d-none');
                            placeholder.classList.remove('d-none');
                        }
                    }
                } else {
                    nameEl.textContent = 'Select a vehicle';
                    if (metaEl) metaEl.textContent = '—';
                    if (img) img.classList.add('d-none');
                    if (placeholder) placeholder.classList.remove('d-none');
                }

                const setText = function (id, value) {
                    const el = document.getElementById(id);
                    if (el) el.textContent = value;
                };
                setText('summarySideCustomer', customerNameInput.value.trim() || '—');
                setText('summarySidePickup', formatSummaryDate(pickupDateInput.value, pickupTimeInput.value));
                setText('summarySideReturn', formatSummaryDate(returnDateInput.value, returnTimeInput.value));
                setText('summarySideDuration', formatSummaryDuration(hours));
                setText('summarySidePassengers', passengerInput.value || '—');
                setText('summarySideDiscount', hasDiscount ? 'Senior (10%)' : 'None');
                setText('summarySideStatus', isPartial ? 'Partially Paid' : (payChoice === 'Reserve' ? 'Pay Later' : 'Fully Paid'));
                setText('summarySidePartialLabel', isPartial ? 'Partial Payment' : (payChoice === 'Reserve' ? 'Estimated Total' : 'Full Payment'));
                setText('summarySidePartialAmount', BookingSummary.formatPeso(payNowAmount));
                setText('summarySideTotalAmount', BookingSummary.formatPeso(total));

                const exceedingRow = document.getElementById('summarySideExceedingRow');
                if (exceedingRow) {
                    exceedingRow.classList.toggle('d-none', succeedingHours <= 0);
                    setText(
                        'summarySideExceedingLabel',
                        'Exceeding Hours (' + (succeedingHours % 1 === 0 ? succeedingHours : succeedingHours.toFixed(1)) + 'hr)'
                    );
                    setText('summarySideExceedingAmount', BookingSummary.formatPeso(succeedingAmount));
                }

                const balanceBox = document.getElementById('summarySideBalanceBox');
                if (balanceBox) {
                    balanceBox.classList.toggle('d-none', !isPartial || remaining <= 0);
                    setText('summarySideRemaining', BookingSummary.formatPeso(remaining));
                }
            }

            function validateStep1() {
                if (!selectedVehicleIds.length) {
                    alert('Please add at least one vehicle.');
                    return false;
                }
                if (!customerNameInput.value.trim()) {
                    alert('Please enter the customer name.');
                    return false;
                }
                if (!contactInput.value.trim()) {
                    alert('Please enter contact information.');
                    return false;
                }
                if (!/^(09|\+639)\d{9}$/.test(contactInput.value.trim())) {
                    alert('Please enter a valid PH mobile number (09XXXXXXXXX or +639XXXXXXXXX).');
                    return false;
                }
                if (!pickupLocationInput.value.trim() || !dropoffLocationInput.value.trim()) {
                    alert('Please enter pick-up and drop-off locations.');
                    return false;
                }
                const pickup = calendar.parseDate(pickupDateInput.value);
                const ret = calendar.parseDate(returnDateInput.value);
                if (!pickup || !ret) {
                    alert('Please select pick-up and return dates on the calendar.');
                    return false;
                }
                if (ret < pickup) {
                    alert('Return date cannot be earlier than pick-up date.');
                    return false;
                }
                if (calendar.rangeHasRented(pickup, ret)) {
                    alert('Selected range includes dates when this vehicle is already rented.');
                    return false;
                }
                const count = parseInt(passengerInput.value, 10);
                const maxCap = parseInt((getPrimaryVehicleOption() && getPrimaryVehicleOption().dataset.capacity) || '60', 10);
                if (!count || count < 1 || count > maxCap) {
                    alert('Please select a passenger count within vehicle capacity.');
                    return false;
                }
                if (discountSelect.value === 'Yes' && !(fileInput.files && fileInput.files[0])) {
                    alert('Please upload the front of the Senior/PWD ID.');
                    return false;
                }
                return true;
            }

            const paymentTypeInput = document.getElementById('input-PaymentType');
            const paymentMethodInput = document.getElementById('input-PaymentMethod');
            const totalAmountInput = document.getElementById('input-TotalAmount');
            const amountPaidInput = document.getElementById('input-AmountPaid');
            const accountNameInput = document.getElementById('AccountName');
            const paymentDateInput = document.getElementById('input-PaymentDate');
            const paymentTypeBlock = document.querySelector('.payment-type-block');
            const rentalOptionInput = document.getElementById('input-RentalOption');
            const payLaterNotice = document.getElementById('payLaterNotice');
            const summaryConfirmBtn = document.getElementById('summaryConfirmBtn');

            function getPayOptionChoice() {
                const selected = document.querySelector('.payment-option-card.is-selected[data-pay-option]');
                return selected ? (selected.getAttribute('data-pay-option') || 'Full') : 'Full';
            }

            function isPayLater() {
                return getPayOptionChoice() === 'Reserve' || (rentalOptionInput?.value || '') === 'Reserve';
            }

            function applyPayOptionChoice(choice) {
                const value = choice === 'Partial' || choice === 'Reserve' || choice === 'Full' ? choice : 'Full';
                document.querySelectorAll('.payment-option-card[data-pay-option]').forEach(function (card) {
                    card.classList.toggle('is-selected', card.getAttribute('data-pay-option') === value);
                });
                payLaterNotice?.classList.toggle('d-none', value !== 'Reserve');
                document.getElementById('acceptedMethodsPanel')?.classList.toggle('d-none', value === 'Reserve');

                const continueBtn = document.getElementById('paymentTypeContinueBtn');
                if (continueBtn) {
                    continueBtn.textContent = value === 'Reserve' ? 'Continue to Summary' : 'Continue to Payment Method';
                }

                if (value === 'Reserve') {
                    if (rentalOptionInput) rentalOptionInput.value = 'Reserve';
                    if (paymentTypeInput) paymentTypeInput.value = '';
                } else {
                    if (rentalOptionInput) rentalOptionInput.value = 'Book';
                    if (paymentTypeInput) paymentTypeInput.value = value === 'Partial' ? 'Partial Payment' : 'Full Payment';
                }

                document.querySelectorAll('.step-node[data-pay-now-only="true"], .wizard-step-panel[data-pay-now-only="true"]').forEach(function (node) {
                    node.classList.toggle('is-skipped', value === 'Reserve');
                });

                const header = document.getElementById('summaryHeaderBlock');
                if (header) header.setAttribute('data-reserve-flow', value === 'Reserve' ? 'true' : 'false');
                if (summaryConfirmBtn) {
                    summaryConfirmBtn.textContent = 'Continue';
                }
            }

            function calcTotalFare() {
                const hours = BookingSummary.calcHours(
                    pickupDateInput.value,
                    pickupTimeInput.value,
                    returnDateInput.value,
                    returnTimeInput.value
                );
                const succeedingHours = Math.max(0, hours - 8);
                let subtotal = 0;
                selectedVehicleIds.forEach(function (id) {
                    const opt = getPickerOption(id);
                    if (!opt) return;
                    const basePrice = parseFloat(opt.dataset.basePrice || '0');
                    const succeedingFee = parseFloat(opt.dataset.succeedingFee || '0');
                    subtotal += basePrice + (succeedingHours * succeedingFee);
                });
                if (discountSelect.value === 'Yes') subtotal -= subtotal * 0.10;
                return Math.round(subtotal * 100) / 100;
            }

            function syncPaymentFare() {
                const total = calcTotalFare();
                if (totalAmountInput) totalAmountInput.value = total.toFixed(2);
                if (paymentTypeBlock) {
                    const depositPercent = parseFloat(paymentTypeBlock.dataset.depositPercent || '5');
                    const depositAmount = Math.round(total * (depositPercent / 100) * 100) / 100;
                    paymentTypeBlock.dataset.totalFare = String(total);
                    paymentTypeBlock.dataset.depositAmount = String(depositAmount);
                    paymentTypeBlock.dataset.remainingAmount = String(Math.max(0, total - depositAmount));
                    const partialAmount = document.getElementById('optionPartialAmount');
                    const partialRemaining = document.getElementById('optionPartialRemaining');
                    const partialPercent = document.getElementById('optionPartialPercent');
                    const fullAmount = document.getElementById('optionFullAmount');
                    if (partialAmount) partialAmount.textContent = BookingSummary.formatPeso(depositAmount);
                    if (partialRemaining) partialRemaining.textContent = BookingSummary.formatPeso(Math.max(0, total - depositAmount));
                    if (partialPercent) partialPercent.textContent = String(depositPercent);
                    if (fullAmount) fullAmount.textContent = BookingSummary.formatPeso(total);
                }
            }

            function expectedPayAmount() {
                const type = paymentTypeInput?.value || '';
                const total = parseFloat(paymentTypeBlock?.dataset.totalFare || totalAmountInput?.value || '0');
                if (type === 'Partial Payment') {
                    return parseFloat(paymentTypeBlock?.dataset.depositAmount || '0');
                }
                return total;
            }

            function updatePayNowLabels() {
                const amount = expectedPayAmount();
                const label = BookingSummary.formatPeso(amount);
                document.querySelectorAll('.js-pay-now-amount').forEach(function (el) { el.textContent = label; });
                const matchLabel = document.getElementById('amountMatchLabel');
                if (matchLabel) matchLabel.textContent = label;
                const reminderAmount = document.getElementById('reminderExactAmount');
                if (reminderAmount) reminderAmount.textContent = label;
                if (amountPaidInput && !amountPaidInput.value) {
                    amountPaidInput.value = amount.toFixed(2);
                }
            }

            function setChannelPanel(method) {
                const isWalkin = method === 'Walk-in';
                const hasMethod = !!method;
                document.getElementById('channelPanelGCash')?.classList.toggle('d-none', method !== 'GCash');
                document.getElementById('channelPanelBDO')?.classList.toggle('d-none', method !== 'BDO');
                document.getElementById('channelPanelWalkin')?.classList.toggle('d-none', method !== 'Walk-in');
                document.querySelectorAll('.js-cashless-only').forEach(function (el) {
                    el.style.display = !hasMethod || isWalkin ? 'none' : '';
                });
            }

            document.querySelectorAll('.payment-option-card[data-pay-option]').forEach(function (card) {
                card.addEventListener('click', function () {
                    applyPayOptionChoice(card.getAttribute('data-pay-option') || 'Full');
                    syncPaymentFare();
                    if (!isPayLater() && amountPaidInput) {
                        amountPaidInput.value = expectedPayAmount().toFixed(2);
                    }
                    updatePaymentDetailsSidebar();
                });
            });

            document.querySelectorAll('[data-payment-method]').forEach(function (card) {
                if (!card.classList.contains('payment-select-card')
                    && !card.classList.contains('payment-method-row')
                    && !card.classList.contains('payment-method-tab')) return;
                card.addEventListener('click', function () {
                    document.querySelectorAll('.payment-select-card[data-payment-method], .payment-method-row[data-payment-method], .payment-method-tab[data-payment-method]').forEach(function (c) {
                        c.classList.remove('is-selected');
                    });
                    card.classList.add('is-selected');
                    const method = card.getAttribute('data-payment-method') || '';
                    if (paymentMethodInput) paymentMethodInput.value = method;
                    setChannelPanel(method);
                    updatePayNowLabels();
                    if (amountPaidInput) amountPaidInput.value = expectedPayAmount().toFixed(2);
                    updatePaymentDetailsSidebar();
                });
            });

            function validateStep2() {
                syncPaymentFare();
                const value = getPayOptionChoice();
                if (value !== 'Full' && value !== 'Partial' && value !== 'Reserve') {
                    alert('Please choose a payment option.');
                    return false;
                }
                applyPayOptionChoice(value);
                if (!isPayLater()) {
                    updatePayNowLabels();
                }
                return true;
            }

            function validateStep3() {
                if (isPayLater()) return true;
                const method = paymentMethodInput?.value || '';
                if (!method) {
                    alert('Please select a payment method (GCash, BDO, or Walk-in).');
                    return false;
                }
                const paid = parseFloat(amountPaidInput?.value || '0');
                if (!paid || paid <= 0) {
                    alert('Please enter the amount paid.');
                    return false;
                }
                if (method !== 'Walk-in') {
                    if (!accountNameInput?.value.trim()) {
                        alert('Please enter the account name used for payment.');
                        return false;
                    }
                    const ref = document.getElementById('TransactionReference');
                    if (!ref?.value.trim()) {
                        alert('Please enter the transaction/reference number.');
                        return false;
                    }
                    const receipt = document.getElementById('input-ReceiptFile');
                    if (!receipt?.files?.length) {
                        alert('Please upload your payment receipt.');
                        return false;
                    }
                }
                if (!paymentDateInput?.value) {
                    alert('Please enter the payment date and time.');
                    return false;
                }
                return true;
            }

            function collectSummaryData() {
                const opt = getPrimaryVehicleOption();
                syncPaymentFare();
                const payLater = isPayLater();
                return {
                    customerName: customerNameInput.value.trim(),
                    contactNumber: contactInput.value.trim(),
                    pickupLocation: pickupLocationInput.value.trim(),
                    dropoffLocation: dropoffLocationInput.value.trim(),
                    pickupDate: pickupDateInput.value,
                    returnDate: returnDateInput.value,
                    pickupTime: pickupTimeInput.value,
                    returnTime: returnTimeInput.value,
                    passengerCount: passengerInput.value,
                    discount: discountSelect.value,
                    discountFileName: (fileInput.files && fileInput.files[0]) ? fileInput.files[0].name : '',
                    notes: notesInput ? notesInput.value.trim() : '',
                    vehicleName: opt ? ((opt.dataset.brand || '') + ' ' + (opt.dataset.model || '')).trim() : '',
                    vehicleType: opt ? (opt.dataset.type || '') : '',
                    basePrice: opt ? parseFloat(opt.dataset.basePrice || '0') : 0,
                    succeedingFee: opt ? parseFloat(opt.dataset.succeedingFee || '0') : 0,
                    baseHours: 8,
                    paymentType: payLater ? null : (paymentTypeInput?.value || ''),
                    paymentMethod: payLater ? null : (paymentMethodInput?.value || ''),
                    amountPaid: payLater ? null : parseFloat(amountPaidInput?.value || '0'),
                    accountName: payLater ? null : (accountNameInput?.value || ''),
                    transactionReference: payLater ? null : (document.getElementById('TransactionReference')?.value || ''),
                    paymentDate: payLater ? null : (paymentDateInput?.value || '')
                };
            }

            function applySummaryMode() {
                const payLater = isPayLater();
                const title = document.getElementById('summaryPageTitle');
                const subtitle = document.getElementById('summaryPageSubtitle');
                const panelTitle = document.getElementById('summaryPaymentPanelTitle');
                const statusText = document.getElementById('summaryPaymentStatusText');
                const totalLabel = document.getElementById('summaryTotalLabel');
                const reserveAlert = document.getElementById('summaryReserveAlert');
                const editBtn = document.getElementById('summaryPaymentEditBtn');

                if (title) title.textContent = payLater ? 'Hold Summary' : 'Rental Summary';
                if (subtitle) {
                    subtitle.textContent = payLater
                        ? 'Review the hold details. Payment is not collected now.'
                        : 'Review the rental and payment details before confirming.';
                }
                if (panelTitle) panelTitle.textContent = payLater ? 'Estimated Costs' : 'Payment Details';
                if (statusText) statusText.textContent = payLater ? 'Pay Later' : 'Pending';
                if (totalLabel) totalLabel.textContent = payLater ? 'Estimated Total' : 'Total Rental Costs';
                reserveAlert?.classList.toggle('d-none', !payLater);
                editBtn?.classList.toggle('d-none', payLater);
                document.querySelectorAll('.js-summary-paynow').forEach(function (el) {
                    el.classList.toggle('d-none', payLater);
                });
                document.getElementById('summaryFeeGrid')?.classList.toggle('d-none', !payLater);
                document.getElementById('summaryFeeTotal')?.classList.toggle('d-none', !payLater);
                if (summaryConfirmBtn) {
                    summaryConfirmBtn.textContent = 'Continue';
                }
            }

            function restorePayOptionFromModel() {
                const option = rentalOptionInput?.value || '';
                const type = paymentTypeInput?.value || '';
                if (option === 'Reserve') applyPayOptionChoice('Reserve');
                else if (type === 'Partial Payment') applyPayOptionChoice('Partial');
                else applyPayOptionChoice('Full');
            }

            function restorePaymentMethodFromModel() {
                const method = paymentMethodInput?.value || '';
                if (!method) {
                    setChannelPanel('');
                    return;
                }
                document.querySelectorAll('.payment-select-card[data-payment-method], .payment-method-row[data-payment-method], .payment-method-tab[data-payment-method]').forEach(function (card) {
                    card.classList.toggle('is-selected', card.getAttribute('data-payment-method') === method);
                });
                setChannelPanel(method);
            }

            BookingSummary.initReceiptUpload();
            BookingSummary.initWizard({
                stepPanelIds: ['reservationStep1', 'reservationStep2', 'reservationStep3', 'reservationStep4'],
                submitStep: 4,
                initialStep: @wizardStartStep,
                visualStepMap: { 1: 1, 2: 2, 3: 3, 4: 4 },
                validateStep1: validateStep1,
                validateStep2: validateStep2,
                validateStep3: validateStep3,
                collectSummaryData: collectSummaryData,
                resolveNextStep: function (step) {
                    if (step === 1) return 2;
                    if (step === 2) return isPayLater() ? 4 : 3;
                    if (step === 3) return 4;
                    return step;
                },
                resolveBackStep: function (step) {
                    if (step === 4) return isPayLater() ? 2 : 3;
                    if (step === 3) return 2;
                    if (step === 2) return 1;
                    return 1;
                },
                resolveSummaryEditStep: function (btn, target) {
                    if (btn.id === 'summaryPaymentEditBtn') return isPayLater() ? 2 : 3;
                    return target;
                },
                onStepChange: function (step) {
                    if (step === 2) {
                        syncPaymentFare();
                        applyPayOptionChoice(getPayOptionChoice());
                        updateTripSummarySidebar();
                    }
                    if (step === 3) {
                        updatePayNowLabels();
                        setChannelPanel(paymentMethodInput?.value || '');
                        // Keep a value the user already typed; only fill when blank.
                        if (amountPaidInput && !String(amountPaidInput.value || '').trim()) {
                            amountPaidInput.value = expectedPayAmount().toFixed(2);
                        }
                        updatePaymentDetailsSidebar();
                    }
                    if (step === 4) {
                        applySummaryMode();
                        BookingSummary.populate(collectSummaryData());
                        updateSummarySidebar();
                    }
                }
            });

            restorePayOptionFromModel();
            restorePaymentMethodFromModel();

            if (paymentDateInput && !paymentDateInput.value) {
                const now = new Date();
                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                paymentDateInput.value = now.toISOString().slice(0, 16);
            }

            vehicleSelect.addEventListener('change', function () {
                updateCapacityHint();
                if (calendar) {
                    calendar.resetSelection();
                    calendar.loadAvailability();
                }
                syncPaymentFare();
                updateTripSummarySidebar();
            });
            btnAddVehicle?.addEventListener('click', function () {
                const id = vehiclePicker?.value;
                if (!id) {
                    alert('Select a vehicle first.');
                    return;
                }
                if (!addSelectedVehicle(id)) {
                    alert('That vehicle is already on this booking.');
                    return;
                }
                if (vehiclePicker) vehiclePicker.value = '';
            });
            selectedVehiclesList?.addEventListener('click', function (e) {
                const btn = e.target.closest('[data-remove-vehicle]');
                if (!btn) return;
                removeSelectedVehicle(btn.getAttribute('data-remove-vehicle'));
            });
            bookingVehiclesGallery?.addEventListener('click', function (e) {
                const btn = e.target.closest('[data-remove-vehicle]');
                if (!btn) return;
                removeSelectedVehicle(btn.getAttribute('data-remove-vehicle'));
            });
            passengerInput.addEventListener('change', updateTripSummarySidebar);
            pickupTimeInput.addEventListener('change', updateTripSummarySidebar);
            returnTimeInput.addEventListener('change', updateTripSummarySidebar);
            discountSelect.addEventListener('change', toggleDiscountUpload);

            function bindDiscountUpload(zone, input, onFile) {
                if (!zone || !input) return;
                input.addEventListener('change', function () {
                    if (input.files && input.files[0]) onFile(input.files[0]);
                });
                ['dragenter', 'dragover'].forEach(function (evt) {
                    zone.addEventListener(evt, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        zone.style.backgroundColor = '#e9e9e9';
                    });
                });
                ['dragleave', 'drop'].forEach(function (evt) {
                    zone.addEventListener(evt, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        zone.style.backgroundColor = '';
                    });
                });
                zone.addEventListener('drop', function (e) {
                    const files = e.dataTransfer.files;
                    if (files && files.length > 0) {
                        const dt = new DataTransfer();
                        dt.items.add(files[0]);
                        input.files = dt.files;
                        onFile(files[0]);
                    }
                });
            }

            bindDiscountUpload(frontUploadZone, fileInput, showFrontDiscountPreview);
            bindDiscountUpload(backUploadZone, backFileInput, showBackDiscountPreview);
            frontRemoveBtn?.addEventListener('click', clearFrontDiscountFile);
            backRemoveBtn?.addEventListener('click', clearBackDiscountFile);
            frontPreviewBox?.addEventListener('click', function () { fileInput?.click(); });
            backPreviewBox?.addEventListener('click', function () { backFileInput?.click(); });

            syncVehicleFormFields();
            updateCapacityHint();
            toggleDiscountUpload();
            calendar = AvailabilityCalendar.init({
                getVehicleIds: function () {
                    return selectedVehicleIds.slice();
                },
                availabilityUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Availability", "Rentals"))),
                initialUnavailable: @Html.Raw(initialUnavailableJson),
                onDatesChange: updateTripSummarySidebar
            });
            updateTripSummarySidebar();
            syncPaymentFare();
        })();
    </script>
}
