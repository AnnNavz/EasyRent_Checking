@model EasyRent_Checking.ViewModels.RentalInputModel
@using EasyRent_Checking.Models
@using System.Globalization

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Edit Booking";
    ViewData["ActivePage"] = "Rentals";
    var vehicles = ViewBag.Vehicles as IEnumerable<Vehicle> ?? Enumerable.Empty<Vehicle>();
    var existingReceipt = ViewData["ExistingReceiptPath"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/payment-wizard.css" asp-append-version="true" />
}

<div class="container-fluid px-4 py-3">
    <div class="details-page-actions mb-3">
        <a asp-action="Details" asp-route-id="@Model.RentalId" class="btn btn-page-back">Back</a>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data" id="reservationEditForm">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <input type="hidden" asp-for="RentalId" />
        <input type="hidden" asp-for="RentalDetailsID" />
        <input type="hidden" asp-for="DiscountImagePath" />
        <input type="hidden" asp-for="PaymentId" />

        <div class="form-container-card p-4 mb-4 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-file-earmark-text fs-5 text-secondary"></i>
                <h6 class="wizard-section-title fw-bold mb-0 text-dark" style="font-size:0.95rem;">Booking Information</h6>
            </div>
            <hr class="wizard-section-divider" />

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="VehicleId" class="form-label fw-semibold small text-secondary mb-1">Vehicle</label>
                    <select asp-for="VehicleId" id="input-VehicleId" class="form-select form-control-thin shadow-sm">
                        <option value="">Select vehicle</option>
                        @foreach (var vehicle in vehicles)
                        {
                            if (Model.VehicleId == vehicle.VehicleId)
                            {
                                <option value="@vehicle.VehicleId"
                                        data-base-price="@vehicle.BasePrice.ToString(CultureInfo.InvariantCulture)"
                                        data-succeeding-fee="@vehicle.SucceedingFee.ToString(CultureInfo.InvariantCulture)"
                                        selected>
                                    @vehicle.Brand @vehicle.Model (@vehicle.PlateNumber)
                                </option>
                            }
                            else
                            {
                                <option value="@vehicle.VehicleId"
                                        data-base-price="@vehicle.BasePrice.ToString(CultureInfo.InvariantCulture)"
                                        data-succeeding-fee="@vehicle.SucceedingFee.ToString(CultureInfo.InvariantCulture)">
                                    @vehicle.Brand @vehicle.Model (@vehicle.PlateNumber)
                                </option>
                            }
                        }
                    </select>
                    <span asp-validation-for="VehicleId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomerName" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <input asp-for="CustomerName" class="form-control form-control-thin" />
                    <span asp-validation-for="CustomerName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContactNumber" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <input asp-for="ContactNumber" class="form-control form-control-thin" />
                    <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PickupLocation" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <input asp-for="PickupLocation" class="form-control form-control-thin" />
                    <span asp-validation-for="PickupLocation" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DropoffLocation" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <input asp-for="DropoffLocation" class="form-control form-control-thin" />
                    <span asp-validation-for="DropoffLocation" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="PickupDate" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <input asp-for="PickupDate" class="form-control form-control-thin" type="date" />
                    <span asp-validation-for="PickupDate" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="PickupTime" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <input asp-for="PickupTime" class="form-control form-control-thin" type="time" />
                    <span asp-validation-for="PickupTime" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ReturnDate" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <input asp-for="ReturnDate" class="form-control form-control-thin" type="date" />
                    <span asp-validation-for="ReturnDate" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="ReturnTime" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <input asp-for="ReturnTime" class="form-control form-control-thin" type="time" />
                    <span asp-validation-for="ReturnTime" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PassengerCount" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <input asp-for="PassengerCount" class="form-control form-control-thin" />
                    <span asp-validation-for="PassengerCount" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Discount" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <select asp-for="Discount" class="form-select form-control-thin" asp-items="Html.GetEnumSelectList<Discount>()"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="RentalOption" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <select asp-for="RentalOption" class="form-select form-control-thin" asp-items="Html.GetEnumSelectList<RentalOption>()"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="RentalStatus" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <select asp-for="RentalStatus" class="form-select form-control-thin" asp-items="Html.GetEnumSelectList<RentalStatus>()"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="DiscountImageFile" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <input asp-for="DiscountImageFile" class="form-control form-control-thin" type="file" accept=".png,.jpg,.jpeg" />
                    <span asp-validation-for="DiscountImageFile" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label fw-semibold small text-secondary mb-1"></label>
                    <textarea asp-for="Notes" class="form-control form-control-thin" rows="3"></textarea>
                </div>
            </div>
        </div>

        <div class="form-container-card p-4 mb-4 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-wallet2 fs-5 text-secondary"></i>
                <h6 class="wizard-section-title fw-bold mb-0 text-dark" style="font-size:0.95rem;">Payment</h6>
            </div>
            <hr class="wizard-section-divider" />

            <partial name="_ClientPaymentMethodStep" model="Model" />
            <div class="mt-3">
                <partial name="_ClientPaymentDetailsStep" model="Model" />
            </div>

            @if (!string.IsNullOrWhiteSpace(existingReceipt))
            {
                <div class="mt-3">
                    <span class="small text-muted d-block mb-2">Current receipt on file:</span>
                    <img src="~/images/@existingReceipt" alt="Current receipt" style="max-width: 280px; border-radius: 8px; border: 1px solid #ddd;" />
                </div>
            }
        </div>

        <div class="d-flex justify-content-end gap-2 mb-4">
            <a asp-action="Details" asp-route-id="@Model.RentalId" class="btn btn-light border px-4 py-2 fw-semibold">Cancel</a>
            <button type="submit" class="btn btn-dark px-4 py-2 fw-bold" style="background-color:#1E3A8A;border-color:#1E3A8A;">Save Booking &amp; Payment</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/booking-summary.js" asp-append-version="true"></script>
    <script>
        (function () {
            BookingSummary.initReceiptUpload();
            const paymentTypeInput = document.getElementById('input-PaymentType');
            const paymentMethodInput = document.getElementById('input-PaymentMethod');
            const amountPaidInput = document.getElementById('input-AmountPaid');
            const paymentDateInput = document.getElementById('input-PaymentDate');

            function setChannelPanel(method) {
                const isWalkin = method === 'Walk-in';
                const hasMethod = !!method;
                document.getElementById('channelPanelGCash')?.classList.toggle('d-none', method !== 'GCash');
                document.getElementById('channelPanelBDO')?.classList.toggle('d-none', method !== 'BDO');
                document.getElementById('channelPanelWalkin')?.classList.toggle('d-none', method !== 'Walk-in');
                document.querySelectorAll('.js-cashless-only').forEach(function (el) {
                    el.style.display = !hasMethod || isWalkin ? 'none' : '';
                });
            }

            document.querySelectorAll('.payment-option-card').forEach(function (card) {
                card.addEventListener('click', function () {
                    document.querySelectorAll('.payment-option-card').forEach(function (c) { c.classList.remove('is-selected'); });
                    card.classList.add('is-selected');
                    if (paymentTypeInput) paymentTypeInput.value = card.getAttribute('data-payment-type') || '';
                });
            });

            document.querySelectorAll('.payment-select-card[data-payment-method]').forEach(function (card) {
                card.addEventListener('click', function () {
                    document.querySelectorAll('.payment-select-card[data-payment-method]').forEach(function (c) { c.classList.remove('is-selected'); });
                    card.classList.add('is-selected');
                    const method = card.getAttribute('data-payment-method') || '';
                    if (paymentMethodInput) paymentMethodInput.value = method;
                    setChannelPanel(method);
                });
            });

            // Hide wizard nav buttons from payment partials on edit page
            document.querySelectorAll('#reservationEditForm [data-wizard-next], #reservationEditForm [data-wizard-back]').forEach(function (btn) {
                btn.classList.add('d-none');
            });

            // Preselect saved payment choices
            const type = paymentTypeInput?.value;
            if (type) {
                document.querySelectorAll('.payment-option-card').forEach(function (card) {
                    card.classList.toggle('is-selected', card.getAttribute('data-payment-type') === type);
                });
            }
            const method = paymentMethodInput?.value || 'Walk-in';
            document.querySelectorAll('.payment-select-card[data-payment-method]').forEach(function (card) {
                card.classList.toggle('is-selected', card.getAttribute('data-payment-method') === method);
            });
            setChannelPanel(method);

            if (paymentDateInput && paymentDateInput.value && paymentDateInput.value.indexOf('T') < 0) {
                // leave as-is; browsers accept datetime-local
            }
        })();
    </script>
}
