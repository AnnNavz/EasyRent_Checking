@model EasyRent_Checking.ViewModels.RentalInputModel
@using EasyRent_Checking.Models
@using System.Globalization

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Edit Booking";
    ViewData["ActivePage"] = "Rentals";
    ViewData["ShowPayLaterOption"] = true;
    ViewData["HidePaymentReminders"] = true;

    var vehicles = ViewBag.Vehicles as IEnumerable<Vehicle> ?? Enumerable.Empty<Vehicle>();
    var existingReceipt = ViewData["ExistingReceiptPath"] as string;
    var bookingId = $"BK-{Model.RentalId:D5}";
    var hasDiscountId = !string.IsNullOrWhiteSpace(Model.DiscountImagePath);
    var discountFileName = hasDiscountId ? System.IO.Path.GetFileName(Model.DiscountImagePath) : null;
}

@section Styles {
    <link rel="stylesheet" href="~/css/payment-wizard.css" asp-append-version="true" />
}

<div class="wizard-max-wrapper admin-booking-create admin-booking-edit py-3">
    <div class="admin-booking-edit-topbar mb-3">
        <div class="reservation-details-id-card">
            <div class="reservation-details-id-main">
                <span class="reservation-view-id-label">Booking ID</span>
                <h1 class="reservation-view-id mb-0">@bookingId</h1>
            </div>
            <span class="booking-status-badge @StatusBadgeClass(Model.RentalStatus)">
                <i class="bi @StatusIcon(Model.RentalStatus)"></i>@Model.RentalStatus
            </span>
        </div>
        <a asp-action="Details" asp-route-id="@Model.RentalId" class="btn btn-page-back">Back</a>
    </div>

    <div class="admin-create-step1-intro">
        <h1 class="admin-create-step1-title">Edit reservation</h1>
        <p class="admin-create-step1-subtitle">Update trip details, passenger information, and payment. Changes apply immediately after you save.</p>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data" id="reservationEditForm" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <input type="hidden" asp-for="RentalId" />
        <input type="hidden" asp-for="RentalDetailsID" />
        <input type="hidden" asp-for="DiscountImagePath" />
        <input type="hidden" asp-for="PaymentId" />

        <div class="rent-step-card">
            <div class="rent-card-head">
                <span class="rent-card-icon"><i class="bi bi-car-front"></i></span>
                <h2>Vehicle Information</h2>
            </div>
            <p class="rent-card-hint mb-3">
                Review vehicles on this booking. Add or remove vehicles as needed — they share the same schedule.
            </p>

            <div id="bookingVehiclesGallery" class="booking-vehicles-gallery" aria-live="polite"></div>

            <label class="rent-field-label mt-3" for="input-VehiclePicker">Add vehicle</label>
            <div class="d-flex flex-wrap gap-2 align-items-stretch">
                <div class="flex-grow-1">
                    <select id="input-VehiclePicker" class="rent-field-input form-select">
                        <option value="">Select vehicle to add</option>
                        @foreach (var vehicle in vehicles)
                        {
                            var imageUrl = string.IsNullOrEmpty(vehicle.ImagePath) ? "" : Url.Content($"~/images/{vehicle.ImagePath}");
                            <option value="@vehicle.VehicleId"
                                    data-capacity="@vehicle.PassengersCount"
                                    data-base-price="@vehicle.BasePrice.ToString(CultureInfo.InvariantCulture)"
                                    data-succeeding-fee="@vehicle.SucceedingFee.ToString(CultureInfo.InvariantCulture)"
                                    data-brand="@vehicle.Brand"
                                    data-model="@vehicle.Model"
                                    data-type="@vehicle.Type"
                                    data-type-label="@VehicleTypes.DisplayUpper(vehicle.Type)"
                                    data-plate="@vehicle.PlateNumber"
                                    data-image="@imageUrl">
                                @vehicle.Brand @vehicle.Model (@vehicle.PlateNumber)
                            </option>
                        }
                    </select>
                </div>
                <button type="button" class="rent-btn-continue" id="btnAddVehicle" style="white-space:nowrap;">+ Add vehicle</button>
            </div>
            <input type="hidden" asp-for="VehicleId" id="input-VehicleId" />
            <div id="selectedVehiclesHidden"></div>
            <span class="rent-field-help">All selected vehicles share one schedule.</span>
            <span asp-validation-for="VehicleId" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="rent-step-card">
            <div class="rent-card-head">
                <span class="rent-card-icon"><i class="bi bi-file-earmark-text"></i></span>
                <h2>Rental Information</h2>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CustomerName" class="rent-field-label">Customer Name</label>
                    <input asp-for="CustomerName" class="rent-field-input" placeholder="e.g. Jane Doe" />
                    <span asp-validation-for="CustomerName" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContactNumber" class="rent-field-label">Contact Information</label>
                    <input asp-for="ContactNumber" class="rent-field-input" placeholder="09123456789 or +639123456789" />
                    <span asp-validation-for="ContactNumber" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PickupLocation" class="rent-field-label">Pick-up Location</label>
                    <input asp-for="PickupLocation" class="rent-field-input" placeholder="e.g. Mactan International Airport" />
                    <span asp-validation-for="PickupLocation" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DropoffLocation" class="rent-field-label">Drop-off Location</label>
                    <input asp-for="DropoffLocation" class="rent-field-input" placeholder="e.g. Talisay, Cebu City" />
                    <span asp-validation-for="DropoffLocation" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <div class="rent-step-card">
            <div class="rent-card-head">
                <span class="rent-card-icon"><i class="bi bi-calendar3"></i></span>
                <h2>Pick-up &amp; Return Schedule</h2>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PickupDate" class="rent-field-label">Pick-up Date</label>
                    <div class="rent-date-field">
                        <input asp-for="PickupDate" class="rent-field-input" type="date" />
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                    </div>
                    <span asp-validation-for="PickupDate" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PickupTime" class="rent-field-label">Pick-up Time</label>
                    <div class="rent-date-field">
                        <input asp-for="PickupTime" class="rent-field-input" type="time" />
                        <i class="bi bi-clock" aria-hidden="true"></i>
                    </div>
                    <span asp-validation-for="PickupTime" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ReturnDate" class="rent-field-label">Return Date</label>
                    <div class="rent-date-field">
                        <input asp-for="ReturnDate" class="rent-field-input" type="date" />
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                    </div>
                    <span asp-validation-for="ReturnDate" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ReturnTime" class="rent-field-label">Return Time</label>
                    <div class="rent-date-field">
                        <input asp-for="ReturnTime" class="rent-field-input" type="time" />
                        <i class="bi bi-clock" aria-hidden="true"></i>
                    </div>
                    <span asp-validation-for="ReturnTime" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <div class="rent-step-card">
            <div class="rent-card-head">
                <span class="rent-card-icon"><i class="bi bi-people"></i></span>
                <h2>Passenger &amp; Discount</h2>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PassengerCount" class="rent-field-label">Passenger Count</label>
                    <input asp-for="PassengerCount" class="rent-field-input" />
                    <span asp-validation-for="PassengerCount" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Discount" class="rent-field-label">Senior/PWD Discount (if applicable)</label>
                    <select asp-for="Discount" id="input-Discount" class="rent-field-input form-select" asp-items="Html.GetEnumSelectList<Discount>()"></select>
                    <span class="rent-field-help">10% discount - present valid ID upon booking.</span>
                </div>
                <div class="col-md-6">
                    <label asp-for="RentalOption" class="rent-field-label">Rental Option</label>
                    <select asp-for="RentalOption" class="rent-field-input form-select" asp-items="Html.GetEnumSelectList<RentalOption>()"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="RentalStatus" class="rent-field-label">Status</label>
                    <select asp-for="RentalStatus" class="rent-field-input form-select" asp-items="Html.GetEnumSelectList<RentalStatus>()"></select>
                </div>
                <div class="col-12 @(Model.Discount == Discount.Yes ? "" : "d-none")" id="discountUploadSection">
                    <label asp-for="DiscountImageFile" class="rent-field-label">Discount ID Image</label>
                    @if (hasDiscountId)
                    {
                        <div class="admin-booking-edit-existing-media mb-2">
                            <img src="~/images/@Model.DiscountImagePath" alt="Current discount ID" />
                            <span>@discountFileName</span>
                        </div>
                    }
                    <input asp-for="DiscountImageFile" class="rent-field-input" type="file" accept=".png,.jpg,.jpeg" />
                    <span class="rent-field-help">Upload a new file only if you need to replace the current ID.</span>
                    <span asp-validation-for="DiscountImageFile" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </div>

        <div class="rent-step-card">
            <div class="rent-card-head">
                <span class="rent-card-icon"><i class="bi bi-file-earmark-plus"></i></span>
                <h2>Additional Information</h2>
            </div>
            <label asp-for="Notes" class="rent-field-label">Special Requests / Notes (Optional)</label>
            <textarea asp-for="Notes" class="rent-field-input rent-field-textarea" rows="4" placeholder="e.g. Please prepare child seats, need early morning pick-up..."></textarea>
            <span asp-validation-for="Notes" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="rent-step-card admin-booking-edit-payment-card">
            <div class="rent-card-head">
                <span class="rent-card-icon"><i class="bi bi-wallet2"></i></span>
                <h2>Payment</h2>
            </div>

            <partial name="_ClientPaymentMethodStep" model="Model" />
            <div class="mt-3">
                <partial name="_ClientPaymentDetailsStep" model="Model" />
            </div>

            @if (!string.IsNullOrWhiteSpace(existingReceipt))
            {
                <div class="admin-booking-edit-existing-media mt-3">
                    <span class="rent-field-label mb-2">Current receipt on file</span>
                    <img src="~/images/@existingReceipt" alt="Current receipt" />
                </div>
            }
        </div>

        <div class="rent-step-actions">
            <a asp-action="Details" asp-route-id="@Model.RentalId" class="rent-btn-cancel">Cancel</a>
            <button type="submit" class="rent-btn-continue">Save Booking &amp; Payment</button>
        </div>
    </form>
</div>

@functions {
    string StatusBadgeClass(RentalStatus status) => status switch
    {
        RentalStatus.Approved => "booking-status-approved",
        RentalStatus.Cancelled => "booking-status-cancelled",
        RentalStatus.Expired => "booking-status-expired",
        _ => "booking-status-pending"
    };

    string StatusIcon(RentalStatus status) => status switch
    {
        RentalStatus.Approved => "bi-check-circle",
        RentalStatus.Cancelled => "bi-x-circle",
        RentalStatus.Expired => "bi-hourglass-split",
        _ => "bi-clock"
    };
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/booking-summary.js" asp-append-version="true"></script>
    <script>
        (function () {
            BookingSummary.initReceiptUpload();

            const paymentTypeInput = document.getElementById('input-PaymentType');
            const paymentMethodInput = document.getElementById('input-PaymentMethod');
            const discountSelect = document.getElementById('input-Discount');
            const discountSection = document.getElementById('discountUploadSection');
            const vehicleSelect = document.getElementById('input-VehicleId');
            const vehiclePicker = document.getElementById('input-VehiclePicker');
            const selectedVehiclesHidden = document.getElementById('selectedVehiclesHidden');
            const bookingVehiclesGallery = document.getElementById('bookingVehiclesGallery');
            const btnAddVehicle = document.getElementById('btnAddVehicle');
            const initialVehicleIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.GetNormalizedVehicleIds() ?? Array.Empty<int>()));
            let selectedVehicleIds = Array.isArray(initialVehicleIds) ? initialVehicleIds.map(Number).filter(function (id) { return id > 0; }) : [];

            function getPickerOption(vehicleId) {
                if (!vehiclePicker) return null;
                return Array.from(vehiclePicker.options).find(function (o) { return String(o.value) === String(vehicleId); }) || null;
            }

            function escapeHtml(value) {
                return String(value || '')
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function formatPeso(amount) {
                return BookingSummary.formatPeso(amount);
            }

            function getVehicleMeta(vehicleId) {
                const opt = getPickerOption(vehicleId);
                if (!opt) return null;
                return {
                    id: Number(opt.value),
                    capacity: parseInt(opt.dataset.capacity || '0', 10) || 0,
                    basePrice: parseFloat(opt.dataset.basePrice || '0') || 0,
                    succeedingFee: parseFloat(opt.dataset.succeedingFee || '0') || 0,
                    brand: opt.dataset.brand || '',
                    model: opt.dataset.model || '',
                    typeLabel: opt.dataset.typeLabel || opt.dataset.type || '',
                    plate: opt.dataset.plate || '',
                    image: opt.dataset.image || ''
                };
            }

            function renderVehicleGallery() {
                if (!bookingVehiclesGallery) return;
                if (!selectedVehicleIds.length) {
                    bookingVehiclesGallery.innerHTML = '<p class="booking-vehicles-empty text-muted small mb-0">No vehicles on this booking yet.</p>';
                    return;
                }

                bookingVehiclesGallery.innerHTML = selectedVehicleIds.map(function (id) {
                    const meta = getVehicleMeta(id);
                    if (!meta) {
                        return '<article class="booking-vehicle-info-card"><div class="booking-vehicle-info-body"><h3 class="booking-vehicle-info-name">Vehicle #' + id + '</h3></div></article>';
                    }
                    const name = escapeHtml((meta.brand + ' ' + meta.model).trim());
                    const typeLabel = escapeHtml(meta.typeLabel || 'Vehicle');
                    const plate = escapeHtml(meta.plate || '—');
                    const media = meta.image
                        ? '<img src="' + escapeHtml(meta.image) + '" alt="' + name + '" />'
                        : '<span class="booking-vehicle-info-placeholder" aria-hidden="true"><i class="bi bi-car-front"></i></span>';
                    return ''
                        + '<article class="booking-vehicle-info-card" data-vehicle-id="' + meta.id + '">'
                        +   '<div class="booking-vehicle-info-media">' + media + '</div>'
                        +   '<div class="booking-vehicle-info-body">'
                        +     '<span class="booking-vehicle-info-type">' + typeLabel + '</span>'
                        +     '<h3 class="booking-vehicle-info-name">' + name + '</h3>'
                        +     '<p class="booking-vehicle-info-specs">' + plate + ' • ' + meta.capacity + ' seater</p>'
                        +     '<p class="booking-vehicle-info-rates">'
                        +       'Base ' + formatPeso(meta.basePrice)
                        +       ' · +' + formatPeso(meta.succeedingFee) + '/hr after 8h'
                        +     '</p>'
                        +   '</div>'
                        +   '<div class="booking-vehicle-info-actions">'
                        +     '<button type="button" class="booking-vehicle-info-remove" data-remove-vehicle="' + meta.id + '" aria-label="Remove vehicle"><i class="bi bi-x-lg"></i></button>'
                        +   '</div>'
                        + '</article>';
                }).join('');
            }

            function syncVehicleFormFields() {
                if (vehicleSelect) vehicleSelect.value = selectedVehicleIds[0] ? String(selectedVehicleIds[0]) : '';
                if (selectedVehiclesHidden) {
                    selectedVehiclesHidden.innerHTML = selectedVehicleIds.map(function (id, index) {
                        return '<input type="hidden" name="VehicleIds[' + index + ']" value="' + id + '" />';
                    }).join('');
                }
                renderVehicleGallery();
                if (vehiclePicker) {
                    Array.from(vehiclePicker.options).forEach(function (opt) {
                        if (!opt.value) return;
                        opt.disabled = selectedVehicleIds.indexOf(Number(opt.value)) >= 0;
                    });
                }
            }

            function addSelectedVehicle(vehicleId) {
                const id = Number(vehicleId);
                if (!id || selectedVehicleIds.indexOf(id) >= 0) return false;
                selectedVehicleIds.push(id);
                syncVehicleFormFields();
                return true;
            }

            function removeSelectedVehicle(vehicleId) {
                const id = Number(vehicleId);
                selectedVehicleIds = selectedVehicleIds.filter(function (x) { return x !== id; });
                syncVehicleFormFields();
            }

            btnAddVehicle?.addEventListener('click', function () {
                const id = vehiclePicker?.value;
                if (!id) {
                    alert('Select a vehicle first.');
                    return;
                }
                if (!addSelectedVehicle(id)) {
                    alert('That vehicle is already on this booking.');
                    return;
                }
                if (vehiclePicker) vehiclePicker.value = '';
            });

            bookingVehiclesGallery?.addEventListener('click', function (e) {
                const btn = e.target.closest('[data-remove-vehicle]');
                if (!btn) return;
                removeSelectedVehicle(btn.getAttribute('data-remove-vehicle'));
            });

            syncVehicleFormFields();

            function syncDiscountSection() {
                if (!discountSection || !discountSelect) return;
                discountSection.classList.toggle('d-none', discountSelect.value !== 'Yes');
            }

            discountSelect?.addEventListener('change', syncDiscountSection);
            syncDiscountSection();

            function setChannelPanel(method) {
                const isWalkin = method === 'Walk-in';
                const hasMethod = !!method;
                document.getElementById('channelPanelGCash')?.classList.toggle('d-none', method !== 'GCash');
                document.getElementById('channelPanelBDO')?.classList.toggle('d-none', method !== 'BDO');
                document.getElementById('channelPanelWalkin')?.classList.toggle('d-none', method !== 'Walk-in');
                document.querySelectorAll('.js-cashless-only').forEach(function (el) {
                    el.style.display = !hasMethod || isWalkin ? 'none' : '';
                });
            }

            document.querySelectorAll('.payment-option-card').forEach(function (card) {
                card.addEventListener('click', function () {
                    document.querySelectorAll('.payment-option-card').forEach(function (c) { c.classList.remove('is-selected'); });
                    card.classList.add('is-selected');
                    if (paymentTypeInput) paymentTypeInput.value = card.getAttribute('data-payment-type') || '';
                });
            });

            document.querySelectorAll('.payment-select-card[data-payment-method], .payment-method-tab[data-payment-method]').forEach(function (card) {
                card.addEventListener('click', function () {
                    document.querySelectorAll('.payment-select-card[data-payment-method], .payment-method-tab[data-payment-method]').forEach(function (c) {
                        c.classList.remove('is-selected');
                    });
                    card.classList.add('is-selected');
                    const method = card.getAttribute('data-payment-method') || '';
                    if (paymentMethodInput) paymentMethodInput.value = method;
                    setChannelPanel(method);
                });
            });

            document.querySelectorAll('#reservationEditForm [data-wizard-next], #reservationEditForm [data-wizard-back]').forEach(function (btn) {
                btn.classList.add('d-none');
            });
            document.querySelectorAll('#reservationEditForm .payment-type-actions').forEach(function (el) {
                el.classList.add('d-none');
            });

            const type = paymentTypeInput?.value;
            if (type) {
                document.querySelectorAll('.payment-option-card').forEach(function (card) {
                    card.classList.toggle('is-selected', card.getAttribute('data-payment-type') === type);
                });
            }

            const method = paymentMethodInput?.value || 'Walk-in';
            document.querySelectorAll('.payment-select-card[data-payment-method], .payment-method-tab[data-payment-method]').forEach(function (card) {
                card.classList.toggle('is-selected', card.getAttribute('data-payment-method') === method);
            });
            setChannelPanel(method);
        })();
    </script>
}
