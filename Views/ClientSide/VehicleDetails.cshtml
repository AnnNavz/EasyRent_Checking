@model EasyRent_Checking.Models.Vehicle
@using EasyRent_Checking.Models
@using System.Globalization

@{
    Layout = "~/Views/Shared/_LayoutClientSide.cshtml";
    ViewData["Title"] = $"{Model.Brand} {Model.Model}";
    ViewData["ActiveNav"] = "Vehicles";

    string typeLabel = VehicleTypes.DisplayUpper(Model.Type);
    string vehicleTitle = $"{Model.Model} {Model.Brand}";
    string breadcrumbLabel = $"{Model.Brand} {Model.Model}";
    bool isAvailable = Model.IsActive && Model.Status == VehicleStatus.Available;
    string statusLabel = !Model.IsActive
        ? "Unavailable"
        : Model.Status switch
    {
        VehicleStatus.Available => "Available",
        VehicleStatus.Rented => "Currently Rented",
        VehicleStatus.InMaintenance => "In Maintenance",
        _ => "Unavailable"
    };
    string aboutText = string.IsNullOrWhiteSpace(Model.Description)
        ? "This vehicle is part of the EasyRent fleet and is maintained to provide a comfortable, reliable ride for every trip. Enjoy spacious seating, air-conditioning, and a smooth driving experience suited for city travel and out-of-town adventures."
        : Model.Description;

    var reviews = ViewData["VehicleReviews"] as IList<Feedback> ?? new List<Feedback>();
    var reviewCount = ViewData["ReviewCount"] as int? ?? reviews.Count;
    var averageRating = ViewData["AverageRating"] as double? ?? 0d;
    var completedTrips = ViewData["CompletedTripsCount"] as int? ?? 0;
    var filledStars = reviewCount == 0 ? 0 : (int)Math.Round(averageRating, MidpointRounding.AwayFromZero);
    var professionalismTen = ViewData["ProfessionalismTen"] as double? ?? 0d;
    var drivingTen = ViewData["DrivingTen"] as double? ?? 0d;
    var courtesyTen = ViewData["CourtesyTen"] as double? ?? 0d;
    var hasDriverRatings = ViewData["HasDriverRatings"] as bool? ?? false;
    var isFavorite = ViewData["IsFavorite"] as bool? ?? false;

    string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        return char.ToUpperInvariant(name.Trim()[0]).ToString();
    }
}

<div class="client-details-breadcrumb-bar">
    <div class="client-details-breadcrumb-inner">
        <nav class="client-details-breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="ClientSide" asp-action="Homepage">Home</a>
            <span class="client-details-breadcrumb-sep">&rsaquo;</span>
            <a asp-controller="ClientSide" asp-action="Browse">Browse Vehicles</a>
            <span class="client-details-breadcrumb-sep">&rsaquo;</span>
            <span class="client-details-breadcrumb-current">@breadcrumbLabel</span>
        </nav>
        <a asp-controller="ClientSide" asp-action="Browse" class="client-btn-back-browse">
            <i class="bi bi-arrow-left"></i>
            Back to Browse Details
        </a>
    </div>
</div>

<div class="client-page client-details-page">
    <div class="client-details-layout">
        <div class="client-details-main">
            <div class="client-details-card">
                <div class="client-details-header">
                    <div>
                        <span class="client-details-type-pill">@typeLabel</span>
                        <h1 class="client-details-title">@vehicleTitle</h1>
                        <div class="client-details-meta">
                            <span class="client-details-stars" aria-hidden="true">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= filledStars ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </span>
                            @if (reviewCount > 0)
                            {
                                <span class="client-details-rating-text">@averageRating.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                <span class="client-details-meta-muted">(@reviewCount verified @(reviewCount == 1 ? "review" : "reviews"))</span>
                            }
                            else
                            {
                                <span class="client-details-meta-muted">(No reviews yet)</span>
                            }
                            <span class="client-details-meta-muted">@completedTrips @(completedTrips == 1 ? "trip" : "trips") completed</span>
                        </div>
                    </div>
                    <div class="client-details-header-actions">
                        <button type="button" class="client-details-icon-btn" id="vehicleShareBtn" aria-label="Share">
                            <i class="bi bi-share"></i>
                        </button>
                        <button type="button"
                                class="client-details-icon-btn @(isFavorite ? "is-favorite" : "")"
                                data-favorite-toggle
                                data-toggle-url="@Url.Action("ToggleFavorite", "ClientSide", new { id = Model.VehicleId })"
                                data-login-url="@(User.Identity?.IsAuthenticated == true ? null : Url.Action("Login", "Account", new { returnUrl = Url.Action("VehicleDetails", "ClientSide", new { id = Model.VehicleId }) }))"
                                aria-pressed="@(isFavorite ? "true" : "false")"
                                aria-label="@(isFavorite ? "Remove from favorites" : "Save to favorites")">
                            <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart")"></i>
                        </button>
                    </div>
                </div>

                <div class="client-details-gallery">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="/images/@Model.ImagePath" alt="@vehicleTitle" />
                    }
                    else
                    {
                        <div class="client-details-gallery-placeholder">
                            <i class="bi bi-car-front"></i>
                        </div>
                    }
                    <div class="client-details-gallery-overlay client-details-gallery-overlay-left">
                        <i class="bi bi-people"></i>
                        @Model.PassengersCount seats
                    </div>
                    <div class="client-details-gallery-overlay client-details-gallery-overlay-right @(isAvailable ? "is-available" : "")">
                        @if (isAvailable)
                        {
                            <span class="client-details-status-dot"></span>
                        }
                        @statusLabel
                    </div>
                </div>

                <div class="client-details-tabs-wrap">
                    <ul class="nav client-details-tabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-panel" type="button" role="tab">Overview</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews-panel" type="button" role="tab">Reviews &amp; Ratings</button>
                        </li>
                    </ul>

                    <div class="tab-content client-details-tab-content">
                        <div class="tab-pane fade show active" id="overview-panel" role="tabpanel">
                            <div class="client-details-panel">
                                <h2>About this Vehicle</h2>
                                <p>@aboutText</p>

                                <div class="client-details-features">
                                    <div class="client-details-feature">
                                        <span class="client-details-feature-icon"><i class="bi bi-snow"></i></span>
                                        <span>Fully Air Conditioning</span>
                                    </div>
                                    <div class="client-details-feature">
                                        <span class="client-details-feature-icon"><i class="bi bi-geo-alt"></i></span>
                                        <span>GPS Navigation</span>
                                    </div>
                                    <div class="client-details-feature">
                                        <span class="client-details-feature-icon"><i class="bi bi-person-badge"></i></span>
                                        <span>Driver-Assisted Only</span>
                                    </div>
                                </div>

                                <div class="client-details-rating-bars">
                                    <div class="client-details-rating-row">
                                        <span>Professionalism</span>
                                        <div class="client-details-rating-track"><div class="client-details-rating-fill" style="width: @(professionalismTen * 10)%;"></div></div>
                                        <span class="client-details-rating-score">@professionalismTen.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                    </div>
                                    <div class="client-details-rating-row">
                                        <span>Driving</span>
                                        <div class="client-details-rating-track"><div class="client-details-rating-fill" style="width: @(drivingTen * 10)%;"></div></div>
                                        <span class="client-details-rating-score">@drivingTen.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                    </div>
                                    <div class="client-details-rating-row">
                                        <span>Courtesy</span>
                                        <div class="client-details-rating-track"><div class="client-details-rating-fill" style="width: @(courtesyTen * 10)%;"></div></div>
                                        <span class="client-details-rating-score">@courtesyTen.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                    </div>
                                </div>
                                @if (!hasDriverRatings)
                                {
                                    <p class="client-details-rating-empty">Driver ratings appear here after completed trips are reviewed.</p>
                                }

                                <div class="client-details-trust-banner">
                                    <span class="client-details-trust-icon" aria-hidden="true">
                                        <i class="bi bi-shield-fill-check"></i>
                                    </span>
                                    <div>
                                        <strong>Why rent with EasyRent?</strong>
                                        <p>We ensure a smooth and secure booking experience from the start.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="reviews-panel" role="tabpanel">
                            <div class="client-details-panel">
                                @if (reviewCount > 0)
                                {
                                    <div class="vehicle-reviews-summary">
                                        <span class="vehicle-reviews-avg">@averageRating.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                        <div class="vehicle-reviews-summary-stars" aria-hidden="true">
                                            @for (var i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= filledStars ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                        <span class="vehicle-reviews-summary-count">Based on @reviewCount verified @(reviewCount == 1 ? "review" : "reviews")</span>
                                    </div>

                                    <h2 class="vehicle-reviews-heading">Customer Reviews</h2>
                                    <div class="vehicle-reviews-list">
                                        @foreach (var review in reviews)
                                        {
                                            var reviewerName = review.Customer?.User?.FullName ?? "Customer";
                                            var reviewScore = (review.VehicleComfort + review.VehiclePerformance + review.VehicleSafety) / 3.0;
                                            <article class="vehicle-review-card">
                                                <div class="vehicle-review-head">
                                                    <span class="vehicle-review-avatar" aria-hidden="true">@GetInitial(reviewerName)</span>
                                                    <div class="vehicle-review-meta">
                                                        <span class="vehicle-review-name">@reviewerName</span>
                                                        <span class="vehicle-review-date">@review.CreatedAt.ToString("MMMM d, yyyy | h:mm tt", CultureInfo.InvariantCulture)</span>
                                                    </div>
                                                    <div class="vehicle-review-score" aria-label="@reviewScore.ToString("0.0", CultureInfo.InvariantCulture) out of 5">
                                                        <i class="bi bi-star-fill" aria-hidden="true"></i>
                                                        <span>@reviewScore.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                                    </div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(review.Comment))
                                                {
                                                    <p class="vehicle-review-comment">“@review.Comment”</p>
                                                }
                                                else
                                                {
                                                    <p class="vehicle-review-comment is-muted">No written comment.</p>
                                                }
                                            </article>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="vehicle-reviews-empty">No customer reviews for this vehicle yet. Ratings appear here after completed trips are reviewed.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <aside class="client-details-sidebar">
            <partial name="_RateSummarySidebar" model="Model" />
        </aside>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script src="~/js/vehicle-favorite.js" asp-append-version="true"></script>
    <script>
        (function () {
            var share = document.getElementById('vehicleShareBtn');
            if (!share) return;
            share.addEventListener('click', function () {
                var payload = { title: document.title, url: window.location.href };
                if (navigator.share) {
                    navigator.share(payload).catch(function () {});
                    return;
                }
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(payload.url);
                }
            });
        })();
    </script>
}
