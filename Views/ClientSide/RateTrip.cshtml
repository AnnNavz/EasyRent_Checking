@model EasyRent_Checking.ViewModels.RateTripPageViewModel

@{
    Layout = "~/Views/Shared/_LayoutClientSide.cshtml";
    ViewData["Title"] = "Rate & Review";
    ViewData["HubActive"] = "bookings";

    var multipleVehicles = Model.Items.Count > 1;
    var driverNames = Model.Items
        .Where(i => !string.IsNullOrWhiteSpace(i.DriverName))
        .Select(i => i.DriverName!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    string? headerDriverName = driverNames.Count switch
    {
        0 => null,
        1 => driverNames[0],
        _ => "Multiple drivers"
    };
}

<div class="client-page account-hub is-wide-main rate-trip-hub">
    <partial name="_AccountHubNav" />

    <section class="account-hub-main rate-trip-page">
        <a asp-action="MyBookings" class="rate-trip-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Transaction &amp; Rentals
        </a>

        <div class="rate-trip-card">
            <header class="rate-trip-header">
                <div class="rate-trip-vehicle">
                    @if (!multipleVehicles)
                    {
                        var single = Model.Items[0];
                        <div class="rate-trip-thumb" aria-hidden="true">
                            @if (!string.IsNullOrEmpty(single.VehicleImagePath))
                            {
                                <img src="~/images/@single.VehicleImagePath" alt="@single.VehicleTitle" />
                            }
                            else
                            {
                                <i class="bi bi-car-front"></i>
                            }
                        </div>
                    }

                    <div>
                        <p class="rate-trip-eyebrow">Trip completed</p>
                        <h1 class="rate-trip-title">How was your ride?</h1>
                        <p class="rate-trip-meta">
                            @if (multipleVehicles)
                            {
                                <span>@Model.Items.Count vehicles</span>
                            }
                            else
                            {
                                var single = Model.Items[0];
                                var typeLabel = string.IsNullOrWhiteSpace(single.VehicleTypeLabel) ? "Vehicle" : single.VehicleTypeLabel;
                                <span>@typeLabel</span>
                            }
                            <span aria-hidden="true">•</span>
                            @Model.BookingLabel
                            @if (!multipleVehicles && !string.IsNullOrWhiteSpace(headerDriverName))
                            {
                                <span aria-hidden="true">•</span>
                                <span>Driver: @headerDriverName</span>
                            }
                            else if (multipleVehicles && headerDriverName == "Multiple drivers")
                            {
                                <span aria-hidden="true">•</span>
                                <span>@headerDriverName</span>
                            }
                            else if (multipleVehicles && !string.IsNullOrWhiteSpace(headerDriverName))
                            {
                                <span aria-hidden="true">•</span>
                                <span>Driver: @headerDriverName</span>
                            }
                        </p>
                    </div>
                </div>
            </header>

            <form asp-action="RateTrip" asp-route-id="@Model.RentalId" method="post" class="rate-trip-form" id="rateTripForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];
                    var itemPrefix = $"{nameof(Model.Items)}[{i}]";

                    <input type="hidden" asp-for="Items[i].TransitId" />
                    <input type="hidden" asp-for="Items[i].HasDriver" />

                    <section class="rate-trip-vehicle-block@(i > 0 ? " rate-trip-vehicle-block-separated" : "")">
                        @if (multipleVehicles)
                        {
                            <div class="rate-trip-vehicle-item-header">
                                <div class="rate-trip-thumb rate-trip-thumb-small" aria-hidden="true">
                                    @if (!string.IsNullOrEmpty(item.VehicleImagePath))
                                    {
                                        <img src="~/images/@item.VehicleImagePath" alt="@item.VehicleTitle" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-car-front"></i>
                                    }
                                </div>
                                <div>
                                    <h2 class="rate-trip-vehicle-item-title">@item.VehicleTitle</h2>
                                    <p class="rate-trip-vehicle-item-meta">
                                        @(string.IsNullOrWhiteSpace(item.VehicleTypeLabel) ? "Vehicle" : item.VehicleTypeLabel)
                                        @if (!string.IsNullOrWhiteSpace(item.VehiclePlateNumber))
                                        {
                                            <span aria-hidden="true">•</span>
                                            <span>@item.VehiclePlateNumber</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.DriverName))
                                        {
                                            <span aria-hidden="true">•</span>
                                            <span>Driver: @item.DriverName</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        }

                        <section class="rate-trip-group">
                            <h2 class="rate-trip-group-title">@(multipleVehicles ? $"Rate {item.VehicleTitle}" : "Rate this vehicle")</h2>

                            @{
                                var vehicleComfort = new StarRatingInputModel { Name = $"{itemPrefix}.{nameof(item.VehicleComfort)}", Label = "Comfort", Value = item.VehicleComfort };
                                var vehiclePerformance = new StarRatingInputModel { Name = $"{itemPrefix}.{nameof(item.VehiclePerformance)}", Label = "Performance", Value = item.VehiclePerformance };
                                var vehicleSafety = new StarRatingInputModel { Name = $"{itemPrefix}.{nameof(item.VehicleSafety)}", Label = "Safety", Value = item.VehicleSafety };
                            }

                            <partial name="_StarRatingInput" model="vehicleComfort" />
                            <span asp-validation-for="Items[i].VehicleComfort" class="text-danger rate-trip-category-error"></span>

                            <partial name="_StarRatingInput" model="vehiclePerformance" />
                            <span asp-validation-for="Items[i].VehiclePerformance" class="text-danger rate-trip-category-error"></span>

                            <partial name="_StarRatingInput" model="vehicleSafety" />
                            <span asp-validation-for="Items[i].VehicleSafety" class="text-danger rate-trip-category-error"></span>
                        </section>

                        @if (item.HasDriver)
                        {
                            <section class="rate-trip-group">
                                <h2 class="rate-trip-group-title">
                                    @(string.IsNullOrWhiteSpace(item.DriverName) ? "How was your driver on this trip?" : $"How was {item.DriverName} on this trip?")
                                </h2>

                                @{
                                    var driverProfessionalism = new StarRatingInputModel { Name = $"{itemPrefix}.{nameof(item.DriverProfessionalism)}", Label = "Professionalism", Value = item.DriverProfessionalism };
                                    var driverDriving = new StarRatingInputModel { Name = $"{itemPrefix}.{nameof(item.DriverDriving)}", Label = "Driving", Value = item.DriverDriving };
                                    var driverCourtesy = new StarRatingInputModel { Name = $"{itemPrefix}.{nameof(item.DriverCourtesy)}", Label = "Courtesy", Value = item.DriverCourtesy };
                                }

                                <partial name="_StarRatingInput" model="driverProfessionalism" />
                                <span asp-validation-for="Items[i].DriverProfessionalism" class="text-danger rate-trip-category-error"></span>

                                <partial name="_StarRatingInput" model="driverDriving" />
                                <span asp-validation-for="Items[i].DriverDriving" class="text-danger rate-trip-category-error"></span>

                                <partial name="_StarRatingInput" model="driverCourtesy" />
                                <span asp-validation-for="Items[i].DriverCourtesy" class="text-danger rate-trip-category-error"></span>
                            </section>
                        }

                        <div class="rate-trip-comment-block">
                            <label asp-for="Items[i].Comment" class="rate-trip-label">Comments <span class="rate-trip-optional">(Optional)</span></label>
                            <textarea asp-for="Items[i].Comment"
                                      class="form-control rate-trip-comment"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Tell us about this vehicle, driver, or experience..."></textarea>
                            <span asp-validation-for="Items[i].Comment" class="text-danger"></span>
                        </div>
                    </section>
                }

                <div class="rate-trip-actions">
                    <button type="submit" class="my-booking-btn-primary rate-trip-submit">
                        @(multipleVehicles ? "Submit All Reviews" : "Submit Review")
                    </button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
