@model EasyRent_Checking.ViewModels.FeedbackInputModel
@using System.Globalization

@{
    Layout = "~/Views/Shared/_LayoutClientSide.cshtml";
    ViewData["Title"] = "Rate & Review";
}

<div class="client-page rate-trip-page">
    <a asp-action="MyBookingDetails" asp-route-id="@Model.RentalId" class="rate-trip-back">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to booking
    </a>

    <div class="rate-trip-card">
        <header class="rate-trip-header">
            <div class="rate-trip-vehicle">
                <div class="rate-trip-thumb" aria-hidden="true">
                    @if (!string.IsNullOrEmpty(Model.VehicleImagePath))
                    {
                        <img src="~/images/@Model.VehicleImagePath" alt="@Model.VehicleTitle" />
                    }
                </div>
                <div>
                    <p class="rate-trip-eyebrow">Trip completed</p>
                    <h1 class="rate-trip-title">How was your ride?</h1>
                    <p class="rate-trip-meta">
                        @Model.VehicleTitle
                        <span aria-hidden="true">·</span>
                        @Model.BookingLabel
                        @if (!string.IsNullOrWhiteSpace(Model.DriverName))
                        {
                            <span aria-hidden="true">·</span>
                            <span>Driver: @Model.DriverName</span>
                        }
                    </p>
                </div>
            </div>
        </header>

        <form asp-action="RateTrip" asp-route-id="@Model.RentalId" method="post" class="rate-trip-form" id="rateTripForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="rate-trip-stars-block">
                <label class="rate-trip-label" for="rating-1">Your rating</label>
                <div class="rate-trip-stars" role="radiogroup" aria-label="Star rating">
                    @for (var star = 5; star >= 1; star--)
                    {
                        var isChecked = Model.Rating == star;
                        <input type="radio"
                               name="Rating"
                               value="@star"
                               id="rating-@star"
                               class="rate-trip-star-input"
                               @(isChecked ? "checked=\"checked\"" : null) />
                        <label for="rating-@star" class="rate-trip-star-label" title="@star star@(star == 1 ? "" : "s")">
                            <i class="bi bi-star-fill" aria-hidden="true"></i>
                            <span class="visually-hidden">@star star@(star == 1 ? "" : "s")</span>
                        </label>
                    }
                </div>
                <span asp-validation-for="Rating" class="text-danger d-block mt-2"></span>
            </div>

            <div class="rate-trip-comment-block">
                <label asp-for="Comment" class="rate-trip-label">Comments <span class="rate-trip-optional">(optional)</span></label>
                <textarea asp-for="Comment"
                          class="form-control rate-trip-comment"
                          rows="5"
                          maxlength="1000"
                          placeholder="Tell us about the vehicle, driver, or overall experience..."></textarea>
                <div class="rate-trip-char-count">
                    <span id="commentCount">@(Model.Comment?.Length ?? 0)</span>/1000
                </div>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>

            <div class="rate-trip-actions">
                <a asp-action="MyBookingDetails" asp-route-id="@Model.RentalId" class="my-booking-btn-secondary">Cancel</a>
                <button type="submit" class="my-booking-btn-primary">Submit review</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const textarea = document.getElementById('Comment');
            const counter = document.getElementById('commentCount');
            if (textarea && counter) {
                textarea.addEventListener('input', function () {
                    counter.textContent = textarea.value.length;
                });
            }
        })();
    </script>
}
