@model EasyRent_Checking.ViewModels.MyBookingsPageViewModel
@using EasyRent_Checking.Models
@using System.Globalization

@{
    Layout = "~/Views/Shared/_LayoutClientSide.cshtml";
    ViewData["Title"] = "Transaction and Rentals";
    ViewData["HubActive"] = "bookings";

    string StatusLabel(RentalStatus status) => status switch
    {
        RentalStatus.Approved => "Approved",
        RentalStatus.Cancelled => "Cancelled",
        RentalStatus.Expired => "Expired",
        RentalStatus.Refunded => "Refunded",
        RentalStatus.RefundRejected => "Cancelled",
        _ => "Pending"
    };

    string StatusClass(RentalStatus status) => status switch
    {
        RentalStatus.Approved => "is-approved",
        RentalStatus.Cancelled => "is-cancelled",
        RentalStatus.Expired => "is-expired",
        RentalStatus.Refunded => "is-refunded",
        RentalStatus.RefundRejected => "is-cancelled",
        _ => "is-pending"
    };

    string FormatPeso(decimal amount) =>
        "₱" + Math.Max(0, amount).ToString("N2", CultureInfo.GetCultureInfo("en-PH"));

    string FormatTime(TimeOnly time) => time.ToString("h:mmtt", CultureInfo.InvariantCulture);

    string FilterLabel = Model.Filter switch
    {
        "upcoming" => "Upcoming",
        "completed" => "Completed",
        _ => "All Bookings"
    };

    string SortLabel = Model.Sort switch
    {
        "oldest" => "Oldest",
        "pickup" => "Pickup date",
        _ => "Newest"
    };
}

<div class="client-page account-hub is-wide-main my-bookings-page">
    <partial name="_AccountHubNav" />

    <section class="account-hub-main">
        <div class="my-bookings-header">
            <div>
                <h1 class="my-bookings-title">Transaction and Rentals</h1>
                <p class="my-bookings-subtitle">Manage your active rentals and view your rental history.</p>
            </div>
            <div class="my-bookings-toolbar">
                <div class="dropdown">
                    <button class="my-bookings-tool" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Sorting by
                        <span>@SortLabel</span>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item @(Model.Sort == "newest" ? "active" : null)" asp-action="MyBookings" asp-route-filter="@Model.Filter" asp-route-sort="newest">Newest</a></li>
                        <li><a class="dropdown-item @(Model.Sort == "oldest" ? "active" : null)" asp-action="MyBookings" asp-route-filter="@Model.Filter" asp-route-sort="oldest">Oldest</a></li>
                        <li><a class="dropdown-item @(Model.Sort == "pickup" ? "active" : null)" asp-action="MyBookings" asp-route-filter="@Model.Filter" asp-route-sort="pickup">Pickup date</a></li>
                    </ul>
                </div>
                <div class="dropdown">
                    <button class="my-bookings-tool" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Filters
                        <span>@FilterLabel</span>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item @(Model.Filter == "all" ? "active" : null)" asp-action="MyBookings" asp-route-filter="all" asp-route-sort="@Model.Sort">All Bookings</a></li>
                        <li><a class="dropdown-item @(Model.Filter == "upcoming" ? "active" : null)" asp-action="MyBookings" asp-route-filter="upcoming" asp-route-sort="@Model.Sort">Upcoming</a></li>
                        <li><a class="dropdown-item @(Model.Filter == "completed" ? "active" : null)" asp-action="MyBookings" asp-route-filter="completed" asp-route-sort="@Model.Sort">Completed</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="my-bookings-list">
            @if (Model.Items.Count > 0)
            {
                @foreach (var item in Model.Items)
                {
                    <article class="my-booking-row@(item.Vehicles.Count > 1 ? " has-multi-vehicles" : "")">
                        @if (item.Vehicles.Count > 1)
                        {
                            <div class="my-booking-thumbs is-multi" aria-hidden="true">
                                @foreach (var bookingVehicle in item.Vehicles.Take(3))
                                {
                                    <div class="my-booking-thumb-tile">
                                        @if (!string.IsNullOrEmpty(bookingVehicle.ImagePath))
                                        {
                                            <img src="~/images/@bookingVehicle.ImagePath" alt="@bookingVehicle.Brand @bookingVehicle.Model" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-car-front-fill" aria-hidden="true"></i>
                                        }
                                    </div>
                                }
                                @if (item.Vehicles.Count > 3)
                                {
                                    <div class="my-booking-thumb-tile is-more">
                                        <span>+@(item.Vehicles.Count - 3)</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="my-booking-thumb" aria-hidden="true">
                                @if (!string.IsNullOrEmpty(item.VehicleImagePath))
                                {
                                    <img src="~/images/@item.VehicleImagePath" alt="@item.VehicleTitle" />
                                }
                            </div>
                        }

                        <div class="my-booking-main">
                            <span class="my-booking-status @StatusClass(item.RentalStatus)">@StatusLabel(item.RentalStatus)</span>
                            @if (!string.IsNullOrWhiteSpace(item.ProgressLabel)
                                && item.ProgressLabel != StatusLabel(item.RentalStatus))
                            {
                                <span class="my-booking-progress is-@item.ProgressTone">@item.ProgressLabel</span>
                            }
                            @if (item.Vehicles.Count > 1)
                            {
                                <h2 class="my-booking-vehicle">@item.Vehicles.Count vehicles</h2>
                                <ul class="my-booking-vehicle-list">
                                    @foreach (var bookingVehicle in item.Vehicles)
                                    {
                                        <li>
                                            <strong>@bookingVehicle.Brand @bookingVehicle.Model</strong>
                                            <span>@bookingVehicle.TypeLabel • @bookingVehicle.PassengersCount seater</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <h2 class="my-booking-vehicle">@item.VehicleTitle</h2>
                                <p class="my-booking-spec">
                                    @item.VehicleTypeLabel <text>• @item.PassengersCount seater</text>
                                </p>
                            }
                        </div>

                        <div class="my-booking-meta my-booking-schedule">
                            <span class="my-booking-meta-label">Schedule</span>
                            <span class="my-booking-meta-value">@item.PickupDate.ToString("MMM. d, yyyy", CultureInfo.InvariantCulture)</span>
                            <span class="my-booking-meta-sub">@FormatTime(item.PickupTime) - @FormatTime(item.ReturnTime)</span>
                        </div>

                        <div class="my-booking-meta my-booking-paid">
                            <span class="my-booking-meta-label">Paid/Balance</span>
                            <span class="my-booking-meta-value">@FormatPeso(item.AmountPaid)</span>
                            @if (item.RemainingBalance > 0)
                            {
                                <span class="my-booking-meta-sub my-booking-balance-due">Balance @FormatPeso(item.RemainingBalance)</span>
                            }
                            else if (item.AmountPaid > 0)
                            {
                                <span class="my-booking-meta-sub">@(string.IsNullOrWhiteSpace(item.PaymentMethod) ? "Settled" : item.PaymentMethod + " • Settled")</span>
                            }
                            else
                            {
                                <span class="my-booking-meta-sub">Unpaid</span>
                            }
                        </div>

                        <div class="my-booking-meta my-booking-driver">
                            <span class="my-booking-meta-label">Driver Assigned</span>
                            @if (!string.IsNullOrWhiteSpace(item.DriverName))
                            {
                                <span class="my-booking-driver-pill">
                                    <span class="my-booking-driver-avatar" aria-hidden="true">
                                        @if (!string.IsNullOrEmpty(item.DriverImagePath))
                                        {
                                            <img src="~/images/@item.DriverImagePath" alt="@item.DriverName" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" />
                                        }
                                        else
                                        {
                                            @(item.DriverInitials ?? "D")
                                        }
                                    </span>
                                    @item.DriverName
                                </span>
                            }
                            else if (item.ProgressLabel == "Preparing vehicle & driver")
                            {
                                <span class="my-booking-meta-value my-booking-driver-prep">Preparing assignment</span>
                            }
                            else
                            {
                                <span class="my-booking-meta-value my-booking-driver-empty">Not Assigned Yet</span>
                            }
                        </div>

                        <div class="my-booking-actions">
                            @if (item.CanPay)
                            {
                                <a asp-action="PayRental" asp-route-id="@item.RentalId" class="my-booking-btn-primary">
                                    Pay Now
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                                <a asp-action="MyBookingDetails" asp-route-id="@item.RentalId" class="my-booking-btn-secondary">View Details</a>
                            }
                            else
                            {
                                <a asp-action="MyBookingDetails" asp-route-id="@item.RentalId" class="my-booking-btn-primary">
                                    View Details
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                                @if (item.CanRate)
                                {
                                    <a asp-action="RateTrip" asp-route-id="@item.RentalId" class="my-booking-btn-secondary">Ratings &amp; Review</a>
                                }
                                else if (item.HasFeedback)
                                {
                                    <a asp-action="MyBookingDetails" asp-route-id="@item.RentalId" class="my-booking-btn-secondary">Ratings &amp; Review</a>
                                }
                                else
                                {
                                    <span class="my-booking-btn-secondary is-disabled">Ratings &amp; Review</span>
                                }
                            }
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="my-bookings-empty">
                    <i class="bi bi-calendar2-x" aria-hidden="true"></i>
                    <p>No bookings found.</p>
                    <a asp-action="Browse" class="my-booking-btn-primary">Book a Vehicle</a>
                </div>
            }
        </div>
    </section>
</div>
