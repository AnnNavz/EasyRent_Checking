@model EasyRent_Checking.ViewModels.RentalInputModel
@using EasyRent_Checking.Models

@{
    Layout = "~/Views/Shared/_LayoutClientSide.cshtml";
    var vehicle = ViewData["Vehicle"] as Vehicle;
    if (vehicle == null)
    {
        return;
    }

    ViewData["Title"] = "Complete Booking";
    ViewData["ActiveNav"] = "Vehicles";
    ViewData["HideReserveButton"] = true;
    ViewData["LiveRateSummary"] = true;
    ViewData["HidePaymentReminders"] = true;

    string typeLabel = VehicleTypes.DisplayUpper(vehicle.Type);
    string vehicleTitle = $"{vehicle.Model} {vehicle.Brand}";
    string breadcrumbLabel = $"{vehicle.Brand} {vehicle.Model}";
    int capacity = vehicle.PassengersCount;
    int reserveWindowDays = RentalRules.ReservePaymentWindowDays;
    var pickupDateValue = Model?.PickupDate.Year >= 2000 ? Model.PickupDate.ToString("yyyy-MM-dd") : "";
    var returnDateValue = Model?.ReturnDate.Year >= 2000 ? Model.ReturnDate.ToString("yyyy-MM-dd") : "";
    var initialUnavailableDates = ViewData["InitialUnavailableDates"] as IEnumerable<string> ?? Enumerable.Empty<string>();
    var initialUnavailableJson = System.Text.Json.JsonSerializer.Serialize(initialUnavailableDates);
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/rentals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/payment-wizard.css" asp-append-version="true" />
    <style>
        .client-reservation-page .admin-booking-create {
            max-width: none;
            margin: 0;
            padding: 0;
        }
        .client-reservation-page .client-reservation-stepper {
            max-width: 720px;
            width: 100%;
            margin: 0 auto 1.75rem;
        }
        .client-reservation-page .airbnb-cal-card {
            max-width: 100%;
            background: #F9FAFF !important;
        }
        .client-reservation-page .airbnb-cal-cell.is-past .airbnb-cal-day {
            color: #bdbdbd !important;
            background: transparent !important;
            text-decoration: none !important;
        }
        .client-reservation-page .airbnb-cal-cell.is-rented .airbnb-cal-day {
            color: #fff !important;
            background: #e53935 !important;
            text-decoration: none !important;
            box-shadow: 0 1px 3px rgba(229, 57, 53, 0.35);
        }
        .client-reservation-page .airbnb-cal-cell.in-range .airbnb-cal-day {
            background: #bbdefb !important;
            color: #0d47a1 !important;
        }
        .client-reservation-page .airbnb-cal-cell.is-pickup .airbnb-cal-day {
            background: #1E3A8A !important;
            color: #fff !important;
            box-shadow: 0 1px 3px rgba(30, 58, 138, 0.4);
        }
        .client-reservation-page .airbnb-cal-cell.is-return .airbnb-cal-day {
            background: #00897b !important;
            color: #fff !important;
            box-shadow: 0 1px 3px rgba(0, 137, 123, 0.4);
        }
        .client-reservation-page .airbnb-cal-cell.is-single.is-pickup .airbnb-cal-day,
        .client-reservation-page .airbnb-cal-cell.is-single.is-return .airbnb-cal-day {
            background: linear-gradient(135deg, #1E3A8A 50%, #00897b 50%) !important;
            color: #fff !important;
        }
        .client-reservation-page .airbnb-legend-dot.is-pickup {
            background: #1E3A8A;
            border: none;
        }
        .client-reservation-page .airbnb-legend-dot.is-return {
            background: #00897b;
            border: none;
        }
        .client-reservation-page .airbnb-legend-dot.is-unavailable {
            background: #F9FAFF;
            border: 1.5px solid #c5cde0;
        }
        .client-reservation-page .airbnb-legend-dot.is-rented {
            background: #e53935;
            border: none;
        }
        .client-reservation-page .airbnb-legend-dot.is-range {
            background: #bbdefb;
            border: none;
        }
        .client-reservation-page .client-details-sidebar {
            position: sticky;
            top: calc(var(--client-topbar-height) + 1rem);
        }
        .client-reservation-page .client-reservation-vehicle-card {
            background: #d9d9d9;
            border-radius: 14px;
            padding: 1.15rem 1.25rem;
        }
        .client-reservation-page .client-reservation-vehicle-summary {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }
        .client-reservation-page .client-reservation-vehicle-image {
            width: 150px;
            aspect-ratio: 4 / 3;
            border: 1.5px solid #333;
            border-radius: 8px;
            overflow: hidden;
            flex-shrink: 0;
            background: #ececec;
        }
        .client-reservation-page .client-reservation-vehicle-meta {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.35rem;
        }
        .client-reservation-page .client-reservation-type-pill {
            display: inline-block;
            background: #cfcfcf;
            color: #333;
            font-size: 0.68rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 0.22rem 0.7rem;
            border-radius: 999px;
        }
        .client-reservation-page .client-reservation-vehicle-name {
            font-size: 1.35rem;
            font-weight: 700;
            color: #222;
            margin: 0;
            line-height: 1.2;
        }
        .client-reservation-page .client-reservation-vehicle-specs {
            font-size: 0.82rem;
            color: #444;
            margin: 0;
        }
        .client-reservation-page .btn-request-reservation {
            background-color: #1E3A8A !important;
            border-color: #1E3A8A !important;
            color: #fff !important;
        }
        .client-reservation-page .btn-request-reservation:hover {
            background-color: #172e6e !important;
            border-color: #172e6e !important;
            color: #fff !important;
        }
        .client-reservation-step.is-skipped {
            opacity: 0.4;
        }
    </style>
}

<div class="client-details-breadcrumb-bar">
    <div class="client-details-breadcrumb-inner">
        <nav class="client-details-breadcrumb" aria-label="Breadcrumb">
            <a asp-action="Homepage"><i class="bi bi-house-door"></i></a>
            <span class="client-details-breadcrumb-sep">&rsaquo;</span>
            <a asp-action="Browse">Browse Vehicles</a>
            <span class="client-details-breadcrumb-sep">&rsaquo;</span>
            <a asp-action="VehicleDetails" asp-route-id="@vehicle.VehicleId">@breadcrumbLabel</a>
            <span class="client-details-breadcrumb-sep">&rsaquo;</span>
            <span class="client-details-breadcrumb-current">Rent</span>
        </nav>
        <a asp-controller="ClientSide" asp-action="VehicleDetails" asp-route-id="@vehicle.VehicleId" class="client-btn-back-browse">
            <i class="bi bi-arrow-left"></i>
            Back to Browse Details
        </a>
    </div>
</div>

<div class="client-page client-reservation-page">
    @* Stepper sits above the 2-column layout so it stays centered on every step. *@
    <div class="client-reservation-stepper" aria-label="Booking progress">
        <div class="client-reservation-step active" data-step="1">
            <span class="client-reservation-step-dot">1</span>
            <span class="client-reservation-step-label">Info</span>
        </div>
        <div class="client-reservation-step-line" aria-hidden="true"></div>
        <div class="client-reservation-step" data-step="2">
            <span class="client-reservation-step-dot">2</span>
            <span class="client-reservation-step-label">Payment Type</span>
        </div>
        <div class="client-reservation-step-line" aria-hidden="true"></div>
        <div class="client-reservation-step" data-step="3" data-pay-now-only="true">
            <span class="client-reservation-step-dot">3</span>
            <span class="client-reservation-step-label">Payment Details</span>
        </div>
        <div class="client-reservation-step-line" aria-hidden="true"></div>
        <div class="client-reservation-step" data-step="4">
            <span class="client-reservation-step-dot">4</span>
            <span class="client-reservation-step-label">Summary</span>
        </div>
        <div class="client-reservation-step-line" aria-hidden="true"></div>
        <div class="client-reservation-step" data-step="5">
            <span class="client-reservation-step-dot">5</span>
            <span class="client-reservation-step-label">Complete</span>
        </div>
    </div>

    <div class="client-details-layout client-reservation-layout">
        <div class="client-details-main">
            <div class="admin-booking-create">
                <form asp-action="Rental" asp-route-id="@vehicle.VehicleId" method="post" enctype="multipart/form-data" id="reservationWizardForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <input type="hidden" asp-for="VehicleId" id="input-VehicleId" value="@vehicle.VehicleId" data-capacity="@capacity"
                           data-base-price="@vehicle.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           data-succeeding-fee="@vehicle.SucceedingFee.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                           data-brand="@vehicle.Brand"
                           data-model="@vehicle.Model"
                           data-type="@vehicle.Type" />
                    <input type="hidden" asp-for="RentalStatus" value="Pending" />
                    <input type="hidden" asp-for="RentalOption" id="input-RentalOption" value="@Model.RentalOption" />
                    <div class="wizard-step-panel active" id="reservationStep1">
                    @{
                        var lockCustomerFields = ViewData["CustomerFieldsLocked"] as bool? == true;
                    }
                    <!-- Rental Information -->
                    <div class="rent-step-card">
                        <div class="rent-card-head">
                            <span class="rent-card-icon"><i class="bi bi-file-earmark-text"></i></span>
                            <h2>Rental Information</h2>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CustomerName" class="rent-field-label">Customer Name</label>
                                <input asp-for="CustomerName" id="CustomerName" class="rent-field-input" placeholder="e.g. Jane Doe" readonly="@lockCustomerFields" />
                                <span asp-validation-for="CustomerName" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ContactNumber" class="rent-field-label">Contact Information</label>
                                <input asp-for="ContactNumber" id="ContactNumber" class="rent-field-input" placeholder="09123456789 or +639123456789" readonly="@lockCustomerFields" />
                                <span asp-validation-for="ContactNumber" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PickupLocation" class="rent-field-label">Pick-up Location</label>
                                <input asp-for="PickupLocation" id="PickupLocation" class="rent-field-input" placeholder="e.g. Mactan International Airport" />
                                <span asp-validation-for="PickupLocation" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DropoffLocation" class="rent-field-label">Drop-off Location</label>
                                <input asp-for="DropoffLocation" id="DropoffLocation" class="rent-field-input" placeholder="e.g. Talisay, Cebu City" />
                                <span asp-validation-for="DropoffLocation" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Pick-up & Return Date -->
                    <div class="rent-step-card">
                        <div class="rent-card-head">
                            <span class="rent-card-icon"><i class="bi bi-calendar3"></i></span>
                            <h2>Select Pick-up &amp; Return Date</h2>
                        </div>
                        <p class="rent-card-hint">
                            Click on available date to set your pick-up date, then select your return date. White = Available and Red = Rented.
                        </p>

                        <div class="row g-4 airbnb-cal-split align-items-start">
                            <div class="col-lg-7">
                                <div class="airbnb-cal-card">
                                    <div class="airbnb-cal-header">
                                        <button type="button" class="airbnb-cal-nav" id="calPrev" aria-label="Previous month">
                                            <i class="bi bi-chevron-left"></i>
                                        </button>
                                        <span class="airbnb-cal-month" id="calMonthLabel">July 2026</span>
                                        <button type="button" class="airbnb-cal-nav" id="calNext" aria-label="Next month">
                                            <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </div>
                                    <div class="airbnb-cal-weekdays">
                                        <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
                                    </div>
                                    <div class="airbnb-cal-grid" id="calGrid"></div>
                                    <div class="airbnb-cal-legend">
                                        <span><i class="airbnb-legend-dot is-unavailable"></i>Unavailable</span>
                                        <span><i class="airbnb-legend-dot is-return"></i>Return</span>
                                        <span><i class="airbnb-legend-dot is-range"></i>Range</span>
                                        <span><i class="airbnb-legend-dot is-pickup"></i>Selected</span>
                                        <span><i class="airbnb-legend-dot is-rented"></i>Rented</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5 airbnb-date-fields-side">
                                <input type="hidden" name="PickupDate" id="input-PickupDate" value="@pickupDateValue" />
                                <input type="hidden" name="ReturnDate" id="input-ReturnDate" value="@returnDateValue" />

                                <label class="rent-field-label">Pick-up Date &amp; Time</label>
                                <div class="airbnb-datetime-stack mb-3">
                                    <div class="airbnb-date-field">
                                        <input type="date" id="pickupDisplay" class="airbnb-date-input" />
                                        <i class="bi bi-calendar3 airbnb-date-icon" aria-hidden="true"></i>
                                    </div>
                                    <div class="airbnb-date-field">
                                        <input asp-for="PickupTime" id="input-PickupTime" type="time" class="airbnb-time-input" />
                                        <i class="bi bi-clock airbnb-date-icon"></i>
                                    </div>
                                </div>
                                <span asp-validation-for="PickupDate" class="text-danger small mt-1 d-block"></span>
                                <span asp-validation-for="PickupTime" class="text-danger small mt-1 d-block"></span>

                                <label class="rent-field-label">Return Date &amp; Time</label>
                                <div class="airbnb-datetime-stack">
                                    <div class="airbnb-date-field">
                                        <input type="date" id="returnDisplay" class="airbnb-date-input" />
                                        <i class="bi bi-calendar3 airbnb-date-icon" aria-hidden="true"></i>
                                    </div>
                                    <div class="airbnb-date-field">
                                        <input asp-for="ReturnTime" id="input-ReturnTime" type="time" class="airbnb-time-input" />
                                        <i class="bi bi-clock airbnb-date-icon"></i>
                                    </div>
                                </div>
                                <span asp-validation-for="ReturnDate" class="text-danger small mt-1 d-block"></span>
                                <span asp-validation-for="ReturnTime" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Passenger & Discount -->
                    <div class="rent-step-card">
                        <div class="rent-card-head">
                            <span class="rent-card-icon"><i class="bi bi-people"></i></span>
                            <h2>Passenger &amp; Discount</h2>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="PassengerCount" class="rent-field-label">Passenger Count</label>
                                <select asp-for="PassengerCount" id="input-PassengerCount" class="rent-field-input">
                                    <option value="">Select Capacity</option>
                                    @for (var seats = 1; seats <= capacity; seats++)
                                    {
                                        <option value="@seats">@seats</option>
                                    }
                                </select>
                                <span class="rent-field-help" id="capacityHint">Maximum capacity: @capacity passengers</span>
                                <span asp-validation-for="PassengerCount" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Discount" class="rent-field-label">Senior/PWD Discount (if applicable)</label>
                                <select asp-for="Discount" id="input-Discount" class="rent-field-input">
                                    <option value="No">No</option>
                                    <option value="Yes">Yes</option>
                                </select>
                                <span class="rent-field-help">10% discount - present valid ID upon booking.</span>
                                <span asp-validation-for="Discount" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-12 @(Model?.Discount == Discount.Yes ? "" : "d-none")" id="discountUploadSection">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="discount-id-panel">
                                            <div class="discount-id-panel-title">Front</div>
                                            <div id="discount-front-upload-zone" class="license-upload-zone discount-id-upload-zone">
                                                <div>
                                                    <i class="bi bi-person-vcard fs-3 text-muted d-block mb-2"></i>
                                                    <span class="d-block small fw-semibold mb-1">Drag &amp; drop or click to upload</span>
                                                    <span class="d-block text-muted" style="font-size: 0.72rem;">PNG, JPG, or JPEG (max 5MB)</span>
                                                </div>
                                                <input asp-for="DiscountImageFile" id="input-DiscountFile" type="file" class="license-file-input" accept=".png,.jpg,.jpeg" />
                                            </div>
                                            <div id="discount-front-preview-state" class="d-none">
                                                <div class="license-preview-box" id="discount-front-preview-box" title="Click to replace image">
                                                    <img id="discount-front-preview-img" class="d-none" alt="Front ID preview" />
                                                </div>
                                                <div class="upload-preview-bar d-flex align-items-center justify-content-between">
                                                    <span id="discount-front-filename" class="small fw-semibold text-muted font-monospace" style="font-size:0.8rem;"></span>
                                                    <button type="button" class="upload-preview-remove-btn" id="discount-front-remove-btn">Remove</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="discount-id-panel">
                                            <div class="discount-id-panel-title">Back</div>
                                            <div id="discount-back-upload-zone" class="license-upload-zone discount-id-upload-zone">
                                                <div>
                                                    <i class="bi bi-person-vcard fs-3 text-muted d-block mb-2"></i>
                                                    <span class="d-block small fw-semibold mb-1">Drag &amp; drop or click to upload</span>
                                                    <span class="d-block text-muted" style="font-size: 0.72rem;">PNG, JPG, or JPEG (max 5MB)</span>
                                                </div>
                                                <input type="file" id="input-DiscountBackFile" class="license-file-input" accept=".png,.jpg,.jpeg" />
                                            </div>
                                            <div id="discount-back-preview-state" class="d-none">
                                                <div class="license-preview-box" id="discount-back-preview-box" title="Click to replace image">
                                                    <img id="discount-back-preview-img" class="d-none" alt="Back ID preview" />
                                                </div>
                                                <div class="upload-preview-bar d-flex align-items-center justify-content-between">
                                                    <span id="discount-back-filename" class="small fw-semibold text-muted font-monospace" style="font-size:0.8rem;"></span>
                                                    <button type="button" class="upload-preview-remove-btn" id="discount-back-remove-btn">Remove</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <span asp-validation-for="DiscountImageFile" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Information -->
                    <div class="rent-step-card">
                        <div class="rent-card-head">
                            <span class="rent-card-icon"><i class="bi bi-file-earmark-plus"></i></span>
                            <h2>Additional Information</h2>
                        </div>

                        <label asp-for="Notes" class="rent-field-label">Special Requests/ Notes (Optional)</label>
                        <textarea asp-for="Notes" id="input-Notes" class="rent-field-input rent-field-textarea" rows="4" placeholder="e.g. Please prepare child seats, need early morning pick-up, allergic to cigarette smoke..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="rent-step-actions">
                        <a asp-controller="ClientSide" asp-action="VehicleDetails" asp-route-id="@vehicle.VehicleId" class="rent-btn-cancel">Cancel</a>
                        <button type="button" class="rent-btn-continue" data-wizard-next="1">
                            Continue to Payment Type
                        </button>
                    </div>
                    </div>

                    <div class="wizard-step-panel" id="reservationStep2">
                        @{
                            var totalFare = ViewData["TotalFare"] as decimal? ?? vehicle.BasePrice;
                            var depositPercent = ViewData["DepositPercent"] as decimal? ?? 5m;
                            var depositAmount = Math.Round(totalFare * (depositPercent / 100m), 2);
                            var remainingAmount = Math.Max(0, totalFare - depositAmount);
                            var initialChoice = Model.RentalOption == RentalOption.Reserve
                                ? "Reserve"
                                : (string.Equals(Model.PaymentType, "Partial Payment", StringComparison.OrdinalIgnoreCase) ? "Partial" : "Full");
                            string FormatPeso(decimal amount) =>
                                "₱" + Math.Max(0, amount).ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-PH"));
                        }
                        <input type="hidden" asp-for="PaymentType" id="input-PaymentType" value="@(Model.PaymentType ?? "Full Payment")" />
                        <input type="hidden" asp-for="TotalAmount" id="input-TotalAmount" value="@totalFare.ToString(System.Globalization.CultureInfo.InvariantCulture)" />

                        <div class="payment-type-block"
                             data-total-fare="@totalFare.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                             data-deposit-percent="@depositPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                             data-deposit-amount="@depositAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                             data-remaining-amount="@remainingAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                            <h1 class="payment-type-title">Type of Payment</h1>
                            <p class="payment-type-subtitle">Choose full payment, Partial Payment, or PayLater to continue.</p>

                            <div class="payment-options-panel">
                                    <button type="button"
                                            class="payment-option-card @(initialChoice == "Partial" ? "is-selected" : "")"
                                            data-pay-option="Partial"
                                            data-payment-type="Partial Payment"
                                            id="optionPartial">
                                        <div class="payment-option-icon"><i class="bi bi-percent"></i></div>
                                        <div class="payment-option-body">
                                            <div class="payment-option-title">Partial Payment</div>
                                            <div class="payment-option-desc">Pay a deposit percentage to secure your slot.</div>
                                            <div class="payment-option-amount">
                                                <span id="optionPartialAmount">@FormatPeso(depositAmount)</span>
                                                <span>initial deposit (<span id="optionPartialPercent">@depositPercent.ToString("0.##")</span>%)</span>
                                            </div>
                                            <div class="payment-option-note">
                                                Remaining <span id="optionPartialRemaining">@FormatPeso(remainingAmount)</span> to be paid on-site to the driver.
                                            </div>
                                        </div>
                                        <span class="payment-option-radio" aria-hidden="true"></span>
                                    </button>

                                    <button type="button"
                                            class="payment-option-card @(initialChoice == "Full" ? "is-selected" : "")"
                                            data-pay-option="Full"
                                            data-payment-type="Full Payment"
                                            id="optionFull">
                                        <div class="payment-option-icon"><i class="bi bi-coin"></i></div>
                                        <div class="payment-option-body">
                                            <div class="payment-option-title">Full Payment</div>
                                            <div class="payment-option-desc">Pay 100% of base fare online or walk-in for a hassle-free trip.</div>
                                            <div class="payment-option-amount">
                                                <span id="optionFullAmount">@FormatPeso(totalFare)</span>
                                                <span>total base fare</span>
                                            </div>
                                            <div class="payment-option-note">
                                                Balance = ₱0.00 (Note: Exceeding hours are separate).
                                            </div>
                                        </div>
                                        <span class="payment-option-radio" aria-hidden="true"></span>
                                    </button>

                                    <button type="button"
                                            class="payment-option-card @(initialChoice == "Reserve" ? "is-selected" : "")"
                                            data-pay-option="Reserve"
                                            data-payment-type=""
                                            id="optionPayLater">
                                        <div class="payment-option-icon"><i class="bi bi-clock-history"></i></div>
                                        <div class="payment-option-body">
                                            <div class="payment-option-title">Pay Later</div>
                                            <div class="payment-option-desc">Pay 100% when you arrive on the venue.</div>
                                            <div class="payment-option-amount">
                                                @FormatPeso(0) <span>due online today</span>
                                            </div>
                                            <div class="payment-option-note">
                                                Hold the vehicle for @reserveWindowDays days — pay on arrival or from Transactions &amp; Rentals before it expires.
                                            </div>
                                        </div>
                                        <span class="payment-option-radio" aria-hidden="true"></span>
                                    </button>
                            </div>

                            <div class="rent-pay-later-note d-none mt-3" id="payLaterNotice" role="status">
                                No payment is collected online now. You must pay within @reserveWindowDays days after submitting, or this hold expires automatically.
                            </div>

                            <div class="payment-method-panel mt-4" id="acceptedMethodsPanel">
                                <div class="payment-method-title">
                                    <i class="bi bi-credit-card-2-front"></i>
                                    <span>Payment Method</span>
                                </div>

                                <div class="payment-method-info-grid rent-pay-methods">
                                    <div class="payment-method-info-card">
                                        <div class="payment-method-info-header">
                                            <img src="~/images/System Images/GcashImage.jpg" alt="GCash" class="payment-method-info-logo" />
                                            <div>
                                                <div class="payment-method-info-name">GCash</div>
                                                <div class="payment-method-info-channel">QR only</div>
                                            </div>
                                        </div>
                                        <p class="payment-method-info-desc">Scan GCash QR code and send the exact amount.</p>
                                        <div class="payment-method-info-footer">
                                            <i class="bi bi-qr-code"></i>
                                            <span>QR Code provided on next</span>
                                        </div>
                                    </div>

                                    <div class="payment-method-info-card">
                                        <div class="payment-method-info-header">
                                            <img src="~/images/System Images/BDOimage.png" alt="BDO" class="payment-method-info-logo" />
                                            <div>
                                                <div class="payment-method-info-name">BDO</div>
                                                <div class="payment-method-info-channel">QR only</div>
                                            </div>
                                        </div>
                                        <p class="payment-method-info-desc">Scan QR code or bank transfer via BDO online banking.</p>
                                        <div class="payment-method-info-footer">
                                            <i class="bi bi-qr-code"></i>
                                            <span>QR Code provided on next</span>
                                        </div>
                                    </div>

                                    <div class="payment-method-info-card">
                                        <div class="payment-method-info-header">
                                            <div class="payment-method-info-logo-fallback"><i class="bi bi-shop"></i></div>
                                            <div>
                                                <div class="payment-method-info-name">Walk-in</div>
                                                <div class="payment-method-info-channel">Pay at Office</div>
                                            </div>
                                        </div>
                                        <p class="payment-method-info-desc">Visit our office and pay in person. Cash or card accepted.</p>
                                        <div class="payment-method-info-footer">
                                            <i class="bi bi-geo-alt"></i>
                                            <span>Address shown on confirmation</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="rent-step-actions rent-step-actions--split payment-type-actions">
                                <button type="button" class="rent-btn-cancel" data-wizard-back="1">Back</button>
                                <button type="button" class="rent-btn-continue" data-wizard-next="2" id="paymentOptionContinueBtn">
                                    Continue to Payment Method
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="wizard-step-panel" id="reservationStep3">
                        @{
                            ViewData["HidePaymentReminders"] = true;
                        }
                        <partial name="_ClientPaymentDetailsStep" model="Model" />
                    </div>

                    <div class="wizard-step-panel" id="reservationStep4">
                        @{
                            ViewData["SummaryConfirmLabel"] = "Continue";
                            ViewData["SummaryBackStep"] = "3";
                            ViewData["IsReserveFlow"] = false;
                            ViewData["HideSummaryPaymentEdit"] = false;
                        }
                        <partial name="_BookingSummaryStep" />
                    </div>
                </form>
            </div>
        </div>

        <aside class="client-details-sidebar" id="clientRateSidebar">
            <div class="rent-vehicle-preview">
                <div class="rent-vehicle-preview-image">
                    @if (!string.IsNullOrEmpty(vehicle.ImagePath))
                    {
                        <img src="/images/@vehicle.ImagePath" alt="@vehicleTitle" />
                    }
                    else
                    {
                        <i class="bi bi-car-front"></i>
                    }
                </div>
                <div class="rent-vehicle-preview-meta">
                    <strong>@vehicle.Model</strong>
                    <p>@typeLabel • @capacity seater</p>
                </div>
            </div>
            <partial name="_RateSummarySidebar" model="vehicle" />
        </aside>
        <partial name="_BookingTripSummarySidebar" model="vehicle" />
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/booking-summary.js" asp-append-version="true"></script>
    <script src="~/js/availability-calendar.js" asp-append-version="true"></script>
    <script>
        (function () {
            const pickupDateInput = document.getElementById('input-PickupDate');
            const returnDateInput = document.getElementById('input-ReturnDate');
            const pickupTimeInput = document.getElementById('input-PickupTime');
            const returnTimeInput = document.getElementById('input-ReturnTime');
            const vehicleInput = document.getElementById('input-VehicleId');
            const passengerInput = document.getElementById('input-PassengerCount');
            const capacityHint = document.getElementById('capacityHint');
            const discountSelect = document.getElementById('input-Discount');
            const discountSection = document.getElementById('discountUploadSection');
            const fileInput = document.getElementById('input-DiscountFile');
            const backFileInput = document.getElementById('input-DiscountBackFile');
            const frontUploadZone = document.getElementById('discount-front-upload-zone');
            const backUploadZone = document.getElementById('discount-back-upload-zone');
            const frontPreviewState = document.getElementById('discount-front-preview-state');
            const backPreviewState = document.getElementById('discount-back-preview-state');
            const frontFilenameLabel = document.getElementById('discount-front-filename');
            const backFilenameLabel = document.getElementById('discount-back-filename');
            const frontPreviewImg = document.getElementById('discount-front-preview-img');
            const backPreviewImg = document.getElementById('discount-back-preview-img');
            const frontPreviewBox = document.getElementById('discount-front-preview-box');
            const backPreviewBox = document.getElementById('discount-back-preview-box');
            const frontRemoveBtn = document.getElementById('discount-front-remove-btn');
            const backRemoveBtn = document.getElementById('discount-back-remove-btn');
            const rateRoot = document.getElementById('rateSummaryRoot');
            const notesInput = document.getElementById('input-Notes');
            const customerNameInput = document.getElementById('CustomerName');
            const contactInput = document.getElementById('ContactNumber');
            const pickupLocationInput = document.getElementById('PickupLocation');
            const dropoffLocationInput = document.getElementById('DropoffLocation');
            const rateSidebar = document.getElementById('clientRateSidebar');
            const tripSidebar = document.getElementById('clientTripSummarySidebar');
            const maxCapacity = @capacity;
            let calendar;

            function formatPeso(amount) {
                return '₱' + Math.round(amount).toLocaleString('en-PH');
            }

            function recalculateRate() {
                if (!rateRoot || rateRoot.dataset.live !== 'true') return;

                const emptyEl = document.getElementById('rateEstimateEmpty');
                const detailsEl = document.getElementById('rateEstimateDetails');
                const basePrice = parseFloat(rateRoot.dataset.basePrice) || 0;
                const succeedingFee = parseFloat(rateRoot.dataset.succeedingFee) || 0;
                const baseHours = parseInt(rateRoot.dataset.baseHours, 10) || 8;
                const discountPercent = parseFloat(rateRoot.dataset.discountPercent) || 10;

                const pickupDate = pickupDateInput.value;
                const returnDate = returnDateInput.value;
                const pickupTime = (pickupTimeInput && pickupTimeInput.value) ? pickupTimeInput.value : '00:00';
                const returnTime = (returnTimeInput && returnTimeInput.value) ? returnTimeInput.value : '00:00';

                if (!pickupDate || !returnDate) {
                    emptyEl.classList.add('d-none');
                    detailsEl.classList.remove('d-none');
                    document.getElementById('rateEstimateTitle').textContent = 'EXAMPLE: 10-HOUR TRIP';
                    document.getElementById('rateBaseAmount').textContent = formatPeso(basePrice);
                    document.getElementById('rateSucceedingRow').classList.remove('d-none');
                    document.getElementById('rateSucceedingLabel').textContent =
                        '+2 succeeding hours (' + formatPeso(succeedingFee) + '×2)';
                    document.getElementById('rateSucceedingAmount').textContent = formatPeso(2 * succeedingFee);
                    document.getElementById('rateDiscountRow').classList.add('d-none');
                    document.getElementById('rateTotalLabel').textContent = 'ESTIMATED TOTAL (10 hours)';
                    document.getElementById('rateTotalAmount').textContent = formatPeso(basePrice + (2 * succeedingFee));
                    return;
                }

                const start = new Date(pickupDate + 'T' + pickupTime);
                const end = new Date(returnDate + 'T' + returnTime);
                if (isNaN(start.getTime()) || isNaN(end.getTime()) || end < start) {
                    emptyEl.textContent = 'Return date/time must be after pick-up.';
                    emptyEl.classList.remove('d-none');
                    detailsEl.classList.add('d-none');
                    return;
                }

                const hours = Math.max(0, Math.round((end - start) / 3600000));
                const succeedingHours = Math.max(0, hours - baseHours);
                const succeedingAmount = succeedingHours * succeedingFee;
                const subtotal = basePrice + succeedingAmount;
                const hasDiscount = discountSelect.value === 'Yes';
                const discountAmount = hasDiscount ? (subtotal * (discountPercent / 100)) : 0;
                const total = subtotal - discountAmount;

                emptyEl.classList.add('d-none');
                detailsEl.classList.remove('d-none');
                document.getElementById('rateEstimateTitle').textContent = 'YOUR TRIP ESTIMATE';

                document.getElementById('rateBaseAmount').textContent = formatPeso(basePrice);

                const succeedingRow = document.getElementById('rateSucceedingRow');
                if (succeedingHours > 0) {
                    succeedingRow.classList.remove('d-none');
                    document.getElementById('rateSucceedingLabel').textContent =
                        '+' + succeedingHours + ' succeeding hour' + (succeedingHours === 1 ? '' : 's') +
                        ' (' + formatPeso(succeedingFee) + '×' + succeedingHours + ')';
                    document.getElementById('rateSucceedingAmount').textContent = formatPeso(succeedingAmount);
                } else {
                    succeedingRow.classList.add('d-none');
                }

                const discountRow = document.getElementById('rateDiscountRow');
                if (hasDiscount) {
                    discountRow.classList.remove('d-none');
                    document.getElementById('rateDiscountAmount').textContent = '-' + formatPeso(discountAmount);
                } else {
                    discountRow.classList.add('d-none');
                }

                const hourLabel = hours === 1 ? '1 hour' : hours + ' hours';
                document.getElementById('rateTotalLabel').textContent = 'ESTIMATED TOTAL (' + hourLabel + ')';
                document.getElementById('rateTotalAmount').textContent = formatPeso(total);
            }

            function updateCapacityHint() {
                if (capacityHint) {
                    capacityHint.textContent = 'Maximum capacity: ' + maxCapacity + ' passengers';
                }
            }

            function clearFrontDiscountFile() {
                if (fileInput) fileInput.value = '';
                if (frontFilenameLabel) frontFilenameLabel.textContent = '';
                BookingSummary.clearImagePreview(frontPreviewImg);
                frontUploadZone?.classList.remove('d-none');
                frontPreviewState?.classList.add('d-none');
            }

            function clearBackDiscountFile() {
                if (backFileInput) backFileInput.value = '';
                if (backFilenameLabel) backFilenameLabel.textContent = '';
                BookingSummary.clearImagePreview(backPreviewImg);
                backUploadZone?.classList.remove('d-none');
                backPreviewState?.classList.add('d-none');
            }

            function toggleDiscountUpload() {
                const isYes = discountSelect.value === 'Yes';
                discountSection.classList.toggle('d-none', !isYes);
                if (!isYes) {
                    clearFrontDiscountFile();
                    clearBackDiscountFile();
                }
                recalculateRate();
            }

            function showFrontDiscountPreview(file) {
                if (!file || !frontFilenameLabel) return;
                frontFilenameLabel.textContent = file.name;
                BookingSummary.showImagePreview(file, frontPreviewImg);
                frontUploadZone?.classList.add('d-none');
                frontPreviewState?.classList.remove('d-none');
            }

            function showBackDiscountPreview(file) {
                if (!file || !backFilenameLabel) return;
                backFilenameLabel.textContent = file.name;
                BookingSummary.showImagePreview(file, backPreviewImg);
                backUploadZone?.classList.add('d-none');
                backPreviewState?.classList.remove('d-none');
            }

            function bindDiscountUpload(zone, input, onFile) {
                if (!zone || !input) return;
                ['dragenter', 'dragover'].forEach(function (evt) {
                    zone.addEventListener(evt, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        zone.classList.add('is-dragover');
                    });
                });
                ['dragleave', 'drop'].forEach(function (evt) {
                    zone.addEventListener(evt, function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        zone.classList.remove('is-dragover');
                    });
                });
                zone.addEventListener('drop', function (e) {
                    const files = e.dataTransfer.files;
                    if (files && files.length > 0) {
                        const dt = new DataTransfer();
                        dt.items.add(files[0]);
                        input.files = dt.files;
                        onFile(files[0]);
                    }
                });
                input.addEventListener('change', function () {
                    if (input.files && input.files[0]) onFile(input.files[0]);
                });
            }

            function validateStep1() {
                if (!customerNameInput.value.trim()) {
                    alert('Please enter your full name.');
                    return false;
                }
                if (!contactInput.value.trim()) {
                    alert('Please enter your contact information.');
                    return false;
                }
                if (!pickupLocationInput.value.trim() || !dropoffLocationInput.value.trim()) {
                    alert('Please enter pick-up and drop-off locations.');
                    return false;
                }
                const pickup = calendar.parseDate(pickupDateInput.value);
                const ret = calendar.parseDate(returnDateInput.value);
                if (!pickup || !ret) {
                    alert('Please select pick-up and return dates on the calendar.');
                    return false;
                }
                if (ret < pickup) {
                    alert('Return date cannot be earlier than pick-up date.');
                    return false;
                }
                if (calendar.rangeHasRented(pickup, ret)) {
                    alert('Selected range includes dates when this vehicle is already rented.');
                    return false;
                }
                const count = parseInt(passengerInput.value, 10);
                if (!count || count < 1 || count > maxCapacity) {
                    alert('Passenger count must be between 1 and ' + maxCapacity + '.');
                    return false;
                }
                if (discountSelect.value === 'Yes' && !(fileInput.files && fileInput.files[0])) {
                    alert('Please upload a Senior/PWD ID image.');
                    return false;
                }
                return true;
            }

            const paymentTypeInput = document.getElementById('input-PaymentType');
            const paymentMethodInput = document.getElementById('input-PaymentMethod');
            const totalAmountInput = document.getElementById('input-TotalAmount');
            const amountPaidInput = document.getElementById('input-AmountPaid');
            const paymentDateInput = document.getElementById('input-PaymentDate');
            const accountNameInput = document.getElementById('AccountName');
            const paymentBlock = document.querySelector('.payment-type-block');
            const depositAmount = parseFloat(paymentBlock?.dataset.depositAmount || '0');
            const fullAmount = parseFloat(paymentBlock?.dataset.totalFare || totalAmountInput?.value || '0');

            function fareParts() {
                const hours = BookingSummary.calcHours(
                    pickupDateInput.value,
                    pickupTimeInput.value,
                    returnDateInput.value,
                    returnTimeInput.value
                );
                const basePrice = parseFloat(vehicleInput.dataset.basePrice || '0');
                const succeedingFee = parseFloat(vehicleInput.dataset.succeedingFee || '0');
                const succeedingHours = Math.max(0, hours - 8);
                const succeedingAmount = succeedingHours * succeedingFee;
                const hasDiscount = discountSelect.value === 'Yes';
                const subtotal = basePrice + succeedingAmount;
                const discountAmount = hasDiscount ? subtotal * 0.10 : 0;
                const total = Math.round((subtotal - discountAmount) * 100) / 100;
                const percent = parseFloat(paymentBlock?.dataset.depositPercent || '5');
                // Partial payment = 5% of the total rental amount.
                const deposit = Math.round((total * (percent / 100)) * 100) / 100;
                return { hours, succeedingHours, succeedingAmount, discountedBase: total, total, deposit };
            }

            function computeFareTotal() {
                return fareParts().total;
            }

            function refreshFareTotals() {
                const parts = fareParts();
                const dueNow = (paymentTypeInput?.value === 'Partial Payment')
                    ? parts.deposit
                    : parts.total;
                if (totalAmountInput) totalAmountInput.value = parts.total.toFixed(2);
                if (paymentBlock) {
                    paymentBlock.dataset.totalFare = String(parts.total);
                    paymentBlock.dataset.depositAmount = String(parts.deposit);
                    paymentBlock.dataset.remainingAmount = String(Math.max(0, parts.total - dueNow));
                }
                return parts;
            }

            function expectedPayAmount() {
                const parts = refreshFareTotals();
                return (paymentTypeInput?.value === 'Partial Payment')
                    ? parts.deposit
                    : parts.total;
            }

            function updatePayNowLabels() {
                const amount = expectedPayAmount();
                const label = BookingSummary.formatPeso(amount);
                document.querySelectorAll('.js-pay-now-amount').forEach(function (el) { el.textContent = label; });
                const matchLabel = document.getElementById('amountMatchLabel');
                if (matchLabel) matchLabel.textContent = label;
                const reminderAmount = document.getElementById('reminderExactAmount');
                if (reminderAmount) reminderAmount.textContent = label;
                if (amountPaidInput && !amountPaidInput.value) {
                    amountPaidInput.value = amount.toFixed(2);
                }
            }

            function setChannelPanel(method) {
                const isWalkin = method === 'Walk-in';
                const hasMethod = !!method;
                document.getElementById('channelPanelGCash')?.classList.toggle('d-none', method !== 'GCash');
                document.getElementById('channelPanelBDO')?.classList.toggle('d-none', method !== 'BDO');
                document.getElementById('channelPanelWalkin')?.classList.toggle('d-none', method !== 'Walk-in');
                document.querySelectorAll('.js-cashless-only').forEach(function (el) {
                    el.style.display = !hasMethod || isWalkin ? 'none' : '';
                });
            }

            document.querySelectorAll('.payment-select-card[data-payment-method], .payment-method-row[data-payment-method], .payment-method-tab[data-payment-method]').forEach(function (card) {
                card.addEventListener('click', function () {
                    document.querySelectorAll('.payment-select-card[data-payment-method], .payment-method-row[data-payment-method], .payment-method-tab[data-payment-method]').forEach(function (c) {
                        c.classList.remove('is-selected');
                    });
                    card.classList.add('is-selected');
                    const method = card.getAttribute('data-payment-method') || '';
                    if (paymentMethodInput) paymentMethodInput.value = method;
                    setChannelPanel(method);
                    updatePayNowLabels();
                    if (amountPaidInput) amountPaidInput.value = expectedPayAmount().toFixed(2);
                });
            });

            function formatTripDate(dateStr) {
                if (!dateStr) return '—';
                const parts = dateStr.split('-');
                if (parts.length !== 3) return dateStr;
                const months = ['Jan.', 'Feb.', 'Mar.', 'Apr.', 'May', 'Jun.', 'Jul.', 'Aug.', 'Sep.', 'Oct.', 'Nov.', 'Dec.'];
                return months[parseInt(parts[1], 10) - 1] + ' ' + parseInt(parts[2], 10) + ', ' + parts[0];
            }

            function formatTripTime(timeStr) {
                if (!timeStr) return '';
                const bits = timeStr.split(':');
                let h = parseInt(bits[0], 10);
                const m = bits[1] || '00';
                const suffix = h >= 12 ? 'PM' : 'AM';
                const hour12 = h % 12 || 12;
                return hour12 + ':' + m + suffix;
            }

            function populateTripSummary() {
                const pickupDate = pickupDateInput?.value || '';
                const returnDate = returnDateInput?.value || '';
                const pickupTime = pickupTimeInput?.value || '';
                const returnTime = returnTimeInput?.value || '';
                const hours = BookingSummary.calcHours(pickupDate, pickupTime, returnDate, returnTime);
                const passengers = passengerInput?.value || '';

                const setText = (id, value) => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = value;
                };

                setText('tripSummaryCustomer', (customerNameInput?.value || '').trim() || '—');
                setText('tripSummaryPickup', pickupDate
                    ? (formatTripDate(pickupDate) + (pickupTime ? ' • ' + formatTripTime(pickupTime) : ''))
                    : '—');
                setText('tripSummaryReturn', returnDate
                    ? (formatTripDate(returnDate) + (returnTime ? ' • ' + formatTripTime(returnTime) : ''))
                    : '—');
                setText('tripSummaryDuration', hours === 1 ? '1 hour' : (hours + ' hours'));
                setText('tripSummaryPassengers', passengers || '—');
                setText('tripSummaryDiscount', discountSelect?.value === 'Yes' ? 'Senior (10%)' : 'None');

                const choice = getPayOptionChoice();
                setText('tripSummaryStatus', choice === 'Partial' ? 'Partially Paid' : (choice === 'Reserve' ? 'Unpaid' : 'Fully Paid'));

                const parts = refreshFareTotals();
                const dueNow = choice === 'Partial'
                    ? parts.deposit
                    : parts.total;
                const remaining = Math.max(0, parts.total - dueNow);
                const typeAmount = choice === 'Partial' ? parts.deposit : parts.total;

                const breakdown = document.getElementById('tripCostBreakdown');
                const hoursRow = document.getElementById('tripBreakdownHoursRow');
                const balanceCard = document.getElementById('tripBalanceCard');
                const showCosts = breakdown && !breakdown.classList.contains('d-none');

                setText('tripBreakdownTypeLabel', choice === 'Partial' ? 'Partial Payment' : (choice === 'Reserve' ? 'Estimated Total' : 'Full Payment'));
                setText('tripBreakdownTypeAmount', formatOptionPeso(typeAmount));
                if (hoursRow) {
                    hoursRow.classList.toggle('d-none', parts.succeedingHours <= 0);
                    const extra = parts.succeedingHours;
                    setText('tripBreakdownHoursLabel', 'Exceeding Hours (' + extra + (extra === 1 ? 'hr' : 'hrs') + ')');
                    setText('tripBreakdownHoursAmount', formatOptionPeso(parts.succeedingAmount));
                }
                setText('tripBreakdownTotal', formatOptionPeso(parts.total));
                setText('tripBalanceAmount', formatOptionPeso(remaining));
                if (balanceCard && showCosts) {
                    balanceCard.classList.toggle('d-none', choice !== 'Partial' || remaining <= 0);
                }
            }

            const rentalOptionInput = document.getElementById('input-RentalOption');
            const payLaterNotice = document.getElementById('payLaterNotice');
            const reserveWindowDays = @reserveWindowDays;

            function getPayOptionChoice() {
                const selected = document.querySelector('.payment-option-card.is-selected[data-pay-option]');
                return selected ? (selected.getAttribute('data-pay-option') || 'Full') : 'Full';
            }

            function isPayLater() {
                return getPayOptionChoice() === 'Reserve' || (rentalOptionInput?.value || '') === 'Reserve';
            }

            function formatOptionPeso(amount) {
                return BookingSummary.formatPeso(amount);
            }

            function refreshPayOptionAmounts() {
                refreshFareTotals();
                const total = parseFloat(paymentBlock?.dataset.totalFare || '0');
                const deposit = parseFloat(paymentBlock?.dataset.depositAmount || '0');
                const remaining = parseFloat(paymentBlock?.dataset.remainingAmount || Math.max(0, total - deposit));
                const percent = paymentBlock?.dataset.depositPercent || '5';
                const partialAmount = document.getElementById('optionPartialAmount');
                const partialRemaining = document.getElementById('optionPartialRemaining');
                const partialPercent = document.getElementById('optionPartialPercent');
                const fullAmount = document.getElementById('optionFullAmount');
                if (partialAmount) partialAmount.textContent = formatOptionPeso(deposit);
                if (partialRemaining) partialRemaining.textContent = formatOptionPeso(remaining);
                if (partialPercent) partialPercent.textContent = percent;
                if (fullAmount) fullAmount.textContent = formatOptionPeso(total);
            }

            function applyPayOptionChoice(choice) {
                const value = choice === 'Partial' || choice === 'Reserve' || choice === 'Full' ? choice : 'Full';
                document.querySelectorAll('.payment-option-card[data-pay-option]').forEach(function (card) {
                    card.classList.toggle('is-selected', card.getAttribute('data-pay-option') === value);
                });
                payLaterNotice?.classList.toggle('d-none', value !== 'Reserve');
                document.getElementById('acceptedMethodsPanel')?.classList.toggle('d-none', value === 'Reserve');

                const continueBtn = document.getElementById('paymentOptionContinueBtn');
                if (continueBtn) {
                    continueBtn.textContent = value === 'Reserve' ? 'Continue to Summary' : 'Continue to Payment Method';
                }

                if (value === 'Reserve') {
                    if (rentalOptionInput) rentalOptionInput.value = 'Reserve';
                    if (paymentTypeInput) paymentTypeInput.value = '';
                } else {
                    if (rentalOptionInput) rentalOptionInput.value = 'Book';
                    if (paymentTypeInput) paymentTypeInput.value = value === 'Partial' ? 'Partial Payment' : 'Full Payment';
                }

                document.querySelectorAll('.client-reservation-step[data-pay-now-only="true"]').forEach(function (node) {
                    node.classList.toggle('is-skipped', value === 'Reserve');
                });

                if (tripSidebar && !tripSidebar.classList.contains('d-none')) {
                    populateTripSummary();
                }
            }

            function syncPayOptionUI() {
                applyPayOptionChoice(getPayOptionChoice());
                refreshPayOptionAmounts();
            }

            function applySummaryMode() {
                const payLater = isPayLater();
                const title = document.getElementById('summaryPageTitle');
                const subtitle = document.getElementById('summaryPageSubtitle');
                const panelTitle = document.getElementById('summaryPaymentPanelTitle');
                const statusText = document.getElementById('summaryPaymentStatusText');
                const totalLabel = document.getElementById('summaryTotalLabel');
                const reserveAlert = document.getElementById('summaryReserveAlert');
                const editBtn = document.getElementById('summaryPaymentEditBtn');
                const confirmBtn = document.getElementById('summaryConfirmBtn');

                if (title) title.textContent = payLater ? 'Hold Summary' : 'Booking Summary';
                if (subtitle) {
                    subtitle.textContent = payLater
                        ? ('Review your trip details. Payment is not included now — you must pay within ' + reserveWindowDays + ' days or this hold expires.')
                        : 'Review the rental details below before confirming and submitting this booking.';
                }
                if (panelTitle) panelTitle.textContent = payLater ? 'Estimated Costs' : 'Payment Details';
                if (statusText) statusText.textContent = payLater ? 'Pay Later' : 'Pending';
                if (totalLabel) totalLabel.textContent = payLater ? 'Estimated Total' : 'Total Rental Costs';
                reserveAlert?.classList.toggle('d-none', !payLater);
                editBtn?.classList.toggle('d-none', payLater);
                document.querySelectorAll('.js-summary-paynow').forEach(function (el) {
                    el.classList.toggle('d-none', payLater);
                });
                document.getElementById('summaryFeeGrid')?.classList.toggle('d-none', !payLater);
                if (confirmBtn) {
                    confirmBtn.textContent = payLater ? 'Confirm Hold' : 'Continue';
                }
            }

            document.querySelectorAll('.payment-option-card[data-pay-option]').forEach(function (card) {
                card.addEventListener('click', function () {
                    applyPayOptionChoice(card.getAttribute('data-pay-option') || 'Full');
                    refreshPayOptionAmounts();
                    if (!isPayLater() && amountPaidInput) {
                        amountPaidInput.value = expectedPayAmount().toFixed(2);
                    }
                });
            });

            function validateStep2() {
                const value = getPayOptionChoice();
                if (value !== 'Full' && value !== 'Partial' && value !== 'Reserve') {
                    alert('Please choose a payment option.');
                    return false;
                }
                applyPayOptionChoice(value);
                if (!isPayLater()) {
                    updatePayNowLabels();
                    if (amountPaidInput) amountPaidInput.value = expectedPayAmount().toFixed(2);
                }
                return true;
            }

            function validateStep3() {
                const method = paymentMethodInput?.value || '';
                if (!method) {
                    alert('Please select a payment method (GCash, BDO, or Walk-in).');
                    return false;
                }
                const paid = parseFloat(amountPaidInput?.value || '0');
                if (!paid || paid <= 0) {
                    alert('Please enter the amount paid.');
                    return false;
                }
                if (method !== 'Walk-in') {
                    if (!accountNameInput?.value.trim()) {
                        alert('Please enter the account name used for payment.');
                        return false;
                    }
                    const ref = document.getElementById('TransactionReference');
                    if (!ref?.value.trim()) {
                        alert('Please enter the transaction/reference number.');
                        return false;
                    }
                    const receipt = document.getElementById('input-ReceiptFile');
                    if (!receipt?.files?.length) {
                        alert('Please upload your payment receipt.');
                        return false;
                    }
                }
                if (!paymentDateInput?.value) {
                    alert('Please enter the payment date and time.');
                    return false;
                }
                return true;
            }

            function collectSummaryData() {
                const payLater = isPayLater();
                return {
                    customerName: customerNameInput.value.trim(),
                    contactNumber: contactInput.value.trim(),
                    pickupLocation: pickupLocationInput.value.trim(),
                    dropoffLocation: dropoffLocationInput.value.trim(),
                    pickupDate: pickupDateInput.value,
                    returnDate: returnDateInput.value,
                    pickupTime: pickupTimeInput.value,
                    returnTime: returnTimeInput.value,
                    passengerCount: passengerInput.value,
                    discount: discountSelect.value,
                    discountFileName: (fileInput.files && fileInput.files[0]) ? fileInput.files[0].name : '',
                    notes: notesInput ? notesInput.value.trim() : '',
                    vehicleName: ((vehicleInput.dataset.brand || '') + ' ' + (vehicleInput.dataset.model || '')).trim(),
                    vehicleType: vehicleInput.dataset.type || '',
                    basePrice: parseFloat(vehicleInput.dataset.basePrice || '0'),
                    succeedingFee: parseFloat(vehicleInput.dataset.succeedingFee || '0'),
                    baseHours: 8,
                    paymentType: payLater ? null : (paymentTypeInput?.value || ''),
                    paymentMethod: payLater ? null : (paymentMethodInput?.value || ''),
                    amountPaid: payLater ? null : parseFloat(amountPaidInput?.value || '0'),
                    accountName: payLater ? null : (accountNameInput?.value || ''),
                    transactionReference: payLater ? null : (document.getElementById('TransactionReference')?.value || ''),
                    paymentDate: payLater ? null : (paymentDateInput?.value || '')
                };
            }

            BookingSummary.initReceiptUpload();
            BookingSummary.initWizard({
                stepSelector: '.client-reservation-stepper .client-reservation-step',
                stepPanelIds: ['reservationStep1', 'reservationStep2', 'reservationStep3', 'reservationStep4'],
                submitStep: 4,
                validateStep1: validateStep1,
                validateStep2: validateStep2,
                validateStep3: validateStep3,
                collectSummaryData: collectSummaryData,
                getSubmitStep: function () { return 4; },
                resolveNextStep: function (step) {
                    if (step === 1) return 2;
                    if (step === 2) return isPayLater() ? 4 : 3;
                    if (step === 3) return 4;
                    return step;
                },
                resolveBackStep: function (step) {
                    if (step === 4) return isPayLater() ? 2 : 3;
                    if (step === 3) return 2;
                    if (step === 2) return 1;
                    return 1;
                },
                resolveSummaryEditStep: function (btn, target) {
                    if (btn.id === 'summaryPaymentEditBtn') return isPayLater() ? 2 : 3;
                    return target;
                },
                onStepChange: function (step) {
                    if (rateSidebar) {
                        rateSidebar.style.display = step === 1 ? '' : 'none';
                    }
                    if (tripSidebar) {
                        if (step === 2 || step === 3 || step === 4) {
                            const breakdown = document.getElementById('tripCostBreakdown');
                            const balanceCard = document.getElementById('tripBalanceCard');
                            breakdown?.classList.toggle('d-none', step === 2);
                            if (step === 2) {
                                balanceCard?.classList.add('d-none');
                            }
                            populateTripSummary();
                            tripSidebar.classList.remove('d-none');
                        } else {
                            tripSidebar.classList.add('d-none');
                        }
                    }
                    document.querySelector('.client-reservation-page')?.classList.toggle('is-payment-type-step', step === 2);
                    document.getElementById('summaryNextStepsCard')?.classList.toggle('d-none', step !== 4);
                    document.getElementById('tripPaymentRemindersCard')?.classList.toggle('d-none', step !== 3);
                    if (step === 2) syncPayOptionUI();
                    if (step === 3) {
                        if (paymentMethodInput && !String(paymentMethodInput.value || '').trim()) {
                            paymentMethodInput.value = 'GCash';
                            document.querySelectorAll('.payment-method-tab[data-payment-method]').forEach(function (tab) {
                                tab.classList.toggle('is-selected', tab.getAttribute('data-payment-method') === 'GCash');
                            });
                        } else {
                            const method = paymentMethodInput?.value || '';
                            document.querySelectorAll('.payment-method-tab[data-payment-method]').forEach(function (tab) {
                                tab.classList.toggle('is-selected', tab.getAttribute('data-payment-method') === method);
                            });
                        }
                        updatePayNowLabels();
                        setChannelPanel(paymentMethodInput?.value || '');
                        // Keep a value the user already typed; only fill when blank.
                        if (amountPaidInput && !String(amountPaidInput.value || '').trim()) {
                            amountPaidInput.value = expectedPayAmount().toFixed(2);
                        }
                    }
                    if (step === 4) {
                        applySummaryMode();
                        BookingSummary.populate(collectSummaryData());
                    }
                }
            });
            syncPayOptionUI();
            if (paymentDateInput && !paymentDateInput.value) {
                const now = new Date();
                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                paymentDateInput.value = now.toISOString().slice(0, 16);
            }

            discountSelect.addEventListener('change', toggleDiscountUpload);
            pickupTimeInput.addEventListener('change', recalculateRate);
            returnTimeInput.addEventListener('change', recalculateRate);
            bindDiscountUpload(frontUploadZone, fileInput, showFrontDiscountPreview);
            bindDiscountUpload(backUploadZone, backFileInput, showBackDiscountPreview);
            frontRemoveBtn?.addEventListener('click', clearFrontDiscountFile);
            backRemoveBtn?.addEventListener('click', clearBackDiscountFile);
            frontPreviewBox?.addEventListener('click', function () { fileInput?.click(); });
            backPreviewBox?.addEventListener('click', function () { backFileInput?.click(); });

            updateCapacityHint();
            toggleDiscountUpload();
            calendar = AvailabilityCalendar.init({
                vehicleInput: vehicleInput,
                availabilityUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Availability", "ClientSide"))),
                initialUnavailable: @Html.Raw(initialUnavailableJson),
                onDatesChange: recalculateRate
            });
        })();
    </script>
}
