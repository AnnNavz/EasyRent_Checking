@model EasyRent_Checking.Models.ReservationPaymentDetailsViewModel
@using EasyRent_Checking.Models
@using System.ComponentModel.DataAnnotations
@using System.Reflection

@{
    Layout = "~/Views/Shared/_LayoutClientSide.cshtml";
    var vehicle = Model.Vehicle;
    var reservation = Model.Reservation;
    var pricing = Model.Pricing;

    ViewData["Title"] = "Booking Summary";
    ViewData["ActiveNav"] = "Vehicles";
    ViewData["ReservationStep"] = 4;

    string breadcrumbVehicle = $"{vehicle.Brand} {vehicle.Model}";
    string typeLabel = vehicle.Type == VehicleType.Van ? "Van" : vehicle.Type.ToString();
    string vehicleTitle = $"{vehicle.Model} {vehicle.Brand}";

    string StatusLabel(ReservationStatus status)
    {
        var member = typeof(ReservationStatus).GetMember(status.ToString()).FirstOrDefault();
        var display = member?.GetCustomAttribute<DisplayAttribute>();
        return display?.Name ?? status.ToString();
    }

    string PaymentLabel()
    {
        return reservation.PaymentChannel switch
        {
            PaymentChannel.GCash => "GCash",
            PaymentChannel.BDO => "BDO",
            PaymentChannel.WalkIn => "Walk-in",
            _ => "—"
        };
    }

    string FormatDateTime(DateOnly date, TimeOnly time)
    {
        var dt = date.ToDateTime(time);
        return dt.ToString("MMM. d, yyyy") + " \u2022 " + dt.ToString("h:mmtt");
    }

    string FormatContact(string contact)
    {
        var digits = new string(contact.Where(char.IsDigit).ToArray());
        if (digits.Length == 11 && digits.StartsWith("09"))
        {
            return $"{digits[..4]}-{digits[4..7]}-{digits[7..]}";
        }

        return contact;
    }

    string DiscountLabel()
    {
        return reservation.Discount == 1 ? "Senior Citizen (10% off)" : "None";
    }

    var bookingDateTime = reservation.CreatedAtUtc.ToLocalTime();
    bool isWalkIn = reservation.PaymentChannel == PaymentChannel.WalkIn;
}

<div class="client-details-breadcrumb-bar">
    <div class="client-details-breadcrumb-inner">
        <nav class="client-details-breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="Vehicles" asp-action="Homepage"><i class="bi bi-house-door"></i></a>
            <span class="client-details-breadcrumb-sep">&rsaquo;</span>
            <a asp-controller="Vehicles" asp-action="Browse">Browse Vehicles</a>
            <span class="client-details-breadcrumb-sep">&rsaquo;</span>
            <a asp-controller="Vehicles" asp-action="VehicleDetails" asp-route-id="@vehicle.VehicleId">@breadcrumbVehicle</a>
            <span class="client-details-breadcrumb-sep">&rsaquo;</span>
            <span class="client-details-breadcrumb-current">Reservation</span>
        </nav>
        <a asp-controller="Vehicles" asp-action="VehicleDetails" asp-route-id="@vehicle.VehicleId" class="client-btn-back-browse">
            <i class="bi bi-arrow-left"></i>
            Back to Vehicle Details
        </a>
    </div>
</div>

<div class="client-page client-reservation-page client-payment-page client-booking-summary-page">
    <partial name="_ReservationStepper" />

    <form asp-controller="Reservations"
          asp-action="ConfirmBooking"
          method="post"
          class="client-details-layout client-reservation-layout">
        @Html.AntiForgeryToken()

        <div class="client-payment-main">
            <section class="client-payment-card client-summary-card client-summary-reservation-card">
                <div class="client-summary-card-header">
                    <h3 class="client-payment-section-title">
                        <i class="bi bi-clipboard-check"></i>
                        Reservation Details
                    </h3>
                    <a asp-controller="Reservations"
                       asp-action="Create"
                       asp-route-vehicleId="@vehicle.VehicleId"
                       class="client-summary-edit-btn">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                </div>

                <div class="client-summary-res-grid">
                    <dl class="client-summary-res-col">
                        <div class="client-summary-res-row">
                            <dt>Reservation Status</dt>
                            <dd>
                                <span class="client-summary-badge">
                                    <i class="bi bi-clock" aria-hidden="true"></i>
                                    @StatusLabel(reservation.Status)
                                </span>
                            </dd>
                        </div>
                        <div class="client-summary-res-row">
                            <dt>Booking Date &amp; Time</dt>
                            <dd>@bookingDateTime.ToString("MMM. d, yyyy") • @bookingDateTime.ToString("h:mmtt")</dd>
                        </div>
                        <div class="client-summary-res-row">
                            <dt>Customer Name</dt>
                            <dd>@reservation.CustomerName</dd>
                        </div>
                        <div class="client-summary-res-row">
                            <dt>Contact Information</dt>
                            <dd>@FormatContact(reservation.ContactInfo)</dd>
                        </div>
                        <div class="client-summary-res-row">
                            <dt>Pick-up Location</dt>
                            <dd>@reservation.PickupLoc</dd>
                        </div>
                        <div class="client-summary-res-row">
                            <dt>Drop-off Location</dt>
                            <dd>@reservation.DropoffLoc</dd>
                        </div>
                    </dl>

                    <dl class="client-summary-res-col">
                        <div class="client-summary-res-row">
                            <dt>Designated Driver</dt>
                            <dd>
                                <span class="client-summary-badge">
                                    <i class="bi bi-clock" aria-hidden="true"></i>
                                    Pending
                                </span>
                            </dd>
                        </div>
                        <div class="client-summary-res-row">
                            <dt>Vehicle Brand &amp; Model</dt>
                            <dd>@vehicleTitle</dd>
                        </div>
                        <div class="client-summary-res-row">
                            <dt>Vehicle Type</dt>
                            <dd>@typeLabel</dd>
                        </div>
                        <div class="client-summary-res-row">
                            <dt>Pick-up Date &amp; Time</dt>
                            <dd>@FormatDateTime(reservation.PickupDate, reservation.PickupTime)</dd>
                        </div>
                        <div class="client-summary-res-row">
                            <dt>Return Date &amp; Time</dt>
                            <dd>@FormatDateTime(reservation.ReturnDate, reservation.ReturnTime)</dd>
                        </div>
                        <div class="client-summary-res-row">
                            <dt>Total Duration</dt>
                            <dd>@pricing.DurationLabel</dd>
                        </div>
                    </dl>
                </div>

                <div class="client-summary-res-divider"></div>

                <div class="client-summary-passenger-section">
                    <dl class="client-summary-passenger-details">
                        <div class="client-summary-res-row">
                            <dt>Passenger Count</dt>
                            <dd>@reservation.PassengerCount Passenger@(reservation.PassengerCount == 1 ? "" : "s")</dd>
                        </div>
                        <div class="client-summary-res-row">
                            <dt>Senior/PWD Discount</dt>
                            <dd>@DiscountLabel()</dd>
                        </div>
                    </dl>

                    @if (reservation.Discount == 1 && !string.IsNullOrEmpty(reservation.ImagePath))
                    {
                        <figure class="client-summary-id-upload">
                            <span class="client-summary-id-upload-label">Valid ID Uploaded</span>
                            <div class="client-summary-id-upload-box">
                                <img src="/images/@reservation.ImagePath" alt="Discount valid ID" />
                            </div>
                            <figcaption>@reservation.ImagePath</figcaption>
                        </figure>
                    }
                </div>

                <div class="client-summary-res-divider"></div>

                <div class="client-summary-notes-section">
                    <label class="client-summary-notes-label">Special Requests / Notes</label>
                    <div class="client-summary-special-notes">
                        @(string.IsNullOrWhiteSpace(reservation.SpNotes) ? "None" : reservation.SpNotes)
                    </div>
                </div>
            </section>

            <section class="client-payment-card client-summary-card client-summary-payment-card">
                <div class="client-summary-card-header">
                    <h3 class="client-payment-section-title">
                        <i class="bi bi-credit-card"></i>
                        Payment Details
                    </h3>
                    <a asp-controller="Reservations"
                       asp-action="PaymentConfirmation"
                       class="client-summary-edit-btn">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                </div>

                <div class="client-summary-payment-grid">
                    <div class="client-summary-payment-breakdown">
                        <div class="client-summary-payment-row">
                            <span>Base Rental Fee</span>
                            <strong>₱@pricing.BaseFee.ToString("N2")</strong>
                        </div>
                        @if (pricing.SucceedingHours > 0)
                        {
                            <div class="client-summary-payment-row">
                                <span>Succeeding Hours (@pricing.SucceedingHours hour@(pricing.SucceedingHours == 1 ? "" : "s"))</span>
                                <strong>₱@pricing.SucceedingFee.ToString("N2")</strong>
                            </div>
                        }
                        @if (pricing.HasDiscount)
                        {
                            <div class="client-summary-payment-row is-discount">
                                <span>Senior Discount (10%)</span>
                                <strong>-₱@pricing.DiscountAmount.ToString("N2")</strong>
                            </div>
                        }
                    </div>

                    <dl class="client-summary-payment-meta">
                        <div class="client-summary-res-row">
                            <dt>Payment Status</dt>
                            <dd>
                                <span class="client-summary-badge">
                                    <i class="bi bi-clock" aria-hidden="true"></i>
                                    @StatusLabel(reservation.Status)
                                </span>
                            </dd>
                        </div>
                        <div class="client-summary-res-row">
                            <dt>Payment Method</dt>
                            <dd>@PaymentLabel()</dd>
                        </div>
                    </dl>
                </div>

                <div class="client-summary-payment-total">
                    <span>Total Reservation Costs</span>
                    <strong>₱@pricing.Total.ToString("N2")</strong>
                </div>
            </section>

            @if (!isWalkIn)
            {
                <section class="client-payment-card client-summary-card client-summary-submission-card">
                    <div class="client-summary-card-header">
                        <h3 class="client-payment-section-title">
                            <i class="bi bi-patch-check"></i>
                            Payment Submission Details
                        </h3>
                        <a asp-controller="Reservations"
                           asp-action="PaymentConfirmation"
                           class="client-summary-edit-btn">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                    </div>

                    <div class="client-summary-res-grid">
                        <dl class="client-summary-res-col">
                            <div class="client-summary-res-row">
                                <dt>Account Name (Sender)</dt>
                                <dd>@(reservation.PayerAccountName ?? "—")</dd>
                            </div>
                            <div class="client-summary-res-row">
                                <dt>Reference Number</dt>
                                <dd>@(reservation.PaymentReference ?? "—")</dd>
                            </div>
                        </dl>

                        <dl class="client-summary-res-col">
                            <div class="client-summary-res-row">
                                <dt>Amount Sent</dt>
                                <dd>₱@((reservation.AmountSent ?? pricing.Total).ToString("N2"))</dd>
                            </div>
                            <div class="client-summary-res-row client-summary-receipt-row">
                                <dt>Receipt Screenshot</dt>
                                <dd>
                                    @if (!string.IsNullOrEmpty(reservation.PaymentProofPath))
                                    {
                                        <figure class="client-summary-receipt-upload">
                                            <div class="client-summary-id-upload-box">
                                                <img src="/images/@reservation.PaymentProofPath" alt="Payment receipt" />
                                            </div>
                                            <figcaption>@reservation.PaymentProofPath</figcaption>
                                        </figure>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </dd>
                            </div>
                        </dl>
                    </div>
                </section>
            }

            <div class="client-reservation-actions client-payment-actions">
                <a asp-controller="Reservations"
                   asp-action="PaymentConfirmation"
                   class="client-reservation-btn-back">Back</a>
                <button type="submit" class="client-reservation-btn-continue">Confirm Booking and Submit</button>
            </div>
        </div>

        <aside class="client-details-sidebar">
            <partial name="_BookingSummaryNextSteps" />
        </aside>
    </form>
</div>
