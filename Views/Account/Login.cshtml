@model EasyRent_Checking.ViewModels.LoginInputModel
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewData["Title"] = "Login";
    var keepTypedValues = string.Equals(Context.Request.Method, "POST", StringComparison.OrdinalIgnoreCase);
}

<div class="auth-page auth-page-login">
    <div class="auth-login-header">
        <div class="auth-card-brand auth-card-brand-login">
            <img src="~/images/System Images/EasyRentLogo.png" alt="EasyRent" class="client-brand-logo-img" asp-append-version="true" />
            <span class="client-brand-name">EasyRent</span>
        </div>
        <p class="auth-subtitle auth-login-welcome">Welcome back! Please login to your account</p>
    </div>

    <div class="auth-card auth-card-login">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="auth-alert auth-alert-success" role="alert">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="auth-alert auth-alert-error" role="alert">@TempData["ErrorMessage"]</div>
        }
        @if (ViewData["LoginReminder"] != null)
        {
            <div class="auth-alert auth-alert-info" role="status">@ViewData["LoginReminder"]</div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" class="auth-form auth-form-login" autocomplete="off" novalidate>
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert-error"></div>

            <div class="auth-field">
                <label asp-for="Email" class="auth-label auth-label-login">Email Address</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-envelope auth-input-icon auth-input-icon-login"></i>
                    <input asp-for="Email" class="auth-input auth-input-login" placeholder="name@example.com" autocomplete="off" autocapitalize="off" spellcheck="false" />
                </div>
            </div>

            <div class="auth-field">
                <label asp-for="Password" class="auth-label auth-label-login">Password</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-lock auth-input-icon auth-input-icon-login"></i>
                    <input asp-for="Password" type="password" class="auth-input auth-input-login auth-password-input" placeholder="••••••••••" value="@Model.Password" autocomplete="new-password" />
                    <button type="button" class="auth-password-toggle" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <div class="auth-row-between">
                <a asp-controller="Account" asp-action="ForgotPassword" class="auth-forgot-link auth-forgot-link-login">Forgot Password?</a>
            </div>

            <button type="submit" class="auth-submit auth-submit-login">Sign In</button>
        </form>

        <div class="auth-divider auth-divider-login"></div>

        <p class="auth-footer-text auth-login-footer">
            Don't have an account yet?
            <a asp-controller="Account" asp-action="Registration" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="auth-footer-link auth-footer-link-login">Sign up for free</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var email = document.getElementById('Email');
            var password = document.getElementById('Password');
            var keepTypedValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.Equals(Context.Request.Method, "POST", StringComparison.OrdinalIgnoreCase)));

            function clearLoginFields() {
                if (keepTypedValues) return;
                if (email) email.value = '';
                if (password) password.value = '';
            }

            if (keepTypedValues) {
                if (password) {
                    password.value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Password ?? ""));
                }
            } else {
                clearLoginFields();
                window.addEventListener('pageshow', clearLoginFields);
                setTimeout(clearLoginFields, 50);
                setTimeout(clearLoginFields, 300);
            }
        })();

        document.querySelectorAll('.auth-password-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.parentElement.querySelector('.auth-password-input');
                var icon = btn.querySelector('i');
                if (!input) return;
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.classList.toggle('bi-eye', !show);
                icon.classList.toggle('bi-eye-slash', show);
            });
        });
    </script>
}
