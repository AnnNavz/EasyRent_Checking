@{
    Layout = "~/Views/Shared/_LayoutClientSide.cshtml";
    ViewData["Title"] = "Login";
    ViewData["HideSignIn"] = true;
}

<div class="auth-page">
    <div class="auth-login-header">
        <div class="auth-card-brand">
            <span class="client-brand-logo">L</span>
            <span class="client-brand-name">EasyRent</span>
        </div>
        <p class="auth-subtitle auth-login-welcome">Welcome back! Please login to your account</p>
    </div>

    <div class="auth-card auth-card-login">
        <form asp-controller="Account" asp-action="Login" method="post" class="auth-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="auth-field">
                <label class="auth-label" for="loginEmail">Email Address</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-envelope auth-input-icon"></i>
                    <input id="loginEmail" name="Email" type="email" class="auth-input" placeholder="name@example.com" autocomplete="email" required />
                </div>
            </div>

            <div class="auth-field">
                <label class="auth-label" for="loginPassword">Password</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-lock auth-input-icon"></i>
                    <input id="loginPassword" name="Password" type="password" class="auth-input auth-password-input" placeholder="**********" autocomplete="current-password" required />
                    <button type="button" class="auth-password-toggle" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <label class="auth-check">
                <input type="checkbox" name="RememberMe" value="true" />
                <span>Remember me for 30 days</span>
            </label>

            <button type="submit" class="auth-submit">Login</button>
        </form>

        <p class="auth-footer-text auth-login-footer">
            Don't have an account yet?
            <a asp-controller="Account" asp-action="Registration" class="auth-footer-link">Sign up for free</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.auth-password-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.parentElement.querySelector('.auth-password-input');
                var icon = btn.querySelector('i');
                if (!input) return;
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.classList.toggle('bi-eye', !show);
                icon.classList.toggle('bi-eye-slash', show);
            });
        });
    </script>
}
