@model EasyRent_Checking.ViewModels.CustomerAccountInputModel
@using EasyRent_Checking.Models

@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewData["Title"] = "Create Account";
}

<div class="auth-page auth-page-login auth-page-register">
    <div class="auth-register-header">
        <div class="auth-card-brand auth-card-brand-login">
            <img src="~/images/System Images/EasyRentLogo.png" alt="EasyRent" class="client-brand-logo-img" asp-append-version="true" />
            <span class="client-brand-name">EasyRent</span>
        </div>
        <h1 class="auth-page-title">Create Your Account</h1>
        <p class="auth-subtitle auth-page-subtitle">Join us today and start your journey.</p>
    </div>

    <div class="auth-card auth-card-register auth-card-mockup">
        @if (ViewData["LoginReminder"] != null)
        {
            <div class="auth-reminder" role="status">
                <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                <p>@ViewData["LoginReminder"]</p>
            </div>
        }

        <form asp-controller="Account" asp-action="Registration" method="post" enctype="multipart/form-data" class="auth-form auth-form-login" novalidate>
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert-error"></div>

            <div class="auth-field">
                <label asp-for="FullName" class="auth-label auth-label-login">Full Name</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-person auth-input-icon auth-input-icon-login"></i>
                    <input asp-for="FullName" class="auth-input auth-input-login" placeholder="@FieldRules.NamePlaceholder" autocomplete="name" />
                </div>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="auth-grid-2">
                <div class="auth-field">
                    <label asp-for="ContactNumber" class="auth-label auth-label-login">Contact Number</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-telephone auth-input-icon auth-input-icon-login"></i>
                        <input asp-for="ContactNumber" class="auth-input auth-input-login" placeholder="09123456789" maxlength="11" inputmode="numeric" pattern="09[0-9]{9}" autocomplete="tel" />
                    </div>
                    <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                </div>
                <div class="auth-field">
                    <label asp-for="Email" class="auth-label auth-label-login">Email Address</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-envelope auth-input-icon auth-input-icon-login"></i>
                        <input asp-for="Email" class="auth-input auth-input-login" placeholder="name@example.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="auth-password-block">
                <p class="auth-password-hint">Must be at least 8 characters and include a number.</p>
                <div class="auth-grid-2">
                    <div class="auth-field">
                        <label asp-for="Password" class="auth-label auth-label-login">Password</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-lock auth-input-icon auth-input-icon-login"></i>
                            <input asp-for="Password" class="auth-input auth-input-login auth-password-input" type="password" placeholder="••••••••••" value="@Model.Password" autocomplete="new-password" />
                            <button type="button" class="auth-password-toggle" aria-label="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="auth-field">
                        <label asp-for="ConfirmPassword" class="auth-label auth-label-login">Confirm Password</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-lock auth-input-icon auth-input-icon-login"></i>
                            <input asp-for="ConfirmPassword" class="auth-input auth-input-login auth-password-input" type="password" placeholder="••••••••••" value="@Model.ConfirmPassword" autocomplete="new-password" />
                            <button type="button" class="auth-password-toggle" aria-label="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="auth-field">
                <label asp-for="ValidIDtype" class="auth-label auth-label-login">Type of valid IDs</label>
                <div class="auth-select-wrap">
                    <select asp-for="ValidIDtype" id="input-ValidIDtype" class="auth-select auth-select-login">
                        <option value="">Select ID type</option>
                        <option value="@nameof(ValidIDtype.NationalID)">National ID</option>
                        <option value="@nameof(ValidIDtype.Passport)">Passport</option>
                        <option value="@nameof(ValidIDtype.UMID)">UMID</option>
                        <option value="@nameof(ValidIDtype.DriverLicense)">Driver License</option>
                        <option value="@nameof(ValidIDtype.VotersID)">Voters ID</option>
                        <option value="@nameof(ValidIDtype.PostalID)">Postal ID</option>
                    </select>
                    <i class="bi bi-chevron-down auth-select-chevron auth-select-chevron-login"></i>
                </div>
                <span asp-validation-for="ValidIDtype" class="text-danger small"></span>
            </div>

            <input type="hidden" asp-for="FrontValidIDImagePath" />
            <input type="hidden" asp-for="BackValidIDImagePath" />

            <div id="validIdUploadSection" class="auth-upload-section @(string.IsNullOrWhiteSpace(Model.ValidIDtype) ? "d-none" : "")">
                <div class="auth-id-upload-grid">
                    <div class="auth-id-upload-panel">
                        <label class="auth-label auth-label-login" for="input-FrontValidIDFile">Front</label>
                        <div id="valid-id-front-upload-zone" class="auth-upload-zone auth-upload-zone-login">
                            <div>
                                <i class="bi bi-person-vcard auth-upload-icon"></i>
                                <span class="auth-upload-title">Drag &amp; drop or click to upload</span>
                                <span class="auth-upload-hint">PNG, JPG, JPEG (max 5MB)</span>
                            </div>
                            <input asp-for="FrontValidIDImageFile" id="input-FrontValidIDFile" type="file" class="auth-file-input" accept=".png,.jpg,.jpeg" />
                        </div>
                        <div id="valid-id-front-preview-state" class="d-none auth-upload-preview">
                            <div class="auth-preview-box" title="Click to replace image" onclick="document.getElementById('input-FrontValidIDFile').click()">
                                <img id="valid-id-front-preview-img" alt="Front of valid ID" />
                            </div>
                            <div class="auth-upload-file-row">
                                <span id="valid-id-front-filename" class="auth-upload-filename"></span>
                                <button type="button" class="auth-upload-remove" id="valid-id-front-remove-btn">Remove</button>
                            </div>
                        </div>
                        <span asp-validation-for="FrontValidIDImageFile" class="text-danger small"></span>
                    </div>
                    <div class="auth-id-upload-panel">
                        <label class="auth-label auth-label-login" for="input-BackValidIDFile">Back</label>
                        <div id="valid-id-back-upload-zone" class="auth-upload-zone auth-upload-zone-login">
                            <div>
                                <i class="bi bi-person-vcard auth-upload-icon"></i>
                                <span class="auth-upload-title">Drag &amp; drop or click to upload</span>
                                <span class="auth-upload-hint">PNG, JPG, JPEG (max 5MB)</span>
                            </div>
                            <input asp-for="BackValidIDImageFile" id="input-BackValidIDFile" type="file" class="auth-file-input" accept=".png,.jpg,.jpeg" />
                        </div>
                        <div id="valid-id-back-preview-state" class="d-none auth-upload-preview">
                            <div class="auth-preview-box" title="Click to replace image" onclick="document.getElementById('input-BackValidIDFile').click()">
                                <img id="valid-id-back-preview-img" alt="Back of valid ID" />
                            </div>
                            <div class="auth-upload-file-row">
                                <span id="valid-id-back-filename" class="auth-upload-filename"></span>
                                <button type="button" class="auth-upload-remove" id="valid-id-back-remove-btn">Remove</button>
                            </div>
                        </div>
                        <span asp-validation-for="BackValidIDImageFile" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="auth-terms-block">
                <label class="auth-check auth-check-login auth-check-terms">
                    <input asp-for="AgreeTerms" />
                    <span>I agree to the <a asp-controller="ClientSide" asp-action="TermsConditions" class="auth-inline-link" data-legal-modal="terms">Terms &amp; Conditions</a> and <a asp-controller="ClientSide" asp-action="PrivacyPolicy" class="auth-inline-link" data-legal-modal="privacy">Privacy Policy</a>.</span>
                </label>
                <span asp-validation-for="AgreeTerms" class="text-danger small"></span>
            </div>

            <button type="submit" class="auth-submit auth-submit-login">Create Account</button>
        </form>

        <div class="auth-divider auth-divider-login"></div>

        <p class="auth-footer-text auth-login-footer">
            Already have an account?
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="auth-footer-link auth-footer-link-login">Login here</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var password = document.getElementById('Password');
            var confirm = document.getElementById('ConfirmPassword');
            if (password) {
                password.value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Password ?? ""));
            }
            if (confirm) {
                confirm.value = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ConfirmPassword ?? ""));
            }
        })();

        document.querySelectorAll('.auth-password-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.parentElement.querySelector('.auth-password-input');
                var icon = btn.querySelector('i');
                if (!input) return;
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.classList.toggle('bi-eye', !show);
                icon.classList.toggle('bi-eye-slash', show);
            });
        });

        (function () {
            var idTypeSelect = document.getElementById('input-ValidIDtype');
            var uploadSection = document.getElementById('validIdUploadSection');
            var existingFrontUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.IsNullOrEmpty(Model.FrontValidIDImagePath) ? null : Url.Content("~/images/" + Model.FrontValidIDImagePath)));
            var existingFrontName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.IsNullOrEmpty(Model.FrontValidIDImagePath) ? null : System.IO.Path.GetFileName(Model.FrontValidIDImagePath)));
            var existingBackUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.IsNullOrEmpty(Model.BackValidIDImagePath) ? null : Url.Content("~/images/" + Model.BackValidIDImagePath)));
            var existingBackName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(string.IsNullOrEmpty(Model.BackValidIDImagePath) ? null : System.IO.Path.GetFileName(Model.BackValidIDImagePath)));

            function bindIdUpload(zoneId, inputId, previewId, filenameId, removeId, imageId, pathInputId) {
                var uploadZone = document.getElementById(zoneId);
                var fileInput = document.getElementById(inputId);
                var previewState = document.getElementById(previewId);
                var filenameLabel = document.getElementById(filenameId);
                var removeBtn = document.getElementById(removeId);
                var previewImg = document.getElementById(imageId);
                var pathInput = document.getElementById(pathInputId);
                if (!uploadZone || !fileInput || !previewState || !filenameLabel || !removeBtn || !previewImg) return;

                function clearFile() {
                    fileInput.value = '';
                    filenameLabel.textContent = '';
                    previewImg.removeAttribute('src');
                    previewState.classList.add('d-none');
                    uploadZone.classList.remove('d-none');
                    if (pathInput) pathInput.value = '';
                }

                function showSaved(url, fileName) {
                    if (!url) return;
                    filenameLabel.textContent = fileName || 'Uploaded ID';
                    previewImg.src = url;
                    uploadZone.classList.add('d-none');
                    previewState.classList.remove('d-none');
                }

                function showPreview(file) {
                    if (!file) {
                        clearFile();
                        return;
                    }
                    filenameLabel.textContent = file.name;
                    uploadZone.classList.add('d-none');
                    previewState.classList.remove('d-none');
                    if (file.type && file.type.startsWith('image/')) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            previewImg.src = e.target.result;
                        };
                        reader.readAsDataURL(file);
                    }
                }

                fileInput.addEventListener('change', function () {
                    showPreview(fileInput.files && fileInput.files[0]);
                });
                removeBtn.addEventListener('click', clearFile);
                uploadZone.addEventListener('dragover', function (e) {
                    e.preventDefault();
                    uploadZone.classList.add('is-dragover');
                });
                uploadZone.addEventListener('dragleave', function () {
                    uploadZone.classList.remove('is-dragover');
                });
                uploadZone.addEventListener('drop', function (e) {
                    e.preventDefault();
                    uploadZone.classList.remove('is-dragover');
                    var files = e.dataTransfer && e.dataTransfer.files;
                    if (!files || !files.length) return;
                    var dt = new DataTransfer();
                    dt.items.add(files[0]);
                    fileInput.files = dt.files;
                    showPreview(files[0]);
                });

                return { clear: clearFile, showSaved: showSaved };
            }

            var frontUpload = bindIdUpload(
                'valid-id-front-upload-zone',
                'input-FrontValidIDFile',
                'valid-id-front-preview-state',
                'valid-id-front-filename',
                'valid-id-front-remove-btn',
                'valid-id-front-preview-img',
                'FrontValidIDImagePath');
            var backUpload = bindIdUpload(
                'valid-id-back-upload-zone',
                'input-BackValidIDFile',
                'valid-id-back-preview-state',
                'valid-id-back-filename',
                'valid-id-back-remove-btn',
                'valid-id-back-preview-img',
                'BackValidIDImagePath');

            function toggleUploadSection() {
                var hasType = !!idTypeSelect.value;
                uploadSection.classList.toggle('d-none', !hasType);
                if (!hasType) {
                    if (frontUpload) frontUpload.clear();
                    if (backUpload) backUpload.clear();
                }
            }

            idTypeSelect.addEventListener('change', toggleUploadSection);
            toggleUploadSection();
            if (frontUpload) frontUpload.showSaved(existingFrontUrl, existingFrontName);
            if (backUpload) backUpload.showSaved(existingBackUrl, existingBackName);
        })();
    </script>
}
