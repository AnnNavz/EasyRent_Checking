@model EasyRent_Checking.ViewModels.ForgotPasswordInputModel

@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-page auth-page-login auth-page-forgot">
    <div class="auth-login-header">
        <div class="auth-card-brand auth-card-brand-login">
            <img src="~/images/System Images/EasyRentLogo.png" alt="EasyRent" class="client-brand-logo-img" asp-append-version="true" />
            <span class="client-brand-name">EasyRent</span>
        </div>
        <h1 class="auth-page-title">Forgot Password?</h1>
        <p class="auth-subtitle auth-page-subtitle">No worries! Enter your email address and we'll send you instructions to reset your password</p>
    </div>

    <div class="auth-card auth-card-login auth-card-mockup">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success small py-2 px-3 mb-3" role="alert">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger small py-2 px-3 mb-3" role="alert">@TempData["ErrorMessage"]</div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="auth-form auth-form-login" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="auth-field">
                <label asp-for="Email" class="auth-label auth-label-login">Email Address</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-envelope auth-input-icon auth-input-icon-login"></i>
                    <input asp-for="Email" class="auth-input auth-input-login" placeholder="name@example.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="auth-submit auth-submit-login">Send Reset Link</button>
        </form>

        <div class="auth-divider auth-divider-login"></div>

        <p class="auth-footer-text auth-login-footer">
            Already have an account?
            <a asp-controller="Account" asp-action="Login" class="auth-footer-link auth-footer-link-login">Login here</a>
        </p>
    </div>

    <div class="auth-help-box" role="note">
        <div class="auth-help-box-top">
            <i class="bi bi-info-circle-fill auth-help-box-icon" aria-hidden="true"></i>
            <div class="auth-help-box-body">
                <strong>Can't access to your email?</strong>
                <p>If you no longer have access to your email account, please contact our main office number for assistance.</p>
            </div>
        </div>
        <div class="auth-help-box-action">
            <a href="tel:+6390223459708" class="auth-help-box-btn">Call +63 902 2345 9708</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
