@model EasyRent_Checking.ViewModels.ResetPasswordInputModel

@{
    Layout = "~/Views/Shared/_LayoutClientSide.cshtml";
    ViewData["Title"] = "Reset Password";
    ViewData["HideSignIn"] = true;
}

<div class="auth-page">
    <div class="auth-login-header">
        <div class="auth-card-brand">
            <img src="~/images/System Images/EasyRentLogo.png" alt="EasyRent" class="client-brand-logo-img" asp-append-version="true" />
            <span class="client-brand-name">EasyRent</span>
        </div>
        <h1 class="auth-title">Set a New Password</h1>
        <p class="auth-subtitle auth-login-welcome">Your email is verified. Choose a new password for your account.</p>
    </div>

    <div class="auth-card auth-card-login">
        <form asp-controller="Account" asp-action="ResetPassword" method="post" class="auth-form" novalidate>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="auth-field">
                <label asp-for="Password" class="auth-label">New Password</label>
                <p class="auth-password-hint">Must be at least 8 characters and include a number.</p>
                <div class="auth-input-wrap">
                    <i class="bi bi-lock auth-input-icon"></i>
                    <input asp-for="Password" class="auth-input auth-password-input" type="password" placeholder="**********" autocomplete="new-password" />
                    <button type="button" class="auth-password-toggle" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword" class="auth-label">Confirm Password</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-lock auth-input-icon"></i>
                    <input asp-for="ConfirmPassword" class="auth-input auth-password-input" type="password" placeholder="**********" autocomplete="new-password" />
                    <button type="button" class="auth-password-toggle" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="auth-submit">Change password</button>
        </form>

        <p class="auth-footer-text auth-login-footer">
            <a asp-controller="Account" asp-action="Login" class="auth-footer-link">Back to login</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.auth-password-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.parentElement.querySelector('.auth-password-input');
                var icon = btn.querySelector('i');
                if (!input) return;
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.classList.toggle('bi-eye', !show);
                icon.classList.toggle('bi-eye-slash', show);
            });
        });
    </script>
}
