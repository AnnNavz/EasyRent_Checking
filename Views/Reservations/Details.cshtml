@model EasyRent_Checking.Models.Reservation
@using EasyRent_Checking.Models
@using System.Globalization

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Reservation > View Details";
    ViewData["ActivePage"] = "Reservations";

    var details = Model?.Details;
    var vehicle = details?.Vehicle;
    var latestPayment = ViewData["LatestPayment"] as Payment;
    var isPending = Model?.ReservationStatus == ReservationStatus.Pending;
    var isApproved = Model?.ReservationStatus == ReservationStatus.Approved;
    var isCancelled = Model?.ReservationStatus == ReservationStatus.Cancelled;
    var justApproved = TempData["ShowPaymentSection"] as bool? == true;
    var showPaymentSection = isApproved || justApproved;
    var paymentStatusLabel = latestPayment == null
        ? "Unpaid"
        : latestPayment.PaymentStatus.ToString();

    string FormatDateTime(DateOnly? date, TimeOnly? time)
    {
        if (date == null || time == null) return "—";
        return $"{date.Value.ToString("MMM. d, yyyy", CultureInfo.InvariantCulture)} | {time.Value.ToString("h:mm tt", CultureInfo.InvariantCulture)}";
    }

    string FormatDuration()
    {
        if (details == null) return "—";
        var start = details.PickupDate.ToDateTime(details.PickupTime);
        var end = details.ReturnDate.ToDateTime(details.ReturnTime);
        var hours = Math.Max(0, (int)Math.Round((end - start).TotalHours));
        return hours == 1 ? "1 hour" : $"{hours} hours";
    }

    string StatusBadgeClass(ReservationStatus status) => status switch
    {
        ReservationStatus.Approved => "booking-status-approved",
        ReservationStatus.Cancelled => "booking-status-cancelled",
        _ => "booking-status-pending"
    };

    string StatusIcon(ReservationStatus status) => status switch
    {
        ReservationStatus.Approved => "bi-check-circle",
        ReservationStatus.Cancelled => "bi-x-circle",
        _ => "bi-clock"
    };

    var bookingId = $"BK-{Model?.ReservationId.ToString("D5") ?? "00000"}";
    var discountLabel = details?.Discount == Discount.Yes ? "Senior Citizen (10% off)" : "None";
}

<div class="container-fluid px-4 py-3 reservation-details-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 px-3 mb-3" role="alert">@TempData["SuccessMessage"]</div>
    }

    <div class="details-page-actions mb-3">
        <a asp-action="Index" class="btn btn-page-back">Back</a>
        <a asp-action="Edit" asp-route-id="@Model?.ReservationId" class="btn btn-reservation-edit">Edit Reservation</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="reservation-view-card mb-4">
                <div class="reservation-view-idbar">
                    <div>
                        <span class="reservation-view-id-label">Booking ID</span>
                        <h1 class="reservation-view-id">@bookingId</h1>
                    </div>
                    <span class="booking-status-badge @StatusBadgeClass(Model!.ReservationStatus)">
                        <i class="bi @StatusIcon(Model.ReservationStatus) me-1"></i>@Model.ReservationStatus
                    </span>
                </div>

                <div class="reservation-view-people">
                    <div class="reservation-view-person">
                        <div class="reservation-view-avatar" aria-hidden="true">
                            <i class="bi bi-person"></i>
                        </div>
                        <div>
                            <div class="reservation-view-person-name">@Model.CustomerName</div>
                            <div class="reservation-view-person-meta">@Model.ContactNumber</div>
                        </div>
                    </div>
                    <div class="reservation-view-vehicle">
                        <div class="reservation-view-vehicle-thumb" aria-hidden="true">
                            @if (!string.IsNullOrEmpty(vehicle?.ImagePath))
                            {
                                <img src="~/images/@vehicle.ImagePath" alt="@vehicle.Model" />
                            }
                            else
                            {
                                <div class="reservation-view-placeholder">
                                    <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                                        <line x1="0" y1="0" x2="100" y2="100" />
                                        <line x1="100" y1="0" x2="0" y2="100" />
                                    </svg>
                                </div>
                            }
                        </div>
                        <div>
                            <div class="reservation-view-vehicle-label">Selected Vehicle</div>
                            <div class="reservation-view-vehicle-name">
                                @(vehicle != null ? $"{vehicle.Model} {vehicle.Brand}" : "Unassigned")
                            </div>
                            <div class="reservation-view-vehicle-type">@(vehicle?.Type.ToString() ?? "—")</div>
                        </div>
                    </div>
                </div>

                <div class="reservation-view-grid">
                    <div class="reservation-view-field">
                        <span class="reservation-view-label">Pick-up Date</span>
                        <span class="reservation-view-value">@FormatDateTime(details?.PickupDate, details?.PickupTime)</span>
                    </div>
                    <div class="reservation-view-field">
                        <span class="reservation-view-label">Return Date</span>
                        <span class="reservation-view-value">@FormatDateTime(details?.ReturnDate, details?.ReturnTime)</span>
                    </div>
                    <div class="reservation-view-field">
                        <span class="reservation-view-label">Total Duration</span>
                        <span class="reservation-view-value">@FormatDuration()</span>
                    </div>
                    <div class="reservation-view-field">
                        <span class="reservation-view-label">Passengers</span>
                        <span class="reservation-view-value">@(details != null ? $"{details.PassengerCount} Persons" : "—")</span>
                    </div>
                    <div class="reservation-view-field">
                        <span class="reservation-view-label">Pick-up Location</span>
                        <span class="reservation-view-value">@(details?.PickupLocation ?? "—")</span>
                    </div>
                    <div class="reservation-view-field">
                        <span class="reservation-view-label">Drop-off Location</span>
                        <span class="reservation-view-value">@(details?.DropoffLocation ?? "—")</span>
                    </div>
                </div>
            </div>

            <div class="reservation-view-card">
                <div class="reservation-view-section-title">
                    <i class="bi bi-info-circle"></i>
                    <span>Additional Reservation Information</span>
                </div>

                @{
                    var transit = ViewData["Transit"] as Transit;
                    var driverName = transit?.Driver?.Name;
                }
                <div class="reservation-view-grid reservation-view-grid-two mb-3">
                    <div class="reservation-view-field">
                        <span class="reservation-view-label">Designated Driver</span>
                        <span class="reservation-view-value">
                            @if (!string.IsNullOrWhiteSpace(driverName))
                            {
                                @driverName
                                @if (transit != null)
                                {
                                    <a asp-controller="Transits" asp-action="Details" asp-route-transitid="@transit.TransitID" class="ms-1 small">View Transit</a>
                                }
                            }
                            else if (transit != null)
                            {
                                <text>Not Assigned Yet</text>
                                <a asp-controller="Transits" asp-action="Details" asp-route-transitid="@transit.TransitID" class="ms-1 small">Assign Driver</a>
                            }
                            else
                            {
                                <text>Not Assigned Yet</text>
                                <i class="bi bi-info-circle reservation-view-info-icon" title="Available after payment is approved"></i>
                            }
                        </span>
                    </div>
                    <div class="reservation-view-field">
                        <span class="reservation-view-label">Discount Applied</span>
                        <span class="reservation-view-value">@discountLabel</span>
                    </div>
                </div>

                <div class="reservation-view-field mb-0">
                    <span class="reservation-view-label">Special Requests/Notes</span>
                    <div class="reservation-view-notes">@(string.IsNullOrWhiteSpace(Model.Notes) ? "None" : Model.Notes)</div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="reservation-view-side-card mb-4">
                <h6 class="reservation-view-side-title">Internal Audit Log</h6>
                <div class="reservation-view-audit-list">
                    <div class="reservation-view-audit-item">
                        <span>Booking Created</span>
                    </div>
                    <div class="reservation-view-audit-item">
                        <span>Booking Submitted</span>
                    </div>
                    @if (isApproved)
                    {
                        <div class="reservation-view-audit-item">
                            <span>Booking Approved</span>
                        </div>
                    }
                    @if (isCancelled)
                    {
                        <div class="reservation-view-audit-item">
                            <span>Booking Rejected</span>
                        </div>
                    }
                </div>

                @if (isPending)
                {
                    <form asp-action="Approve" asp-route-id="@Model.ReservationId" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn reservation-btn-approve w-100">Approve Reservation</button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@Model.ReservationId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn reservation-btn-reject w-100" onclick="return confirm('Reject this reservation?');">Reject Reservation</button>
                    </form>
                }
            </div>

            @if (showPaymentSection)
            {
                <div class="reservation-view-side-card reservation-payment-card @(justApproved ? "is-reveal" : "")" id="paymentStatusCard">
                    <div class="reservation-payment-header">
                        <h6 class="reservation-view-side-title mb-0">Payment Status</h6>
                        <strong class="reservation-payment-status-text">@paymentStatusLabel</strong>
                    </div>
                    @if (latestPayment == null)
                    {
                        <a asp-controller="Payments" asp-action="Create" asp-route-reservationId="@Model.ReservationId" class="btn reservation-btn-payment w-100">
                            Add Payment
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Payments" asp-action="Details" asp-route-paymentid="@latestPayment.PaymentId" class="btn reservation-btn-payment w-100">
                            View Payment
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
