@model EasyRent_Checking.Models.Reservation

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Reservation</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Vehicle)</dt>
        <dd class="col-sm-10">
            @(Model?.Vehicle != null ? $"{Model.Vehicle.Brand} {Model.Vehicle.Model} ({Model.Vehicle.Type})" : "Unassigned")
        </dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.CustomerName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.CustomerName)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ContactNumber)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ContactNumber)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PickupLocation)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PickupLocation)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DropoffLocation)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DropoffLocation)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PickupDate)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PickupDate)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ReturnDate)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ReturnDate)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PickupTime)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PickupTime)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ReturnTime)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ReturnTime)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PassengerCount)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PassengerCount)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Notes)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Notes)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Discount)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Discount)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DiscountImagePath)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DiscountImagePath)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ReservationStatus)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ReservationStatus)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ReservationId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
