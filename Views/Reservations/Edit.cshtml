@model EasyRent_Checking.Models.Reservation

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Reservation</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReservationId" />
            <input type="hidden" asp-for="DiscountImagePath" />
            <div class="form-group mb-2">
                <label asp-for="VehicleId" class="control-label"></label>
                <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.VehicleId">
                    <option value="">Select vehicle</option>
                </select>
                <span asp-validation-for="VehicleId" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="CustomerName" class="control-label"></label>
                <input asp-for="CustomerName" class="form-control" />
                <span asp-validation-for="CustomerName" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="ContactNumber" class="control-label"></label>
                <input asp-for="ContactNumber" class="form-control" />
                <span asp-validation-for="ContactNumber" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="PickupLocation" class="control-label"></label>
                <input asp-for="PickupLocation" class="form-control" />
                <span asp-validation-for="PickupLocation" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="DropoffLocation" class="control-label"></label>
                <input asp-for="DropoffLocation" class="form-control" />
                <span asp-validation-for="DropoffLocation" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="PickupDate" class="control-label"></label>
                <input asp-for="PickupDate" class="form-control" type="date" />
                <span asp-validation-for="PickupDate" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="ReturnDate" class="control-label"></label>
                <input asp-for="ReturnDate" class="form-control" type="date" />
                <span asp-validation-for="ReturnDate" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="PickupTime" class="control-label"></label>
                <input asp-for="PickupTime" class="form-control" type="time" />
                <span asp-validation-for="PickupTime" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="ReturnTime" class="control-label"></label>
                <input asp-for="ReturnTime" class="form-control" type="time" />
                <span asp-validation-for="ReturnTime" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="PassengerCount" class="control-label"></label>
                <input asp-for="PassengerCount" class="form-control" />
                <span asp-validation-for="PassengerCount" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" class="form-control"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="Discount" class="control-label"></label>
                <select asp-for="Discount" class="form-select" asp-items="Html.GetEnumSelectList<Discount>()"></select>
                <span asp-validation-for="Discount" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="DiscountImageFile" class="control-label"></label>
                <input asp-for="DiscountImageFile" class="form-control" type="file" />
                <span asp-validation-for="DiscountImageFile" class="text-danger"></span>
            </div>
            <div class="form-group mb-2">
                <label asp-for="ReservationStatus" class="control-label"></label>
                <select asp-for="ReservationStatus" class="form-select" asp-items="Html.GetEnumSelectList<ReservationStatus>()"></select>
                <span asp-validation-for="ReservationStatus" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
