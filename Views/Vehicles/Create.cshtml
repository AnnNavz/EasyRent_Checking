@model EasyRent_Checking.Models.Vehicle

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Add New Vehicle";
    ViewData["ActivePage"] = "Vehicles";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/vehicle-create.css" asp-append-version="true" />
}

<div class="wizard-max-wrapper vehicle-create-wizard py-3">
    <div class="step-timeline">
        <div class="step-node active" id="node-1">
            <div class="step-circle" id="circle-1">1</div>
            <div class="step-label">INFO</div>
        </div>
        <div class="step-node" id="node-2">
            <div class="step-circle" id="circle-2">2</div>
            <div class="step-label">REVIEW</div>
        </div>
        <div class="step-node" id="node-3">
            <div class="step-circle" id="circle-3">3</div>
            <div class="step-label">COMPLETE</div>
        </div>
    </div>

    <form asp-action="Create" enctype="multipart/form-data" id="vehicleWizardForm">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <!-- STEP 1: INFO -->
        <div class="wizard-step-panel active" id="stepPanel-1">
            <div class="text-start mb-2">
                <h5 class="vehicle-wizard-heading" id="step1-title">Register New Vehicle</h5>
                <p class="vehicle-wizard-subheading" id="step1-subtitle">Fill in the vehicle details below to add a new vehicle</p>
            </div>

            <div class="vehicle-wizard-card">
                <div class="vehicle-wizard-section-head">
                    <span class="vehicle-wizard-section-icon"><i class="bi bi-car-front-fill"></i></span>
                    <h6 class="vehicle-wizard-section-title">Vehicle Information</h6>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Brand" class="vehicle-wizard-label">Brand</label>
                        <input asp-for="Brand" id="input-Brand" class="form-control vehicle-wizard-input" placeholder="e.g. Mercedes-Benz" />
                        <span asp-validation-for="Brand" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Model" class="vehicle-wizard-label">Model</label>
                        <input asp-for="Model" id="input-Model" class="form-control vehicle-wizard-input" placeholder="e.g. Sprinter 2500" />
                        <span asp-validation-for="Model" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Color" class="vehicle-wizard-label">Color</label>
                        <input asp-for="Color" id="input-Color" class="form-control vehicle-wizard-input" placeholder="e.g. Blue" />
                        <span asp-validation-for="Color" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <partial name="_VehicleTypeField" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PlateNumber" class="vehicle-wizard-label">Plate Number</label>
                        <input asp-for="PlateNumber" id="input-PlateNumber" class="form-control vehicle-wizard-input text-uppercase font-monospace" placeholder="e.g. GAP 4821" />
                        <span asp-validation-for="PlateNumber" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="vehicle-wizard-label">Status</label>
                        <select asp-for="Status" id="input-Status" class="form-select vehicle-wizard-input" asp-items="Html.GetEnumSelectList<VehicleStatus>()"></select>
                        <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RegistrationDate" class="vehicle-wizard-label">Registration Date</label>
                        <div class="vehicle-date-input-wrap">
                            <input asp-for="RegistrationDate" id="input-RegistrationDate" type="date" class="form-control vehicle-wizard-input" />
                            <i class="bi bi-calendar3 vehicle-date-icon" aria-hidden="true"></i>
                        </div>
                        <span asp-validation-for="RegistrationDate" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RegistrationExpiry" class="vehicle-wizard-label">Registration Expiry Date</label>
                        <div class="vehicle-date-input-wrap">
                            <input asp-for="RegistrationExpiry" id="input-RegistrationExpiry" type="date" class="form-control vehicle-wizard-input" />
                            <i class="bi bi-calendar3 vehicle-date-icon" aria-hidden="true"></i>
                        </div>
                        <span asp-validation-for="RegistrationExpiry" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Odometer" class="vehicle-wizard-label">Odometer (km)</label>
                        <div class="input-group vehicle-input-suffix">
                            <input asp-for="Odometer" id="input-Odometer" class="form-control vehicle-wizard-input" type="number" min="0" step="1" />
                            <span class="input-group-text">km</span>
                        </div>
                        <span asp-validation-for="Odometer" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PassengersCount" class="vehicle-wizard-label">Passengers Count</label>
                        <input asp-for="PassengersCount" id="input-PassengersCount" class="form-control vehicle-wizard-input" type="number" min="1" max="50" placeholder="e.g. 6" />
                        <span asp-validation-for="PassengersCount" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BasePrice" class="vehicle-wizard-label">Base Price</label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input asp-for="BasePrice" id="input-BasePrice" class="form-control vehicle-wizard-input" type="number" step="0.01" min="0.01" placeholder="e.g. 800" />
                        </div>
                        <span asp-validation-for="BasePrice" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SucceedingFee" class="vehicle-wizard-label">Succeeding Fee</label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input asp-for="SucceedingFee" id="input-SucceedingFee" class="form-control vehicle-wizard-input" type="number" step="0.01" min="0.01" placeholder="e.g. 400" />
                        </div>
                        <span class="small text-muted mt-1 d-block">Per hour after the first 8 hours</span>
                        <span asp-validation-for="SucceedingFee" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="vehicle-wizard-label">Description</label>
                        <textarea asp-for="Description" id="input-Description" class="form-control vehicle-wizard-input" rows="4" placeholder="Describe the vehicle features, condition, or rental notes"></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>

            <div class="vehicle-wizard-card">
                <div class="vehicle-wizard-section-head">
                    <span class="vehicle-wizard-section-icon"><i class="bi bi-file-earmark-text-fill"></i></span>
                    <h6 class="vehicle-wizard-section-title">Vehicle Image Upload</h6>
                </div>

                <div id="vehicle-image-upload-zone" class="license-upload-zone">
                    <div>
                        <i class="bi bi-cloud-arrow-up fs-3 d-block mb-2"></i>
                        <span class="d-block upload-main-text mb-1">Drag &amp; drop or click to upload</span>
                        <span class="d-block upload-sub-text">PNG, JPG, or JPEG (max 5MB)</span>
                    </div>
                    <input asp-for="ImageFile" id="input-File" type="file" class="license-file-input" accept=".png,.jpg,.jpeg" onchange="updateFileFeedback(this)" />
                </div>

                <div id="vehicle-image-preview-state" class="d-none">
                    <div class="vehicle-image-preview-box" id="vehicle-image-preview-box" title="Click to replace image">
                        <img id="vehicle-preview-img" alt="Vehicle image preview" />
                    </div>
                    <div id="vehicle-image-filename-bar" class="upload-preview-bar d-flex align-items-center justify-content-between">
                        <span id="feedback-filename" class="small fw-semibold text-muted font-monospace" style="font-size:0.8rem;">vehicle_image.png</span>
                        <button type="button" class="vehicle-image-remove-btn" onclick="clearFileSelection()">Remove</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- STEP 2: REVIEW -->
        <div class="wizard-step-panel" id="stepPanel-2">
            <div class="text-start mb-2">
                <h5 class="vehicle-wizard-heading">Reviews &amp; Verify</h5>
                <p class="vehicle-wizard-subheading">Please confirm the vehicle details before saving to the database.</p>
            </div>

            <div class="vehicle-wizard-card">
                <div class="vehicle-review-card-head">
                    <div class="vehicle-wizard-section-head mb-0">
                        <span class="vehicle-wizard-section-icon"><i class="bi bi-car-front-fill"></i></span>
                        <h6 class="vehicle-wizard-section-title">Vehicle Information</h6>
                    </div>
                    <button type="button" class="vehicle-review-edit-btn" onclick="openEditMode()">
                        Edit <i class="bi bi-pencil"></i>
                    </button>
                </div>

                <div class="vehicle-review-grid mb-4">
                    <div>
                        <span class="vehicle-review-field-label">Brand</span>
                        <span id="review-Brand" class="vehicle-review-field-value">-</span>
                    </div>
                    <div>
                        <span class="vehicle-review-field-label">Model</span>
                        <span id="review-Model" class="vehicle-review-field-value">-</span>
                    </div>
                    <div>
                        <span class="vehicle-review-field-label">Color</span>
                        <span id="review-Color" class="vehicle-review-field-value">-</span>
                    </div>
                    <div>
                        <span class="vehicle-review-field-label">Type</span>
                        <span id="review-Type" class="vehicle-review-field-value">-</span>
                    </div>
                    <div>
                        <span class="vehicle-review-field-label">Plate Number</span>
                        <span id="review-PlateNumber" class="vehicle-review-field-value font-monospace text-uppercase">-</span>
                    </div>
                    <div>
                        <span class="vehicle-review-field-label">Status</span>
                        <span id="review-Status" class="vehicle-review-field-value">-</span>
                    </div>
                    <div>
                        <span class="vehicle-review-field-label">Registration Date</span>
                        <span class="vehicle-review-field-value vehicle-review-date">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            <span id="review-RegistrationDate">-</span>
                        </span>
                    </div>
                    <div>
                        <span class="vehicle-review-field-label">Registration Expiry Date</span>
                        <span class="vehicle-review-field-value vehicle-review-date">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            <span id="review-RegistrationExpiry">-</span>
                        </span>
                    </div>
                    <div>
                        <span class="vehicle-review-field-label">Odometer</span>
                        <span id="review-Odometer" class="vehicle-review-field-value">-</span>
                    </div>
                    <div>
                        <span class="vehicle-review-field-label">Passengers Count</span>
                        <span id="review-PassengersCount" class="vehicle-review-field-value">-</span>
                    </div>
                    <div>
                        <span class="vehicle-review-field-label">Base Price</span>
                        <span id="review-BasePrice" class="vehicle-review-field-value">-</span>
                    </div>
                    <div>
                        <span class="vehicle-review-field-label">Succeeding Fee</span>
                        <span id="review-SucceedingFee" class="vehicle-review-field-value">-</span>
                    </div>
                    <div class="vehicle-review-grid-full">
                        <span class="vehicle-review-field-label">Description</span>
                        <span id="review-Description" class="vehicle-review-field-value">-</span>
                    </div>
                </div>

                <div class="vehicle-wizard-section-head">
                    <span class="vehicle-wizard-section-icon"><i class="bi bi-file-earmark-text-fill"></i></span>
                    <h6 class="vehicle-wizard-section-title">Vehicle Image</h6>
                </div>
                <div class="vehicle-review-image-wrap">
                    <img id="review-VehicleImg" class="d-none" alt="Vehicle image" />
                    <div id="review-VehiclePlaceholder" class="vehicle-review-image-empty">
                        <i class="bi bi-image fs-2"></i>
                        <span id="review-Filename">No image chosen</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- STEP 3: COMPLETE (fallback; successful save redirects to CreateSuccess) -->
        <div class="wizard-step-panel" id="stepPanel-3">
            <div class="vehicle-success-panel">
                <div class="mb-4">
                    <partial name="_SuccessCheckIcon" />
                </div>
                <h5 class="vehicle-wizard-heading mb-2">New Registered Vehicle</h5>
                <p class="vehicle-wizard-subheading mb-4">The vehicle has been added to the fleet inventory.</p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a href="@Url.Action("Index")" class="btn vehicle-wizard-btn-next">View Vehicles <i class="bi bi-arrow-right ms-1"></i></a>
                    <a href="@Url.Action("Create")" class="btn vehicle-wizard-btn-back"><i class="bi bi-plus-lg me-1"></i> Add Another Vehicle</a>
                </div>
            </div>
        </div>

        <div class="vehicle-wizard-actions">
            <button type="button" class="btn vehicle-wizard-btn-back" id="btnWizardCancel" onclick="handleCancelClick()">Cancel</button>
            <button type="button" class="btn vehicle-wizard-btn-next" id="btnWizardNext" onclick="navigateStep(1)">Continue</button>
        </div>
    </form>
</div>

<script src="~/js/vehicle-type-field.js" asp-append-version="true"></script>
<script>
    let isEditMode = false;
    const totalSteps = 3;

    const step1Fields = ['Brand', 'Model', 'Color', 'Type', 'PlateNumber', 'Odometer', 'Status', 'RegistrationDate', 'RegistrationExpiry', 'BasePrice', 'SucceedingFee', 'PassengersCount'];

    function setExpiryOneYearAfterRegistration() {
        const regDateInput = document.getElementById('input-RegistrationDate');
        const expiryInput = document.getElementById('input-RegistrationExpiry');
        if (!regDateInput.value) {
            return;
        }

        const parts = regDateInput.value.split('-');
        const year = parseInt(parts[0], 10);
        const month = parseInt(parts[1], 10) - 1;
        const day = parseInt(parts[2], 10);
        const expiryDate = new Date(year + 1, month, day);
        const formattedMonth = String(expiryDate.getMonth() + 1).padStart(2, '0');
        const formattedDay = String(expiryDate.getDate()).padStart(2, '0');
        expiryInput.value = `${expiryDate.getFullYear()}-${formattedMonth}-${formattedDay}`;
    }

    function validateStep1() {
        if (typeof syncVehicleType === 'function') syncVehicleType();
        const form = document.getElementById('vehicleWizardForm');
        let valid = true;
        let firstInvalid = null;

        if (typeof jQuery !== 'undefined' && jQuery.fn.validate) {
            const validator = jQuery(form).validate();
            step1Fields.forEach(function (name) {
                const el = form.querySelector('[name="' + name + '"]');
                if (el && !validator.element(el)) {
                    valid = false;
                    if (!firstInvalid) firstInvalid = el;
                }
            });
        } else {
            step1Fields.forEach(function (name) {
                const el = form.querySelector('[name="' + name + '"]');
                if (!el) return;
                const value = el.type === 'select-one' ? el.value : el.value.trim();
                if (value === '') {
                    valid = false;
                    el.classList.add('input-validation-error');
                    if (!firstInvalid) firstInvalid = el;
                } else {
                    el.classList.remove('input-validation-error');
                }
            });
        }

        if (!valid && firstInvalid) firstInvalid.focus();
        return valid;
    }

    function navigateStep(direction) {
        if (direction === 1 && isEditMode) {
            if (!validateStep1()) return;
            closeEditMode(true);
            return;
        }

        if (direction === 1 && currentStep === 2) {
            if (typeof syncVehicleType === 'function') syncVehicleType();
            document.getElementById('vehicleWizardForm').submit();
            return;
        }

        if (direction === 1 && currentStep === 1 && !validateStep1()) {
            return;
        }

        if (direction === 1 && currentStep === 1) {
            compileReviewSummary();
        }

        const nextStep = direction === 1 ? currentStep + 1 : currentStep - 1;
        setActiveStep(nextStep);
    }

    function setActiveStep(targetStep) {
        document.getElementById('stepPanel-1').classList.remove('active');
        document.getElementById('stepPanel-2').classList.remove('active');
        document.getElementById('stepPanel-3').classList.remove('active');

        if (targetStep > currentStep) {
            for (let step = currentStep; step < targetStep; step++) {
                document.getElementById(`node-${step}`).classList.add('completed');
            }
        } else if (targetStep < currentStep) {
            for (let step = targetStep; step <= totalSteps; step++) {
                document.getElementById(`node-${step}`).classList.remove('completed');
            }
        }

        currentStep = targetStep;
        isEditMode = false;
        resetStep1Header();
        document.getElementById(`stepPanel-${currentStep}`).classList.add('active');

        for (let i = 1; i <= totalSteps; i++) {
            const node = document.getElementById(`node-${i}`);
            if (i === currentStep) {
                node.classList.add('active');
            } else {
                node.classList.remove('active');
            }
        }

        updateWizardButtons();
        updateStepCircles();
    }

    function updateStepCircles() {
        for (let i = 1; i <= totalSteps; i++) {
            const circle = document.getElementById(`circle-${i}`);
            const node = document.getElementById(`node-${i}`);
            if (!circle || !node) continue;

            circle.textContent = String(i);
        }
    }

    function openEditMode() {
        isEditMode = true;
        document.getElementById('stepPanel-2').classList.remove('active');
        document.getElementById('stepPanel-1').classList.add('active');
        document.getElementById('step1-title').innerText = 'Edit Details';
        document.getElementById('step1-subtitle').innerText = 'Update the vehicle information before confirming.';
        setTopbarTitle('Edit Details');
        updateWizardButtons();
    }

    function closeEditMode(refreshReview) {
        isEditMode = false;
        document.getElementById('stepPanel-1').classList.remove('active');
        document.getElementById('stepPanel-2').classList.add('active');
        resetStep1Header();
        setTopbarTitle('Add New Vehicle');
        if (refreshReview) compileReviewSummary();
        updateWizardButtons();
    }

    function resetStep1Header() {
        document.getElementById('step1-title').innerText = 'Register New Vehicle';
        document.getElementById('step1-subtitle').innerText = 'Fill in the vehicle details below to add a new vehicle';
    }

    function setTopbarTitle(title) {
        const breadcrumbCurrent = document.querySelector('.topbar-breadcrumb-current');
        if (breadcrumbCurrent) breadcrumbCurrent.innerText = title;
    }

    function updateWizardButtons() {
        const cancelBtn = document.getElementById('btnWizardCancel');
        const nextBtn = document.getElementById('btnWizardNext');

        if (isEditMode) {
            cancelBtn.innerText = 'Cancel';
            cancelBtn.classList.remove('d-none');
            nextBtn.innerText = 'Continue';
            nextBtn.classList.remove('d-none');
        } else if (currentStep === 1) {
            cancelBtn.innerText = 'Cancel';
            cancelBtn.classList.remove('d-none');
            nextBtn.innerText = 'Continue';
            nextBtn.classList.remove('d-none');
        } else if (currentStep === 2) {
            cancelBtn.innerText = 'Edit Details';
            nextBtn.innerText = 'Continue';
        } else if (currentStep === 3) {
            cancelBtn.classList.add('d-none');
            nextBtn.classList.add('d-none');
        }
    }

    function handleCancelClick() {
        if (isEditMode) {
            closeEditMode(true);
            return;
        }
        if (currentStep === 1) {
            window.location.href = '@Url.Action("Index")';
        } else if (currentStep === 2) {
            openEditMode();
        } else {
            navigateStep(-1);
        }
    }

    function updateFileFeedback(input) {
        const uploadZone = document.getElementById('vehicle-image-upload-zone');
        const previewState = document.getElementById('vehicle-image-preview-state');
        const nameSpan = document.getElementById('feedback-filename');
        const previewImg = document.getElementById('vehicle-preview-img');

        if (input.files && input.files.length > 0) {
            const file = input.files[0];
            nameSpan.innerText = file.name;
            uploadZone.classList.add('d-none');
            previewState.classList.remove('d-none');

            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    previewImg.src = e.target.result;
                    previewImg.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                previewImg.src = '';
                previewImg.classList.add('d-none');
            }
        }
    }

    function clearFileSelection() {
        const fileInput = document.getElementById('input-File');
        const uploadZone = document.getElementById('vehicle-image-upload-zone');
        const previewState = document.getElementById('vehicle-image-preview-state');
        const previewImg = document.getElementById('vehicle-preview-img');

        fileInput.value = '';
        uploadZone.classList.remove('d-none');
        previewState.classList.add('d-none');
        previewImg.src = '';
        previewImg.classList.add('d-none');
    }

    function formatReviewDate(value) {
        if (!value) return 'N/A';
        const parts = value.split('-');
        const dateObj = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
        return dateObj.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
    }

    function compileReviewSummary() {
        document.getElementById('review-Brand').innerText = document.getElementById('input-Brand').value.trim() || 'N/A';
        document.getElementById('review-Model').innerText = document.getElementById('input-Model').value.trim() || 'N/A';
        document.getElementById('review-Color').innerText = document.getElementById('input-Color').value.trim() || 'N/A';

        const typeEl = document.getElementById('input-Type');
        document.getElementById('review-Type').innerText = typeof selectedVehicleTypeLabel === 'function'
            ? selectedVehicleTypeLabel()
            : (typeEl?.value || 'N/A');
        document.getElementById('review-PlateNumber').innerText = document.getElementById('input-PlateNumber').value.trim() || 'N/A';
        const odometerValue = document.getElementById('input-Odometer').value.trim();
        document.getElementById('review-Odometer').innerText = odometerValue ? `${Number(odometerValue).toLocaleString('en-PH')} km` : '0 km';

        const statusEl = document.getElementById('input-Status');
        const statusText = statusEl.options[statusEl.selectedIndex]?.text || 'N/A';
        document.getElementById('review-Status').innerText = statusText === 'Available' ? 'Active' : statusText;
        document.getElementById('review-RegistrationDate').innerText = formatReviewDate(document.getElementById('input-RegistrationDate').value);
        document.getElementById('review-RegistrationExpiry').innerText = formatReviewDate(document.getElementById('input-RegistrationExpiry').value);
        document.getElementById('review-BasePrice').innerText = document.getElementById('input-BasePrice').value
            ? `₱${parseFloat(document.getElementById('input-BasePrice').value).toLocaleString('en-PH')}`
            : 'N/A';
        document.getElementById('review-SucceedingFee').innerText = document.getElementById('input-SucceedingFee').value
            ? `₱${parseFloat(document.getElementById('input-SucceedingFee').value).toLocaleString('en-PH')}/hr`
            : 'N/A';
        document.getElementById('review-PassengersCount').innerText = document.getElementById('input-PassengersCount').value.trim() || 'N/A';
        document.getElementById('review-Description').innerText = document.getElementById('input-Description').value.trim() || 'N/A';

        const fileInput = document.getElementById('input-File');
        const reviewImg = document.getElementById('review-VehicleImg');
        const reviewPlaceholder = document.getElementById('review-VehiclePlaceholder');
        const reviewFilename = document.getElementById('review-Filename');
        const stepPreviewImg = document.getElementById('vehicle-preview-img');

        if (stepPreviewImg && stepPreviewImg.src && !stepPreviewImg.classList.contains('d-none')) {
            reviewImg.src = stepPreviewImg.src;
            reviewImg.classList.remove('d-none');
            reviewPlaceholder.classList.add('d-none');
        } else if (fileInput.files && fileInput.files.length > 0 && fileInput.files[0].type.startsWith('image/')) {
            const file = fileInput.files[0];
            reviewFilename.innerText = file.name;
            const reader = new FileReader();
            reader.onload = function (e) {
                reviewImg.src = e.target.result;
                reviewImg.classList.remove('d-none');
                reviewPlaceholder.classList.add('d-none');
            };
            reader.readAsDataURL(file);
        } else {
            reviewFilename.innerText = 'No image chosen';
            reviewImg.classList.add('d-none');
            reviewImg.src = '';
            reviewPlaceholder.classList.remove('d-none');
        }
    }

    function setupImageDragDrop() {
        const zone = document.getElementById('vehicle-image-upload-zone');
        const input = document.getElementById('input-File');
        if (!zone || !input) return;

        ['dragenter', 'dragover'].forEach(function (eventName) {
            zone.addEventListener(eventName, function (event) {
                event.preventDefault();
                event.stopPropagation();
                zone.style.backgroundColor = '#eef2ff';
            });
        });

        ['dragleave', 'drop'].forEach(function (eventName) {
            zone.addEventListener(eventName, function (event) {
                event.preventDefault();
                event.stopPropagation();
                zone.style.backgroundColor = '';
            });
        });

        zone.addEventListener('drop', function (event) {
            const files = event.dataTransfer.files;
            if (files && files.length > 0) {
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(files[0]);
                input.files = dataTransfer.files;
                updateFileFeedback(input);
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('input-RegistrationDate').addEventListener('change', setExpiryOneYearAfterRegistration);
        document.getElementById('input-RegistrationDate').addEventListener('input', setExpiryOneYearAfterRegistration);
        setupImageDragDrop();
        updateStepCircles();
        document.getElementById('vehicle-image-preview-box').addEventListener('click', function () {
            document.getElementById('input-File').click();
        });
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
