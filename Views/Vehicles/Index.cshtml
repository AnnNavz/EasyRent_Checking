@model IEnumerable<EasyRent_Checking.Models.Vehicle>
@using System.Globalization

@{
    Layout = "_LayoutAdminDashboard";
    ViewData["Title"] = "Vehicle Management";
    ViewData["ActivePage"] = "Vehicles";

    var totalVehiclesChange = ViewData["TotalVehiclesChange"] as decimal? ?? 0m;
    var activeVehiclesChange = ViewData["ActiveVehiclesChange"] as decimal? ?? 0m;
    var expiredRegistrationsChange = ViewData["ExpiredRegistrationsChange"] as decimal? ?? 0m;
    var today = DateTime.Today;

    string FormatTrend(decimal change) =>
        Math.Abs(change).ToString("0.0", CultureInfo.InvariantCulture) + "%";

    string currentSortName = ViewData["CurrentSort"]?.ToString() switch
    {
        "Model" => "Model",
        "Brand" => "Brand",
        "PlateNumber" => "Plate Number",
        "RegistrationExpiry" => "Registration Expiry",
        _ => "Sorting by"
    };

    string currentFilterName = ViewData["CurrentFilter"]?.ToString() switch
    {
        "Active" => "Active",
        "Rented" => "Rented",
        "Maintenance" => "In Maintenance",
        "ExpiredRegistration" => "Expired",
        _ => "Filters"
    };

    bool IsRegistrationExpired(Vehicle vehicle) => vehicle.RegistrationExpiry.Date < today;

    string DisplayStatusLabel(Vehicle item)
    {
        if (!item.IsActive)
        {
            return "Deactivated";
        }

        if (IsRegistrationExpired(item))
        {
            return "Expired";
        }

        return StatusLabel(item.Status);
    }

    string DisplayStatusClass(Vehicle item)
    {
        if (!item.IsActive)
        {
            return "is-deactivated";
        }

        if (IsRegistrationExpired(item))
        {
            return "is-expired";
        }

        return StatusClass(item.Status);
    }

    string StatusLabel(VehicleStatus status) => status switch
    {
        VehicleStatus.Available => "Active",
        VehicleStatus.InMaintenance => "In Maintenance",
        _ => status.ToString()
    };

    string StatusClass(VehicleStatus status) => status switch
    {
        VehicleStatus.Available => "is-active",
        VehicleStatus.Rented => "is-rented",
        VehicleStatus.InMaintenance => "is-maintenance",
        _ => "is-unavailable"
    };

    string indexReturnUrl = Url.Action("Index", new
    {
        searchString = ViewData["CurrentSearch"],
        sortBy = ViewData["CurrentSort"],
        currentFilter = ViewData["CurrentFilter"],
        page = ViewData["PageIndex"]
    }) ?? "";
}

<div class="vehicles-index-page">
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="vehicle-metric-card">
                <div class="vehicle-metric-icon" aria-hidden="true">
                    <i class="bi bi-truck-front-fill"></i>
                </div>
                <div class="vehicle-metric-body">
                    <span class="vehicle-metric-label">Total Vehicles</span>
                    <div class="vehicle-metric-value">@(ViewData["TotalVehiclesCount"] ?? "0")</div>
                </div>
                <div class="vehicle-metric-trend">
                    <span class="vehicle-metric-badge @(totalVehiclesChange >= 0 ? "is-up" : "is-down")">
                        <i class="bi @(totalVehiclesChange >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                        @FormatTrend(totalVehiclesChange)
                    </span>
                    <span class="vehicle-metric-compare">vs last month</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="vehicle-metric-card">
                <div class="vehicle-metric-icon is-gold" aria-hidden="true">
                    <i class="bi bi-car-front-fill"></i>
                </div>
                <div class="vehicle-metric-body">
                    <span class="vehicle-metric-label">Active Vehicles</span>
                    <div class="vehicle-metric-value">@(ViewData["ActiveVehiclesCount"] ?? "0")</div>
                </div>
                <div class="vehicle-metric-trend">
                    <span class="vehicle-metric-badge @(activeVehiclesChange >= 0 ? "is-up" : "is-down")">
                        <i class="bi @(activeVehiclesChange >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                        @FormatTrend(activeVehiclesChange)
                    </span>
                    <span class="vehicle-metric-compare">vs last month</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="vehicle-metric-card">
                <div class="vehicle-metric-icon is-danger" aria-hidden="true">
                    <i class="bi bi-calendar-x"></i>
                </div>
                <div class="vehicle-metric-body">
                    <span class="vehicle-metric-label">Registration Expiry</span>
                    <div class="vehicle-metric-value">@(ViewData["ExpiredRegistrationsCount"] ?? "0")</div>
                </div>
                <div class="vehicle-metric-trend">
                    <span class="vehicle-metric-badge @(expiredRegistrationsChange >= 0 ? "is-up" : "is-down")">
                        <i class="bi @(expiredRegistrationsChange >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                        @FormatTrend(expiredRegistrationsChange)
                    </span>
                    <span class="vehicle-metric-compare">vs last month</span>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Index" method="get" class="w-100">
        <input type="hidden" name="sortBy" value="@ViewData["CurrentSort"]" />
        <input type="hidden" name="currentFilter" value="@ViewData["CurrentFilter"]" />

        <div class="vehicle-index-toolbar mb-4">
            <div class="vehicle-index-toolbar-filters">
                <div class="dropdown">
                    <button class="btn btn-filter dropdown-toggle text-capitalize" type="button" data-bs-toggle="dropdown">
                        @currentSortName
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="?sortBy=Model&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Model</a></li>
                        <li><a class="dropdown-item" href="?sortBy=Brand&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Brand</a></li>
                        <li><a class="dropdown-item" href="?sortBy=PlateNumber&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Plate Number</a></li>
                        <li><a class="dropdown-item" href="?sortBy=RegistrationExpiry&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Registration Expiry</a></li>
                        <li><hr class="dropdown-menu-divider"></li>
                        <li><a class="dropdown-item text-muted small" href="?sortBy=&searchString=@ViewData["CurrentSearch"]&currentFilter=@ViewData["CurrentFilter"]">Clear Sorting</a></li>
                    </ul>
                </div>

                <div class="dropdown">
                    <button class="btn btn-filter dropdown-toggle text-capitalize" type="button" data-bs-toggle="dropdown">
                        @currentFilterName
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="?currentFilter=Active&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Active</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=Rented&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Rented</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=Maintenance&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">In Maintenance</a></li>
                        <li><a class="dropdown-item" href="?currentFilter=ExpiredRegistration&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Expired</a></li>
                        <li><hr class="dropdown-menu-divider"></li>
                        <li><a class="dropdown-item text-muted small" href="?currentFilter=&searchString=@ViewData["CurrentSearch"]&sortBy=@ViewData["CurrentSort"]">Clear Filters</a></li>
                    </ul>
                </div>
            </div>

            <div class="vehicle-index-toolbar-search">
                <i class="bi bi-search vehicle-index-search-icon" aria-hidden="true"></i>
                <input type="text"
                       name="searchString"
                       value="@ViewData["CurrentSearch"]"
                       class="form-control vehicle-index-search-input"
                       placeholder="Search Vehicles" />
                @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()))
                {
                    <a href="?searchString=&sortBy=@ViewData["CurrentSort"]&currentFilter=@ViewData["CurrentFilter"]"
                       class="vehicle-index-search-clear"
                       aria-label="Clear search">&times;</a>
                }
            </div>

            <a asp-action="Create" class="btn vehicle-index-add-btn">
                <i class="bi bi-plus-lg"></i> Add Vehicle
            </a>
        </div>
    </form>

    <div class="index-table-panel mb-4">
        <div class="table-responsive">
            <table class="table admin-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Model</th>
                        <th>Plate Number</th>
                        <th>Brand</th>
                        <th>Color</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Registration Date</th>
                        <th>Registration Expiry</th>
                        <th class="text-end" style="width: 60px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="table-vehicle-cell">
                                        <div class="table-vehicle-thumb">
                                            @if (!string.IsNullOrEmpty(item.ImagePath))
                                            {
                                                <img src="~/images/@item.ImagePath" alt="@item.Model" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-car-front-fill" aria-hidden="true"></i>
                                            }
                                        </div>
                                        <span class="table-vehicle-name">@Html.DisplayFor(modelItem => item.Model)</span>
                                    </div>
                                </td>
                                <td class="text-uppercase font-monospace fw-semibold">@Html.DisplayFor(modelItem => item.PlateNumber)</td>
                                <td>@Html.DisplayFor(modelItem => item.Brand)</td>
                                <td>@Html.DisplayFor(modelItem => item.Color)</td>
                                <td>@Html.DisplayFor(modelItem => item.Type)</td>
                                <td>
                                    <span class="vehicle-status-badge @DisplayStatusClass(item)">@DisplayStatusLabel(item)</span>
                                </td>
                                <td>@AdminDates.Format(item.RegistrationDate)</td>
                                <td>@AdminDates.Format(item.RegistrationExpiry)</td>
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="admin-row-action" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed","placement":"bottom-end"}' data-bs-boundary="viewport" aria-label="Vehicle actions">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.VehicleId" asp-route-returnUrl="@indexReturnUrl"><i class="bi bi-pencil me-2"></i> Edit</a></li>
                                            <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.VehicleId"><i class="bi bi-info-circle me-2"></i> Details</a></li>
                                            <li><hr class="dropdown-menu-divider"></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger" onclick="openDeletePopup('@item.VehicleId', '@item.Model')">
                                                    <i class="bi bi-trash me-2"></i> Delete
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted fw-medium">
                                <i class="bi bi-car-front fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                No matching vehicles located in fleet indexes.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AdminPagination" />
    </div>
</div>

@{
    ViewData["DeleteModalId"] = "vehicleDeletePopup";
    ViewData["DeleteHiddenInputId"] = "popupVehicleId";
    ViewData["DeleteMessageId"] = "deletePopupMessage";
    ViewData["DeleteEntityLabel"] = "vehicle";
}
<partial name="_DeleteConfirmModal" />
